diff --git a/tools/verify-owner-open-r13-rust-workspace.sh b/tools/verify-owner-open-r13-rust-workspace.sh
new file mode 100755
index 0000000..fb6ab12
--- /dev/null
+++ b/tools/verify-owner-open-r13-rust-workspace.sh
@@ -0,0 +1,113 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# The workspace contains deliberately incompatible product, development, and
+# device-conformance custody domains. A single feature-unified build would
+# erase that boundary and is expected to fail at compile time. Qualify the
+# default workspace plus every declared valid feature lane in isolation.
+export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
+export RUST_BACKTRACE="${RUST_BACKTRACE:-1}"
+export TRILLIONNIUM_P01_CONFORMANCE_BUILD_VARIANT=userdebug
+
+readonly -a VALID_FEATURE_LANES=(
+  "trillionnium-agent-api-uds|legacy-plan-methods"
+  "trillionnium-agent-direct-tools|dev-overrides"
+  "trillionnium-agent-direct-tools|development-compatibility-lane"
+  "trillionnium-agent-direct-tools|production-durable-hotpath"
+  "trillionnium-agent-direct-tools|device-launch-package-conformance"
+  "trillionnium-dbus|legacy-plan-execution"
+  "trillionnium-os-types|p0-launch-package-device-conformance"
+  "trillionnium-privilege-broker-protocol|p0-launch-package-device-conformance"
+  "trillionnium-shell-exec|root-linux-mcp-adapter"
+  "trillionnium-shell-exec|android-product"
+  "trillionnium-shell-exec|host-conformance"
+  "trillionnium-tool-runtime|dev-conformance-fault-hook"
+  "trillionnium-tool-runtime|p0-launch-package-provider-conformance"
+  "trillionnium-tool-runtime|legacy-authority-effects"
+  "trillionnium-agent-privilege-broker|p0-launch-package-device-conformance"
+  "trillionniumd|dev-conformance-fault-hook"
+  "trillionniumd|p0-launch-package-device-conformance"
+  "trillionniumd|legacy-plan-conformance"
+)
+
+readonly -a INVALID_FEATURE_LANES=(
+  "trillionnium-agent-direct-tools|trusted-context-hotpath|trusted-context-hotpath is source-only"
+  "trillionnium-agent-direct-tools|production-durable-hotpath,dev-overrides|production-durable-hotpath and dev-overrides are mutually exclusive custody domains"
+  "trillionnium-agent-direct-tools|production-durable-hotpath,development-compatibility-lane|production-durable-hotpath and development-compatibility-lane are mutually exclusive effect lanes"
+  "trillionnium-agent-direct-tools|device-launch-package-conformance,production-durable-hotpath|device-launch-package-conformance is a separate non-product custody domain"
+)
+
+run_feature_lane() {
+  local phase="$1"
+  local lane="$2"
+  local package="${lane%%|*}"
+  local features="${lane#*|}"
+  echo "==> ${phase}: ${package} [${features}]"
+  case "$phase" in
+    test)
+      cargo test -p "$package" --all-targets --no-default-features \
+        --features "$features" --locked
+      ;;
+    clippy)
+      cargo clippy -p "$package" --all-targets --no-default-features \
+        --features "$features" --locked -- -D warnings
+      ;;
+    doc)
+      RUSTDOCFLAGS="-D warnings" cargo doc -p "$package" --no-deps \
+        --no-default-features --features "$features" --locked
+      ;;
+    *)
+      echo "unknown feature-lane phase: $phase" >&2
+      return 2
+      ;;
+  esac
+}
+
+expect_feature_lane_failure() {
+  local lane="$1"
+  local package="${lane%%|*}"
+  local remainder="${lane#*|}"
+  local features="${remainder%%|*}"
+  local expected="${remainder#*|}"
+  local log
+  log="$(mktemp)"
+  echo "==> expected compile rejection: ${package} [${features}]"
+  if cargo check -p "$package" --all-targets --no-default-features \
+      --features "$features" --locked >"$log" 2>&1; then
+    cat "$log" >&2
+    rm -f "$log"
+    echo "invalid feature combination unexpectedly compiled" >&2
+    return 1
+  fi
+  if ! grep -Fq "$expected" "$log"; then
+    cat "$log" >&2
+    rm -f "$log"
+    echo "invalid feature combination failed for an unexpected reason" >&2
+    return 1
+  fi
+  rm -f "$log"
+}
+
+cargo metadata --workspace --locked --format-version 1 >/dev/null
+cargo fmt --all -- --check
+
+# First prove the ordinary, feature-minimal workspace closure.
+cargo test --workspace --all-targets --locked
+for lane in "${VALID_FEATURE_LANES[@]}"; do
+  run_feature_lane test "$lane"
+done
+
+cargo clippy --workspace --all-targets --locked -- -D warnings
+for lane in "${VALID_FEATURE_LANES[@]}"; do
+  run_feature_lane clippy "$lane"
+done
+
+RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked
+for lane in "${VALID_FEATURE_LANES[@]}"; do
+  run_feature_lane doc "$lane"
+done
+
+# Finally prove that custody-domain boundaries still reject forbidden unions.
+for lane in "${INVALID_FEATURE_LANES[@]}"; do
+  expect_feature_lane_failure "$lane"
+done
