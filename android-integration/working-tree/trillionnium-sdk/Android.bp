android_app {
    name: "org.trillionnium.platform-res",
    use_resource_processor: false,
    sdk_version: "core_platform",
    certificate: "platform",

    manifest: "trillionnium/res/AndroidManifest.xml",

    // Disable dexpreopt and verify_uses_libraries check as the app
    // contains no Java code to be dexpreopted.
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },

    // Soong special-cases org.trillionnium.platform-res to install this alongside
    // the libraries at /system_ext/framework/org.trillionnium.platform-res.apk.

    aaptflags: [
        "--private-symbols",
        "org.trillionnium.platform.internal",

        // Framework doesn't need versioning since it IS the platform.
        "--no-auto-version",

        // Allow overlay to add resource
        "--auto-add-overlay",

        // Tell aapt to create "extending (non-application)" resource IDs,
        // since these resources will be used by many apps.
        "--allow-reserved-package-id",
        // Use id 0x3f (one less than app id).
        "--package-id",
        "63",
    ],

    resource_dirs: [
        "trillionnium/res/res",
    ],

    // Create package-export.apk, which other packages can use to get
    // PRODUCT-agnostic resource data like IDs and type definitions.
    export_package_resources: true,
}

// The Trillionnium OS Platform Framework Library
// ============================================================

// Compile-time product binding for the sole Codex launcher identity. The common contract is the
// authoritative production descriptor. The P01 userdebug variant replaces only the two generated
// descriptor sources with a srcjar derived from the exact verified launcher ELF selected by the
// same product graph. No runtime property, challenge field, or caller can select this value.
soong_config_module_type_import {
    from: "vendor/trillionnium/prebuilt/common/Android.bp",
    module_types: ["trillionnium_p01_java_library"],
}

python_binary_host {
    name: "trillionnium-agent-descriptor-registry-generator",
    main: "tools/generate-agent-descriptor-registry.py",
    srcs: ["tools/generate-agent-descriptor-registry.py"],
    visibility: ["//visibility:private"],
}

genrule {
    name: "trillionnium-agent-descriptor-registry-p01-userdebug-generated",
    srcs: [
        "contracts/agent-descriptor-registry-v1.json",
        "contracts/canonical-operation-binding-v1.json",
        ":trillionnium-codex-agent-0.144.1-p01-userdebug-verified",
    ],
    tools: ["trillionnium-agent-descriptor-registry-generator"],
    out: ["trillionnium-agent-descriptor-registry-p01-userdebug.srcjar"],
    cmd: "$(location trillionnium-agent-descriptor-registry-generator)" +
        " --contract $(location contracts/agent-descriptor-registry-v1.json)" +
        " --canonical-operation-contract $(location contracts/canonical-operation-binding-v1.json)" +
        " --identity-artifact $(location :trillionnium-codex-agent-0.144.1-p01-userdebug-verified)" +
        " --srcjar-output $(out)",
    visibility: ["//visibility:private"],
}

genrule {
    name: "trillionnium-agent-descriptor-registry-p01-userdebug-contract",
    srcs: [
        "contracts/agent-descriptor-registry-v1.json",
        "contracts/canonical-operation-binding-v1.json",
        ":trillionnium-codex-agent-0.144.1-p01-userdebug-verified",
    ],
    tools: ["trillionnium-agent-descriptor-registry-generator"],
    out: ["agent-descriptor-registry-p01-userdebug-materialized.json"],
    cmd: "$(location trillionnium-agent-descriptor-registry-generator)" +
        " --contract $(location contracts/agent-descriptor-registry-v1.json)" +
        " --canonical-operation-contract $(location contracts/canonical-operation-binding-v1.json)" +
        " --identity-artifact $(location :trillionnium-codex-agent-0.144.1-p01-userdebug-verified)" +
        " --materialized-contract-output $(out)",
    visibility: ["//visibility:private"],
}

trillionnium_p01_java_library {
    name: "trillionnium-agent-identity-product",
    srcs: [
        "agentidentity/src/org/trillionnium/agentidentity/AgentDescriptor.java",
        "agentidentity/src/org/trillionnium/agentidentity/AgentDescriptorRegistry.java",
        "agentidentity/src/org/trillionnium/agentidentity/CanonicalOperationBinding.java",
        "agentidentity/src/org/trillionnium/agentidentity/CanonicalOperationBindingContract.java",
    ],
    soong_config_variables: {
        trillionnium_p01_build_variant: {
            userdebug: {
                exclude_srcs: [
                    "agentidentity/src/org/trillionnium/agentidentity/AgentDescriptor.java",
                    "agentidentity/src/org/trillionnium/agentidentity/AgentDescriptorRegistry.java",
                ],
                srcs: [":trillionnium-agent-descriptor-registry-p01-userdebug-generated"],
            },
        },
    },
    installable: false,
    sdk_version: "current",
    java_version: "11",
    visibility: ["//visibility:public"],
}

// Single source of truth for the OS-compiled Agent descriptor product allowlist. The framework
// library and platform-signed Accessibility APK compile these exact same closed-schema sources.
filegroup {
    name: "trillionnium-agent-descriptor-registry-sources",
    srcs: ["agentidentity/src/**/*.java"],
}

// Exact source inputs for the vendor product-HOLD gate that prevents the
// capability-lease root-publication helper from being mistaken for the
// independent Direct operation epoch/replay-control protocols. Exporting
// source text to a host test does not create a socket, service, authority, or
// effect route.
filegroup {
    name: "trillionnium-agent-operation-epoch-replay-product-hold-contract-sources",
    srcs: [
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/AgentSystemApiReplayCache.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/AgentSystemApiReplayControlHandler.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/AgentSystemApiReplayControlProtocol.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/AgentSystemApiService.java",
        "tests/AgentSystemApiReplayAckTest.java",
        "packages/TrillionniumAgentAccessibility/src/org/trillionnium/agentaccessibility/AccessibilityReplayControlHandler.java",
        "packages/TrillionniumAgentAccessibility/src/org/trillionnium/agentaccessibility/AccessibilityReplayControlProtocol.java",
        "packages/TrillionniumAgentAccessibility/src/org/trillionnium/agentaccessibility/AccessibilityReplayLedger.java",
        "packages/TrillionniumAgentAccessibility/src/org/trillionnium/agentaccessibility/AccessibilityDeferredClose.java",
        "packages/TrillionniumAgentAccessibility/src/org/trillionnium/agentaccessibility/AgentAccessibilityService.java",
        "packages/TrillionniumAgentAccessibility/tests/src/org/trillionnium/agentaccessibility/AccessibilityReplayAckTest.java",
    ],
    visibility: ["//vendor:__subpackages__"],
}

filegroup {
    name: "trillionnium-canonical-operation-binding-golden-vector-sources",
    srcs: [
        "agentidentity/tests/src/org/trillionnium/agentidentity/CanonicalOperationBindingGoldenVectors.java",
    ],
}

filegroup {
    name: "trillionnium-sdk-sources",
    srcs: [
        "sdk/src/java/trillionnium/**/*.java",
        "sdk/src/java/trillionnium/**/I*.aidl",
    ],
}

filegroup {
    name: "trillionnium-sdk-internal-sources",
    srcs: [
        "sdk/src/java/org/trillionnium/internal/**/*.java",
        "sdk/src/java/org/trillionnium/internal/**/I*.aidl",
    ],
}

// Process-separated capability-lease transport shared by system_server and the
// independent consent APK.  The interface carries only broker-authored bytes;
// callers cannot submit a challenge or destination through this service.
java_library_static {
    name: "trillionnium-capability-lease-binder-api",
    srcs: ["capabilityleaseapi/src/**/*"],
    aidl: {
        local_include_dirs: ["capabilityleaseapi/src"],
    },
    installable: false,
    sdk_version: "core_platform",
    libs: [
        "framework",
    ],
    visibility: ["//visibility:public"],
}

filegroup {
    name: "trillionnium-capability-lease-ui-protocol-source",
    srcs: [
        "capabilityleaseapi/src/org/trillionnium/capabilitylease/CapabilityLeaseUiProtocol.java",
    ],
    visibility: ["//visibility:public"],
}

filegroup {
    name: "trillionnium-library-sources",
    srcs: [
        ":trillionnium-agent-descriptor-registry-sources",
        "trillionnium/lib/main/java/**/*.java",
    ],
}

// Product framework sources exclude the descriptor package because the selected, compile-time
// identity library above is its sole owner. The broader source filegroup remains for common host
// contract tests, which intentionally verify the authoritative production descriptor.
filegroup {
    name: "trillionnium-platform-library-sources",
    srcs: [
        "trillionnium/lib/main/java/**/*.java",
    ],
}

// Exact source-only inputs for the vendor enrollment/loader identity boundary test. Exporting
// these four files as host-test data does not compile, install, package, or activate the loader.
filegroup {
    name: "trillionnium-capability-lease-provider-loader-contract-sources",
    srcs: [
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseConsumerArtifactMeasurement.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseReceiptVerifierArtifactMeasurement.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseVerifiedPluginAndroidBackendV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseVerifiedPluginLoaderV1.java",
    ],
    // Soong permits non-vendor packages to grant vendor access only at this boundary.
    visibility: ["//vendor:__subpackages__"],
}

// Source-disabled destination-provider construction ABI shared by host tests.
// This filegroup neither installs the provider nor makes the runtime reachable.
filegroup {
    name: "trillionnium-capability-lease-destination-construction-sources",
    srcs: [
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseDestinationExecutionPlanV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseDestinationPluginConstructionV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ApprovedDestinationInputV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/DestinationConsumerPluginFactoryV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/DestinationConsumerPluginV1.java",
    ],
}

// Source-disabled receipt-provider construction ABI shared by host tests. This
// filegroup neither installs the provider nor makes the runtime reachable.
filegroup {
    name: "trillionnium-capability-lease-receipt-construction-sources",
    srcs: [
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseReceiptPluginConstructionV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerificationInputV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerifierPluginFactoryV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerifierPluginV1.java",
    ],
}

java_defaults {
    name: "trillionnium-sdk-defaults",

    // Include aidl files from trillionnium.app namespace as well as internal src aidl files
    aidl: {
        local_include_dirs: ["sdk/src/java"],
    },

    srcs: [
        ":trillionnium-sdk-internal-sources",
        ":trillionnium-sdk-sources",
        // For the generated R.java and Manifest.java
        ":org.trillionnium.platform-res{.aapt.srcjar}",
    ],

    static_libs: [
        "vendor.trillionnium.health-V2-java",
        "vendor.trillionnium.livedisplay-V1-java",
        "vendor.trillionnium.touch-V1-java",
    ],
}

java_library {
    name: "org.trillionnium.platform",
    defaults: ["trillionnium-sdk-defaults"],
    installable: true,
    sdk_version: "core_platform",

    libs: [
        "framework",
        "framework-connectivity.stubs.module_lib",
        "services",
    ],

    srcs: [
        ":trillionnium-platform-library-sources",
    ],

    static_libs: [
        "trillionnium-agent-identity-product",
        "trillionnium-capability-lease-binder-api",
    ],

    // These implementations are explicitly source-only. The abstract-socket connector is
    // PRODUCT_WIRED=false and its hidden UnixSocketAddress factory must move behind a separately
    // measured platform artifact. The plugin adapter must remain absent until a fixed loader can
    // atomically bind verified bytes, measurement and the loaded instance. The parent-loaded
    // public @hide SPI/DTO types remain in this library as ABI prerequisites only.
    exclude_srcs: [
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseRootRouteSocketConnectorV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseRootRouteSessionConstructorV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeasePluginAdapterV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeasePluginDexStructureV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeasePluginJarStructureV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseVerifiedPluginAndroidBackendV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseVerifiedPluginLoaderV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseOsNetworkTlsEffectV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseSelectedNetworkTlsProducerV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseAndroidSelectedNetworkTlsProducerV1.java",
    ],

    // PRODUCT_PACKAGES is the sole partition owner of the system_ext
    // Accessibility APK. A cross-partition required edge from this system
    // framework library makes CF's system_other graph receive the same
    // odex/vdex from both system and system_ext.
    required: ["org.trillionnium.agent.system_api.xml"],
}

python_test_host {
    name: "TrillionniumAgentAccessibilityProductOwnershipContractTest",
    main: "tests/agent_accessibility_product_ownership_contract_test.py",
    srcs: [
        "tests/agent_accessibility_product_ownership_contract_test.py",
    ],
    data: [
        "Android.bp",
        "packages/TrillionniumAgentAccessibility/Android.bp",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

// Read-only source/device-surface audit.  The guard intentionally reports HOLD
// when a source tree cannot prove hardware-backed KeyMint, an OS-owned rollback
// producer, or a live Accessibility grant; it never treats missing evidence as
// activation-ready and never performs a device operation.
python_test_host {
    name: "TrillionniumAndroidSecuritySurfaceContractTest",
    main: "tests/android_security_surface_contract_test.py",
    srcs: [
        "tests/android_security_surface_contract_test.py",
        "tools/verify_android_security_surfaces.py",
    ],
    data: [
        "contracts/android-security-surface-v1.json",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

// Build-only, source-disabled loader prerequisite. This module is neither installable nor wired
// into org.trillionnium.platform. Its fixed production paths do not exist in the product image.
