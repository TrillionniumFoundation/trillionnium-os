        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseOsNetworkTlsEffectV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseSelectedNetworkTlsProducerV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseAndroidSelectedNetworkTlsProducerV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/OpenUriLeaseSemanticsV1Contract.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeasePluginDexStructureV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeasePluginJarStructureV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseReceiptVerifierArtifactMeasurement.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseReceiptPluginConstructionV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseVerifiedPluginAndroidBackendV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseVerifiedPluginLoaderV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ApprovedDestinationInputV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/DestinationConsumerPluginFactoryV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/DestinationConsumerPluginV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerificationInputV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerifierPluginFactoryV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerifierPluginV1.java",
    ],
    installable: false,
    sdk_version: "core_platform",
    libs: [
        "framework",
        "framework-connectivity.stubs.module_lib",
    ],
    java_version: "11",
    visibility: ["//visibility:private"],
}

// Production-identity receipt provider source slice. json-prebuilt is a compile-time-only lib:
// it must never be statically merged into this DEX because the closed artifact has exactly two
// provider class definitions. The raw and exact-envelope modules are non-installable and are not
// referenced by PRODUCT_PACKAGES, a required edge, or an install path.
java_library {
    name: "TrillionniumCapabilityLeaseReceiptVerifierProviderSourceDisabledRaw",
    srcs: [
        "providers/receipt/src/org/trillionnium/platform/provider/receipt/CapabilityLeaseReceiptVerifierPluginV1.java",
        "providers/receipt/src/org/trillionnium/platform/provider/receipt/CapabilityLeaseReceiptVerifierProviderV1.java",
    ],
    libs: [
        "org.trillionnium.platform",
        "json-prebuilt",
    ],
    installable: false,
    compile_dex: true,
    sdk_version: "core_platform",
    java_version: "11",
    visibility: ["//visibility:private"],
}

java_genrule {
    name: "TrillionniumCapabilityLeaseReceiptVerifierProviderSourceDisabled",
    tools: [
        "zip2zip",
        "zipalign",
    ],
    srcs: [":TrillionniumCapabilityLeaseReceiptVerifierProviderSourceDisabledRaw"],
    out: ["trillionnium-capability-lease-receipt-verifier.jar"],
    cmd: "$(location zip2zip) -i $(in) " +
        "-o $(genDir)/receipt-provider-unaligned.jar -0 classes.dex " +
        "classes.dex META-INF/MANIFEST.MF && " +
        "$(location zipalign) -f 4 " +
        "$(genDir)/receipt-provider-unaligned.jar $(out)",
    visibility: ["//visibility:private"],
}

java_library {
    name: "trillionnium-capability-lease-receipt-verifier",
    srcs: [
        "providers/receipt/src/org/trillionnium/platform/provider/receipt/CapabilityLeaseReceiptVerifierPluginV1.java",
        "providers/receipt/src/org/trillionnium/platform/provider/receipt/CapabilityLeaseReceiptVerifierProviderV1.java",
    ],
    libs: [
        "org.trillionnium.platform",
        "json-prebuilt",
    ],
    installable: true,
    compile_dex: true,
    sdk_version: "core_platform",
    system_ext_specific: true,
    java_version: "11",
    visibility: ["//visibility:private"],
}

java_test_host {
    name: "TrillionniumCapabilityLeaseReceiptVerifierProviderSourceDisabledTest",
    srcs: [
        "providers/receipt/src/org/trillionnium/platform/provider/receipt/CapabilityLeaseReceiptVerifierPluginV1.java",
        "providers/receipt/src/org/trillionnium/platform/provider/receipt/CapabilityLeaseReceiptVerifierProviderV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseJson.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseReceiptVerifierArtifactMeasurement.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/CapabilityLeaseReceiptPluginConstructionV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/OpenUriLeaseSemanticsV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/OpenUriLeaseSemanticsV1Contract.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ApprovedDestinationInputV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerificationInputV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerifierPluginFactoryV1.java",
        "trillionnium/lib/main/java/org/trillionnium/platform/internal/plugin/ReceiptVerifierPluginV1.java",
        "tests/CapabilityLeaseChallengeV1Golden.java",
        "tests/CapabilityLeaseReceiptVerifierProviderV1Test.java",
