# The immutable source is part of system_ext. A single read-only bind mount
# exposes this same inode at the legacy chroot path, preserving this label as
# the only long-lived broker entrypoint. The underlying rootfs file is never an
# entrypoint and remains ordinary core data.
type trillionnium_codex_agent_exec, exec_type, file_type, system_file_type;
# The real Codex ELF is not an Agent entrypoint. Only the measured integrity
# launcher transitions from the daemon; once inside the Codex domain, that
# launcher may execute this separately labelled runtime without transition.
type trillionnium_codex_runtime_exec, exec_type, file_type, system_file_type;
