# Every ordinary regular file in the release-measured Root Linux tree is
# relabelled only after atomic publication and before any bind mount or worker
# starts. Writable/state and dedicated direct-tool files retain their more
# specific labels. This verified-data type is the sole general Root Linux
# execute surface admitted to the isolated shell worker.
type trillionnium_shell_exec_payload_file, file_type, data_file_type, core_data_file_type, verified_data_exec_type;
# Bind mounts are authorized against their underlying target inode.  Keep each
# target on a dedicated non-executable label so init never needs mounton over
# the generic, replaceable Root-Linux tree.
