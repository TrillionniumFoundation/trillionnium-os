/* SPDX-License-Identifier: Apache-2.0 */
soong_config_module_type_import {
    from: "vendor/trillionnium/prebuilt/common/Android.bp",
    module_types: ["trillionnium_p01_android_app"],
}

genrule {
    name: "TrillionniumAiAuthorityGatewayPeerPolicyP01Userdebug",
    srcs: ["src/org/trillionnium/aiauthority/GatewayPeerPolicy.java"],
    tools: ["toybox"],
    out: ["GatewayPeerPolicy.java"],
    cmd: "$(location toybox) sed" +
        " -e 's|c6065d4be5dc4815f37cb9064dc846ca7d58b65f0fceaca1641459b7b120937f|f3e4cf70cccf6c9ef975f2f3b0010fbef6b8bc00fa2529a24981a916ac8d0488|'" +
        " -e 's|ENTRYPOINT_OWNER_GID = 0;|ENTRYPOINT_OWNER_GID = 2000;|'" +
        " $(in) > $(out)" +
        " && $(location toybox) grep -F -q 'f3e4cf70cccf6c9ef975f2f3b0010fbef6b8bc00fa2529a24981a916ac8d0488' $(out)" +
        " && $(location toybox) grep -F -q 'ENTRYPOINT_OWNER_GID = 2000;' $(out)",
}

trillionnium_p01_android_app {
    name: "TrillionniumAiAuthority",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "testkey",
    system_ext_specific: true,
    privileged: false,
    platform_apis: true,
    min_sdk_version: "36",
    static_libs: ["trillionnium-agent-identity-product"],
    soong_config_variables: {
        trillionnium_p01_build_variant: {
            userdebug: {
                exclude_srcs: [
                    "src/org/trillionnium/aiauthority/GatewayPeerPolicy.java",
                ],
                srcs: [":TrillionniumAiAuthorityGatewayPeerPolicyP01Userdebug"],
            },
        },
    },
}

android_app {
    name: "TrillionniumCapabilityLeaseIssuer",
    manifest: "leaseissuer/AndroidManifest.xml",
    srcs: ["leaseissuer/src/**/*.java"],
    resource_dirs: ["leaseissuer/res"],
    certificate: "testkey",
    system_ext_specific: true,
    privileged: false,
    platform_apis: true,
    min_sdk_version: "36",
    static_libs: [
        "trillionnium-agent-identity-product",
        "trillionnium-capability-lease-binder-api",
    ],
}

// Test-only exporter for a real device KeyMint attestation chain. It has no
// INTERNET permission, deletes only its dedicated ephemeral alias, and never
// participates in the production capability-lease flow.
android_test {
    name: "TrillionniumCapabilityLeaseKeyMintEvidenceProbe",
    manifest: "leaseissuer/device-tests/AndroidManifest.xml",
    srcs: ["leaseissuer/device-tests/**/*.java"],
    resource_dirs: [],
    instrumentation_for: "TrillionniumCapabilityLeaseIssuer",
    certificate: "testkey",
    sdk_version: "current",
    min_sdk_version: "36",
    static_libs: [
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "junit",
    ],
    test_suites: ["general-tests"],
}

genrule {
    name: "TrillionniumCapabilityLeaseIssuerBlueprintContract",
    srcs: ["Android.bp"],
    out: ["TrillionniumCapabilityLeaseIssuer.Android.bp"],
    cmd: "cp $(in) $(out)",
    visibility: ["//visibility:public"],
}

genrule {
    name: "TrillionniumCapabilityLeaseIssuerManifestContract",
    srcs: ["leaseissuer/AndroidManifest.xml"],
    out: ["TrillionniumCapabilityLeaseIssuer.AndroidManifest.xml"],
    cmd: "cp $(in) $(out)",
    visibility: ["//visibility:public"],
}

genrule {
    name: "TrillionniumCapabilityLeaseIssuerSigningResourcesContract",
    srcs: ["leaseissuer/res/values/strings.xml"],
    out: ["TrillionniumCapabilityLeaseIssuer.signing-resources.xml"],
    cmd: "cp $(in) $(out)",
    visibility: ["//visibility:public"],
}

filegroup {
    name: "TrillionniumCapabilityLeaseIssuerPolicyContractSources",
    srcs: [
        ":TrillionniumCapabilityLeaseIssuerBlueprintContract",
        ":TrillionniumCapabilityLeaseIssuerManifestContract",
        ":TrillionniumCapabilityLeaseIssuerSigningResourcesContract",
        "leaseissuer/src/org/trillionnium/capabilitylease/AndroidDurableFileOps.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CanonicalJson.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeaseActivity.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeaseContract.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeaseBrokerClient.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeaseBrokerWire.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeaseBrokerClients.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeasePresentation.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/CapabilityLeaseIssuanceLedger.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/EcdsaP256.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/LeaseIssuerTrust.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/LeasePendingHandle.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/ReceiptSignatureVerifier.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/ReceiptSigner.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/StrictJson.java",
        "leaseissuer/src/org/trillionnium/capabilitylease/SystemUserBoundary.java",
        "leaseissuer/tests/CapabilityLeaseChallengeV1Golden.java",
        ":TrillionniumAiShellCapabilityLeasePolicyContractSources",
    ],
    visibility: ["//visibility:public"],
}

filegroup {
    name: "TrillionniumAiAuthorityPeerIdentityContractSources",
    srcs: [
        "src/org/trillionnium/aiauthority/AgentGatewayServer.java",
        "src/org/trillionnium/aiauthority/GatewayPeerIdentity.java",
        "src/org/trillionnium/aiauthority/GatewayPeerPolicy.java",
    ],
}

