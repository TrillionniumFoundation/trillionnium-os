# Android-native owner-open lifecycle rules. These rules provide only process,
# file, local transport, mount and emergency-stop mechanics. They do not inspect
# commands, assign risk, require leases, inject ADB routing or authorize retries.

# Platform init owns all mount operations. Bootstrap can only verify and
# execute the immutable lower inside the namespace established by init.
allow init trillionnium_owner_open_state_file:dir mounton;
allow init trillionnium_owner_open_payload_file:dir mounton;
# init opens the immutable EROFS backing image before attaching the loop device.
allow init trillionnium_owner_open_payload_file:dir search;
allow init trillionnium_owner_open_payload_file:file { getattr open read };
# EROFS uses platform fs_use_xattr and labeledfs; per-inode labels stay intact.

allow trillionnium_owner_open_bootstrap self:capability {
    kill
    sys_chroot
};
allow trillionnium_owner_open_bootstrap self:process {
    fork
    getpgid
    getsched
    setpgid
    setsched
    signal
    sigkill
    sigstop
};
allow trillionnium_owner_open_bootstrap self:unix_stream_socket create_stream_socket_perms;
allow trillionnium_owner_open_bootstrap self:tcp_socket create_stream_socket_perms;
allow trillionnium_owner_open_bootstrap trillionnium_owner_open_payload_file:file r_file_perms;
allow trillionnium_owner_open_bootstrap trillionnium_owner_open_payload_exec:file {
    execute
    execute_no_trans
    getattr
    map
    open
    read
};
allow trillionnium_owner_open_bootstrap trillionnium_owner_open_payload_file:dir {
    getattr
    open
    read
    search
};
allow trillionnium_owner_open_bootstrap trillionnium_owner_open_state_file:dir create_dir_perms;
allow trillionnium_owner_open_bootstrap trillionnium_owner_open_state_file:file create_file_perms;
allow trillionnium_owner_open_bootstrap trillionnium_owner_open_state_file:sock_file create_file_perms;
allow trillionnium_owner_open_bootstrap proc:filesystem getattr;
allow trillionnium_owner_open_bootstrap sysfs:filesystem getattr;
set_prop(trillionnium_owner_open_bootstrap, trillionnium_owner_open_prop)
get_prop(trillionnium_owner_open_bootstrap, trillionnium_owner_open_prop)

# The ingress terminates Android peer identity and the private broker token. It
# never exposes the token to the application and forwards only bounded bytes.
allow trillionnium_owner_open_ingress self:unix_stream_socket create_stream_socket_perms;
allow trillionnium_owner_open_ingress trillionnium_owner_open_state_file:dir search;
allow trillionnium_owner_open_ingress trillionnium_owner_open_state_file:file r_file_perms;
allow trillionnium_owner_open_ingress trillionnium_owner_open_state_file:sock_file write;
allow trillionnium_owner_open_ingress trillionnium_owner_open_bootstrap:unix_stream_socket connectto;
get_prop(trillionnium_owner_open_ingress, trillionnium_owner_open_prop)

# The unprivileged owner client can connect only to the dedicated Android
# ingress domain; it cannot read Root Linux broker state or credentials.
allow trillionnium_owner_open_client self:unix_stream_socket create_stream_socket_perms;
allow trillionnium_owner_open_client trillionnium_owner_open_ingress:unix_stream_socket connectto;

# Emergency stop durably creates the persistent inhibit and clears readiness.
# Android init subsequently stops the tracked bootstrap service cgroup. No
# numeric persisted PID, cross-domain signal, or KILL capability is needed.
allow trillionnium_owner_open_emergency_stop trillionnium_owner_open_state_file:dir {
    add_name
    getattr
    open
    read
    search
    write
};
allow trillionnium_owner_open_emergency_stop trillionnium_owner_open_state_file:file {
    create
    getattr
    open
    read
    write
};
set_prop(trillionnium_owner_open_emergency_stop, trillionnium_owner_open_prop)
get_prop(trillionnium_owner_open_emergency_stop, trillionnium_owner_open_prop)

# The native profile observes visible same-domain original groups in /proc.
# Cross-domain or escaped descendants are not declared absent by this rule.
allow trillionnium_owner_open_bootstrap self:dir r_dir_perms;
allow trillionnium_owner_open_bootstrap self:file r_file_perms;

# Engineering-only observation of immutable profile and lifecycle properties.
# get_prop grants only getattr/open/read/map, never property_service set.
userdebug_or_eng(`
  get_prop(shell, trillionnium_owner_open_prop)
')
