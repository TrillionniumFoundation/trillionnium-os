diff --git a/common/private/trillionnium_agent_accessibility.te b/common/private/trillionnium_agent_accessibility.te
index 640ff34..42415eb 100644
--- a/common/private/trillionnium_agent_accessibility.te
+++ b/common/private/trillionnium_agent_accessibility.te
@@ -12,6 +12,23 @@ app_domain(trillionnium_agent_accessibility)
 # names.
 typeattribute trillionnium_agent_accessibility mlstrustedsubject;
 
+# This domain intentionally remains MLS-trusted for its fixed backend socket,
+# so the generic app_data_file rules are excluded by AOSP.  The package data
+# directory is assigned the dedicated type in seapp_contexts; grant only the
+# file lifecycle needed by AccessibilityReplayFile (mkdir/open/fstat,
+# fsync, pwrite/ftruncate, atomic rename and stale-temp unlink).
+allow trillionnium_agent_accessibility trillionnium_agent_accessibility_data_file:dir create_dir_perms;
+allow trillionnium_agent_accessibility trillionnium_agent_accessibility_data_file:file create_file_perms;
+
+# Android's AccessibilityService framework performs one activity-manager
+# service-manager lookup while completing the bind handshake.  Keep this edge
+# narrowly scoped to discovery: the service receives no activity Binder call,
+# settings write, input, or generic service-manager access from this rule.
+# Without it a user-authorized bind remains permanently in Binding services and
+# the framework emits an enforcing denial before onServiceConnected can expose
+# the already fail-closed, replay-gated backend.
+allow trillionnium_agent_accessibility activity_service:service_manager find;
+
 allow trillionnium_agent_accessibility_tool trillionnium_agent_accessibility:unix_stream_socket {
     connectto getattr getopt read write setopt shutdown
 };
