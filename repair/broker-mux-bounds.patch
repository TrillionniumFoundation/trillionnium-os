+class StrictMuxBoundsTest(unittest.TestCase):
+    def test_constructor_rejects_non_integer_and_unbounded_capacities(self) -> None:
+        cases = {
+            "max_pending": [True, False, 1.0, float("nan"), float("inf"), 0, -1, 65_537],
+            "max_inflight": [True, False, 1.0, float("nan"), float("inf"), 0, -1, 4_097],
+            "max_retired": [True, False, 1.0, float("nan"), float("inf"), 0, -1, 1_000_001],
+        }
+        defaults = {"max_pending": 16, "max_inflight": 4, "max_retired": 32}
+        for name, values in cases.items():
+            for value in values:
+                with self.subTest(name=name, value=value):
+                    arguments = dict(defaults)
+                    arguments[name] = value
+                    with self.assertRaises(ValueError):
+                        mux.WeightedFairMux(**arguments)
+        with self.assertRaisesRegex(ValueError, "must not exceed"):
+            mux.WeightedFairMux(max_pending=4, max_inflight=5, max_retired=8)
+
+    def test_acquire_rejects_invalid_or_unbounded_timeouts_without_waiting(self) -> None:
+        scheduler = mux.WeightedFairMux(
+            max_pending=2,
+            max_inflight=1,
+            max_retired=2,
+        )
+        invalid = [True, False, "1", object(), -1, float("nan"), float("inf"), float("-inf"), 10**1000]
+        for timeout in invalid:
+            with self.subTest(timeout=repr(timeout)):
+                started = time.monotonic()
+                with self.assertRaises(ValueError):
+                    scheduler.acquire(timeout=timeout)
+                self.assertLess(time.monotonic() - started, 0.2)
+
+    def test_cli_and_runtime_share_capacity_ceilings(self) -> None:
+        for option, maximum in (
+            ("--max-pending", mux.MAX_PENDING_REQUESTS),
+            ("--max-inflight", mux.MAX_INFLIGHT_REQUESTS),
+            ("--max-retired", mux.MAX_RETIRED_REQUESTS),
+        ):
+            with self.subTest(option=option):
+                argv = [
+                    "--listen",
+                    "127.0.0.1:1",
+                    "--client-token-file",
+                    "/tmp/client-token",
+                    "--upstream-cmd-json-file",
+                    "/tmp/upstream.json",
+                    "--upstream-executable-sha256",
+                    "0" * 64,
+                    "--upstream-executable-gid",
+                    "1",
+                    "--audit-log",
+                    "/tmp/audit.log",
+                    "--max-clients",
+                    "1",
+                    option,
+                    str(maximum + 1),
+                ]
+                stream = StringIO()
+                with redirect_stderr(stream), self.assertRaises(SystemExit) as exit_error:
+                    BROKER_MODULE.parse_args(argv)
+                self.assertEqual(exit_error.exception.code, 2)
+                self.assertIn(option.removeprefix("--"), stream.getvalue())
+
+
 if __name__ == "__main__":
     unittest.main()
