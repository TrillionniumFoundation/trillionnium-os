      "evidence_kinds": ["clean_android_target_files"],
      "required_roles": ["producer", "android_builder", "independent_reviewer"],
      "closure_rule": "A clean pinned Android build binds Soong, init, SELinux, packages, target-files, images and installed identities with no legacy semantic nodes."
    },
    {
      "gap_id": "GAP-PHYSICAL-ADB-001",
      "exit_level": "L4",
      "route_kind": "independent_physical_target",
      "evidence_kinds": ["physical_android_adb"],
      "required_roles": ["producer", "device_custodian", "independent_reviewer"],
      "closure_rule": "An owner-authorized physical device retains ordinary ADB enumeration, explicit targeting, raw failures, visible mutation and continued same-turn observation."
    },
    {
      "gap_id": "GAP-FAULT-MATRIX-001",
      "exit_level": "L5",
      "route_kind": "independent_destructive_target",
      "evidence_kinds": ["destructive_fault_matrix"],
      "required_roles": ["producer", "fault_operator", "independent_reviewer", "destructive_authorizer"],
      "closure_rule": "Independently controlled crash, storage, USB, reboot and power-loss cuts bind pre-state and post-restart reconciliation with zero redispatch."
    },
    {
      "gap_id": "GAP-RELEASE-001",
      "exit_level": "L6",
      "route_kind": "independent_release",
      "evidence_kinds": ["signed_public_release"],
      "required_roles": ["producer", "signing_custodian", "independent_reviewer", "release_authorizer"],
      "closure_rule": "Production signing lineage, transparency, AVB, rollback, OTA and a distinct human release decision bind exact artifacts after every lower gap is closed."
    }
  ]
}
