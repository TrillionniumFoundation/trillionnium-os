{
  "schema": "org.trillionnium.owner-open.rootlinux-supervisor.v1",
  "state_root": "/var/lib/trillionnium/owner-open",
  "emergency_stop": "/var/lib/trillionnium/owner-open/emergency-stop",
  "status_path": "/var/lib/trillionnium/owner-open/supervisor-status.json",
  "event_log_path": "/var/lib/trillionnium/owner-open/supervisor-events.jsonl",
  "poll_seconds": 0.05,
  "shutdown_grace_seconds": 3.0,
  "kill_grace_seconds": 2.0,
  "environment": {
    "PATH": "/usr/bin:/bin:/usr/libexec/trillionnium",
    "PYTHONPATH": "/usr/libexec/trillionnium/owner-open",
    "HOME": "/var/lib/trillionnium/owner-open/home",
    "CODEX_HOME": "/var/lib/trillionnium/owner-open/codex-home",
    "ADB_SERVER_SOCKET": "tcp:127.0.0.1:15038",
    "NO_COLOR": "1",
    "TERM": "dumb",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "children": [
    {
      "name": "owner-open-broker",
      "argv": [
        "/usr/bin/python3",
        "/usr/libexec/trillionnium/owner-open/owner_open_connection_broker.py",
        "--socket",
        "/var/lib/trillionnium/owner-open/broker/owner-open.sock",
        "--descriptor",
        "/var/lib/trillionnium/owner-open/broker/owner-open.descriptor.json",
        "--token-file",
        "/var/lib/trillionnium/owner-open/broker/owner-open.token",
        "--broker-id",
        "owner-open-device",
        "--upstream",
        "/usr/libexec/trillionnium/trillionnium-owner-open-r5-host",
        "--upstream-arg=--transport-core",
        "--upstream-arg=/usr/libexec/trillionnium/trillionnium-owner-open-r5-core",
        "--upstream-arg=--provider",
        "--upstream-arg=/usr/libexec/trillionnium/provider-adapter",
        "--upstream-arg=--shell",
        "--upstream-arg=/bin/sh",
        "--upstream-arg=--adb",
        "--upstream-arg=/usr/bin/adb",
        "--upstream-arg=--event-store",
        "--upstream-arg=/var/lib/trillionnium/owner-open/turn-events.jsonl",
        "--upstream-arg=--job-store",
        "--upstream-arg=/var/lib/trillionnium/owner-open/job-events.jsonl",
        "--upstream-arg=--require-job-journal",
        "--max-clients",
        "32",
        "--client-queue-frames",
        "2048",
        "--client-queue-bytes",
        "33554432",
        "--max-pending-requests",
        "512"
      ],
      "environment": {},
      "critical": true,
      "restart_limit": 3,
      "restart_window_seconds": 300.0,
      "restart_backoff_seconds": 1.0
    },
    {
      "name": "owner-open-adb-relay",
      "argv": [
        "/usr/bin/python3",
        "/usr/libexec/trillionnium/owner-open/adb_smart_socket_relay_release.py",
        "--listen-port",
        "15038",
        "--upstream-host",
        "127.0.0.1",
        "--upstream-port",
        "15037",
        "--max-clients",
        "32",
        "--buffer-bytes",
        "1048576",
        "--event-bytes",
        "16777216",
        "--idle-timeout",
        "300",
        "--shutdown-grace",
        "2",
        "--descriptor",
        "/var/lib/trillionnium/owner-open/adb-relay.descriptor.json",
        "--events",
        "/var/lib/trillionnium/owner-open/adb-relay.events.jsonl"
      ],
      "environment": {},
      "critical": true,
      "restart_limit": 3,
      "restart_window_seconds": 300.0,
      "restart_backoff_seconds": 1.0
    }
  ],
  "automatic_effect_redispatch": false
}
