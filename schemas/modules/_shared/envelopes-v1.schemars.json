        "type": "string"
      },
      "operation_id": {
        "type": "string"
      },
      "original_cause": {
        "type": "string"
      },
      "request_digest": {
        "type": "string"
      },
      "retry_disposition": {
        "$ref": "#/definitions/ModuleRetryDispositionV1"
      },
      "schema": {
        "type": "string"
      }
    },
    "required": [
      "class",
      "code",
      "effect_uncertain",
      "module_id",
      "operation_id",
      "original_cause",
      "request_digest",
      "retry_disposition",
      "schema"
