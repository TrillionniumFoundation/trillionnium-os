      "ModuleLifecycleStateV1": {
        "enum": [
          "RECEIVED",
          "VALIDATED",
          "CAPACITY_RESERVED",
          "ACCEPTED_DURABLE",
          "EFFECT_ATTEMPTING",
          "EFFECT_STARTED_OBSERVED",
          "TERMINAL_OBSERVED",
          "TERMINAL_DURABLE",
          "DELIVERY_PENDING",
