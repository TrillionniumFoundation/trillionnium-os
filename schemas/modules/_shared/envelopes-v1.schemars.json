        "type": "string"
      },
      "host_epoch": {
        "format": "uint64",
        "minimum": 0.0,
        "type": "integer"
      },
      "module_id": {
        "type": "string"
      },
      "operation_id": {
        "type": "string"
      },
      "ordering_key": {
        "type": "string"
      },
      "payload": true,
      "request_digest": {
        "type": "string"
      },
      "schema": {
