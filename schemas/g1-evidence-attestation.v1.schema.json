{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/g1-evidence-attestation.v1.schema.json",
  "title": "Trillionnium G1 Evidence Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "package_ids",
    "source_commit",
    "authority",
    "verification_method",
    "trust_root",
    "signature_algorithm",
    "independent_verification",
    "verified_at",
    "expires_at",
    "evidence_ids"
  ],
  "properties": {
    "schema": {"const": "org.trillionnium.g1.evidence-attestation.v1"},
    "version": {"const": "1"},
    "package_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority": {"type": "string", "minLength": 1},
    "verification_method": {"type": "string", "minLength": 1},
    "trust_root": {"const": "g1-attestation-root-20260902"},
    "signature_algorithm": {"const": "rsa-sha256"},
    "independent_verification": {"const": true},
    "verified_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
