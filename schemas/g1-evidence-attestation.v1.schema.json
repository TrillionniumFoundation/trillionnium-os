{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.org/schemas/g1-evidence-attestation.v2.schema.json",
  "title": "Trillionnium G1 Evidence Attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "package_ids",
    "source_commit",
    "subject",
    "authority",
    "verification_method",
    "trust_root",
    "signature_algorithm",
    "independent_verification",
    "verified_at",
    "expires_at",
    "evidence_ids"
  ],
  "properties": {
    "schema": {"const": "org.trillionnium.g1.evidence-attestation.v2"},
    "version": {"const": "2"},
    "package_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject": {"$ref": "#/$defs/subject"},
    "authority": {"type": "string", "minLength": 1},
    "verification_method": {"type": "string", "minLength": 1},
    "trust_root": {"const": "g1-attestation-root-20260902"},
    "signature_algorithm": {"const": "rsa-sha256"},
    "independent_verification": {"const": true},
    "verified_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/git_sha"},
        "tree": {"$ref": "#/$defs/git_sha"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "merge"],
      "properties": {
        "base": {"$ref": "#/$defs/subject_ref"},
        "head": {"$ref": "#/$defs/subject_ref"},
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "commit", "tree", "parents"],
          "properties": {
            "kind": {"enum": ["deterministic_synthetic", "github_prospective"]},
            "commit": {"$ref": "#/$defs/git_sha"},
            "tree": {"$ref": "#/$defs/git_sha"},
            "parents": {
              "type": "array",
              "prefixItems": [
                {"$ref": "#/$defs/git_sha"},
                {"$ref": "#/$defs/git_sha"}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
