{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org.trillionnium.actual-monotonic-completion-stream-context.v2",
  "title": "Owner monotonic completion stream context v2",
  "description": "Closed source-recorder evidence. This schema validates one JSON object only; tools/perf/inspect_monotonic_stream.py must additionally check physical custody, cross-file identity, ACK chain, ranges, counters, exact start-ID closure and file/byte ceilings. It grants no installed, whole-family or L2 qualification.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "org.trillionnium.actual-monotonic-completion-stream-context.v2"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$(?![\\s\\S])"
    },
    "producer_role": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$(?![\\s\\S])",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "start_time_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "boot_id_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "pid",
        "start_time_ticks",
        "boot_id_sha256"
      ],
      "additionalProperties": false
    },
    "trace_complete": {
      "const": false
    },
    "installed_qualified": {
      "const": false
    },
    "bank_count": {
      "const": 2
    },
    "slots_per_bank": {
      "const": 512
    },
    "lifetime_epochs": {
      "const": 256
    },
    "lifetime_files": {
      "const": 514
    },
    "lifetime_disk_bytes": {
      "const": 16777216
    },
    "lifetime_started": {
      "const": 65536
    },
    "resident_credits": {
      "const": 1024
    },
    "completion_order": {
      "const": "closed_publication_admission"
    },
    "lost_count_semantics": {
      "enum": [
        "saturating_lower_bound",
        "unavailable"
      ]
    }
  },
  "required": [
    "schema",
    "sample_id",
    "producer_role",
    "generation",
    "trace_complete",
    "installed_qualified",
    "bank_count",
    "slots_per_bank",
    "lifetime_epochs",
    "lifetime_files",
    "lifetime_disk_bytes",
    "lifetime_started",
    "resident_credits",
    "completion_order",
    "lost_count_semantics"
  ],
  "additionalProperties": false
}
