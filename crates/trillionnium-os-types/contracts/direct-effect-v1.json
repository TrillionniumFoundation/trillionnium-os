      "kind",
      "exit_code",
      "signal",
      "backend_error_code",
      "stdout_bytes",
      "stderr_bytes",
      "stdout_sha256",
      "stderr_sha256",
      "started_boottime_ms",
      "finished_boottime_ms",
      "response_sha256"
    ],
    "kinds": [
      "exited",
      "signaled",
      "launch_rejected",
      "cancelled_before_dispatch",
      "deadline_before_dispatch",
      "policy_rejected_before_dispatch"
    ],
    "binary_safe_output_required": true,
    "lossy_utf8_output_forbidden": true,
    "exact_response_bytes_retained_outside_pure_state": true
  },
  "indeterminate_reasons": [
    "deadline_after_dispatch",
    "cancelled_after_dispatch",
    "output_limit_after_dispatch",
    "broker_restart_after_dispatch",
    "backend_lost_after_dispatch"
