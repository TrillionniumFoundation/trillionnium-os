      "effective_profile",
      "risk_class",
      "confirmation_lease_receipt_sha256",
      "policy_sha256",
      "backend_identity_sha256"
    ]
  },
  "durable_state_machine": {
    "schema": "org.trillionnium.direct-effect.state.v1",
    "initial_state": "not_dispatched",
    "dispatch_occurred_is_explicit": true,
    "transitions": {
      "not_dispatched": [
        "dispatched",
        "terminal"
      ],
      "dispatched": [
        "terminal",
        "indeterminate"
      ],
      "terminal": [],
      "indeterminate": []
    },
    "generations": {
      "not_dispatched": 1,
      "dispatched": 2,
      "terminal_before_dispatch": 2,
      "terminal_after_dispatch": 3,
      "indeterminate": 3
    },
    "recovery": {
      "not_dispatched": "await_same_authenticated_effect_retry_never_automatic_dispatch",
      "dispatched": "persist_indeterminate_without_retry",
      "terminal": "replay_exact_terminal_response",
      "indeterminate": "hold_without_retry"
    },
    "dispatch_marker_rule": "dispatched_must_be_durable_before_worker_ipc_fork_clone_or_backend_contact",
    "restart_rule": "broker_restart_never_auto_dispatches_not_dispatched_or_any_other_state",
    "boot_epoch_rule": {
      "ledger_records_request_boot_id_sha256": true,
      "not_dispatched_from_prior_boot_must_not_dispatch": true,
      "dispatched_from_prior_boot_becomes_restart_indeterminate": true,
      "new_clock_boottime_may_be_lower_than_old_dispatch_start": true
    },
    "post_dispatch_persistence_failure_public_outcome": "indeterminate",
    "terminal_before_dispatch": [
      "cancelled_before_dispatch",
      "deadline_before_dispatch",
      "policy_rejected_before_dispatch"
    ],
    "blind_retry_after_dispatch": false,
    "terminal_response_rederived_on_replay": false
  },
  "binary_output": {
    "closed_fields": [
      "encoding",
      "bytes",
      "sha256",
      "data",
      "complete"
    ],
    "encoding": "base64_standard_rfc4648",
    "byte_count_and_sha256_bind_decoded_bytes": true,
    "complete_required_for_terminal": true,
    "nul_and_non_utf8_preserved": true,
    "lossy_utf8_forbidden": true
  },
  "terminal_response": {
    "schema": "org.trillionnium.direct-effect.terminal-response.v1",
    "canonical_encoding": "compact_json_serde_json_to_vec",
    "closed_fields": [
      "schema",
      "effect_id",
      "request_sha256",
      "dispatch_occurred",
      "kind",
      "exit_code",
      "signal",
      "backend_error_code",
      "stdout",
      "stderr",
      "started_boottime_ms",
      "finished_boottime_ms"
    ],
    "exact_serialized_bytes_sha256_is_terminal_observation_response_sha256": true,
    "replay_requires_exact_serialized_bytes": true
  },
  "terminal_observation": {
    "schema": "org.trillionnium.direct-effect.terminal-observation.v1",
    "closed_fields": [
