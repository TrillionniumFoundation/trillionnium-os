{
  "contract_schema": "org.trillionnium.capabilitylease.root-publisher-launch.contract.v1",
  "source_status": "source_only_no_product_package_no_live_listener_no_effect_authority_v1",
  "fixed": {
    "launcher_domain": "u:r:trillionnium_agentd:s0",
    "publisher_role": "system_api_replay_sync",
    "publisher_executable_identity": "system_ext/bin/trillionnium-system-api-replay-sync",
