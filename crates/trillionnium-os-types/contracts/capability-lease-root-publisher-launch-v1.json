    "publisher_executable_sha256": "must_equal_parent_measured_digest_and_publication",
    "server_identity": "must_equal_fixed_uid_gid_selinux_domain",
    "response": "must_validate_publication_ack_and_match_request_commitments",
    "failure": "close_connection_return_no_ack_and_never_register"
  }
