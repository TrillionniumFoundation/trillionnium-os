    "other_file_descriptors": "closed_except_execveat_loader_requirements",
    "arguments": "none",
    "environment": "empty",
    "pdeathsig": "SIGKILL",
    "no_new_privs": true,
    "dumpable": false,
    "capabilities": "empty",
    "descendants": "forbidden",
    "single_exchange": true
  },
  "socket_custody": {
    "namespace": "linux_abstract",
    "client_connects_after_selinux_transition": true,
    "server_authentication": "SO_PEERCRED_twice_plus_SO_PEERSEC_plus_root_authenticator",
    "client_authentication": "SO_PEERCRED_plus_SO_PEERSEC_exact_system_server",
    "connect_behavior": "single_kernel_local_connect_no_retry",
    "read_timeout_ms": 15000,
    "write_timeout_ms": 5000,
    "exact_request_frames": 1,
    "exact_response_frames": 1,
