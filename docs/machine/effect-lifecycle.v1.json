{
  "schema": "org.trillionnium.effect-lifecycle.v1",
  "version": "1",
  "program_revision": "2026-08-31-g1",
  "status": "SOURCE_MODEL_PENDING_TARGET_EVIDENCE",
  "claim_ceiling": "L1_MACHINE_MODEL_ONLY_NO_INSTALLED_TARGET_DEVICE_FAULT_OR_RELEASE_CLAIM",
  "automatic_redispatch": false,
  "binding_schema": {
    "required_identity_fields": [
      "operation_digest",
      "request_digest",
      "session_id",
      "turn_id",
      "call_id",
      "job_id",
      "ordering_key",
      "host_epoch",
      "provider_epoch",
      "writer_epoch",
      "fencing_token",
      "durable_sequence",
      "monotonic_timestamp_ns"
    ],
    "nullable_when_not_applicable": [
      "call_id",
      "job_id",
      "provider_epoch"
    ],
    "digest_algorithm": "sha256",
    "monotonic_clock_required": true,
    "identity_conflict": "reject_before_effect",
    "stale_epoch": "fence_before_effect"
  },
  "states": [
    {
      "id": "RECEIVED",
      "phase": "ingress",
      "effect_may_have_started": false,
      "durable": false,
      "outcome": "none",
      "permits_new_effect": false,
      "meaning": "A bounded request envelope was received; no semantic or effect claim exists."
    },
    {
      "id": "VALIDATED",
      "phase": "admission",
      "effect_may_have_started": false,
      "durable": false,
      "outcome": "none",
      "permits_new_effect": false,
      "meaning": "Mechanical shape, identity domains and fixed limits passed validation."
    },
    {
      "id": "CAPACITY_RESERVED",
      "phase": "admission",
      "effect_may_have_started": false,
      "durable": false,
      "outcome": "none",
      "permits_new_effect": false,
      "meaning": "Finite capacity is exclusively reserved for this ordering key."
    },
    {
      "id": "ACCEPTED_DURABLE",
      "phase": "admission",
      "effect_may_have_started": false,
      "durable": true,
      "outcome": "none",
      "permits_new_effect": true,
      "meaning": "Exact request identity and acceptance are durably committed before effect."
    },
    {
      "id": "EFFECT_ATTEMPTING",
      "phase": "effect",
      "effect_may_have_started": true,
      "durable": false,
      "outcome": "none",
      "permits_new_effect": false,
      "meaning": "The effect boundary was crossed; absence of later data cannot prove no start."
    },
    {
      "id": "EFFECT_STARTED_OBSERVED",
      "phase": "effect",
      "effect_may_have_started": true,
      "durable": false,
      "outcome": "none",
      "permits_new_effect": false,
      "meaning": "Spawn, write, forward or remote start was positively observed."
    },
    {
      "id": "TERMINAL_OBSERVED",
      "phase": "terminal",
      "effect_may_have_started": true,
      "durable": false,
      "outcome": "definitive",
      "permits_new_effect": false,
      "meaning": "A definitive effect outcome was observed but is not yet durable."
    },
    {
      "id": "TERMINAL_DURABLE",
      "phase": "terminal",
      "effect_may_have_started": true,
      "durable": true,
      "outcome": "definitive",
      "permits_new_effect": false,
      "meaning": "The exact terminal bytes and identity are durably committed."
    },
    {
      "id": "DELIVERY_PENDING",
      "phase": "delivery",
      "effect_may_have_started": true,
      "durable": true,
      "outcome": "definitive",
      "permits_new_effect": false,
      "meaning": "Only caller delivery remains; effect execution must never be repeated."
    },
    {
      "id": "DELIVERED",
      "phase": "delivery",
      "effect_may_have_started": true,
      "durable": true,
      "outcome": "definitive",
      "permits_new_effect": false,
      "meaning": "Exact terminal bytes were written to the selected caller channel."
    },
    {
      "id": "ACKNOWLEDGED",
      "phase": "delivery",
      "effect_may_have_started": true,
      "durable": true,
      "outcome": "definitive",
      "permits_new_effect": false,
      "meaning": "The caller acknowledged the exact terminal identity and bytes."
    },
    {
      "id": "REJECTED_BEFORE_EFFECT",
      "phase": "terminal",
      "effect_may_have_started": false,
      "durable": false,
      "outcome": "definitive",
      "permits_new_effect": false,
      "meaning": "Validation, conflict, capacity or definitive acceptance failure rejected before effect."
    },
    {
      "id": "UNKNOWN_RECONCILIATION_REQUIRED",
      "phase": "uncertainty",
      "effect_may_have_started": true,
      "durable": false,
      "outcome": "uncertain",
      "permits_new_effect": false,
      "meaning": "An effect may have occurred; external reality must be reconciled before new semantic action."
    },
    {
      "id": "FENCED",
      "phase": "uncertainty",
      "effect_may_have_started": true,
      "durable": false,
      "outcome": "uncertain",
      "permits_new_effect": false,
      "meaning": "The ordering key or writer epoch is blocked from new authoritative work."
    },
    {
      "id": "CLOSED",
      "phase": "closed",
      "effect_may_have_started": true,
      "durable": true,
      "outcome": "closed",
      "permits_new_effect": false,
      "meaning": "The lifecycle is closed after acknowledgement, pre-effect rejection or an explicit fenced close."
    }
  ],
