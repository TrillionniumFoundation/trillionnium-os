argv ::= "[" space  space "]"
argv-kv ::= "\"argv\"" space ":" space argv
call-id ::= "\"\""
call-id-kv ::= "\"call_id\"" space ":" space call-id
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
command ::= "\"\""
command-kv ::= "\"command\"" space ":" space command
kind ::= "\"turn.complete\""
kind-kv ::= "\"kind\"" space ":" space kind
root ::= "{" space argv-kv "," space call-id-kv "," space command-kv "," space kind-kv "," space summary-kv "," space task-status-kv "," space tool-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
summary ::= "\"" char{0,1024} "\""
summary-kv ::= "\"summary\"" space ":" space summary
task-status ::= "\"completed\""
task-status-kv ::= "\"task_status\"" space ":" space task-status
tool ::= "\"none\""
tool-kv ::= "\"tool\"" space ":" space tool
