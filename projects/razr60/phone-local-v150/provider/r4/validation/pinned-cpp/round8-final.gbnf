alternative-0 ::= "{" space alternative-0-argv-kv "," space alternative-0-call-id-kv "," space alternative-0-command-kv "," space alternative-0-kind-kv "," space alternative-0-summary-kv "," space alternative-0-task-status-kv "," space alternative-0-tool-kv space "}"
alternative-0-argv ::= "[]"
alternative-0-argv-kv ::= "\"argv\"" space ":" space alternative-0-argv
alternative-0-call-id ::= "\"\""
alternative-0-call-id-kv ::= "\"call_id\"" space ":" space alternative-0-call-id
alternative-0-command ::= "\"\""
alternative-0-command-kv ::= "\"command\"" space ":" space alternative-0-command
alternative-0-kind ::= "\"turn.complete\""
alternative-0-kind-kv ::= "\"kind\"" space ":" space alternative-0-kind
alternative-0-summary ::= "\"" char{0,1024} "\""
alternative-0-summary-kv ::= "\"summary\"" space ":" space alternative-0-summary
alternative-0-task-status ::= ("\"completed\"" | "\"partial\"" | "\"failed\"" | "\"unknown\"")
alternative-0-task-status-kv ::= "\"task_status\"" space ":" space alternative-0-task-status
alternative-0-tool ::= "\"none\""
alternative-0-tool-kv ::= "\"tool\"" space ":" space alternative-0-tool
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
root ::= alternative-0
space ::= | " " | "\n"{1,2} [ \t]{0,20}
