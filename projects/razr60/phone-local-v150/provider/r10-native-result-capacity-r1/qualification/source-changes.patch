+def replace_evidence_bytes(path, temporary, raw):
+    """Keep the existing durable atomic write, coordinating its two name changes."""
+    global _EVIDENCE_GENERATION, _EVIDENCE_WRITERS
+    with _EVIDENCE_WRITE_LOCK:
