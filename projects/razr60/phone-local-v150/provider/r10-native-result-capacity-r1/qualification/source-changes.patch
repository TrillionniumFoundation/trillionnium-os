+    try:
+        with os.fdopen(fd, 'wb', closefd=False) as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(fd)
+        with _EVIDENCE_WRITE_LOCK:
+            os.replace(temporary, path)
+            _EVIDENCE_GENERATION += 1
+        sync_parent(path)
+    finally:
+        try:
+            os.close(fd)
+        finally:
+            with _EVIDENCE_WRITE_LOCK:
+                _EVIDENCE_GENERATION += 1
+                _EVIDENCE_WRITERS -= 1
