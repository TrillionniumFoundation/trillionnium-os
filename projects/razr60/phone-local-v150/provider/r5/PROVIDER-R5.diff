+PROOF_STATE = 'VERIFIED_EVIDENCE_FOR_EXPLICIT_NEW_VERSION_RESOLUTION'
+RESOLUTION_STATE = 'confirmed_not_executed_after_executor_retirement'
+EXECUTOR_BINDING = {
