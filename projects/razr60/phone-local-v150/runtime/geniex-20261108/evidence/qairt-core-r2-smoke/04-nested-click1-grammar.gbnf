root ::= "{" ws "\"name\"" ws ":" ws "\"mobile_use\"" ws "," ws "\"arguments\"" ws ":" ws "{" ws "\"action\"" ws ":" ws "\"click\"" ws "," ws "\"screenshot_id\"" ws ":" ws string "," ws "\"coordinate\"" ws ":" ws "[" ws coordinate "," ws coordinate "]" ws "," ws "\"summary\"" ws ":" ws string "}" ws "}" ws
coordinate ::= ("1000" | [1-9] [0-9] [0-9] | [1-9] [0-9] | [0-9]) ws
string ::= "\"" char+ "\"" ws
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
ws ::= [ \t\n\r]*
