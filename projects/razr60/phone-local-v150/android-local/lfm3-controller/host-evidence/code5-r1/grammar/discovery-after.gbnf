root ::= ws (find-app | open | back | home | wait | done) ws
find-app ::= "{" ws "\"action\"" ws ":" ws "\"find_app\"" ws "," ws "\"observation_id\"" ws ":" ws "\"f91c685bf5f04f5c9a6a3197eade1fed\"" ws "," ws "\"package\"" ws ":" ws "\"com.example.launcher\"" ws "," ws "\"query\"" ws ":" ws query-string ws "," ws "\"offset\"" ws ":" ws app-offset reason-part ws "}"
open ::= "{" ws "\"action\"" ws ":" ws "\"open\"" ws "," ws "\"observation_id\"" ws ":" ws "\"f91c685bf5f04f5c9a6a3197eade1fed\"" ws "," ws "\"package\"" ws ":" ws open-package reason-part ws "}"
open-package ::= "\"com.example.calculator\""
back ::= "{" ws "\"action\"" ws ":" ws "\"back\"" ws "," ws "\"observation_id\"" ws ":" ws "\"f91c685bf5f04f5c9a6a3197eade1fed\"" ws "," ws "\"package\"" ws ":" ws "\"com.example.launcher\"" reason-part ws "}"
home ::= "{" ws "\"action\"" ws ":" ws "\"home\"" ws "," ws "\"observation_id\"" ws ":" ws "\"f91c685bf5f04f5c9a6a3197eade1fed\"" ws "," ws "\"package\"" ws ":" ws "\"com.example.launcher\"" reason-part ws "}"
wait ::= "{" ws "\"action\"" ws ":" ws "\"wait\"" ws "," ws "\"observation_id\"" ws ":" ws "\"f91c685bf5f04f5c9a6a3197eade1fed\"" ws "," ws "\"package\"" ws ":" ws "\"com.example.launcher\"" ws "," ws "\"duration_ms\"" ws ":" ws duration reason-part ws "}"
done ::= "{" ws "\"action\"" ws ":" ws "\"done\"" ws "," ws "\"observation_id\"" ws ":" ws "\"f91c685bf5f04f5c9a6a3197eade1fed\"" ws "," ws "\"package\"" ws ":" ws "\"com.example.launcher\"" ws "," ws "\"status\"" ws ":" ws status ws "," ws "\"summary\"" ws ":" ws summary-string reason-part ws "}"
reason-part ::= ( ws "," ws "\"reason\"" ws ":" ws reason-string)?
direction ::= "\"backward\"" | "\"down\"" | "\"forward\"" | "\"left\"" | "\"right\"" | "\"up\""
status ::= "\"failure\"" | "\"partial\"" | "\"success\""
duration ::= [1-9] [0-9]{2} | "1" [0-9]{3} | "2000"
app-offset ::= "0" | [1-9] [0-9]{0,2} | [1-3] [0-9]{3} | "40" [0-8] [0-9] | "409" [0-5]
query-string ::= "\"" json-char{0,64} "\""
reason-string ::= "\"" json-char{0,256} "\""
text-string ::= "\"" json-char{0,1024} "\""
summary-string ::= "\"" json-char{1,1024} "\""
json-char ::= [^"\\\x00-\x1F] | "\\" ["\\/bfnrt]
ws ::= [ \t\n\r]{0,8}
