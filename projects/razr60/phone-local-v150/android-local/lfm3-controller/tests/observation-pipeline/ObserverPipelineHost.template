    static final class Handler {
        static final class Job {final long when;final Runnable task;Job(long when,Runnable task){this.when=when;this.task=task;}}
        final List<Job> jobs=new ArrayList<Job>();volatile boolean rejectWorkerPosts,throwWorkerPosts;
        synchronized boolean post(Runnable runnable){return postDelayed(runnable,0);}
        synchronized boolean postDelayed(Runnable runnable,long delay){
            if(!isMain()&&throwWorkerPosts)throw new IllegalStateException("fixture post failure");
            if(!isMain()&&rejectWorkerPosts)return false;
            jobs.add(new Job(SystemClock.now+delay,runnable));return true;
        }
        void drain(){
            expect(isMain(),"only test main drains callbacks");int count=0;
            while(true){Job next=null;
                synchronized(this){for(Job job:jobs)if(job.when<=SystemClock.now&&(next==null||job.when<next.when))next=job;if(next!=null)jobs.remove(next);}
                if(next==null)return;expect(++count<1000,"unbounded main spin");next.task.run();
            }
        }
        synchronized boolean hasReady(){for(Job job:jobs)if(job.when<=SystemClock.now)return true;return false;}
    }
    static final class Worker implements Executor {
        final ExecutorService executor=Executors.newSingleThreadExecutor(r->{Thread t=new Thread(r,"observer-fixture-io");t.setDaemon(true);return t;});
        volatile boolean reject;final AtomicInteger active=new AtomicInteger(),uncaught=new AtomicInteger();
        public void execute(Runnable r){if(reject)throw new RejectedExecutionException("fixture reject");active.incrementAndGet();
            executor.execute(()->{try{r.run();}catch(Throwable error){uncaught.incrementAndGet();}finally{active.decrementAndGet();}});}
    }
    static final Worker observationIo=new Worker();static final AtomicBoolean observationIoBusy=new AtomicBoolean();
    static Thread mainThread;static ObserverPipelineHost live;String lease="task-one";
    Object taskScope,taskAuthorization,taskNotesPhase,taskCalculatorInput,taskSubmitAttempts,taskFixedIntentAttempts,appDiscovery;Runnable stopListener;
