    ObserverPipelineHost()throws IOException{directory=Files.createTempDirectory("hepta-observer-host-").toFile();live=this;}
    private synchronized boolean owns(String id){return live==this&&id.equals(lease);}
    private synchronized boolean ownsBackground(String id,BackgroundSession background){return owns(id)&&taskBackground==background;}
    private synchronized BackgroundSession backgroundFor(String id){if(!owns(id))throw new IllegalStateException("retired fixture lease");return taskBackground;}
    private boolean locked(){return locked;}
    private Graph readGraph(GraphBudget budget,BackgroundSession background){
        expect(!isMain(),"observation graph read on main");budget.check();int n=reads.incrementAndGet();
        Graph graph=new Graph(n,background==null?0:background.displayId());graphs.add(graph);
        try{if(readHook!=null)readHook.read(graph,n);budget.check();return graph;}catch(RuntimeException error){graph.close();throw error;}
    }
    private Executor getMainExecutor(){return r->main.post(r);}
    private void takeScreenshot(int display,Executor executor,TakeScreenshotCallback callback){
        expect(isMain(),"screenshot admission state must stay main-owned");expect(display==(taskBackground==null?0:taskBackground.displayId()),"wrong display");
        pendingScreenshot=callback;if(autoScreenshot)deliverScreenshot();
    }
    private void deliverScreenshot(){ScreenshotResult result=new ScreenshotResult();shots.add(result);pendingScreenshot.onSuccess(result);}
    private String fileSha256(File file)throws Exception{
        expect(!isMain(),"hash on main");if(hashHook!=null)hashHook.run();MessageDigest digest=MessageDigest.getInstance("SHA-256");
        digest.update(Files.readAllBytes(file.toPath()));return Arrays.toString(digest.digest());
    }
    private static String message(Throwable error){return error.getMessage()==null?error.getClass().getSimpleName():error.getMessage();}
{{acquire}}
{{recovery_idle}}
{{observation}}
    static boolean isMain(){return Thread.currentThread()==mainThread;}
    static void expect(boolean okay,String message){if(!okay)throw new AssertionError(message);}
    static void await(java.util.function.BooleanSupplier condition,String reason)throws Exception{
        long end=System.nanoTime()+TimeUnit.SECONDS.toNanos(4);
        while(!condition.getAsBoolean()){if(System.nanoTime()>=end)throw new AssertionError("real wait timed out: "+reason);Thread.sleep(1);}
    }
    void begin(){observe(lease,directory,()->cancelled.get(),SystemClock.now+10000,new ObservationCallback(){
        public void onObservation(PhoneObservation value){expect(isMain(),"publish off main");delivered.add(value);}
        public void onError(String error){expect(isMain(),"error off main");errors.add(error);}});main.drain();}
    void awaitSample()throws Exception{await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"sample worker exit");main.drain();}
    void startCapture()throws Exception{begin();awaitSample();SystemClock.now+=200;main.drain();
        // drain may already accept the second sample and start the deliberately
        // blocked screenshot worker. Its admission, not global worker idleness,
        // is the boundary this helper is waiting for.
        await(()->pendingScreenshot!=null||(reads.get()>=2&&!observationIoBusy.get()&&observationIo.active.get()==0),"second sample done or capture admitted");
        main.drain();expect(pendingScreenshot!=null,"stable samples did not admit capture");}
    void finish()throws Exception{await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"capture worker exit");main.drain();}
    void retire(){if(activeObservation!=null)failObservation(activeObservation,"fixture cancelled");}
    void dispose()throws Exception{retire();await(()->observationIo.active.get()==0,"disposal worker exit");main.drain();clearSnapshot();
        for(Graph g:graphs)expect(g.closed,"graph leaked "+g.serial);
        for(ScreenshotResult shot:shots)expect(shot.buffer.closes==1,"hardware buffer leaked");
        for(Bitmap bitmap:Bitmap.made)expect(bitmap.recycled,"bitmap leaked");
        try(java.util.stream.Stream<Path> paths=Files.walk(directory.toPath())){paths.sorted(Comparator.reverseOrder()).forEach(p->{try{Files.delete(p);}catch(IOException e){throw new UncheckedIOException(e);}});}}
    static final class Block implements Runnable {
        final CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        public void run(){entered.countDown();try{expect(release.await(4,TimeUnit.SECONDS),"fixture not unblocked");}catch(InterruptedException e){Thread.currentThread().interrupt();throw new IllegalStateException(e);}}
        void entered()throws Exception{expect(entered.await(4,TimeUnit.SECONDS),"work did not enter");}void open(){release.countDown();}
    }
    interface Case {void run()throws Exception;}
    static int passed;
    static void test(String name,Case body)throws Exception{
        expect(!observationIoBusy.get()&&observationIo.active.get()==0,"previous worker not drained");
        SystemClock.now=1000;Bitmap.made.clear();Bitmap.copyHook=null;Bitmap.encodeHook=null;observationIo.reject=false;WebFlightSession.unreleased=false;
        body.run();passed++;System.out.println("PASS "+name);
    }
    public static void main(String[] args)throws Exception{
        mainThread=Thread.currentThread();
        test("unreleased_web_journal_blocks_admission_without_retiring_session",()->{
            ObserverPipelineHost f=new ObserverPipelineHost();f.lease=null;WebFlightSession prior=new WebFlightSession();f.taskWeb=prior;
            WebFlightSession.unreleased=true;
            expect(!f.acquireTask("new-task",()->{}),"unreleased Web journal admitted a task");
            expect(f.taskWeb==prior&&f.lease==null,"rejected admission erased Web ownership");
            WebFlightSession.unreleased=false;
            expect(f.acquireTask("new-task",()->{})&&f.taskWeb==null,"clean Web journal failed admission");f.dispose();});
        test("web_and_observer_barriers_must_both_clear_before_admission",()->{
            ObserverPipelineHost f=new ObserverPipelineHost();Block b=new Block();f.readHook=(g,n)->b.run();f.begin();b.entered();
            f.cancelled.set(true);SystemClock.now+=100;f.main.drain();f.lease=null;WebFlightSession.unreleased=true;
            expect(!f.acquireTask("new-task",()->{}),"two active barriers admitted task");b.open();f.finish();
            expect(!f.acquireTask("new-task",()->{}),"worker exit erased independent Web barrier");
            WebFlightSession.unreleased=false;expect(f.acquireTask("new-task",()->{}),"both cleared barriers did not restore admission");f.dispose();});
        test("recovery_requires_web_display_and_observer_cleanup_together",()->{
            ObserverPipelineHost f=new ObserverPipelineHost();LocalTaskController controller=new LocalTaskController();f.ownedController=controller;
            expect(f.recoveryControllerIdle(controller),"clean recovery rejected");
            f.taskWeb=new WebFlightSession();expect(!f.recoveryControllerIdle(controller),"unreleased Web cleanup bypassed");
            f.taskWeb.closed=true;expect(f.recoveryControllerIdle(controller),"released Web cleanup remained blocked");
            f.taskBackground=new BackgroundSession(6);expect(!f.recoveryControllerIdle(controller),"unreleased display bypassed");
            f.taskBackground.closed=true;observationIoBusy.set(true);
            try{expect(!f.recoveryControllerIdle(controller),"pending observation IO bypassed recovery");}finally{observationIoBusy.set(false);}
            expect(f.recoveryControllerIdle(controller),"complete cleanup did not restore recovery");
            controller.running=true;expect(!f.recoveryControllerIdle(controller),"running controller bypassed recovery");controller.running=false;f.dispose();});
        test("normal_pipeline_preserves_two_samples_two_rechecks_and_capture_age",()->{
            ObserverPipelineHost f=new ObserverPipelineHost();f.startCapture();await(()->observationIo.active.get()==0,"save complete");
            long screenshotAt=f.lastScreenshotAt;SystemClock.now+=700;f.main.drain();
            expect(f.delivered.size()==1&&f.errors.isEmpty()&&f.reads.get()==4,"complete original graph checks");
            expect(f.current.capturedElapsedMillis==screenshotAt,"queued publication must not refresh screenshot age");
            expect(f.current.collectionStats==f.currentGraph.collectionStats,"worker publication lost exact captured collection counters");f.dispose();});
        test("main_heartbeat_and_absolute_deadline_while_graph_is_blocked",()->{
            ObserverPipelineHost f=new ObserverPipelineHost();Block b=new Block();f.readHook=(g,n)->b.run();f.begin();b.entered();
            AtomicBoolean heartbeat=new AtomicBoolean();f.main.post(()->heartbeat.set(true));f.main.drain();expect(heartbeat.get(),"main heartbeat blocked");
            SystemClock.now+=10000;f.main.drain();expect(f.errors.size()==1&&f.errors.get(0).contains("phase=sample_graph"),"timely phase diagnostic");
            expect(f.observationReadWorkPending(),"retirement is not worker exit");b.open();f.finish();expect(f.delivered.isEmpty(),"late graph published");f.dispose();});
        test("cancelled_busy_worker_blocks_new_task_until_actual_exit",()->{
            ObserverPipelineHost f=new ObserverPipelineHost();Block b=new Block();f.readHook=(g,n)->b.run();f.begin();b.entered();
            f.cancelled.set(true);SystemClock.now+=100;f.main.drain();f.lease=null;
            expect(!f.acquireTask("new-task",()->{}),"busy cancelled work admitted new task");b.open();f.finish();
            expect(f.acquireTask("new-task",()->{}),"actual worker exit did not restore admission");expect(f.delivered.isEmpty(),"retired graph published");f.dispose();});
        test("busy_worker_fences_replacement_service_until_actual_exit",()->{
            ObserverPipelineHost old=new ObserverPipelineHost();Block b=new Block();old.readHook=(g,n)->b.run();old.begin();b.entered();
            old.retire();ObserverPipelineHost replacement=new ObserverPipelineHost();replacement.lease=null;
            expect(!replacement.acquireTask("replacement-task",()->{}),"replacement service bypassed process-wide busy worker");
            b.open();old.finish();expect(old.delivered.isEmpty(),"old service published after replacement");
            expect(replacement.acquireTask("replacement-task",()->{}),"actual worker exit did not reopen replacement admission");
            old.dispose();replacement.dispose();});
