package org.trillionnium.hepta.local;

import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;

/**
 * Control-flow bridge for two verbatim HeptaAccessibilityService methods.
 * The full Phone/Session/Guard/comparator contract has its own actual-class gate.
 * All Android IO, captures, graph facts, comparison, claim and effects here are
 * explicit instrumented ports. This gate proves those ports are called in the
 * required order, not that an Android effect or historical receipt is valid.
 */
final class NativeFormHistoryActionHost {
    static final long MAX_OBSERVATION_AGE_MS=90000;
    static int assertions;
    static final List<String> cases=new ArrayList<String>();
    interface Work {void run() throws Exception;}
    static void yes(boolean value,String message){assertions++;if(!value)throw new AssertionError(message);}
    static void one(String name,Work work)throws Exception{work.run();cases.add(name);}
    static final class SystemClock {static long elapsedRealtime(){return 1000;}}
    static final class Capture {final boolean history;Capture(boolean value){history=value;}boolean formHistory(){return history;}}
    static final class PhoneObservation {
        final String id="observed",packageName="ctrip.android.view";
        final long capturedElapsedMillis=900;
        Capture capture=new Capture(true);
    }
    static final class ActionDecision {
        String action,observationId="observed",packageName="ctrip.android.view",nodeId="date";
        ActionDecision(String value){action=value;}
    }
    static final class ObservedTargetLabels {}
    interface Cancellation {boolean isCancelled();}
    static final class BackgroundSession {}
    static final class NativeActionSnapshotCheck {
        static final String YEAR="flight.inspect_year",QUERY="flight.query";
    }
    final class Guard {
        final String purpose;boolean claimed;int requireClaimedCalls;
        Guard(String value){purpose=value;}
        void requireClaimed(){requireClaimedCalls++;events.add("require_claimed");if(!claimed)throw new StaleObservation("explicit unclaimed port");}
    }
    final class Graph {
        String digest="equal";boolean window=true,closed;
        boolean sameWindow(Graph other){return other.window;}
        void close(){if(closed)throw new AssertionError("double close");closed=true;closedReads++;}
    }
    final class ActionWork {
        BackgroundSession background=new BackgroundSession();
        Guard nativeGuard=new Guard(NativeActionSnapshotCheck.YEAR);
        boolean nativeActionRevalidated;
        Object nativeRegion;
        Object budget(){return this;}
    }
    static final class ActionPolicy {
        // Explicit stable-tree classification input; no policy qualification.
        static boolean requiresStableTree(ActionDecision action){return "click".equals(action.action);}
    }
    static final class StaleObservation extends IllegalStateException {
        private static final long serialVersionUID=1L;
        StaleObservation(String message){super(message);}
    }
    static final class ProfileOwnershipViolation extends IllegalStateException {
        private static final long serialVersionUID=1L;
        ProfileOwnershipViolation(String message){super(message);}
    }
    static final class WebFlightNativeStability {static final class Permit {}}
    static final class WebRegionNativeBridge {}
    static final class WebFlightSession {
        WebFlightNativeStability.Permit flightNativePermitForDispatch(ActionDecision a,PhoneObservation p){throw new AssertionError("Web outside gate");}
        void acceptFlightNativeCheck(ActionDecision a,PhoneObservation p,Object proof){throw new AssertionError("Web outside gate");}
        WebRegionNativeBridge nativeRegionForDispatch(ActionDecision a,String run,PhoneObservation p){throw new AssertionError("Web outside gate");}
        void acceptNativeRegionCheck(ActionDecision a,String run,Object proof){throw new AssertionError("Web outside gate");}
        void beforeNativeClickInvocation(ActionDecision a,String run){throw new AssertionError("Web outside gate");}
    }
    static final class PersistentActionPolicy {
        static final class Decision {boolean allowed=true;String reasonCode="",detail="";}
        static Decision evaluate(String text,String description,String child,boolean editable){return new Decision();}
    }
    static final class QualificationScopeConfig {static final class Bound {}}
    static final class TaskAuthorization {static final class Gate {}}
    static final class ChildText {String text="";}
    static final class ActionOutcome {
        final boolean accepted,dispatched,stale;final String detail;
        ActionOutcome(boolean a,boolean d,boolean s,String text){accepted=a;dispatched=d;stale=s;detail=text;}
    }
    interface ActionCallback {void onResult(ActionOutcome outcome);}
    final class AccessibilityNodeInfo {
        static final int ACTION_CLICK=16;
        CharSequence getText(){return "日期";}CharSequence getContentDescription(){return "";}
        boolean isEditable(){return false;}
        boolean performAction(int action){if(action!=ACTION_CLICK)throw new AssertionError("unexpected effect");effects++;events.add("perform");return true;}
    }
    final PhoneObservation current=new PhoneObservation();
    final Graph original=new Graph();
    final List<String> events=new ArrayList<String>();
    WebFlightSession taskWeb;
    int reads,closedReads,compares,finalChecks,effects,effectEntries,returned,staleDiagnostics;
    boolean differentDigest,windowChanged,compareReject,finalReject,finalLeavesUnclaimed;
    boolean callbackAccepted;
    Graph graphForAction(ActionWork work){return original;}
    boolean owns(String task){return "task".equals(task);}
    boolean locked(BackgroundSession background){return false;}
    void requireBackgroundObservation(String task,PhoneObservation expected){if(expected!=current)throw new StaleObservation("explicit stale port");}
    String targetBindingError(PhoneObservation expected,ActionDecision action,ObservedTargetLabels targets){return null;}
    void actionPhase(ActionWork work,String phase){events.add(phase);}
    Graph readGraph(Object budget,BackgroundSession background){reads++;Graph fresh=new Graph();fresh.digest=differentDigest?"different":"equal";fresh.window=!windowChanged;return fresh;}
    BackgroundSession currentBackground(){return new BackgroundSession();}
    BackgroundSession backgroundFor(String task){return new BackgroundSession();}
    void actionCheck(ActionWork work){}
    Object requireLiveFlightNativeStability(String task,PhoneObservation expected,ActionDecision action,WebFlightNativeStability.Permit permit,Graph now,Cancellation cancel,ActionWork work){throw new AssertionError("Web outside gate");}
    void compareNativeAction(String task,PhoneObservation expected,ActionDecision action,Graph now,ActionWork work){
        compares++;events.add("compare");if(compareReject)throw new StaleObservation("explicit comparison rejection");
    }
    void recordStaleDiagnostic(ActionWork work,Graph before,Graph after,String node){staleDiagnostics++;}
    static String message(Throwable error){return error.getMessage();}
    static String string(CharSequence value){return value==null?"":value.toString();}
    boolean hasAction(AccessibilityNodeInfo node,int action){return action==AccessibilityNodeInfo.ACTION_CLICK;}
    void scopeBeforeDispatch(String task,QualificationScopeConfig.Bound scope,PhoneObservation expected,ActionDecision action,AccessibilityNodeInfo node,boolean effect,ActionWork work){events.add("scope");}
    void authorizationBeforeDispatch(String task,TaskAuthorization.Gate auth,ActionDecision action,String run){events.add("authorization");}
    Object requireLiveNativeRegion(String task,PhoneObservation expected,AccessibilityNodeInfo node,WebRegionNativeBridge region,Cancellation cancel,ActionWork work){throw new AssertionError("Web outside gate");}
    boolean nativeSearchEntryGuard(ActionWork work){return false;}
    boolean nativeFlightOpenGuard(ActionWork work){return false;}
    void finalNativeActionCheck(String task,PhoneObservation expected,ActionDecision action,ActionWork work){
        finalChecks++;events.add("final");
        if(finalReject)throw new StaleObservation("explicit final rejection");
        if(!finalLeavesUnclaimed&&work!=null&&work.nativeGuard!=null)work.nativeGuard.claimed=true;
    }
    void enterActionEffect(ActionWork work){effectEntries++;events.add("enter");}
    void actionEffectReturned(ActionWork work,Boolean accepted){returned++;events.add("returned");}
    void finishAfter(long delay,boolean accepted,String text,ActionCallback callback,ActionWork work){callback.onResult(new ActionOutcome(accepted,accepted,false,text));}

    {{validate}}

    void actualClickBranch(ActionDecision action,ActionWork work)throws Exception{
        String taskId="task",modelRunId="run";
        PhoneObservation expected=current;
        AccessibilityNodeInfo node=new AccessibilityNodeInfo();
        ChildText freshChildText=new ChildText();
        QualificationScopeConfig.Bound dispatchScope=new QualificationScopeConfig.Bound();
        TaskAuthorization.Gate authorization=new TaskAuthorization.Gate();
        Cancellation cancel=()->false;
        ActionCallback callback=outcome->{callbackAccepted=outcome.accepted;};
        boolean accepted;
        {{click_branch}}
    }

    static void runCases()throws Exception{
        one("historical_equal_digest_YEAR_runs_comparison",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"valid history YEAR");
            yes(h.compares==1&&w.nativeActionRevalidated,"equal digest must invoke complete comparison port");
            yes(h.reads==1&&h.closedReads==1&&h.effects==0,"one closed read and no validation effect");
        });
        one("historical_equal_digest_QUERY_runs_comparison",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=h.new Guard(NativeActionSnapshotCheck.QUERY);
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"valid history QUERY");
            yes(h.compares==1&&w.nativeActionRevalidated&&h.effects==0,"QUERY same digest comparison");
        });
        one("historical_different_digest_runs_comparison",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.differentDigest=true;ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"different digest history");
            yes(h.compares==1&&w.nativeActionRevalidated&&h.closedReads==1,"comparison and close");
        });
        one("historical_equal_digest_comparison_refusal_is_preserved",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.compareReject=true;ActionWork w=h.new ActionWork();
            String refusal=h.validate("task",h.current,new ActionDecision("click"),null,()->false,w);
            yes(refusal!=null&&refusal.contains("explicit comparison rejection"),"comparison refusal retained");
            yes(h.compares==1&&!w.nativeActionRevalidated&&h.staleDiagnostics==1&&h.closedReads==1&&h.effects==0,"no validation bypass");
        });
        one("historical_click_missing_guard_refused_before_read",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=null;
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)!=null,"missing guard refused");
            yes(h.reads==0&&h.compares==0&&h.effects==0,"no read/effect");
        });
        one("historical_click_wrong_purpose_refused_before_read",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=h.new Guard("flight.open");
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)!=null,"wrong purpose refused");
            yes(h.reads==0&&h.effects==0,"no read/effect");
        });
        one("historical_nonclick_effect_refused_before_read",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("back"),null,()->false,w)!=null,"nonclick effect refused");
            yes(h.reads==0&&h.effects==0,"no read/effect");
        });
        one("historical_wait_keeps_noneffect_path_without_guard",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=null;
            yes(h.validate("task",h.current,new ActionDecision("wait"),null,()->false,w)==null,"wait remains allowed");
            yes(h.compares==0&&h.closedReads==1&&h.effects==0,"wait no comparison or effect");
        });
        one("historical_done_keeps_noneffect_path_without_guard",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=null;
            yes(h.validate("task",h.current,new ActionDecision("done"),null,()->false,w)==null,"done remains allowed here; Session separately refuses success");
            yes(h.compares==0&&h.closedReads==1&&h.effects==0,"done no comparison or effect");
        });
        one("historical_final_click_forces_final_check_even_without_revalidated_flag",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
            yes(!w.nativeActionRevalidated,"explicit false flag");h.actualClickBranch(new ActionDecision("click"),w);
            yes(h.finalChecks==1&&w.nativeGuard.requireClaimedCalls==1&&h.effects==1&&h.effectEntries==1&&h.returned==1&&h.callbackAccepted,"final/claim before single effect port");
            yes(h.events.equals(java.util.Arrays.asList("scope","authorization","final","require_claimed","enter","perform","returned")),"ordered final and claim");
        });
        one("historical_final_check_refusal_has_zero_effect",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.finalReject=true;ActionWork w=h.new ActionWork();boolean rejected=false;
            try{h.actualClickBranch(new ActionDecision("click"),w);}catch(StaleObservation expected){rejected=true;}
            yes(rejected&&h.finalChecks==1&&w.nativeGuard.requireClaimedCalls==0,"actual final refusal stops branch");
            yes(h.effects==0&&h.effectEntries==0&&h.returned==0&&!h.callbackAccepted,"zero effect");
        });
        one("historical_final_check_without_claim_has_zero_effect",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.finalLeavesUnclaimed=true;ActionWork w=h.new ActionWork();boolean rejected=false;
            try{h.actualClickBranch(new ActionDecision("click"),w);}catch(StaleObservation expected){rejected=true;}
            yes(rejected&&h.finalChecks==1&&w.nativeGuard.requireClaimedCalls==1,"claim is actually required");
            yes(h.effects==0&&h.effectEntries==0&&h.returned==0,"zero effect");
        });
        one("ordinary_equal_digest_control_keeps_existing_branch",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.current.capture=new Capture(false);ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"ordinary control");
            yes(h.compares==0&&!w.nativeActionRevalidated,"ordinary equal digest keeps original path");
            h.actualClickBranch(new ActionDecision("click"),w);
            yes(h.finalChecks==0&&w.nativeGuard.requireClaimedCalls==0&&h.effects==1,"control has no history force");
        });
    }
    static String quoted(String value){return "\""+value.replace("\\","\\\\").replace("\"","\\\"").replace("\n","\\n").replace("\r","\\r")+"\"";}
    public static void main(String[] args)throws Exception{
        String failure=null;
        try{runCases();}catch(Throwable error){failure=error.getClass().getSimpleName()+": "+error.getMessage();}
        StringBuilder names=new StringBuilder("[");for(String name:cases){if(names.length()>1)names.append(',');names.append(quoted(name));}names.append(']');
        String json="{\"schema\":\"hepta.native-form-history-action-control-flow.v1\",\"all_pass\":"+(failure==null)+",\"cases\":"+cases.size()+",\"assertions\":"+assertions+",\"case_names\":"+names
                +",\"failure\":"+(failure==null?"null":quoted(failure))+",\"android_execution\":false,\"phone_execution\":false,\"business_completion_verified\":false,\"real_comparator_executed\":false,\"real_guard_executed\":false,\"effects_are_instrumented_ports\":true}\n";
        Files.write(Paths.get(args[0]),json.getBytes(StandardCharsets.UTF_8));System.out.print(json);
        if(failure!=null)throw new AssertionError(failure);
    }
}
