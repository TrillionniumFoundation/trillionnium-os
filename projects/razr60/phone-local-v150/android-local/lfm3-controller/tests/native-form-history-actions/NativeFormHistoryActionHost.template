    static void runQueryCases(String encoded)throws Exception{
        String[] counts=encoded.split(",");
        for(int ix=0;ix<counts.length;ix++){
            final int ordinal=Integer.parseInt(counts[ix]);
            one("recorded_undispatched_query_step_"+(ix+4),()->{
                SystemClock.time=1000;NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
                w.nativeGuard=h.new Guard(NativeActionSnapshotCheck.QUERY);h.queryReplay=true;
                h.firstFailureOrdinal=ordinal;h.injectedFailures=1;h.readMs=120;
                ActionDecision action=new ActionDecision("click");
                yes(h.validate("task",h.current,action,null,()->false,w)==null,"new complete validation required");
                h.actualClickBranch(action,w);
                yes(h.effects==1&&h.reads==3&&h.closedReads==2&&h.compares==2,"both full graph checks and a single original effect");
                yes((ordinal==2?"final_census":"validation_census").equals(w.queryCensusRetry.get("failed_stage")),"actual failing traversal stage");
                yes(("0/0/7/"+ordinal).equals(w.queryCensusRetry.get("failed_native_path")),"test-only injected child is reported accurately");
                yes(Boolean.TRUE.equals(w.queryCensusRetry.get("reread_complete"))&&!Boolean.TRUE.equals(w.queryCensusRetry.get("action_replayed")),"complete new read without replay");
            });
        }
        for(String fault:new String[]{"another_descendant","late","untyped","no_path","cancel","foreign_lease","installation",
                "already_entered","protected_change","new_date","ordinary_pixels","wrong_route","other_purpose","repeated_in_final"}){
            one("bound_query_reread_refuses_"+fault,()->{
                SystemClock.time=1000;NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
                w.nativeGuard=h.new Guard("other_purpose".equals(fault)?"select_calendar_day":NativeActionSnapshotCheck.QUERY);
                ActionDecision action=new ActionDecision("click");h.queryReplay=true;h.injectedFailures=1;h.readMs=50;
                if("another_descendant".equals(fault))h.injectedFailures=2;
                if("late".equals(fault))w.state.deadlineElapsed=1100;
                if("untyped".equals(fault))h.untyped=true;
                if("no_path".equals(fault))h.unidentified=true;
                if("cancel".equals(fault))w.cancel=()->true;
                if("foreign_lease".equals(fault))h.retired=true;
                if("installation".equals(fault))h.installed=false;
                if("already_entered".equals(fault))w.state.entered=true;
                if("protected_change".equals(fault)||"new_date".equals(fault))h.compareReject=true;
                if("ordinary_pixels".equals(fault))h.current.capture=new Capture(false);
                if("wrong_route".equals(fault))w.nativeGuard.goal=flightGoal(NativeAppGoal.CSAIR_PACKAGE);
                if("repeated_in_final".equals(fault)){
                    yes(h.validate("task",h.current,action,null,()->false,w)==null,"one allowed complete reread consumed before final check");
                    h.injectedFailures=1;h.firstFailureOrdinal=h.reads+1;
                    try{h.actualClickBranch(action,w);throw new AssertionError("final graph must reject");}catch(StaleObservation expected){}
                    yes("final_census".equals(w.queryCensusRetry.get("later_failed_stage"))&&h.reads==3,"no second read retry");
                }else{
                    String rejection=h.validate("task",h.current,action,null,()->false,w);
                    yes(rejection!=null,"changed or unavailable complete graph refused");
                }
                yes(h.effects==0&&h.effectEntries==0&&!w.nativeGuard.claimed,"no claim or effect");
                if("another_descendant".equals(fault))yes("0/0/7/2".equals(w.queryCensusRetry.get("later_failed_native_path")),"second distinct failed child preserved");
            });
        }
        SystemClock.time=1000;
    }
    static void runYearCases(String encoded)throws Exception{
        String[] rows=encoded.split(",");
        for(int index=0;index<rows.length;index++){
            String[] fields=rows[index].split("/");
            final int ordinal=Integer.parseInt(fields[0]),start=Integer.parseInt(fields[1]);
            final int duration=Integer.parseInt(fields[2]),deadline=Integer.parseInt(fields[3]);
            one("86b343_recorded_inspect_departure_year_step_"+(index+2),()->{
                NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
                SystemClock.time=1000L+start-(ordinal-1L)*duration;
                w.state.deadlineElapsed=1000L+deadline;
                h.firstFailureOrdinal=ordinal;h.injectedFailures=1;h.readMs=duration;h.queryReplay=true;
                ActionDecision action=new ActionDecision("click");action.nodeId="n33";
                yes(h.validate("task",h.current,action,null,()->false,w)==null,"complete validation failed before the dated target");
                h.actualClickBranch(action,w);
                yes(h.effects==1&&h.effectEntries==1&&h.returned==1,"one original model click after full validation and claim");
                yes(h.reads==3&&h.closedReads==2&&h.compares==2,"both completed census samples compared and released");
                yes(w.state.deadlineElapsed==1000L+deadline&&SystemClock.time<w.state.deadlineElapsed,"original elapsed deadline retained");
                yes(w.queryCensusRetry!=null&&NativeActionSnapshotCheck.YEAR.equals(w.queryCensusRetry.get("purpose")),"typed year receipt");
                yes("hepta.ctrip-departure-year-census-retry.v1".equals(w.queryCensusRetry.get("schema")),"year receipt distinct from query");
                yes((ordinal==2?"final_census":"validation_census").equals(w.queryCensusRetry.get("failed_stage")),"actual failing traversal stage");
                yes(("0/0/7/"+ordinal).equals(w.queryCensusRetry.get("failed_native_path")),"injected child path persisted");
                yes(Boolean.TRUE.equals(w.queryCensusRetry.get("reread_complete"))&&Boolean.FALSE.equals(w.queryCensusRetry.get("reused_partial_census"))
                        &&Boolean.FALSE.equals(w.queryCensusRetry.get("action_replayed")),"one fresh complete read before original effect");
            });
        }
        for(String fault:new String[]{"two_missing","no_path","untyped","deadline","profile","retired","already_entered",
                "changed_form","wrong_route","ordinary_pixels","repeat_after_validation"}){
            one("departure_year_refuses_"+fault,()->{
                NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
                SystemClock.time=1000;h.readMs=100;h.queryReplay=true;h.injectedFailures="two_missing".equals(fault)?2:1;
                if("no_path".equals(fault))h.unidentified=true;
                if("untyped".equals(fault))h.untyped=true;
                if("deadline".equals(fault))w.state.deadlineElapsed=1200;
                if("profile".equals(fault))h.installed=false;
                if("retired".equals(fault))h.retired=true;
                if("already_entered".equals(fault))w.state.entered=true;
                if("changed_form".equals(fault))h.compareReject=true;
                if("wrong_route".equals(fault))w.nativeGuard.goal=flightGoal(NativeAppGoal.CSAIR_PACKAGE);
                if("ordinary_pixels".equals(fault))h.current.capture=new Capture(false);
                ActionDecision action=new ActionDecision("click");action.nodeId="n33";
                String refusal=h.validate("task",h.current,action,null,()->false,w);
                if("repeat_after_validation".equals(fault)){
                    yes(refusal==null&&h.reads==2,"first complete recovery consumed");
                    h.firstFailureOrdinal=3;h.injectedFailures=1;
                    try{h.actualClickBranch(action,w);throw new AssertionError("second reread denied");}
                    catch(StaleObservation seen){yes("final_census".equals(w.queryCensusRetry.get("later_failed_stage"))&&h.reads==3,"no second replacement");}
                }else yes(refusal!=null,"no authority when the pending year read fails");
                yes(h.effects==0&&h.effectEntries==0&&!w.nativeGuard.claimed,"no effect or claim");
            });
        }
        SystemClock.time=1000;
    }
    static void runCases()throws Exception{
        one("historical_equal_digest_YEAR_runs_comparison",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"valid history YEAR");
            yes(h.compares==1&&w.nativeActionRevalidated,"equal digest must invoke complete comparison port");
            yes(h.reads==1&&h.closedReads==1&&h.effects==0,"one closed read and no validation effect");
        });
        one("historical_equal_digest_QUERY_runs_comparison",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=h.new Guard(NativeActionSnapshotCheck.QUERY);
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"valid history QUERY");
            yes(h.compares==1&&w.nativeActionRevalidated&&h.effects==0,"QUERY same digest comparison");
        });
        one("historical_different_digest_runs_comparison",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.differentDigest=true;ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"different digest history");
            yes(h.compares==1&&w.nativeActionRevalidated&&h.closedReads==1,"comparison and close");
        });
        one("historical_equal_digest_comparison_refusal_is_preserved",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.compareReject=true;ActionWork w=h.new ActionWork();
            String refusal=h.validate("task",h.current,new ActionDecision("click"),null,()->false,w);
            yes(refusal!=null&&refusal.contains("explicit comparison rejection"),"comparison refusal retained");
            yes(h.compares==1&&!w.nativeActionRevalidated&&h.staleDiagnostics==1&&h.closedReads==1&&h.effects==0,"no validation bypass");
        });
        one("historical_click_missing_guard_refused_before_read",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=null;
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)!=null,"missing guard refused");
            yes(h.reads==0&&h.compares==0&&h.effects==0,"no read/effect");
        });
        one("historical_click_wrong_purpose_refused_before_read",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=h.new Guard("flight.open");
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)!=null,"wrong purpose refused");
            yes(h.reads==0&&h.effects==0,"no read/effect");
        });
        one("historical_nonclick_effect_refused_before_read",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("back"),null,()->false,w)!=null,"nonclick effect refused");
            yes(h.reads==0&&h.effects==0,"no read/effect");
        });
        one("historical_wait_keeps_noneffect_path_without_guard",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=null;
            yes(h.validate("task",h.current,new ActionDecision("wait"),null,()->false,w)==null,"wait remains allowed");
            yes(h.compares==0&&h.closedReads==1&&h.effects==0,"wait no comparison or effect");
        });
        one("historical_done_keeps_noneffect_path_without_guard",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();w.nativeGuard=null;
            yes(h.validate("task",h.current,new ActionDecision("done"),null,()->false,w)==null,"done remains allowed here; Session separately refuses success");
            yes(h.compares==0&&h.closedReads==1&&h.effects==0,"done no comparison or effect");
        });
        one("historical_final_click_forces_final_check_even_without_revalidated_flag",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();ActionWork w=h.new ActionWork();
            yes(!w.nativeActionRevalidated,"explicit false flag");h.actualClickBranch(new ActionDecision("click"),w);
            yes(h.finalChecks==1&&w.nativeGuard.requireClaimedCalls==1&&h.effects==1&&h.effectEntries==1&&h.returned==1&&h.callbackAccepted,"final/claim before single effect port");
            yes(h.events.equals(java.util.Arrays.asList("scope","authorization","final","require_claimed","enter","perform","returned")),"ordered final and claim");
        });
        one("historical_final_check_refusal_has_zero_effect",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.finalReject=true;ActionWork w=h.new ActionWork();boolean rejected=false;
            try{h.actualClickBranch(new ActionDecision("click"),w);}catch(StaleObservation expected){rejected=true;}
            yes(rejected&&h.finalChecks==1&&w.nativeGuard.requireClaimedCalls==0,"actual final refusal stops branch");
            yes(h.effects==0&&h.effectEntries==0&&h.returned==0&&!h.callbackAccepted,"zero effect");
        });
        one("historical_final_check_without_claim_has_zero_effect",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.finalLeavesUnclaimed=true;ActionWork w=h.new ActionWork();boolean rejected=false;
            try{h.actualClickBranch(new ActionDecision("click"),w);}catch(StaleObservation expected){rejected=true;}
            yes(rejected&&h.finalChecks==1&&w.nativeGuard.requireClaimedCalls==1,"claim is actually required");
            yes(h.effects==0&&h.effectEntries==0&&h.returned==0,"zero effect");
        });
        one("ordinary_equal_digest_control_keeps_existing_branch",()->{
            NativeFormHistoryActionHost h=new NativeFormHistoryActionHost();h.current.capture=new Capture(false);ActionWork w=h.new ActionWork();
            yes(h.validate("task",h.current,new ActionDecision("click"),null,()->false,w)==null,"ordinary control");
            yes(h.compares==0&&!w.nativeActionRevalidated,"ordinary equal digest keeps original path");
            h.actualClickBranch(new ActionDecision("click"),w);
            yes(h.finalChecks==0&&w.nativeGuard.requireClaimedCalls==0&&h.effects==1,"control has no history force");
        });
    }
    static String quoted(String value){return "\""+value.replace("\\","\\\\").replace("\"","\\\"").replace("\n","\\n").replace("\r","\\r")+"\"";}
    public static void main(String[] args)throws Exception{
        String failure=null;
        try{runCases();runQueryCases(args[1]);runYearCases(args[2]);}catch(Throwable error){failure=error.getClass().getSimpleName()+": "+error.getMessage();}
        StringBuilder names=new StringBuilder("[");for(String name:cases){if(names.length()>1)names.append(',');names.append(quoted(name));}names.append(']');
        String json="{\"schema\":\"hepta.native-form-history-action-control-flow.v1\",\"all_pass\":"+(failure==null)+",\"cases\":"+cases.size()+",\"assertions\":"+assertions+",\"case_names\":"+names
                +",\"failure\":"+(failure==null?"null":quoted(failure))+",\"android_execution\":false,\"phone_execution\":false,\"business_completion_verified\":false,\"real_comparator_executed\":false,\"real_guard_executed\":false,\"effects_are_instrumented_ports\":true}\n";
        Files.write(Paths.get(args[0]),json.getBytes(StandardCharsets.UTF_8));System.out.print(json);
        if(failure!=null)throw new AssertionError(failure);
    }
