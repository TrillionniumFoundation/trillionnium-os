    }
    static final class NodeRef {
        final AccessibilityNodeInfo node;final String signature,appTreeSignature,inputTextSha256;final ObservedImeEnter imeEnter;
        NodeRef(String id){node=new AccessibilityNodeInfo(id);signature="signature";appTreeSignature="tree";inputTextSha256=null;imeEnter=new ObservedImeEnter();}
        /*__NODE_COPY__*/
    }
