        JSONObject toJson(){check(Thread.currentThread()!=MAIN,"frame serialization ran on main");return new JSONObject().put("observation_id",id);}
        static final class CollectionStats {
            int visited=1,retained=1,pending;long childSlotsOmitted;boolean truncated(){return pending!=0||childSlotsOmitted!=0;}
