        final String generation;volatile boolean released;
        BackgroundSession(String g){generation=g;}
        void requireActive(){if(released)throw new IllegalStateException("released background");}
    }
    static final class WebFlightSession {
        final String taskId=TASK;final Object goal=new Object();final TaskAuthorization.Gate authorization;
        final Purpose purpose=new Purpose();
        static final class Purpose {final Object flight=new Object(),shopping=null;}
        WebFlightSession(TaskAuthorization.Gate a){authorization=a;}
    }
