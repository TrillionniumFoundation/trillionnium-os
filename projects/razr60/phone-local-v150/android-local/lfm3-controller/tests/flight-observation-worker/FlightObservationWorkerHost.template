    static final class WebFlightNativeStability {static final String LABEL="booking";static final int MAX_NATIVE_NODES=1536;}
    static final class WebShoppingObservationStability {
        static final int MAX_NATIVE_NODES=1024;
        static PhoneObservation.Node target(List<PhoneObservation.Node> rows){throw new AssertionError("flight-only host carrier has no shopping target");}
    }
