/** Exact production lifecycle/handoff methods; Android native IO below is an explicit blocking fake. */
public final class FlightObservationWorkerHost {
    static final Thread MAIN=Thread.currentThread();
    static final String TASK="11111111111111111111111111111111",OWNER="owner",GEN="generation-a";
    static int cases,assertions;
    interface Case {void run()throws Exception;}
    static void check(boolean value,String why){assertions++;if(!value)throw new AssertionError(why);}
    static void run(String name,Case work)throws Exception{work.run();cases++;System.out.println("PASS "+name);}
    static void await(CountDownLatch latch)throws InterruptedException{check(latch.await(3,TimeUnit.SECONDS),"host latch deadline");}
    static void refuses(Case work)throws Exception{
        boolean refused=false;try{work.run();}catch(IllegalStateException expected){refused=true;}
        check(refused,"expected refusal");
    }
    static void futureRefuses(Future<?> f)throws Exception{
        boolean refused=false;try{f.get(3,TimeUnit.SECONDS);}catch(ExecutionException e){
            check(e.getCause() instanceof IllegalStateException||e.getCause() instanceof RejectedExecutionException,
                    "unexpected host failure: "+e.getCause());refused=true;
        }check(refused,"late result was accepted");
    }
    static final class SystemClock {
        static final AtomicLong value=new AtomicLong(100);
        static long elapsedRealtime(){return value.get();}
    }
    static final class Looper {static Thread getMainLooper(){return MAIN;}static Thread myLooper(){return Thread.currentThread();}}
    static final class Handler {
        final BlockingQueue<Runnable> queued=new LinkedBlockingQueue<Runnable>();boolean reject;
        boolean post(Runnable work){if(reject)return false;queued.add(work);return true;}
        void runOne()throws Exception{Runnable r=queued.poll(3,TimeUnit.SECONDS);check(r!=null,"no main handoff queued");r.run();}
    }
    static final class Rect {
        final int left,top,right,bottom;
        Rect(int l,int t,int r,int b){left=l;top=t;right=r;bottom=b;}
        Rect(Rect r){this(r.left,r.top,r.right,r.bottom);}
        @Override public boolean equals(Object v){if(!(v instanceof Rect))return false;Rect r=(Rect)v;return left==r.left&&top==r.top&&right==r.right&&bottom==r.bottom;}
        @Override public int hashCode(){return left+31*top+961*right+29791*bottom;}
    }
    static final class AccessibilityNodeInfo {
        static final List<AccessibilityNodeInfo> copies=Collections.synchronizedList(new ArrayList<AccessibilityNodeInfo>());
        final String id;final AtomicInteger closes=new AtomicInteger();
        AccessibilityNodeInfo(String id){this.id=id;}
        static AccessibilityNodeInfo obtain(AccessibilityNodeInfo n){
            check(n.closes.get()==0,"copied retired node");AccessibilityNodeInfo c=new AccessibilityNodeInfo(n.id);copies.add(c);return c;
        }
        void recycle(){check(closes.incrementAndGet()==1,"double node recycle");}
    }
