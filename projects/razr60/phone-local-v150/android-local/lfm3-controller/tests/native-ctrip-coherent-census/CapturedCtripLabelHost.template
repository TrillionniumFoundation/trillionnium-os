        void getBoundsInScreen(Rect rect){
            List<?> b=(List<?>)value("bounds");
            rect.left=((Number)b.get(0)).intValue();rect.top=((Number)b.get(1)).intValue();
            rect.right=((Number)b.get(2)).intValue();rect.bottom=((Number)b.get(3)).intValue();
        }
        List<AccessibilityAction> getActionList(){
            List<AccessibilityAction> result=new ArrayList<AccessibilityAction>();
            if(flag("action_click"))result.add(new AccessibilityAction(ACTION_CLICK));
            ObservedScrollActions scroll=scroll(text("scroll_actions"));
            for(String direction:scroll.directions){
                int id="forward".equals(direction)?ACTION_SCROLL_FORWARD:"backward".equals(direction)?ACTION_SCROLL_BACKWARD:
                        "up".equals(direction)?AccessibilityAction.ACTION_SCROLL_UP.getId():
                        "down".equals(direction)?AccessibilityAction.ACTION_SCROLL_DOWN.getId():
                        "left".equals(direction)?AccessibilityAction.ACTION_SCROLL_LEFT.getId():
                        AccessibilityAction.ACTION_SCROLL_RIGHT.getId();
                result.add(new AccessibilityAction(id));
            }
            return result;
        }
    }
