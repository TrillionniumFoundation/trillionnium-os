    static final class AccessibilityNodeInfo {
        static final int ACTION_CLICK=16,ACTION_LONG_CLICK=32,ACTION_SET_TEXT=2097152,
                ACTION_SCROLL_FORWARD=4096,ACTION_SCROLL_BACKWARD=8192;
        static final class AccessibilityAction {
