    static String string(CharSequence value){return value==null?"":value.toString();}
    static String sha(byte[] bytes){
        try{
            MessageDigest md=MessageDigest.getInstance("SHA-256");
            StringBuilder out=new StringBuilder();for(byte b:md.digest(bytes))out.append(String.format(Locale.ROOT,"%02x",b&255));
            return out.toString();
        }catch(java.security.NoSuchAlgorithmException impossible){throw new AssertionError(impossible);}
    }
    private static ObservedImeEnter readImeEnter(AccessibilityNodeInfo node){
        throw new AssertionError("fixture must supply the complete archived IME value explicitly");
