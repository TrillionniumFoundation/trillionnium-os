    }
    static ObservedScrollActions scroll(String fingerprint){
        String prefix=ObservedScrollActions.SCHEMA+"|observed";
        if((ObservedScrollActions.SCHEMA+"|unknown").equals(fingerprint))return ObservedScrollActions.UNKNOWN;
        if(!fingerprint.startsWith(prefix))throw new AssertionError("unrecognised archived scroll value");
        if(fingerprint.equals(prefix))return ObservedScrollActions.observed(Collections.<String>emptyList());
        if(fingerprint.charAt(prefix.length())!='|')throw new AssertionError("unrecognised scroll separator");
        return ObservedScrollActions.observed(Arrays.asList(fingerprint.substring(prefix.length()+1).split("\\|")));
    }
    static ObservedImeEnter ime(String fingerprint){
        if(ObservedImeEnter.ABSENT.fingerprintInput().equals(fingerprint))return ObservedImeEnter.ABSENT;
        if(ObservedImeEnter.UNKNOWN.fingerprintInput().equals(fingerprint))return ObservedImeEnter.UNKNOWN;
        throw new AssertionError("unsupported archived IME fixture shape");
    }
    static void need(boolean value,String reason){if(!value)throw new AssertionError(reason);}
    @SuppressWarnings("unchecked")
    static Map<String,Object> derive(List<Map<String,Object>> raw,String omitPath){
        final Graph graph=new Graph();final List<RawNode> values=new ArrayList<RawNode>();
        NativeSearchCapturedLabels facts=new NativeSearchCapturedLabels();
        Map<String,Object> result=new LinkedHashMap<String,Object>();int characters=0;
        try{
            for(Map<String,Object> row:raw){
                RawNode stored=new RawNode(row);values.add(stored);
                AccessibilityNodeInfo node=new AccessibilityNodeInfo(stored);
                try{
                    String path=(String)row.get("path"),parent=(String)row.get("parent_class");
                    if(!path.equals(omitPath))facts.add(captureNativeSearchLabelFact(node,path,parent));
                    graph.nativeActionBuilding.add(new NativeActionSnapshotCheck.Node(row));
                    // Original ref presence records retention. No new action target
                    // or retention membership is inferred from label text.
                    if(row.get("ref_signature_sha256")!=null){
                        String id="n"+graph.rows.size();
                        ObservedChildText.Result initial=ObservedChildText.notApplicable();
                        ObservedScrollActions scroll=scroll((String)row.get("scroll_actions"));
                        ObservedImeEnter ime=ime((String)row.get("ime_enter"));
                        String input=(String)row.get("input_sha256");
                        NodeRef reference=new NodeRef(node,initial,scroll,ime,input);
                        graph.refs.put(id,reference);
                        Rect bounds=new Rect();node.getBoundsInScreen(bounds);
                        PhoneObservation.Node retained=new PhoneObservation.Node(id,(String)row.get("package"),
                                (String)row.get("class"),(String)row.get("view_id"),(String)row.get("text"),
                                (String)row.get("description"),bounds,(Boolean)row.get("clickable"),(Boolean)row.get("editable"),
                                (Boolean)row.get("scrollable"),(Boolean)row.get("enabled"),(Boolean)row.get("focused"),
                                (Boolean)row.get("password"),initial,scroll,ime,input,false,reference.appTreeSignature,
                                path,parent,(Boolean)row.get("selected"),(Boolean)row.get("checkable"),(Boolean)row.get("checked"));
                        graph.rows.add(retained);characters+=retained.text.length()+retained.description.length();
                    }
                }finally{node.recycle();}
            }
            facts.complete(raw.size(),0,false);
            final int[] budgetChecks={0};GraphBudget budget=new GraphBudget(){public void check(){budgetChecks[0]++;}};
            StringBuilder signatures=new StringBuilder("uncommitted");
            int returned=new CapturedCtripLabelHost().applyNativeSearchCapturedLabels(graph,facts,budget,characters,32768,signatures);
            Map<String,PhoneObservation.Node> rowsByPath=new LinkedHashMap<String,PhoneObservation.Node>();
            for(PhoneObservation.Node row:graph.rows)rowsByPath.put(row.nativeTreePath,row);
            List<Map<String,Object>> census=new ArrayList<Map<String,Object>>();
            List<Map<String,Object>> labels=new ArrayList<Map<String,Object>>();
            int changed=0;
            for(int i=0;i<raw.size();i++){
                Map<String,Object> original=raw.get(i),actual=graph.nativeActionBuilding.get(i).v;
                Map<String,Object> originalFixed=new TreeMap<String,Object>(original),actualFixed=new TreeMap<String,Object>(actual);
                for(String key:Arrays.asList("label","ref_signature_sha256")){originalFixed.remove(key);actualFixed.remove(key);}
                need(originalFixed.equals(actualFixed),"all complete raw node facts outside label/ref must stay identical");
                if(!original.equals(actual))changed++;
                PhoneObservation.Node retained=rowsByPath.get(actual.get("path"));
                if(retained!=null){
                    NodeRef ref=graph.refs.get(retained.id);
                    need(ref!=null&&retained.observedAppTreeSignature.equals(ref.appTreeSignature),"retained row and actual new NodeRef bind together");
                    need(NativeAppEvidence.hash(ref.signature).equals(actual.get("ref_signature_sha256")),"native census must use the same actual copied NodeRef");
                    if("derived".equals(retained.childText.status))
                        need(ObservedTargetLabels.project(retained.label()).equals(actual.get("label")),"derived published label matches native census");
                    Map<String,Object> label=new LinkedHashMap<String,Object>();label.put("path",retained.nativeTreePath);
                    label.put("status",retained.childText.status);label.put("label",actual.get("label"));
                    label.put("reference_sha256",actual.get("ref_signature_sha256"));labels.add(label);
                }else need(original.equals(actual),"unretained raw rows remain byte-value equal");
                census.add(actual);
            }
            result.put("nodes",census);result.put("retained_labels",labels);
            result.put("complete_node_count",census.size());result.put("retained_count",graph.rows.size());
            result.put("changed_label_reference_rows",changed);result.put("text_characters",returned);
            result.put("native_bytes",graph.nativeActionBytes);result.put("budget_checks",budgetChecks[0]);
            result.put("signatures_nonempty",signatures.length()>0);result.put("all_non_label_ref_facts_unchanged",true);
            result.put("synthetic_missing_metadata",Arrays.asList("input_type=0","long_clickable=false","ACTION_LONG_CLICK/ACTION_SET_TEXT absent"));
            result.put("original_raw_nodes_not_modified",true);result.put("android_bfs_execution_claimed",false);
        }finally{
            graph.close();int obtained=0,recycled=0;
            for(RawNode node:values){need(node.obtained==node.recycled,"all synthetic Android references released");obtained+=node.obtained;recycled+=node.recycled;}
            result.put("references_obtained",obtained);result.put("references_recycled",recycled);
            result.put("all_references_closed",true);result.put("nested_refresh_or_child_io",0);result.put("effects",0);
        }
        return result;
    }
