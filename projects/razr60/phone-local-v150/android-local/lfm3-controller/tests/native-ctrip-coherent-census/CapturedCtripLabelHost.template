        boolean isEditable(){return flag("editable");}
        boolean isScrollable(){return flag("scrollable");}
        boolean isFocused(){return flag("focused");}
        boolean isSelected(){return flag("selected");}
        boolean isCheckable(){return flag("checkable");}
