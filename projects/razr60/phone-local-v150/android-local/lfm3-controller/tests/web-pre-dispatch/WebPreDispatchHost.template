    interface Change {void run(WebFlightSession s)throws Exception;}
    static void check(boolean ok,String why){assertions++;if(!ok)throw new AssertionError(why);}
    static void test(String name,Work body)throws Exception{SystemClock.now=1000;body.run();cases++;names.put(name);}
    static String repeat(char c,int n){char[] a=new char[n];Arrays.fill(a,c);return new String(a);}
    static void need(boolean ok,String why){if(!ok)throw new IllegalArgumentException(why);}
    static final class SystemClock {static long now=1000;static long elapsedRealtime(){return now;}}
