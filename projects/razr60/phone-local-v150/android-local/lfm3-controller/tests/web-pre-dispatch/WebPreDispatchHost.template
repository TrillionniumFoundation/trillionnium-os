/** Exact production Session methods and Controller catch/continue block.
 * IPC, current authority, page recognition, clock, model and platform effects
 * below are explicit synthetic IO. This is not phone or model qualification. */
public final class WebPreDispatchHost {
    static final String TASK=repeat('1',32),RUN=repeat('2',32),GEN="lease",INSTANCE="instance",BIND=repeat('3',64);
    static int cases,assertions;
    static JSONArray names=new JSONArray();
