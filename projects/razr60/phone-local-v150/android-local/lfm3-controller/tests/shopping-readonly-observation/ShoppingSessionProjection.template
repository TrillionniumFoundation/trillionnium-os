    private void record(String name,JSONObject evidence)throws Exception{
        if(failRecord)throw new java.io.IOException("synthetic evidence writer failure");
        if(name==null||evidence==null)throw new AssertionError("record arguments");
        if(name.startsWith("web-shopping-final-read-")){
            if(cancelAfterPersist)cancellation.cancelled=true;
            if(expireAfterPersist>0)SystemClock.value=expireAfterPersist;
        }
    }
    private static void need(boolean yes,String reason){WebEvidenceJson.need(yes,reason);}

    private final Cancellation cancellation=new Cancellation();
