        modelActionOutcome(modelAction,modelRun,new HeptaAccessibilityService.ActionOutcome(accepted,dispatched,stale),
            before.receipt.ended+100,before.receipt.ended+101);
    }
    void publish(ShoppingQuoteHost.Sample after){
        domain=after.domain;current=after.frame;SystemClock.value=after.receipt.ended+200;
        completion.observed(ShoppingQuoteHost.completion(after.frame));completion.bindWebDomain(domain);
    }
    boolean hasPending(){return shoppingReadCompletion!=null;}
    void writerFails(){failRecord=true;}
    void cancel(){cancellation.cancelled=true;}
    void afterPersist(boolean cancel,long deadline){cancelAfterPersist=cancel;expireAfterPersist=deadline;}
    WebShoppingQuote.Completion finish(ShoppingQuoteHost.Sample before,PhoneObservation after,long deadline)throws Exception{
        return shoppingCompletion(modelAction,modelRun,before.frame,after,deadline);
    }
