    private static final class Cancellation {boolean cancelled;boolean isCancelled(){return cancelled;}}
    private static final class Background {boolean active=true;void requireActive(){need(active,"synthetic retired lease");}}
    void initialize(ShoppingQuoteHost.Sample before,TaskCompletionGate gate)throws Exception{
        domain=before.domain;dispatchSource=domain;current=before.frame;taskId=domain.taskId;purpose=ShoppingQuoteHost.purpose;
        authorization=ShoppingQuoteHost.authorization.bind(taskId);completion=gate;
        modelAction=ShoppingQuoteHost.done(before);modelRun=ShoppingQuoteHost.id(22);
        dispatchSourceRun=modelRun;dispatchSourceAction=actionKey(modelAction);
        dispatchCheckedRun=modelRun;dispatchCheckedAction=dispatchSourceAction;dispatchCheckedAt=before.receipt.ended+90;
        SystemClock.value=before.receipt.ended+200;
    }
