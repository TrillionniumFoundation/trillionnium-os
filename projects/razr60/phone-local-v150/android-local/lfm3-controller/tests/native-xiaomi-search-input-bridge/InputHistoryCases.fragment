
    static org.json.JSONObject historyRaw;
    static List<NativeActionSnapshotCheck.Node> historyNodes(boolean after,String change){
        org.json.JSONArray rows=historyRaw.getJSONObject(after?"after":"before").getJSONArray("native_nodes");
        List<NativeActionSnapshotCheck.Node> nodes=new ArrayList<NativeActionSnapshotCheck.Node>();
        for(int i=0;i<rows.length();i++){
            Map<String,Object> row=rows.getJSONObject(i).toMap();String path=(String)row.get("path");
            if(after&&"protected".equals(change)&&"0/1".equals(path))row.put("description","changed protected form");
            if(after&&"ancestor".equals(change)&&"0".equals(path))row.put("description","changed actual form ancestor");
            if(after&&"nonneutral".equals(change)&&"0/6/14".equals(path))row.put("editable",true);
            nodes.add(new NativeActionSnapshotCheck.Node(row));
        }return Collections.unmodifiableList(nodes);
    }
    static org.trillionnium.hepta.background.ProfileTarget historyTarget(long version){
        return new org.trillionnium.hepta.background.ProfileTarget(
            new org.trillionnium.hepta.background.ProfileIdentity(10,10,0,org.trillionnium.hepta.background.ProfileIdentity.MANAGED),
            1010111,NativeXiaomiSearchInputObservation.PACKAGE,NativeXiaomiSearchInputObservation.PACKAGE+"/Main",version,
            Collections.singletonMap("base",NativeXiaomiSearchInputObservation.BASE_APK_SHA256),Collections.singleton(SnapshotChecks.OWNER));
    }
    static WindowOwnership historyOwner(ProfileTarget target,int task){
        return new WindowOwnership(target,SnapshotChecks.GENERATION,9,2312,task,90,
            "dddddddd-dddd-4ddd-8ddd-dddddddddddd","eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
            10,10,1010111,SystemClock.now,SystemClock.now+2000);
    }
    static Map<String,Object> historyWindows(){
        Map<String,Object> row=map();row.put("window_id",2312);row.put("display_id",9);row.put("type",1);
        row.put("layer",0);row.put("bounds",Arrays.asList(0,0,1224,2992));row.put("focused",true);row.put("active",false);
        Map<String,Object> out=map();out.put("display_id",9);out.put("target_window_id",2312);out.put("target_layer",0);
        out.put("windows",Collections.singletonList(row));out.put("other_window_roots_traversed",false);out.put("unreported_windows_excluded",false);
        return immutableMap(out);
    }
    static ObserverPipelineHost historyFixture(final boolean changed,final String mutation,final AxChange extra)throws Exception{
        ObserverPipelineHost f=new ObserverPipelineHost();f.lease=SnapshotChecks.TASK;TaskAuthorization.Gate auth=new TaskAuthorization.Gate();f.taskAuthorization=auth;
        BackgroundSession bg=new BackgroundSession(9);bg.ownerSha256=SnapshotChecks.OWNER;bg.generation=SnapshotChecks.GENERATION;
        bg.observedProfileTarget=historyTarget("provider".equals(mutation)?20261009:20261010);
        BackgroundTaskTarget target=new BackgroundTaskTarget();target.route=BackgroundTaskTarget.NATIVE_APP;target.explicitSelection=true;
        target.ownerSha256=bg.ownerSha256;target.packageName=NativeXiaomiSearchInputObservation.PACKAGE;target.nativeGoal=new NativeAppGoal();
        target.nativeGoal.ownerSha256=target.ownerSha256;target.nativeGoal.packageName=target.packageName;target.nativeGoal.kind=NativeAppGoal.PRODUCT_PRICE;
        target.nativeGoal.productModel=NativeAppGoal.PRODUCT_MODEL;
        bg.selection.taskTarget=target;bg.selection.initialPackage=target.packageName;bg.selection.allowedPackages=Collections.singletonList(target.packageName);
        f.taskBackground=bg;LocalTaskController controller=new LocalTaskController();f.ownedController=controller;
        NativeAppSession session=new NativeAppSession();session.authorization=auth;session.taskId=f.lease;session.selection=bg.selection;
        session.target=target;session.goal=target.nativeGoal;session.displayId=9;session.generation=bg.generation;
        f.bindNativeTextObservation(controller,session,f.lease,auth,bg,new LocalInference(false),new LocalRuntimeConfig(false));
        f.readHook=(g,n)->{
            boolean after=changed&&n>=3;g.packageName=target.packageName;g.backgroundGeneration=bg.generation;g.backgroundOwnerSha=bg.ownerSha256;
            g.backgroundSelectionRaw="{\"fixture\":\"synthetic_managed_xiaomi_profile\"}";
            g.backgroundBootstrapPackage=target.packageName;g.backgroundAllowedPackages=bg.selection.allowedPackages;
            g.windowId=2312;g.bounds.right=1224;g.bounds.bottom=2992;
            String state=historyRaw.getJSONObject(after?"after":"before").getString("app_tree_sha256");
            g.state=new ObservationState(state,ImeVisibility.HIDDEN);
            g.windowMetadata=ObservedWindowMetadata.observed(new int[]{0,0,1224,2992},"android.widget.FrameLayout",1,9,new int[]{0,0,1224,2992},target.packageName);
            g.digest=historyRaw.getJSONObject(after?"after":"before").getString("observation_state_sha256");
            g.rows.add(new PhoneObservation.Node("n0",target.packageName,"0/1",g.digest));g.refs.put("n0",new NodeRef(g.digest));
            g.nativeActionNodes=historyNodes(after,mutation);g.nativeActionWindows=historyWindows();g.nativeActionWidth=1224;g.nativeActionHeight=2992;
            g.nativeActionTaskId=f.lease;g.nativeActionAuthorizationSha=SnapshotChecks.OWNER;g.nativeActionSelectionSha=SnapshotChecks.OWNER;
            g.nativeActionTargetSha=SnapshotChecks.OWNER;g.nativeActionGoalSha=SnapshotChecks.OWNER;g.nativeActionCapturedAt=SystemClock.now;
            g.profileWindow=historyOwner(bg.observedProfileTarget,after&&"profile".equals(mutation)?92:91);
            g.collectionStats=new PhoneObservation.CollectionStats(1536,512,6144,180,1,10,0,0,0,0,1);
            if(extra!=null)extra.apply(f,g,n);g.nativeObservationComplete=completeNativeObservationGraph(g);
            if(n==2)f.windowValue=frozenObservationWindow(g);
        };
        MobiMindPrivateFiles.writeHook=null;MobiMindPrivateFiles.readHook=null;MobiMindPrivateFiles.writes=0;MobiMindPrivateFiles.reads=0;return f;
    }
    static void historyPublished(ObserverPipelineHost f,ObservationRequest r,boolean late,boolean changed)throws Exception{
        drainAx(f);check(f.delivered.size()==1&&f.errors.isEmpty(),"history not published: "+f.errors);noPixels(f);
        check(f.current.capture.inputHistory()&&ObservationCaptureEvidence.NATIVE_AX_INPUT_HISTORY.equals(f.current.captureKind),"history kind erased");
        check(f.reads.get()==3&&MobiMindPrivateFiles.writes==1&&MobiMindPrivateFiles.reads==1&&!r.nativeAxPublicationRecheckAttempted,
            "history fabricated a recheck or skipped complete readback");
        check(f.current.capturedElapsedMillis==1200&&r.deadline==r.started+12000,"original A clock or budget changed");
        check(Boolean.valueOf(late).equals(f.current.captureEvidence.get("events_after_complete_census_admitted")),"late typed-content fact missing");
        check(Boolean.TRUE.equals(f.current.captureEvidence.get("historical_empty_input_planning_only")),"history planning-only scope absent");
        check(Boolean.FALSE.equals(f.current.captureEvidence.get("published_pair_is_current_tree_claimed")),"history claims current graph");
        f.current.capture.requireHistoricalPublication(f.current.captureEvidence);
        org.json.JSONObject receipt=onlyAxReceipt(f);
        check(receipt.getJSONObject("first").getJSONArray("nodes").length()==180&&receipt.getJSONObject("second").getJSONArray("nodes").length()==180,"complete nodes lost");
        check(receipt.getJSONObject("first").getJSONArray("nodes").toString().equals(historyRaw.getJSONObject("before").getJSONArray("native_nodes").toString()),
            "original complete A values changed");
        check(receipt.getJSONObject("second").getJSONArray("nodes").toString().equals(historyRaw.getJSONObject(changed?"after":"before").getJSONArray("native_nodes").toString()),
            "complete second values changed");
        org.json.JSONObject proof=receipt.getJSONObject("input_history").getJSONObject("comparison");
        check(proof.getJSONArray("changed_paths").length()==(changed?20:0),"actual full difference count changed");
        check(proof.getBoolean("whole_graph_equal")==!changed&&!proof.getBoolean("published_pair_is_current_tree_claimed"),"history falsely equal/current");
        check(f.current.capture.inputHistoryEvidence().get("source_census").equals("first"),"original A source replaced by second");
        check(f.current.path==null&&f.currentBitmap==null&&!receipt.getBoolean("screenshot_present"),"history invented pixels");
    }
    interface HistoryMutation {void apply(org.json.JSONObject receipt)throws Exception;}
    static void historyReceiptRefused(HistoryMutation mutation)throws Exception{
        ObserverPipelineHost f=historyFixture(true,"",null);ObservationRequest r=axPair(f);historyPublished(f,r,false,true);
        org.json.JSONObject receipt=onlyAxReceipt(f);mutation.apply(receipt);boolean refused=false;
        try{ObservationCaptureEvidence.nativeAxInputHistoryBytes(receipt.toMap());}catch(IllegalArgumentException expected){refused=true;}
        check(refused,"malformed historical receipt accepted");f.dispose();
    }
    public static void main(String[] args)throws Exception{
        mainThread=Thread.currentThread();
        org.json.JSONObject stored=new org.json.JSONObject(new String(Files.readAllBytes(Paths.get(args[1])),StandardCharsets.UTF_8));
        historyRaw=new org.json.JSONObject(stored.getJSONObject("source_files").getJSONObject("failed-native-census.json").getString("raw_utf8"));
        try{
            axCase("actual_180_node_20_changes_keep_complete_A_history_without_pixels",()->{
                ObserverPipelineHost f=historyFixture(true,"",null);ObservationRequest r=axPair(f);historyPublished(f,r,false,true);
                f.current.capture.requireInputHistoryTarget("0/1");boolean refused=false;
                try{f.current.capture.requireInputHistoryTarget("0/6/2");}catch(IllegalArgumentException expected){refused=true;}
                check(refused,"recommendation exposed as a form effect target");f.dispose();
            });
            for(final String stage:new String[]{"pair","persist","window","main"})
                axCase("late_typed_content_"+stage+"_is_declared_history_only",()->{
                    ObserverPipelineHost f=historyFixture(true,"",(x,g,n)->{if(n==3&&"pair".equals(stage))x.activeObservation.recordEvent(false,1);});
                    if("persist".equals(stage))MobiMindPrivateFiles.writeHook=()->f.activeObservation.recordEvent(false,1);
                    if("window".equals(stage))f.windowHook=()->f.activeObservation.recordEvent(false,1);
                    ObservationRequest r=axPair(f);if("main".equals(stage))r.recordEvent(false,1);
                    historyPublished(f,r,!"pair".equals(stage),true);f.dispose();
                });
            for(final int kind:new int[]{0,2,3})axCase("history_refuses_noncontent_"+kind,()->{
                ObserverPipelineHost f=historyFixture(true,"",null);ObservationRequest r=axPair(f);
                r.recordEvent(kind==3,kind==3?1:kind);axRejectedFinally(f,r);
            });
            axCase("new_content_after_DTO_is_not_historical_publication_credit",()->{
                ObserverPipelineHost f=historyFixture(true,"",null);f.phoneConstructHook=()->f.activeObservation.recordEvent(false,1);
                ObservationRequest r=axPair(f);axRejectedFinally(f,r);
            });
            for(final String mutation:new String[]{"protected","ancestor","nonneutral","profile","provider"})
                axCase("history_refuses_actual_"+mutation+"_change",()->{
                    ObserverPipelineHost f=historyFixture(true,mutation,null);ObservationRequest r=axPair(f);axRejectedFinally(f,r);
                });
            axCase("history_window_change_still_rejected",()->{
                ObserverPipelineHost f=historyFixture(true,"",null);
                f.windowHook=()->{FrozenObservationWindow w=f.windowValue;f.windowValue=new FrozenObservationWindow(w.packageName,w.windowId+1,w.displayId,w.rotation,
                    w.left,w.top,w.right,w.bottom,w.width,w.height,w.metadata,w.windows,w.profileWindow);};
                ObservationRequest r=axPair(f);axRejectedFinally(f,r);
            });
            axCase("history_original_deadline_still_expires_during_persistence",()->{
                ObserverPipelineHost f=historyFixture(true,"",null);MobiMindPrivateFiles.writeHook=()->SystemClock.now+=12000;
                ObservationRequest r=axPair(f);axRejectedFinally(f,r);
            });
            axCase("history_actual_readback_hash_mismatch_rejected",()->{
                ObserverPipelineHost f=historyFixture(true,"",null);MobiMindPrivateFiles.readHook=b->{b[b.length-1]^=1;};
                ObservationRequest r=axPair(f);axRejectedFinally(f,r);
            });
            axCase("ordinary_factory_cannot_consume_history_receipt",()->{
                ObserverPipelineHost f=historyFixture(true,"",null);ObservationRequest r=axPair(f);historyPublished(f,r,false,true);
                boolean refused=false;try{ObservationCaptureEvidence.nativeAxBytes(onlyAxReceipt(f).toMap());}catch(IllegalArgumentException expected){refused=true;}
                check(refused,"ordinary AX factory aliased history");f.dispose();
            });
            axCase("history_recomputed_proof_not_trusted_string",()->historyReceiptRefused(r->r.getJSONObject("input_history").getJSONObject("comparison").put("whole_graph_equal",true)));
            axCase("history_type_cannot_claim_current",()->historyReceiptRefused(r->r.put("published_pair_is_current_tree_claimed",true)));
            axCase("history_missing_complete_child_census_rejected",()->historyReceiptRefused(r->r.getJSONObject("second").put("child_slots_omitted",1)));
            axCase("history_visual_misuse_rejected",()->historyReceiptRefused(r->r.put("visual_model",true)));
            axCase("history_boundary_event_cannot_be_relabelled_as_content",()->historyReceiptRefused(r->r.getJSONObject("second_completed_watermark").put("boundary",1)));
        }finally{
            SnapshotChecks.finish(args[0]);observationIo.executor.shutdownNow();
            expect(observationIo.executor.awaitTermination(4,TimeUnit.SECONDS),"history worker executor leaked");
        }
    }
