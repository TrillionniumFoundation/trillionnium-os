            Fixture f=new Fixture("clocks");Map<String,Object> t=clocks(f);t.put("capture_requested_elapsed_ms",1081L);rejects(()->proof(f,nativeAxCensus(f.graph),t));
            Map<String,Object> late=clocks(f);late.put("proof_copied_elapsed_ms",2000L);rejects(()->proof(f,nativeAxCensus(f.graph),late));
