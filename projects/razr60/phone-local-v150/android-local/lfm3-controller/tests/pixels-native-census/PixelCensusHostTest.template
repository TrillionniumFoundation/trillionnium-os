            Read(Path p,byte[] b)throws IOException {path=p;bytes=b;java.nio.file.attribute.BasicFileAttributes a=Files.readAttributes(p,java.nio.file.attribute.BasicFileAttributes.class,LinkOption.NOFOLLOW_LINKS);fileKey=a.fileKey();size=a.size();}
