        test("bounded_original_post_effect_window_recheck_preserves_history",()->{
            Fixture f=new Fixture("recheck");f.persist();f.product.postEffectPublicationRechecks=1;f.product.firstPublicationCheckStartedAt=1160;f.product.firstPublicationCheckCompletedAt=1170;
            f.product.publicationCheckStartedAt=1185;f.product.publicationCheckCompletedAt=1190;PhoneObservation o=f.publish();
            SnapshotChecks.check(o.capturedElapsedMillis==1080&&o.screenshotSha256.equals(f.product.digest),"recheck does not refresh old capture");
            f.product.firstPublicationCheckStartedAt=1161;rejects(f::publish);
        });
        test("PNG_full_read_requires_original_dimensions_signature_CRC_and_IEND",()->{
            Fixture f=new Fixture("png");byte[] b=Files.readAllBytes(f.product.path.toPath());
            rejects(()->PixelNativeCensusEvidence.readPng(new ByteArrayInputStream(b),101,200));
            byte[] bad=b.clone();bad[29]^=1;rejects(()->PixelNativeCensusEvidence.readPng(new ByteArrayInputStream(bad),100,200));
            byte[] truncated=Arrays.copyOf(b,b.length-1);rejects(()->PixelNativeCensusEvidence.readPng(new ByteArrayInputStream(truncated),100,200));
            byte[] signature=b.clone();signature[0]=0;rejects(()->PixelNativeCensusEvidence.readPng(new ByteArrayInputStream(signature),100,200));
        });
        test("PNG_no_progress_and_excessive_original_bytes_refused",()->{
            rejects(()->PixelNativeCensusEvidence.readPng(new InputStream(){public int read(){return 0;}public int read(byte[] b,int o,int l){return 0;}},100,200));
            rejects(()->PixelNativeCensusEvidence.readPng(new InputStream(){int left=PixelNativeCensusEvidence.MAX_PNG_BYTES+1;public int read(){if(left--<=0)return -1;return 0;}
                public int read(byte[] b,int o,int l){if(left<=0)return -1;int n=Math.min(left,l);Arrays.fill(b,o,o+n,(byte)0);left-=n;return n;}},100,200));
        });
        test("complete_original_receipt_and_projection_are_deep_immutable",()->{
            Fixture f=new Fixture("immutable");f.persist();byte[] bytes=f.product.pixelNativeCensus.receiptBytes();bytes[0]^=1;
            SnapshotChecks.check(!Arrays.equals(bytes,f.product.pixelNativeCensus.receiptBytes()),"caller cannot mutate raw receipt");
            try{obj(f.product.pixelNativeCensus.completeReceipt(),"census").put("visited",1);throw new AssertionError("mutable census");}
            catch(UnsupportedOperationException expected){SnapshotChecks.check(true,"immutable census");}
        });
        test("unpublished_owned_companion_is_cleaned_but_published_original_is_retained",()->{
            Fixture f=new Fixture("cleanup");f.persist();File receipt=f.product.pixelNativeCensusPath;f.product.close();
            SnapshotChecks.check(!receipt.exists(),"unpublished owned receipt removed");
            Fixture keep=new Fixture("published");keep.persist();File original=keep.product.pixelNativeCensusPath;keep.product.published=true;keep.product.close();
            SnapshotChecks.check(original.isFile(),"published original retained");
        });
