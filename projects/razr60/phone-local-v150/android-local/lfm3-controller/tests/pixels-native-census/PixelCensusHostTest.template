    @SuppressWarnings("unchecked") static void originalPhoneCases()throws Exception{
        java.lang.reflect.Method binding=NativeAxConsumersHostTest.class.getDeclaredMethod("binding",WindowOwnership.class);binding.setAccessible(true);
        Map<String,Object> b=(Map<String,Object>)binding.invoke(null,new Object[]{null});
        java.lang.reflect.Method captured=NativeAxConsumersHostTest.class.getDeclaredMethod("capture",Map.class);captured.setAccessible(true);
        ObservationCaptureEvidence c=(ObservationCaptureEvidence)captured.invoke(null,b);
        ActualAxPhoneChecks.run(c,new JSONObject(b));ObservationEvidenceHost.run();
    }
    public static void main(String[] args)throws Exception {
        root=new File(args[1]);Files.createDirectories(root.toPath());
        try{if("original".equals(args[0]))originalPhoneCases();else cases();}
        finally{SnapshotChecks.finish(args[2]);}
    }
