            Fixture f=new Fixture("published-clock");f.persist();Map<String,Object> m=mutable(f.product.captureEvidence(1200));m.put("capture_age_at_publication_ms",0L);
            rejects(()->f.publish(f.product.pixelNativeCensus,m,f.graph.rows,f.product.digest));
