            pass("component_proof_and_model_claim_do_not_promote_partial_terminal");
        }
        try(Scenario s=new Scenario("cleanup-unknown",result("cancelled",false,false,false))){
            s.complete();JSONObject v=s.committed();require(s.session.blocked&&!v.getBoolean("cleanup_known"),"unknown cleanup became clean");
            Session restored=new Session(s.files);try{restored.recoverPreviousSession();require(restored.blocked,"unknown cleanup recovered clean");}finally{restored.close();}
