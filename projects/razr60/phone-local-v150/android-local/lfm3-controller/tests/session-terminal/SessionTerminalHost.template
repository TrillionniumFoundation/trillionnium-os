            android.util.AtomicFile.afterCommit=new Runnable(){public void run(){try{
                JSONObject changed=new JSONObject(s.result.toString());changed.put("summary","changed after binding");write(s.resultPath,bytes(changed));
            }catch(Exception e){throw new RuntimeException(e);}}};
