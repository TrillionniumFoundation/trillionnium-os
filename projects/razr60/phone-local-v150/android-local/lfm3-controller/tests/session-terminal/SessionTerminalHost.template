        try(Scenario s=new Scenario("atomic-publish-failure",result("failed",false,false,true))){
            android.util.AtomicFile.rejectRename=true;s.complete();s.requireFailedUnchanged();pass("real_session_atomic_publish_failure_preserves_old_record_and_failure_barrier");
        }
