            s.session.state="replacement state";s.session.controller.id=s.session.taskId;release.countDown();s.session.flush();s.session.main.drain();
            JSONObject v=s.committed();require(v.getString("task_id").equals(TASK)&&v.getString("instruction_sha256").equals(OWNER)
                    &&v.getString("task_authorization_sha256").equals(AUTH)&&v.getString("state").equals("完整终态记录"),"worker borrowed later session identity");
            pass("queued_terminal_uses_one_captured_task_owner_authority_and_summary_snapshot");
        }
        try(Scenario s=new Scenario("key-order",result("failed",false,false,true))){
            write(s.resultPath,bytes(reversed(s.result)));s.complete();require(!s.session.isBlocked(),"key order affected semantic binding");
            JSONObject one=new JSONObject().put("a",1).put("b",new JSONArray().put("x").put(false));
            JSONObject two=new JSONObject().put("b",new JSONArray().put("x").put(false)).put("a",1.0);
            require(SessionTerminalEvidence.semanticSha(one).equals(SessionTerminalEvidence.semanticSha(two)),"equivalent number spelling/key order differs");
            require(!SessionTerminalEvidence.semanticSha(one).equals(SessionTerminalEvidence.semanticSha(new JSONObject().put("a","1").put("b",new JSONArray().put("x").put(false)))),"string/number collision");
            pass("semantic_digest_preserves_types_array_order_and_equivalent_object_number_semantics");
        }
        String[] mismatches={"task_id","task_authorization_sha256","status","summary","steps","model_reported_success","completion_verified","cleanup_known","owner_sha256","completion_payload"};
        for(final String key:mismatches){
            try(Scenario s=new Scenario("mismatch-"+key,result("failed",false,false,true))){
                JSONObject changed=new JSONObject(s.result.toString());
                if(key.equals("owner_sha256")||key.equals("completion_payload")){
                    JSONObject comp=changed.getJSONObject("completion_evidence");
                    if(key.equals("owner_sha256"))comp.put(key,repeat("e",64));else comp.put("unexpected_extra","changed");
                    changed.put("completion_evidence",comp);
                }else if(key.equals("task_id"))changed.put(key,repeat("e",32));
                else if(key.equals("task_authorization_sha256"))changed.put(key,repeat("e",64));
                else if(key.equals("steps"))changed.put(key,12);
                else if(key.equals("model_reported_success")||key.equals("completion_verified")||key.equals("cleanup_known"))changed.put(key,!changed.getBoolean(key));
                else changed.put(key,"different");
                write(s.resultPath,bytes(changed));s.complete();s.requireFailedUnchanged();pass("mismatched_"+key+"_fails_closed_before_session_commit");
            }
        }
        String[] invalid={"missing","symlink","hardlink","mode","trailing-json","wrong-evidence-task"};
        for(String kind:invalid){
            try(Scenario s=new Scenario("invalid-"+kind,result("failed",false,false,true))){
                if(kind.equals("missing"))Files.delete(s.resultPath);
                else if(kind.equals("symlink")){Path target=s.files.resolve("outside-result.json");Files.move(s.resultPath,target);Files.createSymbolicLink(s.resultPath,target);}
                else if(kind.equals("hardlink"))Files.createLink(s.files.resolve("second-link.json"),s.resultPath);
                else if(kind.equals("mode"))android.system.Os.chmod(s.resultPath.toString(),0644);
                else if(kind.equals("trailing-json"))write(s.resultPath,(s.result.toString()+"{}").getBytes(StandardCharsets.UTF_8));
                else s.session.lastResult.evidenceDirectory=s.files.resolve("control-tasks/"+repeat("e",32)).toFile();
                s.complete();s.requireFailedUnchanged();pass("invalid_"+kind+"_cannot_supply_terminal_reference");
