        try(final Scenario s=new Scenario("captured-state",result("failed",false,false,true))){
            final CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
            s.session.io.execute(new Runnable(){public void run(){entered.countDown();try{release.await();}catch(InterruptedException e){Thread.currentThread().interrupt();}}});
