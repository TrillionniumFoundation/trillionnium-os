            byte[] rejected=Files.readAllBytes(s.sessionPath);
            Session restored=new Session(s.files);try{restored.recoverPreviousSession();require(restored.blocked,"changed reference allowed startup");
                require(Files.exists(s.files.resolve("control-session.interrupted.json")),"normal recovery latch missing");
                Path archive=s.files.resolve("session-recovery/control-session.json."+sha(rejected)+".json");
                require(Arrays.equals(rejected,Files.readAllBytes(archive)),"normal recovery did not preserve exact failed record");
                require(restored.controller.starts==0,"failed reference replayed task");
            }finally{restored.close();}
            pass("result_changed_after_session_commit_is_rejected_and_normally_archived_on_startup");
