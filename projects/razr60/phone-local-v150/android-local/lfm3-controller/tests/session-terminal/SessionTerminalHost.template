            try(Scenario s=new Scenario("sync-failure-"+stage,result("failed",false,false,true))){
                android.system.Os.failFsyncPath=(stage.equals("file")?s.resultPath:stage.equals("task_directory")?s.task:stage.equals("tasks_directory")?s.task.getParent():s.files).toString();
                s.complete();s.requireFailedUnchanged();pass("actual_host_"+stage+"_sync_failure_retains_journal_barrier");
            }
