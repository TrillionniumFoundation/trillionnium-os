        for(String kind:new String[]{"missing_result","digest_changed","unknown_reference_schema","missing_reference"}){
            try(Scenario s=new Scenario("restart-"+kind,result("failed",false,false,true))){
                s.complete();require(!s.session.isBlocked(),"initial commit failed");
                if(kind.equals("missing_result"))Files.delete(s.resultPath);
                else if(kind.equals("digest_changed")){JSONObject changed=new JSONObject(s.result.toString());changed.put("extra","changed");write(s.resultPath,bytes(changed));}
                else{JSONObject v=s.committed();if(kind.equals("unknown_reference_schema")){
                        JSONObject ref=v.getJSONObject("task_result_reference");ref.put("schema","unknown");v.put("task_result_reference",ref);
                    }else{JSONObject without=new JSONObject();Iterator<String> names=v.keys();while(names.hasNext()){String key=names.next();if(!key.equals("task_result_reference"))without.put(key,v.get(key));}v=without;}write(s.sessionPath,bytes(v));}
                Session restored=new Session(s.files);try{restored.recoverPreviousSession();require(restored.blocked&&restored.controller.starts==0,"invalid new reference restored clean");}finally{restored.close();}
                pass("startup_"+kind+"_uses_existing_interruption_barrier_without_replay");
            }
        }
        try(Scenario s=new Scenario("legacy-clean",result("failed",false,false,true))){
            JSONObject prior=oldRunning().put("status","failed").put("running",false);
            write(s.sessionPath,bytes(prior));Session restored=new Session(s.files);
            try{restored.recoverPreviousSession();require(!restored.blocked&&restored.controller.starts==0,"legacy clean record was not compatible");}finally{restored.close();}
            pass("existing_legacy_clean_session_remains_compatible_without_new_reference");
        }

        for(String status:new String[]{"not_started","cancelled_before_start"}){
            try(Scenario s=new Scenario("pre-start-"+status,result("failed",false,false,true))){
                s.session.lastResult=null;s.session.taskId=null;Files.delete(s.resultPath);
                s.session.state="任务尚未启动";s.session.persist(status,true);s.session.flush();s.session.main.drain();
                JSONObject v=s.committed();require(!s.session.isBlocked()&&v.getString("status").equals(status)
                        &&!v.has("terminal_evidence_schema")&&!v.has("task_result_reference"),"pre-start failure required task result");
                pass(status+"_keeps_original_small_inline_format_without_result_reference");
            }
        }
        try(Scenario s=new Scenario("early-failure-no-result",result("failed",false,false,true))){
            s.session.lastResult.completionEvidence=Collections.emptyMap();s.session.lastResult.evidenceDirectory=null;
            Files.delete(s.resultPath);s.complete();JSONObject v=s.committed();
            require(!s.session.isBlocked()&&!v.has("terminal_evidence_schema")&&v.getString("status").equals("failed"),"small early failure gained a new required contract");
            pass("small_early_failure_without_contract_or_result_retains_original_inline_behavior");
        }
        try(Scenario s=new Scenario("platform-display-alias",result("failed",false,false,true))){
            s.session.lastResult.evidenceDirectory=new File("/data/data/example.test/files/control-tasks/"+TASK);
            s.complete();require(!s.session.isBlocked(),"legacy Android display path alias rejected");
            require(s.committed().getJSONObject("task_result_reference").getString("relative_path").equals("control-tasks/"+TASK+"/result.json"),"display path supplied binding authority");
            pass("legacy_display_path_alias_is_never_opened_and_fixed_relative_reference_is_used");
        }
        try(Scenario s=new Scenario("context-parent-alias",result("failed",false,false,true))){
            Path alias=root.resolve("context-alias");Files.createSymbolicLink(alias,s.files.getParent());
            Context c=new Context(alias.resolve(s.files.getFileName()).toFile());
            QualificationScopeConfig.FilesRoot resolved=new QualificationScopeConfig.FilesRoot(c);
            require(resolved.path.equals(s.files.toFile()),"trusted framework parent alias did not canonicalize");
            Path directAlias=root.resolve("forbidden-files-alias");Files.createSymbolicLink(directAlias,s.files);
            final Context aliasedContext=new Context(directAlias.toFile());
            rejects(new Checked(){public void run()throws Exception{new QualificationScopeConfig.FilesRoot(aliasedContext);}},"files-directory symlink admitted");
            pass("trusted_context_parent_alias_accepted_but_files_directory_alias_still_refused");
        }
        try(Scenario s=new Scenario("fd-repeat",result("failed",false,false,true))){
            s.complete();JSONObject v=s.committed();SessionTerminalEvidence.verify(v,s.files.toFile(),android.os.Process.myUid());
            int baseline=android.system.Os.liveDescriptors();long nativeBaseline=descriptorCount();
            for(int i=0;i<24;i++)SessionTerminalEvidence.verify(v,s.files.toFile(),android.os.Process.myUid());
            require(android.system.Os.liveDescriptors()==baseline&&descriptorCount()==nativeBaseline,"repeated verify leaked owned descriptors");
            pass("repeated_bind_and_verify_do_not_grow_real_or_fixture_owned_file_descriptors");
        }
        try(Scenario s=new Scenario("fd-close-failure",result("failed",false,false,true))){
            android.system.Os.failClosePath=s.resultPath.toString();s.complete();
            if(Boolean.getBoolean("hepta.fixture.nonowning")){
                s.requireFailedUnchanged();require(s.session.log.contains("injected descriptor close"),"descriptor close error lost");
                require(android.system.Os.liveDescriptors()==0,"close-error fixture left descriptors");
                pass("android_nonowning_stream_explicit_descriptor_close_failure_is_not_silenced");
            }else require(!s.session.isBlocked(),"host owning stream double-closed descriptor");
        }
        if(Boolean.getBoolean("hepta.fixture.nonowning")){
            try(Scenario s=new Scenario("both-close-failures",result("failed",false,false,true))){
                android.system.Os.failInputClosePath=s.resultPath.toString();android.system.Os.failClosePath=s.resultPath.toString();s.complete();s.requireFailedUnchanged();
                require(s.session.log.contains("injected input close")&&s.session.log.contains("injected descriptor close")
                        &&s.session.log.contains("Suppressed"),"close error cause/suppressed chain lost");
                require(android.system.Os.liveDescriptors()==0,"input close failure prevented owned descriptor close");
                pass("android_nonowning_input_and_descriptor_close_errors_preserve_first_and_suppressed_causes");
            }
        }

        JSONArray actualRecords=new JSONArray();
        if(args.length==2){
            JSONArray requests=read(Paths.get(args[1])).getJSONArray("records");
            for(int i=0;i<requests.length();i++){
                JSONObject request=requests.getJSONObject(i);byte[] actual=Files.readAllBytes(Paths.get(request.getString("result_path")));
                JSONObject record=new JSONObject(new String(actual,StandardCharsets.UTF_8)),owner=read(Paths.get(request.getString("owner_path")));
                try(final Scenario s=new Scenario("sealed-actual-"+i,record)){
                    require(owner.getString("task_id").equals(record.getString("task_id"))&&record.getString("task_id").equals(request.getString("task_id")),"actual task subject mismatch");
                    require(owner.getString("instruction_utf8_sha256").equals(record.getJSONObject("completion_evidence").getString("owner_sha256")),"actual owner mismatch");
                    require(owner.getString("task_authorization_sha256").equals(record.getString("task_authorization_sha256")),"actual authority mismatch");
                    write(s.resultPath,actual);
                    final byte[] legacy=s.session.legacySnapshotSession(record.getString("status"),record.getBoolean("cleanup_known"));
                    boolean oversized=bytes(new JSONObject(new String(legacy,StandardCharsets.UTF_8))
                            .put("background_lease_unreleased",false).put("web_helper_lease_unreleased",false)).length>65536;
                    if(oversized)rejects(new Checked(){public void run()throws Exception{s.session.legacyWriteSessionSnapshot(legacy,s.session.readLeaseState());}},"actual legacy writer unexpectedly passed");
                    else s.session.legacyWriteSessionSnapshot(legacy,s.session.readLeaseState());
                    s.complete();require(!s.session.isBlocked(),"actual sealed terminal did not persist: "+s.session.log);
                    JSONObject v=s.committed();require(v.getString("status").equals(record.getString("status"))
                            &&v.getBoolean("completion_verified")==record.getBoolean("completion_verified")
                            &&v.getBoolean("model_reported_success")==record.getBoolean("model_reported_success"),"actual outcome changed");
                    require(v.has("task_result_reference")==oversized,"actual inline/projection choice differs");
                    if(oversized)require(v.getJSONObject("task_result_reference").getString("sha256").equals(sha(actual)),"actual complete bytes digest differs");
                    require(Arrays.equals(actual,Files.readAllBytes(s.resultPath)),"actual complete result altered");
                    actualRecords.put(new JSONObject().put("task_id",record.getString("task_id")).put("status",record.getString("status"))
                            .put("result_bytes",actual.length).put("result_sha256",sha(actual)).put("legacy_snapshot_bytes",legacy.length)
                            .put("projection_required",oversized).put("new_session_bytes",Files.size(s.sessionPath))
                            .put("outcome_preserved",true).put("complete_result_unchanged",true));
                    pass("sealed_actual_"+record.getString("status")+"_"+i+"_preserves_outcome_and_exact_complete_result");
                }
            }
        }
        JSONObject output=new JSONObject().put("schema","hepta.session-terminal-host.v1").put("all_pass",true)
                .put("cases",passed.size()).put("assertions",assertions).put("case_names",new JSONArray(passed))
                .put("real_host_file_reads_writes_sync_and_atomic_moves",true).put("android_io_and_uid_are_host_adapters",true)
                .put("ordinary_recovery_method_executed",true).put("owner_acknowledgement_transactions_not_executed",true)
                .put("android_nonowning_stream_semantics",Boolean.getBoolean("hepta.fixture.nonowning"))
                .put("actual_private_records",actualRecords).put("phone_operations",0);
        System.out.println(output.toString());
    }
    static long descriptorCount()throws Exception {
        try(java.util.stream.Stream<Path> values=Files.list(Paths.get("/proc/self/fd"))){return values.count();}
    }
}
