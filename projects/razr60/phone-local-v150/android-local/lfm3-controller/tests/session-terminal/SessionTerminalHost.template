    static final class Scenario implements AutoCloseable {
        final Path files,task,resultPath,sessionPath;final Session session;final JSONObject result;final byte[] before;
        Scenario(String name,JSONObject result)throws Exception {
            files=root.resolve(name);Files.createDirectory(files);android.system.Os.chmod(files.toString(),0700);
            this.result=result;String id=result.getString("task_id");task=files.resolve("control-tasks").resolve(id);
            Files.createDirectories(task);android.system.Os.chmod(task.getParent().toString(),0700);android.system.Os.chmod(task.toString(),0700);
            resultPath=task.resolve("result.json");write(resultPath,bytes(result));sessionPath=files.resolve("control-session.json");
            before=bytes(oldRunning());write(sessionPath,before);session=new Session(files);configure();
        }
        void configure()throws Exception {
            Session s=session;s.taskId=result.getString("task_id");s.origin="user_button";
            s.instructionSha=result.getJSONObject("completion_evidence").getString("owner_sha256");
            s.taskAuthorization=new TaskAuthorization(result.getString("task_authorization_sha256"),s.instructionSha);
            s.controller.id=s.taskId;s.controller.running=false;
            LocalTaskController.TaskResult r=new LocalTaskController.TaskResult();
            r.taskId=s.taskId;r.status=result.getString("status");r.summary=result.getString("summary");r.steps=result.getInt("steps");
            r.modelReportedSuccess=result.getBoolean("model_reported_success");r.cleanupKnown=result.getBoolean("cleanup_known");
            r.completionVerified=result.getBoolean("completion_verified");r.evidenceDirectory=task.toFile();
            r.displaySummary=result.has("display_summary")?result.getString("display_summary"):r.summary;
            if(result.has("user_explanation"))r.userExplanation=map(result.getJSONObject("user_explanation"));
            r.expectedScopeSha256=result.isNull("expected_scope_sha256")?null:result.getString("expected_scope_sha256");
            r.actualScopeSha256=result.isNull("actual_scope_sha256")?null:result.getString("actual_scope_sha256");
            r.completionEvidence=map(result.getJSONObject("completion_evidence"));s.lastResult=r;
        }
        void complete()throws Exception {session.receiveFinished(session.lastResult);session.flush();session.main.drain();}
        JSONObject committed()throws Exception {return read(sessionPath);}
        void requireFailedUnchanged()throws Exception {
            require(session.blocked&&session.journalQueue.failed()&&!session.journalQueue.pending(),"failed writer lost barrier");
            require(Arrays.equals(before,Files.readAllBytes(sessionPath)),"failed reference changed previous session");
            require(session.log.contains("会话记录保存未确认"),"original failure handling was bypassed");
            require(session.controller.starts==0,"failure started a task");
        }
        public void close()throws Exception {session.close();android.system.Os.reset();android.util.AtomicFile.reset();}
    }

    public static void main(String[] args)throws Exception {
        root=Paths.get(args[0]);Files.createDirectory(root);
        try(final Scenario s=new Scenario("legacy-overflow",result("failed",false,false,true))){
            final byte[] full=s.session.legacySnapshotSession("failed",true);
            require(full.length>65536,"synthetic actual-equivalent payload is not oversized");
            rejects(new Checked(){public void run()throws Exception{s.session.legacyWriteSessionSnapshot(full,s.session.readLeaseState());}},"R13 full embedding unexpectedly passed");
            require(Arrays.equals(s.before,Files.readAllBytes(s.sessionPath)),"old overlimit write replaced base");
            require(!Files.exists(Paths.get(s.sessionPath+".new")),"old overlimit write reached AtomicFile");
            pass("pinned_R13_snapshot_and_writer_reproduce_oversize_refusal_before_atomic_write");
        }
        String[] statuses={"failed","partial","model_reported_done","controller_verified_done","cancelled"};
        for(String status:statuses){
            boolean verified=status.equals("controller_verified_done"),claim=status.equals("model_reported_done");
            try(Scenario s=new Scenario("status-"+status,result(status,verified,claim,true))){
                byte[] original=Files.readAllBytes(s.resultPath);s.complete();JSONObject v=s.committed();
                require(!s.session.isBlocked(),"valid terminal blocked: "+s.session.log);
                require(v.getString("status").equals(status)&&v.getBoolean("completion_verified")==verified
                        &&v.getBoolean("model_reported_success")==claim&&v.getBoolean("goal_independently_verified")==verified,"terminal facts changed");
                require(Files.size(s.sessionPath)<65536,"session cap not satisfied");
                require(Arrays.equals(original,Files.readAllBytes(s.resultPath)),"complete task evidence was modified");
                JSONObject ref=v.getJSONObject("task_result_reference");
                require(ref.getLong("bytes")==original.length&&ref.getString("sha256").equals(sha(original)),"unbound bytes/digest reference");
                require(!Files.exists(Paths.get(s.sessionPath+".new"))&&!Files.exists(Paths.get(s.sessionPath+".bak")),"commit sidecar remains");
                Session restored=new Session(s.files);try{restored.recoverPreviousSession();
                    require(!restored.blocked&&restored.controller.starts==0,"verified terminal did not recover without replay");
                }finally{restored.close();}
                pass("oversize_"+status+"_persists_exact_outcome_and_restarts_without_replay");
            }
        }
        for(String code:new String[]{"native_xiaomi_login_page","APP_ALREADY_ON_MAIN_DISPLAY","goal_verifier_unavailable"}){
            for(boolean large:new boolean[]{false,true}){
                try(Scenario s=new Scenario("cold-presentation-"+code+"-"+large,explainedResult(code,large))){
                    byte[] original=Files.readAllBytes(s.resultPath);s.complete();JSONObject committed=s.committed();
                    require(committed.getString("state").equals(s.result.getString("summary"))
                            &&committed.getString("display_summary").equals(s.result.getString("display_summary")),"display persistence changed original summary");
                    require("failed".equals(committed.getString("status"))&&committed.getBoolean("cleanup_known")
                            &&!committed.getBoolean("completion_verified"),"display persistence changed terminal facts");
                    require(SessionTerminalEvidence.referenced(committed)==large,"inline/reference boundary not exercised");
                    byte[] journal=Files.readAllBytes(s.sessionPath);
                    // Fresh application session, with no TaskResult and no prior
                    // controller. All displayed data must come from disk.
                    Session restored=new Session(s.files);restored.controller=null;
                    try{restored.recoverPreviousSession();
                        require(!restored.blocked&&restored.lastResult==null&&restored.controller==null,"cold display recreated task execution state");
                        require(restored.state.contains("上次任务结果：\n"+s.result.getString("display_summary")),"new session did not restore durable explanation");
                        require(Arrays.equals(journal,Files.readAllBytes(s.sessionPath))&&Arrays.equals(original,Files.readAllBytes(s.resultPath)),"cold display rewrote original records");
                    }finally{restored.close();}
                    pass("fresh_session_restores_"+code+(large?"_from_bound_reference":"_from_inline_terminal")+"_without_result_or_controller");
                }
            }
        }
        String[] presentationFaults={"schema","task_id","owner_sha256","code","source","message","changes_task_status","grants_tool_authority",
                "business_verified","model_summary_preserved","display_summary","missing_display","missing_reason"};
        for(String fault:presentationFaults){
            try(Scenario s=new Scenario("cold-presentation-mismatch-"+fault,explainedResult("native_xiaomi_login_page",false))){
                s.complete();JSONObject changed=s.committed();JSONObject reason=changed.getJSONObject("user_explanation");
                if(fault.equals("display_summary"))changed.put(fault,"unbound replacement");
                else if(fault.equals("missing_display"))changed.put("display_summary",(Object)null);
                else if(fault.equals("missing_reason"))changed.put("user_explanation",(Object)null);
                else{
                    if(fault.equals("changes_task_status")||fault.equals("grants_tool_authority")||fault.equals("business_verified"))reason.put(fault,true);
                    else if(fault.equals("model_summary_preserved"))reason.put(fault,false);
                    else reason.put(fault,"different");
                    changed.put("user_explanation",reason);
                }
                write(s.sessionPath,bytes(changed));Session restored=new Session(s.files);restored.controller=null;
                try{restored.recoverPreviousSession();
                    require(!restored.blocked&&restored.lastResult==null&&restored.controller==null,"display mismatch changed startup admission");
                    require(!restored.state.contains("上次任务结果")&&!restored.state.contains("持久化说明测试"),"mismatched display was trusted");
                }finally{restored.close();}
                pass("cold_presentation_"+fault+"_mismatch_is_hidden_without_changing_recovery");
            }
        }
        for(String barrier:new String[]{"new_sidecar","interruption_latch"}){
            try(Scenario s=new Scenario("cold-presentation-barrier-"+barrier,explainedResult("native_xiaomi_login_page",false))){
                s.complete();write(barrier.equals("new_sidecar")?Paths.get(s.sessionPath+".new"):
                        s.files.resolve("control-session.interrupted.json"),new byte[0]);
                Session restored=new Session(s.files);restored.controller=null;
                try{restored.recoverPreviousSession();
                    require(restored.blocked&&restored.lastResult==null&&restored.controller==null,"presentation bypassed startup barrier");
                    require(!restored.state.contains("持久化说明测试")&&restored.state.contains("暂停新任务"),"old presentation hid current recovery barrier");
                }finally{restored.close();}
                pass("cold_"+barrier+"_keeps_current_interruption_state_above_saved_presentation");
            }
        }
        try(Scenario s=new Scenario("partial-component-proof",result("partial",false,true,true))){
            JSONObject changed=new JSONObject(s.result.toString());changed.getJSONObject("completion_evidence").put("completion_verified",true);
            // The JSON fixture wraps parsed maps; replace the changed object explicitly.
            JSONObject completion=changed.getJSONObject("completion_evidence");completion.put("completion_verified",true);s.result.put("completion_evidence",completion);
            write(s.resultPath,bytes(s.result));s.configure();s.complete();
