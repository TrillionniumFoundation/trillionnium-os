    interface Checked {void run()throws Exception;}
    static void require(boolean value,String why){assertions++;if(!value)throw new AssertionError(why);}
    static void pass(String name){passed.add(name);}
    static String repeat(String text,int count){StringBuilder b=new StringBuilder();for(int i=0;i<count;i++)b.append(text);return b.toString();}
    static String sha(byte[] bytes)throws Exception {byte[] h=MessageDigest.getInstance("SHA-256").digest(bytes);StringBuilder b=new StringBuilder();for(byte v:h)b.append(String.format(Locale.ROOT,"%02x",v&255));return b.toString();}
    static void rejects(Checked work,String why)throws Exception {boolean refused=false;try{work.run();}catch(Exception expected){refused=true;}require(refused,why);}
    static byte[] bytes(JSONObject value){return value.toString(2).getBytes(StandardCharsets.UTF_8);}
    static JSONObject read(Path path)throws Exception{return new JSONObject(new String(Files.readAllBytes(path),StandardCharsets.UTF_8));}
    static void write(Path path,byte[] bytes)throws Exception {
        Files.createDirectories(path.getParent());try(FileOutputStream out=new FileOutputStream(path.toFile())){out.write(bytes);out.getFD().sync();}
        android.system.Os.chmod(path.toString(),0600);
    }
    static Map<String,Object> map(JSONObject value)throws Exception {Map<String,Object> out=new LinkedHashMap<String,Object>();Iterator<String> names=value.keys();
        while(names.hasNext()){String key=names.next();out.put(key,value.get(key));}return out;}
    static JSONObject reversed(JSONObject value)throws Exception {ArrayList<String> keys=new ArrayList<String>();Iterator<String> it=value.keys();while(it.hasNext())keys.add(it.next());Collections.reverse(keys);
        JSONObject result=new JSONObject();for(String key:keys){Object v=value.get(key);result.put(key,v instanceof JSONObject?reversed((JSONObject)v):v);}return result;}
    static JSONObject result(String status,boolean verified,boolean claim,boolean clean)throws Exception {
        JSONArray evidence=new JSONArray();
        for(int i=0;i<96;i++)evidence.put(new JSONObject().put("ordinal",i).put("observed_text",repeat("公开测试记录",200)));
        JSONObject completion=new JSONObject().put("schema","hepta.task-completion.v1").put("kind","native_app")
                .put("owner_sha256",OWNER).put("contract_sha256",CONTRACT).put("completion_verified",verified)
                .put("business_verified",verified).put("terminal_binding_and_cleanup_verified",verified)
                .put("native_app_session",new JSONObject().put("observations",evidence))
                .put("integer_and_decimal_semantics",new JSONArray().put(1).put(2.50));
        return new JSONObject().put("task_id",TASK).put("status",status).put("summary","完整终态记录")
                .put("steps",11).put("model_reported_success",claim).put("completion_verified",verified)
                .put("goal_independently_verified",verified).put("cleanup_known",clean)
                .put("expected_scope_sha256",JSONObject.NULL).put("actual_scope_sha256",JSONObject.NULL)
                .put("task_authorization_sha256",AUTH).put("completion_evidence",completion)
                .put("external_model",false).put("automatic_replay",false);
    }
    static JSONObject oldRunning()throws Exception {
        return new JSONObject().put("schema","hepta.local-session.v1").put("status","running").put("task_id",TASK)
                .put("origin","user_button").put("instruction_sha256",OWNER).put("debug_nonce_sha256",JSONObject.NULL)
                .put("pending",false).put("running",true).put("blocked",false).put("cleanup_known",true)
                .put("app_uid",android.os.Process.myUid()).put("updated_wall_ms",1L).put("state","旧任务仍在运行")
                .put("external_model",false).put("automatic_resume",false);
    }
    /** Explicit presentation fixture only. Provider truth is tested by the full
     * actual-controller gate; these cases exercise durable capture and startup. */
    static JSONObject explainedResult(String code,boolean large)throws Exception {
        JSONObject value=result("failed",false,false,true);
        String source="native_xiaomi_login_page".equals(code)?"version_bound_native_provider_terminal":
                "APP_ALREADY_ON_MAIN_DISPLAY".equals(code)?"owned_background_broker_refusal":"completion_contract";
        String message="持久化说明测试："+code;
        JSONObject reason=new JSONObject().put("schema","hepta.task-user-explanation.v1").put("task_id",TASK)
                .put("owner_sha256",OWNER).put("code",code).put("source",source).put("message",message)
                .put("changes_task_status",false).put("grants_tool_authority",false).put("business_verified",false)
                .put("model_summary_preserved",true);
        value.put("user_explanation",reason).put("display_summary",message+"\n\n任务记录："+value.getString("summary"));
        if(!large){JSONObject completion=value.getJSONObject("completion_evidence");
            completion.put("native_app_session",new JSONObject());value.put("completion_evidence",completion);}
        return value;
    }
    static final class Main implements Executor {
        final ConcurrentLinkedQueue<Runnable> tasks=new ConcurrentLinkedQueue<Runnable>();
        public void execute(Runnable runnable){tasks.add(runnable);}
        void removeCallbacks(Runnable runnable){tasks.remove(runnable);}
        void drain(){Runnable r;while((r=tasks.poll())!=null)r.run();}
    }
