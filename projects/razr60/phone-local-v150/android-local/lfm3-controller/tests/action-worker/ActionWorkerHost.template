    private static final class BlockingProcess extends Process {
        final CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1);
        final AtomicInteger destroys=new AtomicInteger();
        volatile boolean alive=true;
        public java.io.OutputStream getOutputStream(){return new java.io.ByteArrayOutputStream();}
        public java.io.InputStream getInputStream(){return new ByteArrayInputStream(new byte[0]);}
        public java.io.InputStream getErrorStream(){return new ByteArrayInputStream(new byte[0]);}
        public int waitFor()throws InterruptedException{await(release);return 0;}
        public int exitValue(){if(alive)throw new IllegalThreadStateException("host process live");return 0;}
        @Override public boolean isAlive(){return alive;}
        public void destroy(){destroys.incrementAndGet();alive=false;entered.countDown();try{await(release);}catch(InterruptedException error){Thread.currentThread().interrupt();throw new IllegalStateException(error);}}
    }
