        void observe(String id,File directory,Cancellation cancel,long deadline,ObservationCallback callback)throws Exception{
            observeCalls++;host.events.add("old_read_submitted");firstDeadline=deadline;firstCancellation=cancel;firstCallback=callback;
            long started=SystemClock.elapsedRealtime();if("timeout".equals(firstMode)){clock(deadline);return;}
            clock(firstAt>=0?firstAt:Math.min(started+10200,deadline-1));
            if("success".equals(firstMode)){callback.onObservation(fresh());return;}
            if("error".equals(firstMode)){callback.onError("original ordinary read failure");return;}
            issued=mint(id,started,deadline);if(beforeFirstCallback!=null)beforeFirstCallback.run();
            callback.onReadRetryAvailable("original bounded transient read failure",issued);
            if(duplicateFirst)callback.onObservation(new PhoneObservation(host.before.nativeFrame));
        }
        void observeAfterTransientFailure(String id,File directory,Cancellation cancel,long deadline,ObservationCallback callback,NativeObservationRetryProof proof)throws Exception{
            retryCalls++;host.events.add("new_read_submitted");retryDeadline=deadline;retryCancellation=cancel;retryCallback=callback;
            yes(host.nativeObservationRetryUsed,"budget spent before submission");
            yes(host.written.containsKey("native-observation-read-retry-01.json"),"real durable intent before submission");
            yes(firstCancellation!=cancel&&firstCancellation.isCancelled()&&!cancel.isCancelled(),"new token after old abandonment");
            proof.requireOriginal(this,id,host.authorization,host.before);
            yes(proof.consumed.compareAndSet(false,true),"fake admission consumes actual one-use proof");
            if(beforeRetryCallback!=null)beforeRetryCallback.run();
            if("timeout".equals(retryMode)){clock(deadline);return;}
            clock(retryAt>=0?retryAt:Math.min(SystemClock.elapsedRealtime()+300,deadline-1));
            if("error".equals(retryMode)){callback.onError("replacement read still unstable");return;}
            if("typed".equals(retryMode)){callback.onReadRetryAvailable("second transient failure",mint(id,SystemClock.elapsedRealtime(),deadline));return;}
            callback.onObservation(fresh());if(duplicateRetry)callback.onError("late duplicate error");
        }
