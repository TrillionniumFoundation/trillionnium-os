    static final class PendingSample {
        final String mode;final long delay;
        PendingSample(String mode,long delay){this.mode=mode;this.delay=delay;}
    }
    List<PendingSample> pendingSamples;int pendingIndex,nativeModelCalls;
    final List<Long> pendingDeadlines=new ArrayList<Long>();
    final List<String> modelObservationIds=new ArrayList<String>();
    Runnable pendingBeforeCallback;
    void deliverPending(String id,long deadline,HeptaAccessibilityService.ObservationCallback callback)throws Exception{
        if(pendingIndex>=pendingSamples.size())throw new AssertionError("unexpected additional pending observation");
        PendingSample sample=pendingSamples.get(pendingIndex++);pendingDeadlines.add(Long.valueOf(deadline));
        clock(SystemClock.elapsedRealtime()+sample.delay);
        if(pendingBeforeCallback!=null)pendingBeforeCallback.run();
        if("error".equals(sample.mode)){callback.onError("explicit pending read failure");return;}
        if("timeout".equals(sample.mode)){clock(deadline);return;}
        PhoneObservation value;
        if("old".equals(sample.mode)){service.latest=before;value=before;}
        else if("complete".equals(sample.mode))value=service.postFresh();
        else if("unresolved".equals(sample.mode))value=service.fresh();
        else throw new AssertionError("unknown synthetic pending mode");
        callback.onObservation(value);
    }
