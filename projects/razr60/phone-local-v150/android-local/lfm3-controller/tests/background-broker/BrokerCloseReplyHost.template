    private static void transport(boolean profile)throws Exception{
        BrokerCloseReplyHost s=context(profile);
        try(PipedInputStream client=new PipedInputStream();PipedOutputStream output=new PipedOutputStream(client)){
            LocalSocket exact=new LocalSocket(output);s.connection=exact;
            Request request=new Request();s.authenticateAndRegister(request,exact);
            long deadline=s.requestDeadline;
            // Close has now retired admission/lease. An already entered monitor
            // returns the observed retired-lease refusal before close writes.
            s.closing.set(true);
            Thread monitor=new Thread(()->s.latePolicyFailure(new IOException("PUBLIC_SCREEN_LEASE_RETIRED")));
            monitor.start();monitor.join();
            boolean eof=false,wrote=false;byte[] actual=null;
            byte[] payload="synthetic same-request close reply after proven fixture absence".getBytes(StandardCharsets.UTF_8);
            if(exact.closed){
                eof=client.read()==-1;
                try{BrokerProtocol.writeFrame(output,payload);}catch(IOException expected){/* actual closed pipe */}
            }else{
                s.state="RELEASED";s.cleanupDone.countDown();
                if(profile)s.profileCustody.released=true;else s.publicNotesCustody.released=true;
                BrokerProtocol.writeFrame(output,payload);wrote=true;
                DataInputStream reader=new DataInputStream(client);actual=new byte[reader.readInt()];reader.readFully(actual);
            }
            boolean complete=!eof&&wrote&&Arrays.equals(payload,actual)&&s.cleanupCalls==0&&!exact.closed;
            if(!complete)throw new AssertionError((profile?"PROFILE":"NOTES")+
                    "_CLOSE_TRANSPORT_LOST eof="+eof+" wrote="+wrote+" closed="+exact.closed+
                    " shutdown_cleanup_calls="+s.cleanupCalls);
            named((profile?"profile":"notes")+"_actual_late_monitor_shutdown_pipe_frame",complete);
            named((profile?"profile":"notes")+"_same_socket_original_request_deadline",
                    s.authenticatedProfileClosePeer==exact&&s.connection==exact&&s.requestDeadline==deadline);
        }
    }
    private static void notesMidFrame()throws Exception{
        final BrokerCloseReplyHost s=context(false);
        try(PipedInputStream client=new PipedInputStream();PipedOutputStream pipe=new PipedOutputStream(client)){
            final LocalSocket exact=new LocalSocket(pipe);s.connection=exact;
            s.authenticateAndRegister(new Request(),exact);s.closing.set(true);
            OutputStream boundary=new OutputStream(){
                int bytes;boolean fired;
                private void before(int count)throws IOException{
                    if(!fired&&bytes>=4){
                        fired=true;
                        Thread monitor=new Thread(()->s.latePolicyFailure(new IOException("PUBLIC_SCREEN_LEASE_RETIRED")));
                        monitor.start();try{monitor.join();}catch(InterruptedException e){Thread.currentThread().interrupt();throw new IOException(e);}
                    }
                    bytes+=count;
                }
                public void write(int b)throws IOException{before(1);pipe.write(b);}
                public void write(byte[] b,int off,int len)throws IOException{before(len);pipe.write(b,off,len);}
            };
            byte[] payload="synthetic full response payload".getBytes(StandardCharsets.UTF_8);
            BrokerProtocol.writeFrame(boundary,payload);
            DataInputStream reader=new DataInputStream(client);int size=reader.readInt();
            byte[] actual=new byte[size];reader.readFully(actual);
            named("notes_midframe_late_monitor_preserves_header_and_payload",
                    Arrays.equals(payload,actual)&&s.cleanupCalls==0&&!exact.closed&&s.authenticatedProfileClosePeer==exact);
        }
    }
    private static void refusedRegistration(String name,int variant)throws Exception{
        BrokerCloseReplyHost s=context(false);Request r=new Request();LocalSocket exact=new LocalSocket();s.connection=exact;
        boolean mustThrow=false;
        switch(variant){
            case 0:r.valid=false;mustThrow=true;break;
            case 1:exact.uid=12346;mustThrow=true;break;
            case 2:r.operation="state";break;
            case 3:s.config.publicOwnGroupScope=null;break;
            case 4:s.publicNotesCustody=null;break;
            case 5:r.deadline=1000;mustThrow=true;break;
            case 6:r.deadline=999;mustThrow=true;break;
            case 7:s.expires=1000;mustThrow=true;break;
            case 8:s.receipts.replay=true;break;
            default:throw new AssertionError("unknown variant");
        }
        boolean threw=false;
        try{s.authenticateAndRegister(r,exact);}catch(IOException rejected){threw=true;}
        s.closing.set(true);
        named(name,threw==mustThrow&&s.authenticatedProfileClosePeer==null&&!s.profileCloseReplyPending(1000));
    }
