    private static BrokerCloseReplyHost context(boolean profile){
        BrokerCloseReplyHost s=new BrokerCloseReplyHost();
        s.config.publicOwnGroupScope=new Object();
        if(profile)s.config.profileTarget=new Object();else s.publicNotesCustody=new Custody();
