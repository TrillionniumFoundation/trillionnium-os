    public static void main(String[] args)throws Exception{
        long screenOff=Long.parseLong(args[0]),lastAbsence=Long.parseLong(args[1]);
        BrokerCloseReplyHost s=new BrokerCloseReplyHost();
        s.config.publicOwnGroupScope=new Object();s.config.profileTarget=new Object();
        s.connection=new LocalSocket();s.authenticatedProfileClosePeer=s.connection;
        s.cleanupAt=screenOff;s.requestDeadline=screenOff+3500;
        check(!s.profileCloseReplyPending(screenOff));
        s.closing.set(true);
        check(s.profileCloseReplyPending(screenOff));
        check(!s.releasedProfileReplyMayFlush(lastAbsence));
        s.state="RELEASED";s.profileCustody.released=true;
        check(!s.releasedProfileReplyMayFlush(lastAbsence));
        s.cleanupDone.countDown();
        check(s.releasedProfileReplyMayFlush(screenOff+1500));
        check(s.releasedProfileReplyMayFlush(screenOff+2249));
        check(!s.releasedProfileReplyMayFlush(screenOff+2250));
        s.state="CLEANUP_UNKNOWN";check(!s.releasedProfileReplyMayFlush(screenOff+1500));s.state="RELEASED";
        s.profileCustody.released=false;check(!s.releasedProfileReplyMayFlush(screenOff+1500));s.profileCustody.released=true;
        s.requestDeadline=screenOff+1600;check(!s.releasedProfileReplyMayFlush(screenOff+1600));s.requestDeadline=screenOff+3500;
        check(!s.profileCloseReplyPending(s.requestDeadline));check(!s.releasedProfileReplyMayFlush(s.cleanupAt-1));
        LocalSocket original=s.connection;s.connection=new LocalSocket();check(!s.profileCloseReplyPending(screenOff));s.connection=original;
        s.authenticatedProfileClosePeer=null;check(!s.profileCloseReplyPending(screenOff));s.authenticatedProfileClosePeer=original;

        // Only the transport and clock are fixtures. Exercise real framed output while a
        // separate monitor has returned after retirement. The old unconditional close
        // produces EOF on this same pipe before any response can be consumed.
        for(boolean preserve:new boolean[]{false,true}){
            try(PipedInputStream client=new PipedInputStream();PipedOutputStream broker=new PipedOutputStream(client)){
                CountDownLatch observed=new CountDownLatch(1);
                Thread monitor=new Thread(()->{
                    try{if(!preserve||!s.profileCloseReplyPending(screenOff))closePeer(broker);}
                    catch(IOException e){throw new AssertionError(e);}finally{observed.countDown();}
                });monitor.start();observed.await();monitor.join();
                if(!preserve){check(client.read()==-1);continue;}
                byte[] payload="synthetic root RPC reply for original request".getBytes(StandardCharsets.UTF_8);
                BrokerProtocol.writeFrame(broker,payload);
                DataInputStream read=new DataInputStream(client);byte[] frame=new byte[read.readInt()];read.readFully(frame);
                check(Arrays.equals(payload,frame));
            }
        }
        notesCases();
        StringBuilder names=new StringBuilder("[");
        for(String name:cases){if(names.length()>1)names.append(',');names.append('"').append(name).append('"');}
        names.append(']');
        System.out.println("{\"checks\":"+checks+",\"named_cases\":"+cases.size()+",\"case_names\":"+names+
            ",\"phone_operations\":0,\"old_reader_eof_reproduced\":true,\"original_pipe_framing_verified\":true"+
            ",\"notes_actual_extracted_monitor_transport_verified\":true}");
    }
