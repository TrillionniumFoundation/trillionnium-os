    static NativeActionSnapshotCheckHostTest.Fixture productRaw(String side,String purpose)throws Exception{
        NativeActionSnapshotCheckHostTest.Fixture f=NativeActionSnapshotCheckHostTest.form(purpose);
        f.nodes.clear();JSONArray rows=productRecorded.getJSONObject("pairs").getJSONObject(side).getJSONArray("nodes");
        for(int i=0;i<rows.length();i++){
            Object value=productValue(rows.getJSONObject(i));if(!(value instanceof Map))throw new AssertionError("recorded row");
            Map<String,Object> row=new TreeMap<String,Object>();for(Map.Entry<?,?> e:((Map<?,?>)value).entrySet())row.put((String)e.getKey(),e.getValue());
            row.put("window_id",96);f.nodes.put((String)row.get("path"),row);
        }
        f.env.put("visited",f.nodes.size());f.env.put("window_id",96);
        f.target=NativeActionSnapshotCheck.QUERY.equals(purpose)?"0/0/2/13":"0/0/2/5";f.label=(String)f.nodes.get(f.target).get("label");
        return f;
    }
    static NativeActionSnapshotCheck.Snapshot productSnapshot(Fixture f,Graph g,String obs){
        Map<String,Object> e=new TreeMap<String,Object>();
        e.put("task_id",f.task);e.put("owner_sha256",f.selection.taskTarget.ownerSha256);
        e.put("target_sha256",f.selection.taskTarget.targetSha256);e.put("authorization_sha256",f.authorization.sha256);
        try{e.put("selection_sha256",NativeAppObservation.selectionSha(f.selection));}catch(Exception fail){throw new IllegalArgumentException(fail);}
        e.put("goal_sha256",f.selection.taskTarget.nativeGoal.contractSha256);
        e.put("installed_set_sha256",new NativeAppEvidence.Installed(f.productProfile).apkSetSha256);
        e.put("background_generation",f.service.background.generation);e.put("origin_observation_id",obs);
        e.putAll(NativeAppEvidence.profileActionIdentity(g.profileWindow));
        e.put("package",g.packageName);e.put("display_id",g.displayId);e.put("window_id",g.windowId);e.put("rotation",g.rotation);
        e.put("width",g.nativeActionWidth);e.put("height",g.nativeActionHeight);
        e.put("root_bounds",Arrays.asList(g.bounds.left,g.bounds.top,g.bounds.right,g.bounds.bottom));
        e.put("window_metadata_sha256",sha(g.windowMetadata.bindFreshness("").getBytes(StandardCharsets.UTF_8)));
        e.put("reported_windows_sha256",NativeAppEvidence.fingerprint(g.nativeActionWindows));e.put("reported_windows_complete",true);
        e.put("ime_visibility","hidden");e.put("captured_elapsed_ms",g.nativeActionCapturedAt);e.put("full_native_complete",true);
        e.put("visited",g.collectionStats.visited);e.put("pending",g.collectionStats.pending);
        e.put("node_omissions",g.collectionStats.nodeBudgetOmissions);e.put("text_omissions",g.collectionStats.textBudgetOmissions);
        e.put("child_omissions",(int)g.collectionStats.childSlotsOmitted);
        return new NativeActionSnapshotCheck.Snapshot(e,g.nativeActionNodes);
    }
    static NativeAppEvidence.Frame productFrame(Fixture f,List<NativeAppEvidence.Node> nodes,String tree,String obs)throws Exception{
        Map<String,Object> qualification=null;f.productCaptureMetadata=null;
        boolean isForm=false;for(NativeAppEvidence.Node node:nodes)if((NativeAppGoal.CTRIP_PACKAGE+":id/bt_submit_inquire").equals(node.viewId))isForm=true;
        if(isForm){
            Graph original=f.productCapturedGraph,second=null,restore=null;
            try{
                NativeActionSnapshotCheck.Snapshot first=productSnapshot(f,original,obs);
                second=f.graph(productRaw("after",f.purpose),null);
                Map<String,Object> proof=NativeCtripFormObservation.compareForTargetPlanning(first,productSnapshot(f,second,obs));
                Object raw=proof.get("form_purpose_geometry");
                if(!(raw instanceof Map))throw new AssertionError("recorded moving header must require its distinct purpose qualification");
                qualification=new TreeMap<String,Object>();for(Map.Entry<?,?> e:((Map<?,?>)raw).entrySet())qualification.put((String)e.getKey(),e.getValue());
                qualification.put("planning_observation_id",obs);
                Map<String,Object> metadata=new TreeMap<String,Object>();
                metadata.put("schema","hepta.observation-capture.v1");metadata.put("mode","pre_encoding_form_pair_history");
                metadata.put("capture_requested_elapsed_ms",SystemClock.now);
                metadata.put("form_pair_comparison",org.trillionnium.hepta.local.NativeAppObservation.pixelFormPair(proof));
                metadata.put("publication_refreshes_capture_age",false);metadata.put("grants_action_authority",false);
                metadata.put("business_completion_verified",false);f.productCaptureMetadata=metadata;
            }finally{
                if(second!=null)second.close();
                restore=f.graph(f.raw,null);restore.close();
            }
        }
        return new NativeAppEvidence.Frame(f.task,f.selection.taskTarget.ownerSha256,f.selection.taskTarget.targetSha256,f.authorization.sha256,
                NativeAppObservation.selectionSha(f.selection),obs,f.raw.pkg,f.service.background.generation,tree,hash("host-state:"+tree),
                hash("host-screen:"+obs),hash("explicit-host-record:"+obs),hash("explicit-host-completion:"+obs),
                7,96,0,1224,2992,0,0,1224,2992,SystemClock.now,false,true,nodes,1,true,f.productWindow,null,
                f.service.stripFormPurpose?null:qualification);
    }
