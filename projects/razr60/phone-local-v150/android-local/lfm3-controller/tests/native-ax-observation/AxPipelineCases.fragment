            check(r.trace.snapshot(SystemClock.now).toString().contains("window_mismatch"),"window mismatch diagnostic absent");
            check(r.trace.snapshot(SystemClock.now).toString().contains("late_content"),"independent content fact absent");
            axRejectedFinally(f,r);
        });
        axCase("invalid_persisted_pair_cannot_enter_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);
            MobiMindPrivateFiles.readHook=bytes->{bytes[0]='!';f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);drainAx(f);
            check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"invalid persisted bytes admitted recheck");
            axRejectedFinally(f,r);
        });
        for(final String kind:new String[]{"missing","stale","truncated","node","window","identity"})
            axCase("complete_C_"+kind+"_refused",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n!=4)return;
                    if("missing".equals(kind))throw new NoActiveWindow();
                    if("stale".equals(kind))throw new StaleObservation("actual C stale");
                    if("truncated".equals(kind))g.truncated=true;
                    if("node".equals(kind))g.nativeActionNodes=axNodes("different complete C node");
                    if("window".equals(kind)){Map<String,Object> w=new LinkedHashMap<String,Object>(g.nativeActionWindows);w.put("unexpected",true);g.nativeActionWindows=immutableMap(w);}
                    if("identity".equals(kind))g.nativeActionAuthorizationSha="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
