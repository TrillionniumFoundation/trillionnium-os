    static ObservationCaptureEvidence phoneCapture;static org.json.JSONObject phoneBinding;
    volatile FrozenObservationWindow windowValue;volatile Runnable windowHook;volatile String windowFailure;
    volatile boolean authorizationReady=true;final AtomicInteger windowChecks=new AtomicInteger();
    static Map<String,Object> rawWindows(){
        Map<String,Object> row=new LinkedHashMap<String,Object>();row.put("window_id",7);row.put("display_id",9);row.put("type",1);
        row.put("layer",2);row.put("bounds",Arrays.asList(0,0,1080,2400));row.put("focused",true);row.put("active",true);
        Map<String,Object> out=new LinkedHashMap<String,Object>();out.put("display_id",9);out.put("target_window_id",7);out.put("target_layer",2);
        out.put("windows",Collections.singletonList(row));out.put("other_window_roots_traversed",false);out.put("unreported_windows_excluded",false);return out;
    }
    interface AxChange {void apply(ObserverPipelineHost f,Graph graph,int ordinal);}
    static List<NativeActionSnapshotCheck.Node> axNodes(String text){
        List<NativeActionSnapshotCheck.Node> nodes=new ArrayList<NativeActionSnapshotCheck.Node>();
        for(String path:new String[]{"0","0/0","0/1"}){
            Map<String,Object> row=new LinkedHashMap<String,Object>();row.put("path",path);
            row.put("text","0/1".equals(path)?text:"");row.put("window_id",7);row.put("package",SnapshotChecks.APP);
            nodes.add(new NativeActionSnapshotCheck.Node(row));
        }return Collections.unmodifiableList(nodes);
    }
    static void axGraph(Graph g){
        g.packageName=SnapshotChecks.APP;g.backgroundGeneration=SnapshotChecks.GENERATION;g.backgroundOwnerSha=SnapshotChecks.OWNER;
        g.backgroundSelectionRaw="{\"fixture\":\"explicit_host_native_selection\"}";
        g.backgroundBootstrapPackage=SnapshotChecks.APP;g.backgroundAllowedPackages=Collections.singletonList(SnapshotChecks.APP);
        g.state=new ObservationState(SnapshotChecks.OWNER,ImeVisibility.HIDDEN);
        g.windowMetadata=ObservedWindowMetadata.observed(new int[]{0,0,1080,2400},"android.widget.FrameLayout",1,g.displayId,new int[]{0,0,1080,2400},SnapshotChecks.APP);
        g.rows.add(new PhoneObservation.Node("n0",SnapshotChecks.APP,"0/0",SnapshotChecks.OWNER));g.refs.put("n0",new NodeRef(SnapshotChecks.OWNER));
        g.collectionStats=new PhoneObservation.CollectionStats(1536,512,6144,3,1,10,0,0,0,0,1);
        g.nativeActionNodes=axNodes("中文实际完整AX证据");g.nativeActionWidth=1080;g.nativeActionHeight=2400;g.nativeActionWindows=immutableMap(rawWindows());
        g.nativeActionTaskId=SnapshotChecks.TASK;g.nativeActionAuthorizationSha=SnapshotChecks.OWNER;
        g.nativeActionSelectionSha=SnapshotChecks.OWNER;g.nativeActionTargetSha=SnapshotChecks.OWNER;g.nativeActionGoalSha=SnapshotChecks.OWNER;
        g.nativeActionCapturedAt=SystemClock.now;
    }
    static ObserverPipelineHost axFixture(final AxChange change,boolean profileVisual,boolean adapterVisual)throws Exception{
        ObserverPipelineHost f=new ObserverPipelineHost();f.lease=SnapshotChecks.TASK;TaskAuthorization.Gate auth=new TaskAuthorization.Gate();f.taskAuthorization=auth;
        BackgroundSession bg=new BackgroundSession(9);bg.ownerSha256=SnapshotChecks.OWNER;bg.generation=SnapshotChecks.GENERATION;
        BackgroundTaskTarget target=new BackgroundTaskTarget();target.route=BackgroundTaskTarget.NATIVE_APP;target.explicitSelection=true;
        target.ownerSha256=bg.ownerSha256;target.packageName=SnapshotChecks.APP;target.nativeGoal=new NativeAppGoal();
        target.nativeGoal.ownerSha256=target.ownerSha256;target.nativeGoal.packageName=target.packageName;target.nativeGoal.kind=NativeAppGoal.PRODUCT_PRICE;
        bg.selection.taskTarget=target;bg.selection.initialPackage=target.packageName;bg.selection.allowedPackages=Collections.singletonList(target.packageName);
        f.taskBackground=bg;LocalTaskController controller=new LocalTaskController();f.ownedController=controller;
        NativeAppSession session=new NativeAppSession();session.authorization=auth;session.taskId=f.lease;session.selection=bg.selection;
        session.target=target;session.goal=target.nativeGoal;session.displayId=9;session.generation=bg.generation;
        f.bindNativeTextObservation(controller,session,f.lease,auth,bg,new LocalInference(adapterVisual),new LocalRuntimeConfig(profileVisual));
        f.readHook=(g,n)->{axGraph(g);if(change!=null)change.apply(f,g,n);
            String key=g.packageName+"|"+g.digest+"|"+g.windowMetadata.bindFreshness("");
            g.digest=sha(key.getBytes(StandardCharsets.UTF_8));g.nativeObservationComplete=completeNativeObservationGraph(g);
            if(n==2)f.windowValue=frozenObservationWindow(g);
        };
        MobiMindPrivateFiles.writeHook=null;MobiMindPrivateFiles.readHook=null;MobiMindPrivateFiles.writes=0;MobiMindPrivateFiles.reads=0;return f;
    }
    void axBegin(){
        observe(lease,directory,()->cancelled.get(),ObservationStabilityGate.requestDeadline(SystemClock.now,SystemClock.now+100000),new ObservationCallback(){
            public void onObservation(PhoneObservation o){expect(isMain(),"AX published off main");delivered.add(o);}
            public void onError(String error){expect(isMain(),"AX error off main");errors.add(error);}
        });main.drain();
    }
    static ObservationRequest axPair(ObserverPipelineHost f)throws Exception{
        f.axBegin();ObservationRequest r=f.activeObservation;f.awaitSample();SystemClock.now+=200;
        f.main.drainUntil(()->!f.errors.isEmpty()||(f.activeObservation!=null&&f.activeObservation.captured!=null));
        await(()->f.reads.get()>=2&&!observationIoBusy.get()&&observationIo.active.get()==0,"second AX sample exit");
        f.main.drainUntil(()->!f.errors.isEmpty()||(f.activeObservation!=null&&f.activeObservation.captured!=null));
        await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"AX pair and private persistence exit");
        return r;
    }
    static void check(boolean ok,String why){SnapshotChecks.check(ok,why);}
    static void axCase(String name,Case body)throws Exception{SnapshotChecks.run(name,()->test(name,body));}
    static void noPixels(ObserverPipelineHost f){check(f.shots.isEmpty()&&Bitmap.made.isEmpty(),"AX called screenshot/bitmap IO");}
    static void reject(ObserverPipelineHost f,ObservationRequest r)throws Exception{
        drainAx(f);check(f.delivered.isEmpty(),"bad AX pair published");noPixels(f);
        check(r.deadline==r.started+12000,"AX deadline expanded");check(f.directory.list().length==0,"unpublished receipt leaked");f.dispose();
    }
    static void boundBadCapture(String kind)throws Exception{
        ObserverPipelineHost f=axFixture(null,false,false);
        ObservationRequest r=new ObservationRequest(f.lease,f.directory,new ObservationCallback(){
            public void onObservation(PhoneObservation o){f.delivered.add(o);}public void onError(String e){f.errors.add(e);}
        },()->false,SystemClock.now+12000,f.taskBackground);
        r.readAuthorization=f.taskAuthorization;f.bindNativeAxObservationRequest(r);f.activeObservation=r;r.nativeSample=true;
        Graph g=new Graph(1,9);axGraph(g);g.readStartedElapsedMs=SystemClock.now;g.readCompletedElapsedMs=SystemClock.now;
        g.nativeObservationComplete=true;f.graphs.add(g);r.captured=g;
        if("incomplete".equals(kind))g.nativeObservationComplete=false;
        if("missing".equals(kind)){g.close();r.captured=null;}
        if("retired".equals(kind))f.ownedController=new LocalTaskController();
        f.captureObservation(r);await(()->observationIo.active.get()==0,"refused AX");f.main.drain();
        check(!f.errors.isEmpty()&&f.delivered.isEmpty(),"bound invalid AX was not refused");noPixels(f);f.dispose();
    }

    volatile Runnable phoneConstructHook;
    static void drainAx(ObserverPipelineHost f)throws Exception{
        for(int i=0;i<8;i++){
            f.main.drain();await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"AX recheck worker drain");
            if(!f.main.hasReady())return;
        }
        throw new AssertionError("AX callback loop did not drain");
    }
    static org.json.JSONObject onlyAxReceipt(ObserverPipelineHost f)throws Exception{
        File[] paths=f.directory.listFiles();check(paths!=null&&paths.length==1,"one actual final AX receipt required");
        return new org.json.JSONObject(new String(Files.readAllBytes(paths[0].toPath()),StandardCharsets.UTF_8));
    }
    static void axRejectedFinally(ObserverPipelineHost f,ObservationRequest r)throws Exception{
        drainAx(f);check(f.delivered.isEmpty(),"rejected final AX product published");noPixels(f);
        check(r.deadline==r.started+12000,"recheck changed request budget");
        check(f.directory.list().length==0,"failed recheck left a published-looking receipt");f.dispose();
    }
    static void assertOneRecheckPublication(ObserverPipelineHost f,ObservationRequest r)throws Exception{
        drainAx(f);check(f.delivered.size()==1&&f.errors.isEmpty(),"one complete recheck did not publish: "+f.errors);
        check(r.nativeAxPublicationRecheckAttempted,"successful recheck did not consume the one-use mark");
        check(f.reads.get()==4&&MobiMindPrivateFiles.writes==2&&MobiMindPrivateFiles.reads==2,"recheck must read complete C and persist/readback a new receipt");
        check(((Number)f.current.captureEvidence.get("publication_full_graph_recheck_count")).intValue()==1,"recheck count missing");
        check("final_published_complete_census".equals(f.current.captureEvidence.get("events_after_complete_census_admitted_endpoint")),"final endpoint is ambiguous");
        check(Boolean.FALSE.equals(f.current.captureEvidence.get("events_after_complete_census_admitted")),"late event admitted after final C");
        check(f.current.captureEvidence.get("publication_original_pair") instanceof Map,"actual original B provenance missing");
        noPixels(f);
    }
    static void publicationRecheckCases()throws Exception{
        axCase("late_content_at_main_requires_real_new_complete_receipt",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);
            org.json.JSONObject old=onlyAxReceipt(f);String oldId=old.getJSONObject("binding").getString("observation_id");
            long capture=old.getJSONObject("binding").getLong("captured_elapsed_ms");
            r.recordEvent(false,1);assertOneRecheckPublication(f,r);
            org.json.JSONObject next=onlyAxReceipt(f);
            check(!oldId.equals(next.getJSONObject("binding").getString("observation_id")),"old receipt was relabelled");
            check(next.getJSONObject("binding").getLong("captured_elapsed_ms")==capture&&f.current.capturedElapsedMillis==capture,"A capture age refreshed");
            check(old.getJSONObject("first").toString().equals(next.getJSONObject("first").toString()),"original A changed");
            check(next.getJSONObject("second_completed_watermark").getLong("content")==1,"C endpoint did not cover actual content event");
            check(r.deadline==r.started+12000,"original total budget changed");f.dispose();
        });
        axCase("late_content_during_first_persist_has_one_full_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);
            MobiMindPrivateFiles.writeHook=()->{if(MobiMindPrivateFiles.writes==1)f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);assertOneRecheckPublication(f,r);f.dispose();
        });
        axCase("late_content_during_first_window_check_has_one_full_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger windows=new AtomicInteger();
            f.windowHook=()->{if(windows.incrementAndGet()==1)f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);assertOneRecheckPublication(f,r);f.dispose();
        });
        axCase("late_content_after_dto_requires_new_pair_before_transfer",()->{
            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger dtos=new AtomicInteger();
            f.phoneConstructHook=()->{if(dtos.incrementAndGet()==1)f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);assertOneRecheckPublication(f,r);
            check(dtos.get()==2,"first stale DTO was transferred or C was not constructed");f.dispose();
        });
        axCase("qualified_pair_rechecks_after_settle_with_original_total_deadline",()->{
            ObserverPipelineHost f=axFixture((x,g,n)->{
                if(n==2)SystemClock.now=x.activeObservation.started+8772;
                if(n==3)SystemClock.now=x.activeObservation.started+9381;
                if(n==4)SystemClock.now=x.activeObservation.started+10600;
            },false,false);
            MobiMindPrivateFiles.writeHook=()->{if(MobiMindPrivateFiles.writes==1){
                SystemClock.now=f.activeObservation.started+9941;f.activeObservation.recordEvent(false,1);}};
            ObservationRequest r=axPair(f);assertOneRecheckPublication(f,r);
            org.json.JSONObject finalReceipt=onlyAxReceipt(f);
            check(SystemClock.now-r.started>10000&&SystemClock.now<r.deadline,"capture margin case did not cross old settle limit");
            check(f.current.capturedElapsedMillis==r.started+8772,"capture clock replaced by recheck clock");
            check(finalReceipt.getJSONObject("second").getLong("read_completed_elapsed_ms")==r.started+10600,"C clock not actual");
            Map<?,?> previous=(Map<?,?>)f.current.captureEvidence.get("publication_original_pair");
            check(((Number)previous.get("pair_graph_completed_elapsed_ms")).longValue()==r.started+9381,"old B clock lost");
            check(((Number)previous.get("recheck_admitted_elapsed_ms")).longValue()==r.started+9941,"admission clock fabricated");
            check(r.deadline==r.started+12000,"capture margin extended total request");f.dispose();
        });
        axCase("typed_content_during_C_read_requires_complete_equal_C",()->{
            ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)x.activeObservation.recordEvent(false,1);},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);assertOneRecheckPublication(f,r);
            check(onlyAxReceipt(f).getJSONObject("second_completed_watermark").getLong("content")==2,"actual C read content not sealed");f.dispose();
        });
        for(final int kind:new int[]{0,2,3})axCase("late_noncontent_kind_"+kind+"_never_enters_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);
            r.recordEvent(kind==3,kind==3?1:kind);drainAx(f);
            check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"untyped/boundary/unknown event got recheck credit");
            axRejectedFinally(f,r);
        });
        axCase("window_mismatch_even_with_content_never_enters_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);
            f.windowHook=()->{FrozenObservationWindow w=f.windowValue;
                f.windowValue=new FrozenObservationWindow(w.packageName,w.windowId+1,w.displayId,w.rotation,w.left,w.top,w.right,w.bottom,
                        w.width,w.height,w.metadata,w.windows,w.profileWindow);
                f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);drainAx(f);
            check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"window mismatch relabelled as content");
            check(r.trace.snapshot(SystemClock.now).toString().contains("window_mismatch"),"window mismatch diagnostic absent");
            check(r.trace.snapshot(SystemClock.now).toString().contains("late_content"),"independent content fact absent");
            axRejectedFinally(f,r);
        });
        axCase("invalid_persisted_pair_cannot_enter_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);
            MobiMindPrivateFiles.readHook=bytes->{bytes[0]='!';f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);drainAx(f);
            check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"invalid persisted bytes admitted recheck");
            axRejectedFinally(f,r);
        });
        for(final String kind:new String[]{"missing","stale","truncated","node","window","identity"})
            axCase("complete_C_"+kind+"_refused",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n!=4)return;
                    if("missing".equals(kind))throw new NoActiveWindow();
                    if("stale".equals(kind))throw new StaleObservation("actual C stale");
                    if("truncated".equals(kind))g.truncated=true;
                    if("node".equals(kind))g.nativeActionNodes=axNodes("different complete C node");
                    if("window".equals(kind)){Map<String,Object> w=new LinkedHashMap<String,Object>(g.nativeActionWindows);w.put("unexpected",true);g.nativeActionWindows=immutableMap(w);}
                    if("identity".equals(kind))g.nativeActionAuthorizationSha="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
                },false,false);
                ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
                check(r.nativeAxPublicationRecheckAttempted&&f.reads.get()==4,"complete C failure did not use exactly one real read");
                check(MobiMindPrivateFiles.writes==1,"invalid C persisted as a complete replacement");
                axRejectedFinally(f,r);
            });
        for(final int kind:new int[]{2,3})axCase("boundary_or_unknown_during_C_"+kind+"_refused",()->{
            ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)x.activeObservation.recordEvent(kind==3,kind==3?1:2);},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(r.nativeAxPublicationRecheckAttempted&&f.reads.get()==4&&MobiMindPrivateFiles.writes==1,"C boundary got a replacement receipt");
            axRejectedFinally(f,r);
        });
        for(final String point:new String[]{"persist","window","dto"})axCase("second_late_content_at_"+point+"_cannot_recheck_again",()->{
            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger dtos=new AtomicInteger(),windows=new AtomicInteger();
            if("persist".equals(point))MobiMindPrivateFiles.writeHook=()->{if(MobiMindPrivateFiles.writes==2)f.activeObservation.recordEvent(false,1);};
            if("window".equals(point))f.windowHook=()->{if(windows.incrementAndGet()==2)f.activeObservation.recordEvent(false,1);};
            if("dto".equals(point))f.phoneConstructHook=()->{dtos.incrementAndGet();f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(r.nativeAxPublicationRecheckAttempted&&f.reads.get()==4&&MobiMindPrivateFiles.writes==2,"second recheck or missing full C");
            axRejectedFinally(f,r);
        });
        axCase("second_late_content_at_main_cannot_recheck_again",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);
            r.recordEvent(false,1);f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);
            await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"C queued callback");
            r.recordEvent(false,1);drainAx(f);
            check(f.reads.get()==4&&MobiMindPrivateFiles.writes==2,"late main event got third census");axRejectedFinally(f,r);
        });
        axCase("C_finishing_at_original_deadline_is_rejected",()->{
            ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)SystemClock.now=x.activeObservation.deadline;},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(!f.errors.isEmpty()&&r.finished,"original deadline did not retire request");axRejectedFinally(f,r);
        });
        for(final String owner:new String[]{"controller","authorization","background"})axCase("late_"+owner+"_change_cannot_enter_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);r.recordEvent(false,1);
            if("controller".equals(owner))f.ownedController=new LocalTaskController();
            if("authorization".equals(owner))f.taskAuthorization=new TaskAuthorization.Gate();
            if("background".equals(owner))f.taskBackground=new BackgroundSession(9);
            drainAx(f);check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"changed owner entered C");axRejectedFinally(f,r);
        });
        axCase("cancel_before_recheck_admission_never_reads_C",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);r.recordEvent(false,1);f.cancelled.set(true);
            drainAx(f);check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"cancelled request entered C");axRejectedFinally(f,r);
        });
        axCase("cancel_during_C_never_publishes_or_leaks",()->{
            Block b=new Block();ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)b.run();},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);b.entered();
            f.cancelled.set(true);f.main.drain();b.open();drainAx(f);
            check(r.finished&&f.delivered.isEmpty(),"cancelled C transferred");axRejectedFinally(f,r);
        });
        axCase("recheck_queue_rejection_restores_busy_and_ownership",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);r.recordEvent(false,1);observationIo.reject=true;
            drainAx(f);check(r.nativeAxPublicationRecheckAttempted&&!observationIoBusy.get()&&!f.errors.isEmpty(),"recheck queue failure leaked");
            axRejectedFinally(f,r);
        });
        for(final boolean throwing:new boolean[]{false,true})axCase("recheck_main_post_"+(throwing?"throws":"rejects")+"_closes_unpublished_file",()->{
            Block b=new Block();ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)b.run();},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);b.entered();
            f.main.rejectWorkerPosts=!throwing;f.main.throwWorkerPosts=throwing;b.open();
            await(()->observationIo.active.get()==0&&!observationIoBusy.get(),"unposted C exits");
            check(f.delivered.isEmpty()&&f.directory.list().length==0,"unposted C receipt leaked");
            SystemClock.now=r.deadline;f.main.drain();check(r.finished,"original watchdog did not retire unposted C");f.dispose();
        });
    }

    public static void main(String[] args)throws Exception{
        mainThread=Thread.currentThread();
        try{
            axCase("text_native_complete_pair_publishes_actual_receipt_without_png",()->{
                ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);f.main.drain();
                check(f.delivered.size()==1&&f.errors.isEmpty(),"complete AX pair failed: "+f.errors);
                noPixels(f);check(f.reads.get()==3&&f.windowChecks.get()==1,"two stable samples plus complete pair and window gate required");
                check(f.current.capture!=null&&ObservationCaptureEvidence.NATIVE_AX.equals(f.current.captureKind),"typed AX missing");
                check(f.current.path==null&&f.currentBitmap==null,"AX masqueraded as image");
                File[] artifacts=f.directory.listFiles();check(artifacts!=null&&artifacts.length==1&&artifacts[0].getName().endsWith("-native-ax.json"),"real AX receipt absent");
                byte[] bytes=Files.readAllBytes(artifacts[0].toPath());check(f.current.capture.receiptSha256.equals(ObservationCaptureEvidence.hash(bytes)),"persisted receipt hash mismatch");
                org.json.JSONObject raw=new org.json.JSONObject(new String(bytes,StandardCharsets.UTF_8));
                phoneCapture=f.current.capture;phoneBinding=raw.getJSONObject("binding");
                check(raw.getJSONObject("first").getJSONArray("nodes").length()==3,"only retained model rows persisted");
                check(raw.getJSONObject("second").getJSONArray("nodes").length()==3,"second census missing");
                check(f.current.capturedElapsedMillis==1200&&r.deadline==r.started+12000,"capture age/deadline refreshed");
                check(Boolean.FALSE.equals(f.current.captureEvidence.get("screenshot_observed")),"missing explicit no-image evidence");
                check(MobiMindPrivateFiles.writes==1&&MobiMindPrivateFiles.reads==1,"receipt not read back");f.dispose();
            });
            ActualAxPhoneChecks.run(phoneCapture,phoneBinding);
            axCase("equal_complete_pair_covers_only_typed_content_during_read",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)x.activeObservation.recordEvent(false,1);},false,false);
                axPair(f);f.main.drain();check(f.delivered.size()==1,"equal complete typed-content pair refused");noPixels(f);f.dispose();
            });
            axCase("complete_raw_node_change_rejects_even_when_retained_graph_matches",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)g.nativeActionNodes=axNodes("changed nonretained child");},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("pair_reported_window_change_rejected",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3){Map<String,Object> w=new LinkedHashMap<String,Object>(g.nativeActionWindows);w.put("changed",true);g.nativeActionWindows=immutableMap(w);}},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("unknown_event_during_pair_rejected",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)x.activeObservation.recordEvent(true,1);},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("boundary_event_during_pair_rejected",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)x.activeObservation.recordEvent(false,2);},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("any_content_after_complete_endpoint_rejects",()->{
                // The original A/B must be discarded. Hold the newly allowed C read
                // to observe that boundary, then cancel it rather than racing its callback.
                Block b=new Block();ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)b.run();},false,false);
                ObservationRequest r=axPair(f);r.recordEvent(false,1);
                f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);b.entered();
                check(f.delivered.isEmpty(),"original stale A/B was published");
                f.cancelled.set(true);b.open();reject(f,r);
            });
            axCase("event_during_receipt_write_rejects",()->{
                ObserverPipelineHost f=axFixture(null,false,false);MobiMindPrivateFiles.writeHook=()->f.activeObservation.recordEvent(false,1);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("persisted_receipt_corruption_rejected",()->{
                ObserverPipelineHost f=axFixture(null,false,false);MobiMindPrivateFiles.readHook=bytes->bytes[0]='!';
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("identity_window_changed_after_persistence_rejected",()->{
                ObserverPipelineHost f=axFixture(null,false,false);f.windowHook=()->{
                    FrozenObservationWindow w=f.windowValue;f.windowValue=new FrozenObservationWindow(w.packageName,w.windowId+1,w.displayId,w.rotation,
                            w.left,w.top,w.right,w.bottom,w.width,w.height,w.metadata,w.windows,w.profileWindow);};
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("deadline_during_receipt_persistence_not_extended",()->{
                ObserverPipelineHost f=axFixture(null,false,false);MobiMindPrivateFiles.writeHook=()->SystemClock.now+=12000;
                ObservationRequest r=axPair(f);reject(f,r);
            });
            for(final String kind:new String[]{"missing","incomplete","retired"})
                axCase("bound_ax_"+kind+"_never_falls_back_to_pixels",()->boundBadCapture(kind));
            axCase("visual_profile_keeps_legacy_pixel_path",()->{
                ObserverPipelineHost f=axFixture(null,true,true);check(f.nativeAxMode==null,"visual bound AX");
                f.startCapture();f.finish();check(f.shots.size()==1&&!Bitmap.made.isEmpty(),"visual lost screenshot path");
                check(f.delivered.size()==1&&f.current.capture==null,"visual published AX");f.dispose();
            });
            axCase("actual_adapter_profile_disagreement_rejected",()->{
                boolean refused=false;try{axFixture(null,false,true);}catch(IllegalArgumentException expected){refused=true;}
                check(refused,"visual adapter incorrectly bound AX");if(live!=null)live.dispose();
            });
            axCase("unknown_goal_not_opted_into_ax",()->{
                check(!ObservationCaptureEvidence.nativeTextMode(false,false,false),"unknown goal enabled AX");
            });
            publicationRecheckCases();
        }finally{
            SnapshotChecks.finish(args[0]);observationIo.executor.shutdownNow();
            expect(observationIo.executor.awaitTermination(4,TimeUnit.SECONDS),"AX worker executor leaked");
        }
    }
