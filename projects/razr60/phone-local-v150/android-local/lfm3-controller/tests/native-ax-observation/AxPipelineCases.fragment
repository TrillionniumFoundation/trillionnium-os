            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger windows=new AtomicInteger();
            f.windowHook=()->{if(windows.incrementAndGet()==2)f.activeObservation.recordEvent(kind==3,kind==3?1:kind);};
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(f.reads.get()==4&&MobiMindPrivateFiles.writes==1,"post C boundary triggered another census");axRejectedFinally(f,r);
        });
        for(final String owner:new String[]{"controller","authorization","background"})axCase("new_"+owner+"_after_C_refused",()->{
            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger windows=new AtomicInteger();
            f.windowHook=()->{if(windows.incrementAndGet()!=2)return;
                if("controller".equals(owner))f.ownedController=new LocalTaskController();
                if("authorization".equals(owner))f.taskAuthorization=new TaskAuthorization.Gate();
                if("background".equals(owner))f.taskBackground=new BackgroundSession(9);
            };
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(f.reads.get()==4&&MobiMindPrivateFiles.writes==1,"post C ownership changed read/write count");axRejectedFinally(f,r);
        });
        axCase("fresh_window_mismatch_after_C_is_rejected",()->{
            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger windows=new AtomicInteger();
            f.windowHook=()->{if(windows.incrementAndGet()==2){FrozenObservationWindow w=f.windowValue;
                f.windowValue=new FrozenObservationWindow(w.packageName,w.windowId+1,w.displayId,w.rotation,w.left,w.top,w.right,w.bottom,
                        w.width,w.height,w.metadata,w.windows,w.profileWindow);}};
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(f.reads.get()==4&&MobiMindPrivateFiles.writes==1,"fresh window mismatch retried C");axRejectedFinally(f,r);
        });
        axCase("deadline_after_C_before_publication_is_rejected",()->{
            ObserverPipelineHost f=axFixture(null,false,false);AtomicInteger windows=new AtomicInteger();
            f.windowHook=()->{if(windows.incrementAndGet()==2)SystemClock.now=f.activeObservation.deadline;};
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(r.finished&&!f.errors.isEmpty(),"post C original deadline ignored");axRejectedFinally(f,r);
        });
        axCase("C_finishing_at_original_deadline_is_rejected",()->{
            ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)SystemClock.now=x.activeObservation.deadline;},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(!f.errors.isEmpty()&&r.finished,"original deadline did not retire request");axRejectedFinally(f,r);
        });
        for(final String owner:new String[]{"controller","authorization","background"})axCase("late_"+owner+"_change_cannot_enter_recheck",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);r.recordEvent(false,1);
            if("controller".equals(owner))f.ownedController=new LocalTaskController();
            if("authorization".equals(owner))f.taskAuthorization=new TaskAuthorization.Gate();
            if("background".equals(owner))f.taskBackground=new BackgroundSession(9);
            drainAx(f);check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"changed owner entered C");axRejectedFinally(f,r);
        });
        axCase("cancel_before_recheck_admission_never_reads_C",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);r.recordEvent(false,1);f.cancelled.set(true);
            drainAx(f);check(!r.nativeAxPublicationRecheckAttempted&&f.reads.get()==3,"cancelled request entered C");axRejectedFinally(f,r);
        });
        axCase("cancel_during_C_never_publishes_or_leaks",()->{
            Block b=new Block();ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)b.run();},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);b.entered();
            f.cancelled.set(true);f.main.drain();b.open();drainAx(f);
            check(r.finished&&f.delivered.isEmpty(),"cancelled C transferred");axRejectedFinally(f,r);
        });
        axCase("recheck_queue_rejection_restores_busy_and_ownership",()->{
            ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);r.recordEvent(false,1);observationIo.reject=true;
            drainAx(f);check(r.nativeAxPublicationRecheckAttempted&&!observationIoBusy.get()&&!f.errors.isEmpty(),"recheck queue failure leaked");
            axRejectedFinally(f,r);
        });
        for(final boolean throwing:new boolean[]{false,true})axCase("recheck_main_post_"+(throwing?"throws":"rejects")+"_closes_unpublished_file",()->{
            Block b=new Block();ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)b.run();},false,false);
            ObservationRequest r=axPair(f);r.recordEvent(false,1);f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);b.entered();
            f.main.rejectWorkerPosts=!throwing;f.main.throwWorkerPosts=throwing;b.open();
            await(()->observationIo.active.get()==0&&!observationIoBusy.get(),"unposted C exits");
            check(f.delivered.isEmpty()&&f.directory.list().length==0,"unposted C receipt leaked");
            SystemClock.now=r.deadline;f.main.drain();check(r.finished,"original watchdog did not retire unposted C");f.dispose();
        });
    }

    public static void main(String[] args)throws Exception{
        mainThread=Thread.currentThread();
        try{
            axCase("text_native_complete_pair_publishes_actual_receipt_without_png",()->{
                ObserverPipelineHost f=axFixture(null,false,false);ObservationRequest r=axPair(f);f.main.drain();
                check(f.delivered.size()==1&&f.errors.isEmpty(),"complete AX pair failed: "+f.errors);
                noPixels(f);check(f.reads.get()==3&&f.windowChecks.get()==1,"two stable samples plus complete pair and window gate required");
                check(f.current.capture!=null&&ObservationCaptureEvidence.NATIVE_AX.equals(f.current.captureKind),"typed AX missing");
                check(f.current.path==null&&f.currentBitmap==null,"AX masqueraded as image");
                File[] artifacts=f.directory.listFiles();check(artifacts!=null&&artifacts.length==1&&artifacts[0].getName().endsWith("-native-ax.json"),"real AX receipt absent");
                byte[] bytes=Files.readAllBytes(artifacts[0].toPath());check(f.current.capture.receiptSha256.equals(ObservationCaptureEvidence.hash(bytes)),"persisted receipt hash mismatch");
                org.json.JSONObject raw=new org.json.JSONObject(new String(bytes,StandardCharsets.UTF_8));
                phoneCapture=f.current.capture;phoneBinding=raw.getJSONObject("binding");
                check(raw.getJSONObject("first").getJSONArray("nodes").length()==3,"only retained model rows persisted");
                check(raw.getJSONObject("second").getJSONArray("nodes").length()==3,"second census missing");
                check(f.current.capturedElapsedMillis==1200&&r.deadline==r.started+12000,"capture age/deadline refreshed");
                check(Boolean.FALSE.equals(f.current.captureEvidence.get("screenshot_observed")),"missing explicit no-image evidence");
                check(MobiMindPrivateFiles.writes==1&&MobiMindPrivateFiles.reads==1,"receipt not read back");f.dispose();
            });
            ActualAxPhoneChecks.run(phoneCapture,phoneBinding);
            axCase("equal_complete_pair_covers_only_typed_content_during_read",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)x.activeObservation.recordEvent(false,1);},false,false);
                axPair(f);f.main.drain();check(f.delivered.size()==1,"equal complete typed-content pair refused");noPixels(f);f.dispose();
            });
            axCase("complete_raw_node_change_rejects_even_when_retained_graph_matches",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)g.nativeActionNodes=axNodes("changed nonretained child");},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("pair_reported_window_change_rejected",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3){Map<String,Object> w=new LinkedHashMap<String,Object>(g.nativeActionWindows);w.put("changed",true);g.nativeActionWindows=immutableMap(w);}},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("unknown_event_during_pair_rejected",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)x.activeObservation.recordEvent(true,1);},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("boundary_event_during_pair_rejected",()->{
                ObserverPipelineHost f=axFixture((x,g,n)->{if(n==3)x.activeObservation.recordEvent(false,2);},false,false);
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("any_content_after_complete_endpoint_rejects",()->{
                // A/B cannot publish until fresh C qualifies; retain the original file.
                // Hold C to observe that boundary, then cancel rather than race its callback.
                Block b=new Block();ObserverPipelineHost f=axFixture((x,g,n)->{if(n==4)b.run();},false,false);
                ObservationRequest r=axPair(f);r.recordEvent(false,1);
                f.main.drainUntil(()->r.nativeAxPublicationRecheckAttempted);b.entered();
                check(f.delivered.isEmpty(),"original stale A/B was published");
                f.cancelled.set(true);b.open();reject(f,r);
            });
            axCase("events_during_receipt_write_and_after_C_reject",()->{
                ObserverPipelineHost f=axFixture(null,false,false);MobiMindPrivateFiles.writeHook=()->f.activeObservation.recordEvent(false,1);
                AtomicInteger windows=new AtomicInteger();
                f.windowHook=()->{if(windows.incrementAndGet()==2)f.activeObservation.recordEvent(false,1);};
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("persisted_receipt_corruption_rejected",()->{
                ObserverPipelineHost f=axFixture(null,false,false);MobiMindPrivateFiles.readHook=bytes->bytes[0]='!';
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("identity_window_changed_after_persistence_rejected",()->{
                ObserverPipelineHost f=axFixture(null,false,false);f.windowHook=()->{
                    FrozenObservationWindow w=f.windowValue;f.windowValue=new FrozenObservationWindow(w.packageName,w.windowId+1,w.displayId,w.rotation,
                            w.left,w.top,w.right,w.bottom,w.width,w.height,w.metadata,w.windows,w.profileWindow);};
                ObservationRequest r=axPair(f);reject(f,r);
            });
            axCase("deadline_during_receipt_persistence_not_extended",()->{
                ObserverPipelineHost f=axFixture(null,false,false);MobiMindPrivateFiles.writeHook=()->SystemClock.now+=12000;
                ObservationRequest r=axPair(f);reject(f,r);
            });
            for(final String kind:new String[]{"missing","incomplete","retired"})
                axCase("bound_ax_"+kind+"_never_falls_back_to_pixels",()->boundBadCapture(kind));
            axCase("visual_profile_keeps_legacy_pixel_path",()->{
                ObserverPipelineHost f=axFixture(null,true,true);check(f.nativeAxMode==null,"visual bound AX");
                f.startCapture();f.finish();check(f.shots.size()==1&&!Bitmap.made.isEmpty(),"visual lost screenshot path");
                check(f.delivered.size()==1&&f.current.capture==null,"visual published AX");f.dispose();
            });
            axCase("actual_adapter_profile_disagreement_rejected",()->{
                boolean refused=false;try{axFixture(null,false,true);}catch(IllegalArgumentException expected){refused=true;}
                check(refused,"visual adapter incorrectly bound AX");if(live!=null)live.dispose();
            });
            axCase("unknown_goal_not_opted_into_ax",()->{
                check(!ObservationCaptureEvidence.nativeTextMode(false,false,false),"unknown goal enabled AX");
            });
            publicationRecheckCases();
        }finally{
            SnapshotChecks.finish(args[0]);observationIo.executor.shutdownNow();
            expect(observationIo.executor.awaitTermination(4,TimeUnit.SECONDS),"AX worker executor leaked");
        }
    }
