            if("window".equals(point))f.windowHook=()->{if(windows.incrementAndGet()==2)f.activeObservation.recordEvent(false,1);};
            if("dto".equals(point))f.phoneConstructHook=()->{dtos.incrementAndGet();f.activeObservation.recordEvent(false,1);};
            ObservationRequest r=axPair(f);r.recordEvent(false,1);drainAx(f);
            check(r.nativeAxPublicationRecheckAttempted&&f.reads.get()==4&&MobiMindPrivateFiles.writes==1,"second recheck or missing full C");
            axRejectedFinally(f,r);
        });
