    void record(File directory,String name,JSONObject value)throws Exception{
        if(failJournal)throw new java.io.IOException("explicit host disk failure");
        Disk.record(directory,name,value);durableWrites++;
        yes(Files.readAllBytes(new File(directory,name).toPath()).length>0,"real action receipt created and fsynced");
        if(afterFsync!=null)afterFsync.run();
    }
