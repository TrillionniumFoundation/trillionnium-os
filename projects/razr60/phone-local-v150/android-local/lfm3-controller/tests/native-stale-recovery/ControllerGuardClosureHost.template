    static void yes(boolean value,String reason){IntegrationChecks.yes(value,reason);}
    static void one(String name,IntegrationChecks.Work body)throws Exception{IntegrationChecks.one(name,body);}
    static void positive()throws Exception{
        one("actual_await_close_fsync_outcome_recovers_without_reopening_guard",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("positive");
            HeptaAccessibilityService.ActionOutcome outcome=f.await();f.closed();
            yes(f.permit()==null,"await seal alone is not a recovery permit");
            f.afterFsync=()->{f.closed();};f.persist(outcome);
            yes(f.durableWrites==1&&f.permit()!=null,"normal awaited unentered receipt must survive close and durable outcome");
            java.lang.reflect.Method consume=NativeAppSession.ActionGuard.class.getDeclaredMethod("consumeUnenteredOutcome",Map.class);
            consume.setAccessible(true);
            yes(Boolean.FALSE.equals(consume.invoke(f.service.actualGuard,nativeQueryExecution(outcome.actionExecution))),"exact private seal is consumed once and cannot be consumed again");
            f.fixture.observeGraph(f.fixture.fresh);
            yes(NativeActionBridgeHost.recoveryContext(f.fixture)!=null,"actual closure path publishes recovery only on a new observed frame");
            f.closed();f.fixture.noEffect("recovery never dispatches an effect");
            IntegrationChecks.rejects(()->f.persist(outcome),"duplicate receipt cannot consume the seal again");
        });
    }
    static void negatives()throws Exception{
        for(final String mode:Arrays.asList("claimed","ordinary-close","retired","entered","accepted","dispatched","not-stale","cancel"))
            one("actual_await_closed_lineage_refuses_"+mode,()->{
                ControllerGuardClosureHost f=new ControllerGuardClosureHost(mode);f.service.mode=mode;
                HeptaAccessibilityService.ActionOutcome outcome=f.await();f.closed();f.persist(outcome);
                yes(f.permit()==null,"nonqualifying real lifetime has no recovery permit");
            });
        for(final String mode:Arrays.asList("throw","timeout","interrupt","pending","null","malformed-seal"))
            one("actual_await_abnormal_exit_closes_without_lineage_"+mode,()->{
                ControllerGuardClosureHost f=new ControllerGuardClosureHost(mode);f.service.mode=mode;
                try{
                    try{f.await();throw new AssertionError("abnormal actual await returned a usable result");}
                    catch(CleanupUnknown|IllegalArgumentException|IllegalStateException expected){yes(true,"actual await propagates its specific terminal failure");}
                }
                finally{Thread.interrupted();}
                f.closed();yes(f.permit()==null&&f.durableWrites==0,"abandoned await cannot mint durable recovery");
            });
        one("closed_lineage_binds_exact_immutable_scalar_receipt",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("changed-receipt");
            HeptaAccessibilityService.ActionOutcome outcome=f.await();
            outcome.actionExecution.put("operation_id",NativeActionBridgeHost.id("different-valid-operation"));
            f.persist(outcome);yes(f.permit()==null,"otherwise valid operation substitution cannot match private seal");f.closed();
        });
        one("ordinary_close_after_await_revokes_private_seal",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("revoked");HeptaAccessibilityService.ActionOutcome outcome=f.await();
            f.service.actualGuard.close();f.persist(outcome);yes(f.permit()==null,"later ordinary close erases private lineage");f.closed();
        });
        one("actual_stop_after_seal_before_outcome_invalidates_lineage",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("stop-after-seal");HeptaAccessibilityService.ActionOutcome outcome=f.await();
            f.stop();f.persist(outcome);yes(f.cancelled.get()&&f.permit()==null,"actual Stop token invalidates a completed private handoff");f.closed();
        });
        one("actual_stop_and_finally_share_one_publication_monitor",()->{
            final ControllerGuardClosureHost f=new ControllerGuardClosureHost("stop-interleaving");final AtomicReference<Thread> thread=new AtomicReference<Thread>();
            clockOwner=f;clockHook=()->{
                Thread stop=new Thread(()->f.stop(),"host-stop-race");thread.set(stop);stop.start();
                long until=System.nanoTime()+TimeUnit.SECONDS.toNanos(2);
                while(stop.getState()!=Thread.State.BLOCKED&&System.nanoTime()<until)Thread.yield();
                yes(Thread.holdsLock(f)&&stop.getState()==Thread.State.BLOCKED&&!f.cancelled.get(),"Stop cannot interleave between final gate and seal");
            };
            HeptaAccessibilityService.ActionOutcome outcome=f.await();yes(thread.get()!=null,"real finally entered shared monitor");thread.get().join(2000);
            yes(!thread.get().isAlive()&&f.cancelled.get(),"Stop proceeds immediately after the publication gate");
            f.persist(outcome);yes(f.permit()==null,"Stop before outcome consumption invalidates seal");f.closed();
        });
        one("actual_finally_rechecks_original_action_deadline",()->{
            final ControllerGuardClosureHost f=new ControllerGuardClosureHost("final-deadline");clockOwner=f;
            clockHook=()->NativeActionBridgeHost.SystemClock.now=f.service.actualGuard.deadline;
            HeptaAccessibilityService.ActionOutcome outcome=f.await();f.closed();f.persist(outcome);
            yes(f.permit()==null,"crossing original deadline before seal publishes no recovery");
        });
        one("exact_integer_types_are_not_collapsed_by_canonical_hash",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("integer-type");HeptaAccessibilityService.ActionOutcome outcome=f.await();
            int number=outcome.actionExecution.getInt("window_id");Object original=outcome.actionExecution.get("window_id");
            yes(original instanceof Integer,"host actual window identity begins as Integer");outcome.actionExecution.put("window_id",Long.valueOf(number));
            f.persist(outcome);yes(f.permit()==null,"same numeric value with a different runtime type cannot match sealed projection");f.closed();
        });
        one("actual_fsync_failure_cannot_publish_recovery",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("disk");HeptaAccessibilityService.ActionOutcome outcome=f.await();
            f.failJournal=true;IntegrationChecks.ioRejects(()->f.persist(outcome),"real outcome call is after successful journal");
            yes(f.permit()==null&&f.durableWrites==0,"no durable action receipt means no recovery");f.closed();
            f.fixture.session.retire();f.closed();
        });
        one("session_retirement_after_action_fsync_cannot_publish_recovery",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("retire-after-sync");HeptaAccessibilityService.ActionOutcome outcome=f.await();
            f.afterFsync=()->f.fixture.session.retire();IntegrationChecks.rejects(()->f.persist(outcome),"real Session retirement wins after journal");
            yes(f.durableWrites==1,"durable receipt retained without eligibility");f.closed();
        });
        one("duplicate_service_callback_cannot_substitute_the_sealed_outcome",()->{
            ControllerGuardClosureHost f=new ControllerGuardClosureHost("duplicate");f.service.mode="duplicate";
            HeptaAccessibilityService.ActionOutcome outcome=f.await();yes(outcome==f.service.delivered,"first actual callback wins");
            f.persist(outcome);yes(f.permit()!=null,"first exact drained refusal remains recoverable");f.closed();
        });
