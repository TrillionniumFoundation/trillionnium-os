    static Builder last;
    static final class Builder {
        String[] labels;
        int checked;
        Click single,positive;
        Builder(Object owner){}
        Builder setTitle(String value){return this;}
        Builder setMessage(String value){return this;}
        Builder setSingleChoiceItems(String[] items,int current,Click click){
            labels=items.clone();checked=current;single=click;return this;
        }
        Builder setNegativeButton(String text,Click click){return this;}
        Builder setPositiveButton(String text,Click click){positive=click;return this;}
        void show(){last=this;}
        void choose(int index){single.clicked(this,index);checked=index;}
        void confirm(){positive.clicked(this,-1);}
    }
}
