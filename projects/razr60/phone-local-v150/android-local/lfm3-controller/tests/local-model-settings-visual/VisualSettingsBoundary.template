final class LocalTaskController {
    final LocalInference inference;
    boolean running;
    String taskId;
    LocalTaskController(HeptaAccessibilityService service,LocalInference inference){this.inference=inference;}
    boolean isRunning(){return running;}
    void begin(String id){running=true;taskId=id;inference.beginTask(id);}
    LocalInference.TaskCleanup finish(){
        LocalInference.TaskCleanup proof=inference.endTask(taskId);
        if(proof.cleanupKnown)running=false;
        return proof;
    }
}
/** Model-loading boundary only. It owns the complete real shared-engine visual task lease. */
final class VlmInferenceAdapter implements LocalInference {
    static VlmInferenceAdapter last;
    static int constructed;
    static boolean throwAfterBegin;
    final LocalModelEngine engine;
    final LocalRuntimeConfig config;
    LocalModelEngine.TaskExternalLease lease;
    boolean known=true,foreignProof,cancelled;
    CurrentFrame observed;
    VlmInferenceAdapter(Context context,LocalModelEngine engine){
        this.engine=engine;this.config=engine.configuration();last=this;constructed++;
        if(config.profile!=ModelProfile.GUI_OWL_4B||!"npu".equals(config.compute)||config.contextTokens!=8192||config.threads!=4)
            throw new IllegalArgumentException("host VLM port requires the real pinned visual config");
    }
    @Override public LocalRuntimeConfig configuration(){return config;}
    @Override public boolean acceptsObservedImage(){return true;}
    @Override public boolean modelOutputDispatchAllowed(){return !config.visualObservationOnly;}
    @Override public long requestCompletionGraceMillis(){return VlmPins.COMPLETION_GRACE_MILLIS;}
    @Override public void beginTask(String task){
        lease=engine.reserveTaskExternal(task);
        if(throwAfterBegin)throw new IllegalStateException("host partial visual begin failure after actual reservation");
    }
    @Override public void cancelTask(){cancelled=true;if(lease!=null)lease.cancel();}
    @Override public TaskCleanup endTask(String expected){
        TaskCleanup.requireTaskId(expected);
        if(lease==null)return TaskCleanup.noWorker(expected);
        if(!expected.equals(lease.taskId))throw new IllegalStateException("foreign actual lease");
        if(foreignProof)return new TaskCleanup(true,false,false,null,lease.generation(),"ffffffffffffffffffffffffffffffff",true,null);
        TaskCleanup proof=new TaskCleanup(known,false,false,null,lease.generation(),lease.taskId,true,null);
        if(known){lease.endRequests();lease.releaseAfterTerminalPublication(true);lease=null;}
        return proof;
    }
    @Override public Handle generate(String p,String s,File image,DecisionGrammar grammar,int n,long t,Callback cb){
        throw new AssertionError("host visual port cannot run file-only inference");
    }
    @Override public Handle generateObserved(String p,String s,CurrentFrame frame,DecisionGrammar grammar,int n,long t,Callback cb){
        if(lease==null||frame==null||!lease.taskId.equals(frame.taskId))throw new IllegalArgumentException("host visual frame binding");
        observed=frame;return ()->cancelled=true;
    }
}
final class RecoveryQuiescence {
    static final class Sample {}
    static void confirm(List<Sample> samples,int uid,int pid){
        if(samples.isEmpty()||uid<10000||pid<=1)throw new IllegalStateException("host inventory boundary malformed");
    }
}
final class RecoveryProcessInventory {
    static List<RecoveryQuiescence.Sample> awaitInitial(Context context){
        List<RecoveryQuiescence.Sample> out=new ArrayList<RecoveryQuiescence.Sample>();out.add(capture(context));return out;
    }
    static RecoveryQuiescence.Sample capture(Context context){return new RecoveryQuiescence.Sample();}
}
final class PositiveAssetBoundaryEngine extends LocalModelEngine {
    int verifications;
    LocalRuntimeConfig selected;
    boolean reject;
    PositiveAssetBoundaryEngine(Context context){super(context);}
    @Override ModelFileVerifier verifySettingsModel(SettingsReservation lease,LocalRuntimeConfig target)throws Exception{
        lease.requireOwned();verifications++;selected=target;
        RuntimeConfigTransaction.requireSupported(target);
        if(reject)throw new IOException("explicit host asset-admission refusal");
        return new ModelFileVerifier();
    }
}
