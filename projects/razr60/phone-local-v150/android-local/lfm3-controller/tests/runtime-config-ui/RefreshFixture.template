    private static void present(File file)throws Exception{
        File parent=file.getParentFile();
        if(!parent.isDirectory()&&!parent.mkdirs())throw new IllegalStateException("fixture directory creation failed");
        if(!file.createNewFile())throw new IllegalStateException("fresh fixture file required");
    }
    private static void remove(File file)throws Exception{
        if(!file.delete())throw new IllegalStateException("fixture removal failed");
    }
    public static int entryChecks(File files)throws Exception{
        int before=checks;
        RuntimeConfigUiHostTest text=new RuntimeConfigUiHostTest(new File(files,"text"));
        present(text.engine.modelFile());
        check(text.beginTaskModelPreflightError()==null,"ordinary text entry preserves the existing file preflight");

        RuntimeConfigUiHostTest lfm=new RuntimeConfigUiHostTest(new File(files,"lfm"));
        lfm.engine.configuration.profile.select(ModelProfile.LFM3_VL_2B);
        lfm.engine.configuration.compute="npu";lfm.engine.configuration.visualObservationOnly=true;lfm.backgroundMode.checked=true;
        File model=lfm.engine.modelFile(),projector=new File(lfm.engine.modelDirectory(),VlmResultContract.LFM3_VL_2B.projectorFilename);
        File wrong=new File(lfm.engine.modelDirectory(),VlmResultContract.GUI_OWL_4B.projectorFilename);
        present(model);present(projector);
        check(lfm.beginTaskModelPreflightError()==null,"actual beginTask model guards must admit the correct LFM F16 pair");
        lfm.backgroundMode.checked=false;
        check(lfm.beginTaskModelPreflightError().contains("需要启用后台"),"LFM preflight preserves the background-only requirement");
        lfm.backgroundMode.checked=true;remove(projector);present(wrong);
        check(lfm.beginTaskModelPreflightError().contains("投影文件尚未导入"),"foreign GUI projector cannot admit LFM entry");
        remove(wrong);
        check(lfm.beginTaskModelPreflightError().contains("投影文件尚未导入"),"missing LFM projector cannot admit entry");
        present(projector);remove(model);
        check(lfm.beginTaskModelPreflightError().contains("所选本地模型尚未导入"),"correct projector cannot replace the LFM language model");
        present(model);lfm.tasks.running=true;
        check(lfm.beginTaskModelPreflightError().contains("已有本地请求"),"running task retains exclusive admission");
        lfm.tasks.running=false;lfm.tasks.blocked=true;
        check(lfm.beginTaskModelPreflightError().contains("已有本地请求"),"blocked task retains exclusive admission");
        lfm.tasks.blocked=false;lfm.engine.busy=true;
        check(lfm.beginTaskModelPreflightError().contains("已有本地请求"),"busy model retains exclusive admission");
        lfm.engine.busy=false;
        check(lfm.beginTaskModelPreflightError()==null&&lfm.renderCalls==0,"cleared fixture state admits only preflight without inference");

        RuntimeConfigUiHostTest gui=new RuntimeConfigUiHostTest(new File(files,"gui"));
        gui.engine.configuration.profile.select(ModelProfile.GUI_OWL_4B);gui.engine.configuration.compute="npu";gui.backgroundMode.checked=true;
        File guiProjector=new File(gui.engine.modelDirectory(),VlmResultContract.GUI_OWL_4B.projectorFilename);
        present(gui.engine.modelFile());present(guiProjector);
        check(gui.beginTaskModelPreflightError()==null,"actual GUI pair preserves ordinary visual entry");
        remove(guiProjector);present(new File(gui.engine.modelDirectory(),VlmResultContract.LFM3_VL_2B.projectorFilename));
        check(gui.beginTaskModelPreflightError().contains("投影文件尚未导入"),"foreign LFM F16 cannot admit GUI entry");
        present(guiProjector);gui.backgroundMode.checked=false;
        check(gui.beginTaskModelPreflightError().contains("需要启用后台"),"GUI preflight keeps the same background requirement");
        text.engine.busy=true;
        check(text.beginTaskModelPreflightError().contains("已有本地请求"),"text preflight keeps the same exclusive model gate");
        return checks-before;
    }

