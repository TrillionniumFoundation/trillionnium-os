        check(guiDirectory.mkdirs()&&guiPair.engine.modelFile().createNewFile(),"fresh actual GUI model fixture created");
        File wrongLfmProjector=new File(guiDirectory,VlmResultContract.LFM3_VL_2B.projectorFilename);
        check(wrongLfmProjector.createNewFile(),"foreign LFM projector fixture created in GUI directory");
        guiPair.refresh();check(guiPair.modelInfo.text.contains("本地模型待导入"),"LFM F16 projector must not satisfy the GUI visual pair");
        check(new File(guiDirectory,VlmResultContract.GUI_OWL_4B.projectorFilename).createNewFile(),"correct GUI projector fixture created");
        guiPair.refresh();check(guiPair.modelInfo.text.contains("本地模型已导入")&&guiPair.modelInfo.text.contains("本地视觉工具模式")&&!guiPair.modelInfo.text.contains("仅观察"),"correct GUI pair preserves the existing tools display");
        System.out.println("{\"passed\":"+checks+",\"failed\":0,\"production_methods_executed\":7,\"original_passed\":"+originalChecks+",\"visual_projector_passed\":"+(checks-originalChecks)+"}");
    }
}
