    public static void main(String[] args)throws Exception {
        File files=new File(args[0]);File model=new File(files,"model/model.bin");
        if(!model.getParentFile().mkdirs()||!model.createNewFile())throw new IllegalStateException("fresh model fixture required");

        RuntimeConfigUiHostTest invalid=new RuntimeConfigUiHostTest(files);
        invalid.engine.configurationError=CONFIG_ERROR;
        invalid.refresh();
        check(invalid.modelInfo.text.contains(CONFIG_ERROR),"configuration failure must remain visible");
        check(invalid.modelInfo.text.contains("运行参数待修正"),"configuration state must request repair");
        check(!invalid.modelInfo.text.contains("本地模型已导入"),"invalid configuration must not claim a usable model");
        check(!invalid.startTask.enabled&&!invalid.runText.enabled,"invalid configuration must disable new inference");
        check(!invalid.stopTask.enabled,"idle invalid configuration must not invent an active worker");
        check(invalid.openRootManager.enabled&&invalid.prepareBackgroundPermission.enabled,"configuration error must retain idle permission controls");
        check(invalid.backgroundMode.enabled&&invalid.pickBackgroundApps.enabled&&invalid.initialBackgroundApp.enabled,"configuration error must retain owner UI choices");
        invalid.refresh();
        check(invalid.modelInfo.text.contains(CONFIG_ERROR)&&CONFIG_ERROR.equals(invalid.engine.configurationError),"refresh must not clear or silently replace the configuration error");

        invalid.tasks.running=true;invalid.refresh();
        check(invalid.stopTask.enabled,"configuration error must not prevent Stop for an active task");
        check(!invalid.startTask.enabled&&!invalid.runText.enabled,"active task remains blocked from new work");
        invalid.tasks.running=false;invalid.engine.busy=true;invalid.refresh();
        check(invalid.stopTask.enabled,"configuration error must not prevent Stop for an external worker");
        invalid.engine.busy=false;invalid.tasks.backgroundLease=true;invalid.tasks.blocked=true;invalid.refresh();
        check(invalid.cleanupBackground.visibility==View.VISIBLE&&invalid.cleanupBackground.enabled,"configuration error must retain background cleanup");
        invalid.tasks.acknowledge=true;invalid.refresh();
        check(invalid.acknowledgeInterruption.enabled,"configuration error must retain eligible interruption recovery");

        RuntimeConfigUiHostTest background=new RuntimeConfigUiHostTest(files);
        background.backgroundMode.checked=true;background.backgroundPackages.add("example.notes");
        background.engine.configurationError=CONFIG_ERROR;background.refresh();
        check(background.backgroundMode.checked&&background.backgroundPackages.contains("example.notes"),"refresh must preserve selected background mode and range");
        check(!background.startTask.enabled,"background mode must not re-enable invalid configuration");

        RuntimeConfigUiHostTest valid=new RuntimeConfigUiHostTest(files);valid.refresh();
        check(valid.startTask.enabled&&valid.runText.enabled,"valid idle configuration must retain normal controls");
        check(valid.modelInfo.text.contains("fixture model")&&valid.modelInfo.text.contains("Adreno GPU")&&valid.modelInfo.text.contains("本地模型已导入"),"valid model status must remain accurate");
        valid.engine.configuration.compute="npu";valid.refresh();
        check(valid.modelInfo.text.contains("Hexagon NPU"),"NPU configuration must retain its selected backend");
        valid.engine.busy=true;valid.refresh();
        check(valid.stopTask.enabled&&!valid.startTask.enabled&&!valid.runText.enabled,"valid busy configuration retains Stop and existing gating");
        valid.engine.busy=false;valid.visualDiagnostic.blocked=true;valid.refresh();
        check(!valid.startTask.enabled&&!valid.runText.enabled,"configuration readiness must not bypass diagnostic recovery");

        RuntimeConfigUiHostTest missing=new RuntimeConfigUiHostTest(new File(files,"missing"));missing.refresh();
        check(missing.modelInfo.text.contains("本地模型待导入"),"valid configuration without weights retains missing-model status");
        check(missing.startTask.enabled&&missing.runText.enabled,"this repair must preserve existing missing-weight entry behavior");
        check(invalid.renderCalls==0&&background.renderCalls==0&&valid.renderCalls==0&&missing.renderCalls==0,"refresh must not launch inference or synthesize results");
        System.out.println("{\"passed\":"+checks+",\"failed\":0,\"production_methods_executed\":6}");
    }
}
