root ::= ws (find-app | open | click | scroll | back | home | wait | done) ws
find-app ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"find_app\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "," ws "\"query\"" ws ":" ws query-string ws "," ws "\"offset\"" ws ":" ws app-offset ws "}"
open ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"open\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws open-package ws "}"
open-package ::= "\"com.motorola.cn.calculator\""
click ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"click\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "," ws click-target ws "}"
click-target ::= ("\"node_label\"" ws ":" ws "\"超级互联\"" ws "," ws "\"node_id\"" ws ":" ws "\"n10\"") | ("\"node_label\"" ws ":" ws "\"设置\"" ws "," ws "\"node_id\"" ws ":" ws "\"n11\"") | ("\"node_label\"" ws ":" ws "\"超级文件\"" ws "," ws "\"node_id\"" ws ":" ws "\"n12\"") | ("\"node_label\"" ws ":" ws "\"手机管家\"" ws "," ws "\"node_id\"" ws ":" ws "\"n13\"") | ("\"node_label\"" ws ":" ws "\"相册\"" ws "," ws "\"node_id\"" ws ":" ws "\"n14\"") | ("\"node_label\"" ws ":" ws "\"文件夹：生活工具，3 个项目\"" ws "," ws "\"node_id\"" ws ":" ws "\"n15\"") | ("\"node_label\"" ws ":" ws "\"AI 搜索\"" ws "," ws "\"node_id\"" ws ":" ws "\"n2\"") | ("\"node_label\"" ws ":" ws "\"电话\"" ws "," ws "\"node_id\"" ws ":" ws "\"n3\"") | ("\"node_label\"" ws ":" ws "\"信息\"" ws "," ws "\"node_id\"" ws ":" ws "\"n4\"") | ("\"node_label\"" ws ":" ws "\"浏览器\"" ws "," ws "\"node_id\"" ws ":" ws "\"n5\"") | ("\"node_label\"" ws ":" ws "\"相机\"" ws "," ws "\"node_id\"" ws ":" ws "\"n6\"") | ("\"node_label\"" ws ":" ws "\"日历\"" ws "," ws "\"node_id\"" ws ":" ws "\"n8\"") | ("\"node_label\"" ws ":" ws "\"应用商店\"" ws "," ws "\"node_id\"" ws ":" ws "\"n9\"")
scroll ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"scroll\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "," ws scroll-target ws "}"
scroll-target ::= ("\"node_label\"" ws ":" ws "\"\"" ws "," ws "\"node_id\"" ws ":" ws "\"n0\"" ws "," ws "\"direction\"" ws ":" ws ("\"forward\""))
back ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"back\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "}"
home ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"home\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "}"
wait ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"wait\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "," ws "\"duration_ms\"" ws ":" ws duration ws "}"
done ::= "{" ws "\"reason\"" ws ":" ws reason-string ws "," ws "\"action\"" ws ":" ws "\"done\"" ws "," ws "\"observation_id\"" ws ":" ws "\"b5f4a8dda07e458089b0bed037077a82\"" ws "," ws "\"package\"" ws ":" ws "\"com.motorola.launcher3\"" ws "," ws "\"status\"" ws ":" ws status ws "," ws "\"summary\"" ws ":" ws summary-string ws "}"
status ::= "\"failure\"" | "\"partial\"" | "\"success\""
duration ::= [1-9] [0-9]{2} | "1" [0-9]{3} | "2000"
app-offset ::= "0" | [1-9] [0-9]{0,2} | [1-3] [0-9]{3} | "40" [0-8] [0-9] | "409" [0-5]
query-string ::= "\"" json-char{0,64} "\""
reason-string ::= "\"" json-char{1,96} "\""
text-string ::= "\"" json-char{0,1024} "\""
summary-string ::= "\"" json-char{1,1024} "\""
json-char ::= [^"\\\x00-\x1F] | "\\" ["\\/bfnrt]
ws ::= [ \t\n\r]{0,8}
