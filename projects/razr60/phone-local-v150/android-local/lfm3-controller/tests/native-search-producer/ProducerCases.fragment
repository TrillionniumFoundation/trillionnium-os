                NativeSearchSession.Attempt attempt=f.intent();f.graphHook=()->{if(f.graphReads==4){NodeData node=f.nodes.get("0/0/0");node.beforeRefresh=()->node.v.put("selected",true);}};
                f.action(attempt);noEffect(f,"latest signature and current reference rechecked");
