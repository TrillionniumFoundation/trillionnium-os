    static boolean inMethod(String type,String method){for(StackTraceElement s:Thread.currentThread().getStackTrace())if(s.getClassName().equals(type)&&s.getMethodName().equals(method))return true;return false;}
    static boolean entered(SearchActionWork work){return Boolean.TRUE.equals(work.state.evidence().get("effect_entered"));}
    static void noEffect(Fixture f,String detail){check(f.outcome!=null&&!f.outcome.accepted&&!f.outcome.dispatched,detail+": "+(f.outcome==null?"missing":f.outcome.detail));check(f.effects==0,"no real host API effect");check(!actionSlot.pending(),"effect slot drained");}
    static void noFailureFile(Fixture f){check(f.directory.listFiles((d,n)->n.endsWith("failed-native-search-planning.json")).length==0,"no private failure file");}
    static void rawBounds(Fixture f,boolean visible,int left,int right){Map<String,Object> n=f.values.nodes.get("0/2/0");n.put("visible",visible);n.put("bounds",Arrays.asList(left,600,right,800));}
    static ActionExecutionState legacyState(String id,long at){return new ActionExecutionState(id,NativeProfileIdentityHostTest.TASK,NativeSearchSessionHostTest.RUN,NativeSearchSessionHostTest.OBS,NativeSearchSessionHostTest.H,96,7,NativeActionSnapshotCheckHostTest.UUID,at,at+8000,()->SystemClock.now);}
    public static void main(String[] args)throws Exception {
        NativeProfileIdentityHostTest.workspace=Paths.get(args[1]);Files.createDirectories(NativeProfileIdentityHostTest.workspace);
        one("actual_profile_reply_contract_for_producer_fixture",()->{
            HeptaAccessibilityService service=new HeptaAccessibilityService();try(Fixture f=service.new Fixture()){
                Looper.main=false;WindowOwnership proof=f.base.env.session.verifyProfileWindow(96,1234,f.cancel(),SystemClock.now+12000);
                f.base.env.session.requireProfileWindow(proof,96,1234,SystemClock.now);check(proof.fullUid==f.base.env.target.fullUid,"actual registered proof");Looper.main=true;
            }
        });
        one("actual_planning_receipt_is_published_without_generic_current",()->{
            HeptaAccessibilityService service=new HeptaAccessibilityService();try(Fixture f=service.new Fixture()){
                f.plan();check(f.planning!=null,"actual planning producer must publish: "+f.error);
                check(f.graphReads==2,"exact complete A/B");check(service.current==null&&service.currentGraph==null,"no generic frame");
                check(!service.nativeSearchAllowsLegacyObservation(service.lease),"old observer unavailable before typed effect");
                check(f.planning.publication!=null,"real publication envelope");check(!observationIoBusy.get(),"read physically drained");
                check(f.directory.listFiles((d,n)->n.endsWith("failed-native-search-planning.json")).length==0,"success writes no failure diagnostic");
            }
        });
        one("actual_current_C_D_one_claim_one_node_effect_and_navigation_handoff",()->{
            HeptaAccessibilityService service=new HeptaAccessibilityService();try(Fixture f=service.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.action(attempt);
                check(f.outcome!=null&&f.outcome.accepted&&f.outcome.dispatched,"actual typed effect: "+(f.outcome==null?"missing":f.outcome.detail));
                check(f.effects==1&&f.graphReads==4,"one platform call and C/D after A/B");
                check(Boolean.TRUE.equals(f.outcome.actionExecution.get("effect_returned")),"real effect return preserved");
                f.base.search.acceptOutcome(attempt,f.outcome,sha(f.outcome.actionExecution.toString().getBytes(StandardCharsets.UTF_8)),SystemClock.now);
                check(service.nativeSearchAllowsLegacyObservation(service.lease),"old actual AX only after accepted typed effect");
                check(!actionSlot.pending(),"physical effect worker drained");
                for(NodeData node:f.nodes.values())check(node.obtained==node.recycled,"node reference finally drained");
            }
        });
        one("planning_records_historical_content_boundary_unknown_and_untyped_events",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();
                f.graphHook=()->{if(f.graphReads==2){s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,true,true);s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,false,true);s.noteNativeSearchEvent(-1,-1,null,false,false);}};
                observationIo.one();s.noteNativeSearchEvent(-1,-1,null,false,false);s.main.one();
                check(f.planning!=null,"historical planning may retain all actual late kinds: "+f.error);
                NativeSearchPlanning.EventMark mark=request.events.mark();check(mark.events==4&&mark.content==1&&mark.boundary==1&&mark.unknown==2,"all real callbacks retained");
                String publication=NativeSearchPlanning.json(f.planning.publication).toString();check(publication.contains("unknown")&&publication.contains("boundary"),"publication contains watermarks");
                check(!s.nativeSearchAllowsLegacyObservation(s.lease)&&f.effects==0,"historical events grant no old-frame authority");
            }
        });
        one("planning_same_value_controller_replacement_cannot_publish",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();observationIo.one();check(request.workerDrained,"original worker completed");s.ownedController=new Object();s.main.one();
                check(f.planning==null&&f.error!=null&&f.pendingAtError,"diagnostic ownership registered before terminal callback");
                check(request.workerDrained&&request.diagnosticWritePending&&!request.diagnosticWriteDrained&&observationIoBusy.get(),"independent successor state and capacity");
                observationIo.one();JSONObject d=f.diagnostic();check(d.getBoolean("read_worker_drained_before_write")&&"post_read_diagnostic_worker".equals(d.getString("diagnostic_writer_kind")),"honest successor provenance");
                check(request.workerDrained&&request.diagnosticWriteDrained&&!request.diagnosticWritePending&&!observationIoBusy.get(),"successor physically drained");
            }
        });
        one("publication_failure_diagnostic_queue_rejection_does_not_retry",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();observationIo.one();s.ownedController=new Object();observationIo.reject=true;s.main.one();
                check(f.error.contains("unavailable_queue_rejected")&&!f.pendingAtError,"definite diagnostic reject is explicit");
                check(request.workerDrained&&request.diagnosticWriteDrained&&!observationIoBusy.get()&&observationIo.submissions==2,"exact submit and no fake active worker");noFailureFile(f);
            }
        });
        one("publication_failure_uncertain_diagnostic_submit_waits_for_real_finally",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();observationIo.one();s.ownedController=new Object();observationIo.uncertain=true;s.main.one();
                check(request.workerDrained&&request.diagnosticWritePending&&!request.diagnosticWriteDrained&&f.pendingAtError,"uncertain queue cannot certify drain");
                observationIo.one();check(!observationIoBusy.get()&&request.diagnosticWriteDrained&&observationIo.submissions==2,"only actual queued writer releases capacity");f.diagnostic();
            }
        });
        one("publication_failure_diagnostic_cannot_clear_another_worker_capacity",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();observationIo.one();check(observationIoBusy.compareAndSet(false,true),"separate synthetic owner acquires capacity");
                s.ownedController=new Object();s.main.one();check(observationIoBusy.get()&&!request.diagnosticWritePending&&f.error.contains("unavailable_capacity"),"other owner retained");
                check(observationIo.submissions==1,"no second submission");observationIoBusy.set(false);noFailureFile(f);
            }
        });
        one("original_read_failure_keeps_its_last_complete_pair_before_drain",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                f.values.nodes.get("0/1/0").put("selected",false);NativeSearchRequest request=f.startPlanning();final int[] writes={0};
                android.system.Os.beforeWrite=()->{writes[0]++;check(!request.workerDrained&&observationIoBusy.get(),"raw write must precede original read drain");};
                observationIo.one();s.main.one();JSONObject d=f.diagnostic();
                check(f.planning==null&&f.error!=null&&!f.pendingAtError,"failed result remains failed after diagnostic");
                check(writes[0]>0&&d.getBoolean("complete_pair_available")&&!d.isNull("last_complete_pair"),"same request actual completed pair retained");
                check("original_read_worker".equals(d.getString("diagnostic_writer_kind"))&&!d.getBoolean("read_worker_drained_before_write"),"original worker source");
                JSONObject pair=d.getJSONObject("last_complete_pair");check(pair.getJSONObject("second").getLong("census_captured_elapsed_ms")<d.getLong("sampling_deadline_elapsed_ms"),"unrefreshed original census clock");
                check(d.getLong("request_deadline_elapsed_ms")==request.deadline&&d.getInt("new_samples_taken_for_diagnostic")==0&&!d.getBoolean("action_permission"),"no deadline or authority invention");
            }
        });
        one("failure_without_complete_pair_records_null_for_this_request",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                f.rootMissing=true;f.plan();JSONObject d=f.diagnostic();check(!d.getBoolean("complete_pair_available")&&d.isNull("last_complete_pair"),"no old pair borrowed");
                check(f.planning==null&&f.effects==0&&!observationIoBusy.get(),"terminal failure and real read drain");
            }
        });
        for(boolean inverted:new boolean[]{false,true}){final boolean backwards=inverted;one("raw_visible_"+(inverted?"inverted":"zero")+"_rectangle_refused_by_actual_planning_producer",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                rawBounds(f,true,200,backwards?100:200);f.plan();JSONObject d=f.diagnostic();
                check(f.planning==null&&d.getString("last_sample_rejection").contains("raw_visible_nonpositive_bounds: path=0/2/0"),"actual raw first path retained in rejection");
                check(d.getString("last_sample_rejection").contains("bounds=")&&f.effects==0,"same sampled bounds, no API effect");
            }
        });}
        one("raw_false_hidden_zero_rectangle_remains_legal",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                rawBounds(f,false,200,200);f.plan();check(f.planning!=null,"actual hidden zero row legal: "+f.error);check(f.effects==0,"no planning effect");
            }
        });
        one("raw_sidecar_uses_one_bounds_and_one_visibility_getter",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                rawBounds(f,true,200,200);f.syncNodes();NodeData data=f.nodes.get("0/2/0");AccessibilityNodeInfo node=new AccessibilityNodeInfo(data);Graph graph=new Graph();
                int beforeB=data.boundsReads,beforeV=data.visibleReads;
                try{NativeActionSnapshotCheck.Node row=snapshotNativeActionNode(node,"0/2/0","android.widget.LinearLayout",null,null,graph);
                    check(data.boundsReads-beforeB==1&&data.visibleReads-beforeV==1,"no second sampled getter");
                    check(graph.nativeSearchRawVisibilityChecked==1&&graph.nativeSearchInvalidRawVisibility&&Boolean.FALSE.equals(row.v.get("visible")),"raw evidence retained with unchanged legacy projection");
                    check("0/2/0".equals(graph.nativeSearchFirstInvalidRawPath)&&graph.nativeSearchFirstInvalidRawBounds.equals(Arrays.asList(200,600,200,800)),"same raw values");
                }finally{node.recycle();}
            }
        });
        one("missing_raw_sidecar_coverage_cannot_default_to_valid",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();Looper.main=false;Graph graph=f.graph(s.nativeSearchReadBudget(request),f.base.env.session);
                try{graph.nativeSearchRawVisibilityChecked=0;boolean refused=false;try{s.nativeSearchSnapshot(graph,f.base.search,request.id,request.started);}catch(StaleObservation error){refused=error.getMessage().startsWith("stale:raw_visibility_census_coverage:");}
                    check(refused,"typed snapshot requires all actual checked rows");
                }finally{graph.close();f.cancelled=true;Looper.main=true;}
                observationIo.one();s.main.one();
            }
        });
        one("raw_invalid_current_C_refused_before_claim_or_effect",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();rawBounds(f,true,200,100);f.action(attempt);noEffect(f,"raw current C must reject");
                check(f.outcome.detail.contains("raw_visible_nonpositive_bounds"),"current census rejection retained");
            }
        });
        one("raw_invalid_current_D_refused_before_claim_or_effect",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.graphHook=()->{if(f.graphReads==4)rawBounds(f,true,200,200);};f.action(attempt);noEffect(f,"raw current D must reject");
                check(f.outcome.detail.contains("raw_visible_nonpositive_bounds"),"current D same-read rejection");
            }
        });
        one("planning_persistence_readback_must_match_its_encoded_bytes",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                android.system.Os.afterFsync=path->{if(path.endsWith("-native-search-planning.json")){android.system.Os.afterFsync=null;try{Files.write(Paths.get(path)," ".getBytes(StandardCharsets.UTF_8),StandardOpenOption.APPEND);}catch(IOException e){throw new IllegalStateException(e);}}};
                f.plan();check(f.planning==null&&f.error.contains("persisted planning bytes differ"),"valid JSON replacement bytes cannot replace this encode");f.diagnostic();
            }
        });
        one("diagnostic_write_failure_remains_failed_and_physically_drains",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                android.system.Os.beforeWrite=()->{throw new IllegalStateException("synthetic file write failure");};f.plan();
                check(f.planning==null&&f.error.contains("unavailable_write_failed")&&!observationIoBusy.get(),"no diagnostic does not change result or cleanup");check(f.effects==0,"no fallback effect");
            }
        });
        one("planning_second_complete_census_cannot_extend_original_ten_seconds",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();f.graphHook=()->{if(f.graphReads==2)SystemClock.now=request.started+10000;};observationIo.one();s.main.one();JSONObject d=f.diagnostic();
                check(f.planning==null&&request.deadline==request.started+12000,"original request deadline not refreshed");
                check(d.getString("last_sample_rejection").contains("10秒")&&d.getLong("sampling_deadline_elapsed_ms")==request.started+10000,"original sampling limit and honest reason");
            }
        });
        one("planning_cancel_while_reading_keeps_capacity_until_worker_finally",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();f.graphHook=()->{f.cancelled=true;check(observationIoBusy.get()&&!request.workerDrained,"active read not falsely drained");};
                observationIo.one();s.main.one();check(f.planning==null&&request.workerDrained&&!observationIoBusy.get()&&f.callbackCount==1,"single failure after physical drain");
            }
        });
        one("main_post_failure_retains_diagnostic_capacity_without_deadlocking_next_work",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();s.main.reject=true;observationIo.one();check(f.error!=null&&request.workerDrained&&request.diagnosticWritePending,"post failure schedules only write worker");
                observationIo.one();check(!observationIoBusy.get()&&request.diagnosticWriteDrained&&f.callbackCount==1,"writer final cleanup survives main rejection");f.diagnostic();
            }
        });
        one("original_twelve_second_publication_deadline_is_executed",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();observationIo.one();
                check(request.workerDrained&&request.lastCompletePair!=null,"real A/B completed before publication");
                SystemClock.now=request.deadline;s.main.one();
                check(f.planning==null&&f.error!=null&&request.finished&&!request.published,"actual publication at original deadline refused");
                check(request.deadline==request.started+12000&&request.failureElapsed==request.deadline,"original actual deadline clock retained");
                check(f.pendingAtError&&request.diagnosticWritePending&&!request.diagnosticWriteDrained,"successor diagnostic owned before error callback");
                observationIo.one();JSONObject d=f.diagnostic();
                check(d.getLong("failed_elapsed_ms")==request.deadline&&d.getBoolean("complete_pair_available"),"late publication keeps honest original pair/time");
                check(f.effects==0&&f.callbackCount==1&&!observationIoBusy.get(),"no effect or fake callback after diagnostic drain");
            }
        });
        one("original_twelve_second_watchdog_waits_for_the_real_read_worker",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest request=f.startPlanning();check(!s.main.delayed.isEmpty(),"actual watch callback scheduled");
                SystemClock.now=request.deadline;s.main.delayed.remove(0).run();
                check(f.planning==null&&f.error!=null&&request.finished&&f.callbackCount==1,"actual watchdog expired the original request");
                check(!request.workerDrained&&f.pendingAtError&&observationIoBusy.get()&&!request.diagnosticWritePending,"watchdog does not pretend queued read drained");
                observationIo.one();s.main.one();JSONObject d=f.diagnostic();
                check(request.workerDrained&&!observationIoBusy.get()&&f.callbackCount==1,"real finally releases read and no duplicate terminal callback");
                check(d.getLong("failed_elapsed_ms")==request.deadline&&!d.getBoolean("complete_pair_available")&&d.isNull("last_complete_pair"),"watchdog cannot borrow an unobserved pair");
                check("original_read_worker".equals(d.getString("diagnostic_writer_kind"))&&f.effects==0,"only original read writes bounded failure metadata");
            }
        });
        one("permission_UI_worker_blocks_new_typed_dispatch_after_model_latency",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();ProfilePermissionUiSession.pending=true;f.action(attempt);noEffect(f,"existing permission worker admission");check(actionIo.submissions==0,"no typed worker queued");ProfilePermissionUiSession.pending=false;
            }
        });
        one("same_value_new_authorization_Gate_cannot_replace_current_dispatch_owner",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();s.taskAuthorization=f.base.authority.bind(s.lease);f.action(attempt);noEffect(f,"actual Gate object required");check(actionIo.submissions==0,"rejected before worker");
            }
        });
        one("installed_identity_recheck_failure_prevents_current_effect",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.base.verifierFails=true;f.action(attempt);noEffect(f,"real verifier endpoint refusal");
            }
        });
        one("cancellation_before_dispatch_does_not_queue_an_effect",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.cancelled=true;f.action(attempt);noEffect(f,"cancelled admission");check(actionIo.submissions==0,"no queued work");
            }
        });
        one("queue_delay_consumes_original_eight_seconds",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();SearchActionWork work=f.startAction(attempt);SystemClock.now=attempt.deadlineElapsed;actionIo.one();s.main.one();noEffect(f,"reserved deadline remains original");
                check(work.state.queuedElapsed==attempt.startedElapsed,"queue clock is reservation");
            }
        });
        for(int type=0;type<3;type++){final int kind=type;one("current_C_D_rejects_"+new String[]{"unknown","boundary","untyped"}[type]+"_event",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.graphHook=()->{if(f.graphReads==4)s.noteNativeSearchEvent(kind==0?-1:7,96,NativeAppGoal.XIAOMI_PACKAGE,kind==0,kind!=2);};
                f.action(attempt);noEffect(f,"strict current C/D event fence");
            }
        });}
        one("current_C_D_typed_content_with_real_role_equality_remains_eligible",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.graphHook=()->{if(f.graphReads==4)s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,true,true);};
                f.action(attempt);check(f.outcome.accepted&&f.effects==1,"content interval proved by current actual pair");
            }
        });
        one("any_event_after_complete_D_prevents_effect",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.windowHook=()->{if(s.activeSearchAction!=null&&s.activeSearchAction.pairCompleted!=null){f.windowHook=null;s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,true,true);}};
                f.action(attempt);noEffect(f,"no late content bypass after D");
            }
