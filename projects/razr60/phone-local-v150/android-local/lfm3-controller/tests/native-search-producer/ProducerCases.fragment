        one("same_values_new_C_D_Android_node_identity_is_refused",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.replaceTargetOnSecond=true;f.action(attempt);noEffect(f,"current C node must survive D");check(f.outcome.detail.contains("replaced"),"specific node identity refusal");
            }
