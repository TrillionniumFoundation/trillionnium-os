        one("actual_effect_then_cancel_is_recorded_without_replay",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.effectHook=()->f.cancelled=true;f.action(attempt);
                check(!f.outcome.accepted&&f.outcome.dispatched&&f.effects==1,"effect preserved despite cancelled callback");
                check(f.outcome.actionExecution.getBoolean("effect_returned"),"real return retained");check(!actionSlot.pending(),"cancelled effect worker drains");
            }
        });
        one("platform_API_false_is_not_promoted_to_navigation_success",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.apiAccepts=false;f.action(attempt);
                check(!f.outcome.accepted&&f.outcome.dispatched&&f.effects==1,"one actual rejected call retained");
                rejected(()->f.base.search.acceptOutcome(attempt,f.outcome,sha(f.outcome.actionExecution.toString().getBytes(StandardCharsets.UTF_8)),SystemClock.now));
                check(!s.nativeSearchAllowsLegacyObservation(s.lease),"no post-effect generic handoff from rejected API");
            }
        });
        one("consumed_Attempt_cannot_repeat_an_effect",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.action(attempt);check(f.effects==1&&f.outcome.accepted,"first effect succeeds");
                f.action(attempt);check(f.effects==1&&!f.outcome.accepted,"same attempt is one use");
            }
        });
        one("typed_late_callback_after_new_work_registration_is_not_accepted",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();SearchActionWork work=f.startAction(attempt);actionIo.one();check(!actionSlot.pending()&&f.effects==1,"real effect physically drained");
                ActionExecutionState next=legacyState("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",SystemClock.now);check(actionSlot.acquire(next),"drained old slot admits new work before callback");s.lastActionExecution=next;
                s.main.one();check(!f.outcome.accepted&&f.outcome.dispatched&&f.effects==1,"retired typed callback preserves effect");next.drained();actionSlot.release(next);
                check(work.state.evidence().get("callback_published").equals(Boolean.TRUE),"old callback consumed exactly once");
            }
        });
        one("legacy_late_callback_after_typed_registration_keeps_old_effect_but_rejects_acceptance",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                ActionExecutionState old=legacyState("cccccccccccccccccccccccccccccccc",SystemClock.now);check(actionSlot.acquire(old),"old owns shared slot");
                AccessibilityNodeInfo oldNode=new AccessibilityNodeInfo(f.nodes.get("0/0/0"));try{old.enterEffect(false,true);old.effectReturned(Boolean.valueOf(oldNode.performAction(AccessibilityNodeInfo.ACTION_CLICK)));}finally{oldNode.recycle();}old.drained();actionSlot.release(old);
                ActionExecutionState next=legacyState("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",SystemClock.now);check(actionSlot.acquire(next),"new shared slot owner after old physical drain");s.lastActionExecution=next;
                final ActionOutcome[] delivered={null};s.legacyCallback(new LegacyWork(old),()->false,new ActionOutcome(true,true,false,"real synthetic old effect"),value->delivered[0]=value);
                check(delivered[0]!=null&&!delivered[0].accepted&&delivered[0].dispatched&&delivered[0].actionExecution.getBoolean("effect_returned")&&f.effects==1,"verbatim old callback rejects only stale acceptance");
                next.drained();actionSlot.release(next);
            }
        });
        one("typed_main_callback_post_failure_does_not_permanently_latch_slot",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();SearchActionWork work=f.startAction(attempt);s.main.reject=true;actionIo.one();
                check(f.effects==1&&work.state.isDrained()&&!actionSlot.pending(),"effect facts survive undelivered callback");
                ActionExecutionState next=legacyState("eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",SystemClock.now);check(actionSlot.acquire(next),"no permanent unpublished-state latch");next.drained();actionSlot.release(next);
            }
        });
        boolean all=true;for(Map<String,Object> row:cases)all&=Boolean.TRUE.equals(row.get("passed"));
        Map<String,Object> report=new LinkedHashMap<String,Object>();report.put("schema","hepta.native-search-actual-producer-cases.v1");
        report.put("cases",cases.size());report.put("assertions",assertions);report.put("all_pass",all);report.put("results",cases);
        report.put("android_execution",false);report.put("phone_operations",0);report.put("business_verified",false);
        Files.write(Paths.get(args[0]),NativeSearchPlanning.json(report).toString(2).getBytes(StandardCharsets.UTF_8));
        System.out.println("actual HA producer cases="+cases.size()+" assertions="+assertions+" all_pass="+all);
        if(!all)throw new AssertionError("actual HA producer failure; see original CASES.json");
    }
