        one("event_during_final_blocking_profile_check_prevents_platform_call",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();final boolean[] triggered={false};
                android.app.KeyguardManager.beforeCheck=()->{SearchActionWork work=s.activeSearchAction;if(work!=null&&entered(work)&&inMethod("org.trillionnium.hepta.local.BackgroundSession","requireProfileWindow")&&!triggered[0]){triggered[0]=true;s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,true,true);}};
                f.action(attempt);noEffect(f,"last profile RPC cannot hide D-late event");check(triggered[0]&&f.outcome.actionExecution.getBoolean("effect_entered"),"entry fact survives refusal");
            }
