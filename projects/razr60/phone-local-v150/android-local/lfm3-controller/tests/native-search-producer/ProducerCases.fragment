        one("final_reported_window_change_is_refused",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();f.windowHook=()->{if(s.activeSearchAction!=null&&s.activeSearchAction.pairCompleted!=null)f.actualWindow=97;};
                f.action(attempt);noEffect(f,"full window set fence");
            }
        });
        one("profile_proof_expiry_during_final_blocking_check_prevents_platform_call",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt attempt=f.intent();final boolean[] triggered={false};
                android.app.KeyguardManager.beforeCheck=()->{SearchActionWork work=s.activeSearchAction;if(work!=null&&entered(work)&&inMethod("org.trillionnium.hepta.local.BackgroundSession","requireProfileWindow")&&!triggered[0]){triggered[0]=true;SystemClock.now=work.profileBeforeEffect.expiresElapsedMs;}};
                f.action(attempt);noEffect(f,"same original profile proof expiry");check(triggered[0]&&f.outcome.actionExecution.getBoolean("effect_entered"),"actual entered fact retained at late expiry");
                check(!f.outcome.actionExecution.getJSONObject("native_search_execution").getBoolean("platform_call_invoked"),"no false API dispatch");
            }
