    static ObservedScrollActions readScrollActions(AccessibilityNodeInfo node){
        if(node.data.owner.fixture.recordedPlanningNodes){
            String raw=node.s("scroll_actions");
            if("hepta.observed-scroll-actions.v1|observed".equals(raw))return ObservedScrollActions.observed(Collections.<String>emptyList());
            if("hepta.observed-scroll-actions.v1|observed|forward".equals(raw))return ObservedScrollActions.observed(Collections.singletonList("forward"));
            if("hepta.observed-scroll-actions.v1|observed|forward|backward".equals(raw))return ObservedScrollActions.observed(Arrays.asList("forward","backward"));
            throw new AssertionError("unrecognized recorded scroll action");
        }
        return ObservedScrollActions.observed(node.isScrollable()?Arrays.asList("forward","backward"):Collections.<String>emptyList());
    }
