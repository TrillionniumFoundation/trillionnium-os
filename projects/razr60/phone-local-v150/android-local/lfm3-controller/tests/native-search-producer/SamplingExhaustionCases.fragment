        one("sampling_loading_and_sampling_recovery_share_the_same_initial_ordinal2",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture();SamplingRun r=new SamplingRun(s,f)){
                loadingRetryReady(s,f);NativeSearchReadRetryProof loading=f.retryProof;
                samplingExhaustion(f,true);
                s.observeNativeSearchPlanning(s.lease,f.directory,f.base.search,f.cancel(),SystemClock.now+12000,r.callback(true),loading);
                s.main.one();NativeSearchRequest second=s.activeNativeSearchObservation;observationIo.one();s.main.one();
                check(second.retrySubmission==loading&&second.samplingExhaustion!=null&&r.proof==null&&f.error!=null,"loading successor cannot consume another sampling slot");
                check(s.taskObservationAdmissions==2&&s.nativeSearchSamplingTracked==null&&f.effects==0,"same shared slot and no effects");
            }
        });
        for(int variant=0;variant<3;variant++){final int mode=variant;
            one("sampling_actual_LTC_"+new String[]{"late_callback_timeout","cancel_during_intent_write","intent_write_failure"}[variant]+"_closes_proof",()->{
                HeptaAccessibilityService s=new HeptaAccessibilityService();NativeSearchLoadingControllerHost controller=new NativeSearchLoadingControllerHost(s);
                try(Fixture f=s.new Fixture(controller)){
                    controller.bind(f.base.search);samplingExhaustion(f,false);final boolean[] hit={false};
                    if(mode==0)SystemClock.beforeRead=()->{
                        NativeSearchRequest old=s.nativeSearchSamplingTracked;
                        if(old!=null&&old.samplingIssued!=null&&successorStack("org.trillionnium.hepta.local.NativeSearchLoadingControllerHost","awaitNativeSearchPlanningOnce")){
                            SystemClock.beforeRead=null;hit[0]=true;SystemClock.now=old.deadline;
                        }
                    };
                    else android.system.Os.beforeChmod=path->{
                        if(path.endsWith("/native-search-initial-sampling-retry-01.json")){
                            // Actual LTC record uses FileOutputStream+FD.sync, then
                            // Os.chmod. Its final IO endpoint is explicit host IO.
                            hit[0]=true;if(mode==1)controller.cancelled.set(true);else throw new IllegalStateException("synthetic controller record chmod failure");
                        }
                    };
                    Throwable failure=samplingController(controller,f);
                    check(hit[0]&&failure!=null,"actual controller rejection path exercised");
                    check(s.nativeSearchSamplingTracked==null&&f.graphReads==3&&s.taskObservationAdmissions==1&&f.effects==0,
                            "actual timeout/cancel/record failure closes proof before new read: tracker="+(s.nativeSearchSamplingTracked!=null)
                            +", reads="+f.graphReads+", admissions="+s.taskObservationAdmissions+", effects="+f.effects);
                }
            });
        }
    }
