                check(r.old.samplingAnchor==earliest[0]&&r.old.samplingAnchor.baseline.boundary==7&&f.graphReads==5
                        &&r.proof==null&&f.error!=null&&s.nativeSearchSamplingTracked==null,"earliest anchor never replaced to erase mismatch");
            }
