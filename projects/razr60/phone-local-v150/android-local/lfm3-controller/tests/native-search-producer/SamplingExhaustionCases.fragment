                check(r.fresh.started==oldDeadline-1&&f.planning.publishedElapsed>oldDeadline,"one independently admitted read can finish after old request has expired");
                check(r.old.deadline==oldDeadline&&r.fresh.deadline<=r.fresh.started+12000&&f.base.search.chainDeadlineElapsed==chain,"neither original request nor chain was extended");
