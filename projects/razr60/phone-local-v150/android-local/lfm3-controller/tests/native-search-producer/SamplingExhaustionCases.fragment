        one("sampling_later_complete_owner_mismatch_is_latched_and_never_rebaselined",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture();SamplingRun r=new SamplingRun(s,f)){
                f.refreshGraphChildren=true;r.start(true);final NativeSearchSamplingAnchor[] earliest={null};
                f.graphHook=()->{
                    if(f.graphReads<=2){samplingNormal(f);if(f.graphReads==2)samplingBadGeometry(f);}
                    else if(f.graphReads<=4){
                        // A separately complete, owned window has a real different ID
                        // in both the graph and every raw node. Its normal -> changed
                        // geometry pair still fails the real Role comparison.
                        if(f.graphReads==3)earliest[0]=r.old.samplingAnchor;
                        f.actualWindow=97;samplingNormal(f);if(f.graphReads==4)samplingBadGeometry(f);
                        for(Map<String,Object> node:f.values.nodes.values())node.put("window_id",97);
                    }else{
                        f.actualWindow=96;samplingNormal(f);SystemClock.now=r.old.started+9990;f.nodes.get("0/2/0").refresh=false;
                    }
