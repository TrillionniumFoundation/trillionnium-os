                check(s.nativeSearchSamplingTracked==null&&f.effects==0&&!observationIo.hasJobs(),"no third read, model or effect");
                check(f.directory.listFiles((d,n)->n.endsWith("-failed-native-search-planning.json")).length==2,"both failed request diagnostics retained separately");
            }
