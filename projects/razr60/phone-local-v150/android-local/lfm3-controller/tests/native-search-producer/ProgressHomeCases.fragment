    static void recordedHomeSample(Fixture f,JSONObject original){
        f.values=f.base.census(SystemClock.now);f.values.nodes.clear();f.observableLoadingProjection=true;f.recordedPlanningNodes=true;
        for(Object value:original.getJSONArray("nodes")){
            Map<String,Object> v=((JSONObject)value).toMap();v.put("window_id",f.actualWindow);
            f.values.nodes.put((String)v.get("path"),v);
        }
    }
    static void r38ReadPreparationCases()throws Exception{
        byte[] bytes=Files.readAllBytes(Paths.get(System.getProperty("hepta.test.progressHome")).resolveSibling("r38-planning-captures.json"));
        check("edd185366183654e2c859d98e28eb0d13d22c7b2fb6752c1b7e4340a7d561c49".equals(sha(bytes)),"actual R38 saved complete frames and failure watermarks");
        JSONObject records=new JSONObject(new String(bytes,StandardCharsets.UTF_8));
        JSONObject load=records.getJSONObject("loading"),history=records.getJSONObject("boundary"),warm=records.getJSONObject("warm");
        JSONObject a=load.getJSONObject("frames").getJSONObject("first"),b=load.getJSONObject("frames").getJSONObject("second");
        one("r38_actual_loading_history_and_warm_read_budget",()->{
            NativeActionSnapshotCheck.Snapshot shell=fullSwapSnapshot(a.getJSONObject("census")),home=fullSwapSnapshot(b.getJSONObject("census"));
            check(shell.nodes.size()==14&&home.nodes.size()==73&&Integer.valueOf(2195).equals(shell.env.get("window_id")),"two complete original frames");
            check(Boolean.TRUE.equals(NativeSearchRole.loadingToSearch(shell,home).get("fresh_full_pair_required")),"original shell to stable search role, read only");
            NativeSearchPlanning.EventMark start=NativeSearchPlanning.EventMark.read(a.getJSONObject("before_watermark").toMap());
            NativeSearchPlanning.EventMark end=NativeSearchPlanning.EventMark.read(load.getJSONObject("failure_watermark").toMap());
            check(start.boundary==3&&start.unknown==0&&end.content==30&&end.contentOnlySince(start),"all three boundary events precede first complete read");
            JSONObject frame=history.getJSONObject("frames").getJSONObject("first");
            NativeSearchPlanning.EventMark old=NativeSearchPlanning.EventMark.read(frame.getJSONObject("before_watermark").toMap());
            NativeSearchPlanning.EventMark later=NativeSearchPlanning.EventMark.read(frame.getJSONObject("after_watermark").toMap());
            check(later.boundary-old.boundary==17&&!later.contentOnlySince(old),"actual new boundary during capture prevents reuse of that interval");
            check(!warm.getBoolean("complete_pair_available")&&"planning_second_graph".equals(warm.getString("failure_phase")),"warm stale read has no complete pair");
            long startWarm=warm.getLong("request_started_elapsed_ms"),endWarm=warm.getLong("failed_elapsed_ms");
            check(endWarm-startWarm==10028&&warm.getLong("sampling_deadline_elapsed_ms")<endWarm,"original sampling expired in second full graph");
            long cap=NativeSearchPlanning.initialReadDeadline(startWarm,startWarm+174000);
            check(cap==startWarm+30000&&NativeSearchPlanning.samplingDeadline(startWarm,cap)==startWarm+28000,"same initial read remains eligible");
            check(NativeSearchPlanning.initialReadDeadline(startWarm,startWarm+5000)==startWarm+5000,"existing task/chain bound prevails");
            check(NativeSearchPlanning.initialReadDeadline(Long.MAX_VALUE-1,Long.MAX_VALUE)==Long.MAX_VALUE,"elapsed cutoff cannot wrap");
        });
        one("r38_preexisting_boundaries_allow_only_fresh_two_reads_and_late_ready_home",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest first=f.startPlanning(null,30000);
                for(int n=0;n<3;n++)s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,false,true);
                f.graphHook=()->recordedHomeSample(f,(f.graphReads==1?a:b).getJSONObject("census"));
                observationIo.one();s.main.one();observationIo.one();s.main.one();
                check(first.workerDrained&&!first.published&&f.retryProof!=null&&f.graphReads==2&&f.planning==null&&f.effects==0,
                        "actual loading pair cannot plan; only a new read may start: "+f.error);
                NativeSearchRequest fresh=f.startPlanning(f.retryProof,30000);
                f.graphHook=()->{
                    if(f.graphReads==3)SystemClock.now=fresh.started+14000;
                    recordedHomeSample(f,b.getJSONObject("census"));
                };
                observationIo.one();s.main.one();
                check(f.planning!=null&&f.graphReads==4&&f.effects==0&&fresh!=first,"two independently read home frames with no effect: "+f.error);
                check(f.planning.timing.aReadStarted>=fresh.started&&f.planning.timing.bReadCompleted>fresh.started+14000
                        &&fresh.deadline-fresh.started==30000,"new actual pair acquired after previous ceiling");
            }
        });
        one("r38_during_first_read_boundary_cannot_issue_loading_retry",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchRequest first=f.startPlanning(null,30000);
                f.graphHook=()->{
                    if(f.graphReads==1)s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,false,true);
                    if(f.graphReads>2)f.cancelled=true;
                    recordedHomeSample(f,(f.graphReads==1?a:b).getJSONObject("census"));
                };
                observationIo.one();s.main.one();
                check(first.loadingRetryClassification==null&&f.retryProof==null&&f.planning==null&&f.effects==0,"new boundary during A disqualifies the real pair");
            }
        });
    }
    static void progressHomeCases()throws Exception{
        r38ReadPreparationCases();
        byte[] bytes=Files.readAllBytes(Paths.get(System.getProperty("hepta.test.progressHome")));
        check("ebb895f5647bc01f712e81b2f699761efb349817c622036fdee58acbf1311090".equals(sha(bytes)),"recorded two complete planner censuses");
        JSONObject source=new JSONObject(new String(bytes,StandardCharsets.UTF_8));
        JSONObject a=source.getJSONObject("first"),b=source.getJSONObject("second");
        one("recorded_dcc738_progress_to_supported_home_only_reopens_sampling",()->{
            check(source.getBoolean("complete_pair_available")&&source.getBoolean("diagnostic_only")
                    &&!source.getBoolean("planning_published")&&!source.getBoolean("action_permission"),"original was a failed read");
            NativeActionSnapshotCheck.Snapshot first=fullSwapSnapshot(a),second=fullSwapSnapshot(b);
            check(first.nodes.size()==20&&second.nodes.size()==77&&Integer.valueOf(2051).equals(first.env.get("window_id")),"complete real 20/77 pair");
            Map<String,Object> cls=NativeSearchRole.loadingToSearch(first,second);
            check("complete_home_with_progress".equals(cls.get("first_phase"))&&cls.get("first_census_sha256").equals(first.sha)
                    &&cls.get("second_census_sha256").equals(second.sha),"typed exact historical transition");
            check(Boolean.TRUE.equals(cls.get("fresh_full_pair_required"))&&Boolean.FALSE.equals(cls.get("planning_created"))
                    &&Boolean.FALSE.equals(cls.get("grants_action_authority"))&&Boolean.FALSE.equals(cls.get("original_pair_accepted")),
                    "no old frame, plan, action or authorization");
            rejected(()->NativeSearchRole.compare(first,second));rejected(()->NativeSearchRole.loadingToSearch(first,first));
        });
        for(String fault:Arrays.asList("off_center","large_spinner","spinner_action","spinner_text","spinner_view","pager_scroll",
                "cover","extra_root_child","missing_child","tab_relabel","tab_gap","changed_chrome","foreign_window",
                "foreign_package","partial","before_time","second_search_missing","second_spinner","sheet_replaces_spinner")){
            one("recorded_dcc738_refuses_"+fault,()->{
                JSONObject left=new JSONObject(a.toString()),right=new JSONObject(b.toString());
                JSONObject bar=swapNode(left,"0/0/0"),pager=swapNode(left,"0/0");
                if("off_center".equals(fault))bar.getJSONArray("bounds").put(0,577).put(2,645);
                else if("large_spinner".equals(fault))bar.put("bounds",new JSONArray().put(212).put(1096).put(1012).put(1896));
                else if("spinner_action".equals(fault))bar.put("clickable",true).put("action_click",true);
                else if("spinner_text".equals(fault))bar.put("description","去登录");
                else if("spinner_view".equals(fault))bar.put("view_id","com.xiaomi.shop:id/foreign_button");
                else if("pager_scroll".equals(fault))pager.put("scroll_actions","hepta.observed-scroll-actions.v1|observed|backward");
                else if("cover".equals(fault))swapNode(left,"0/1").put("bounds",new JSONArray().put(0).put(0).put(1224).put(2992));
                else if("extra_root_child".equals(fault))swapNode(left,"0").put("children",16);
                else if("missing_child".equals(fault))left.getJSONArray("nodes").remove(2);
                else if("tab_relabel".equals(fault))swapNode(left,"0/2/0").put("label","付款");
                else if("tab_gap".equals(fault)){
                    swapNode(left,"0/2/1").getJSONArray("bounds").put(0,537);swapNode(right,"0/2/1").getJSONArray("bounds").put(0,537);
                }else if("changed_chrome".equals(fault))swapNode(right,"0/4").put("description","新消息");
                else if("foreign_window".equals(fault))right.getJSONObject("envelope").put("window_id",0);
                else if("foreign_package".equals(fault))bar.put("package","any.other");
                else if("partial".equals(fault))left.getJSONObject("envelope").put("child_omissions",1);
                else if("before_time".equals(fault))right.getJSONObject("envelope").put("captured_elapsed_ms",a.getJSONObject("envelope").getLong("captured_elapsed_ms"));
                else if("second_search_missing".equals(fault))swapNode(right,"0/0/3").put("view_id","");
                else if("second_spinner".equals(fault))swapNode(right,"0/0/1/3/0/0").put("class","android.widget.ProgressBar");
                else bar.put("class","android.widget.FrameLayout");
                rejected(()->NativeSearchRole.loadingToSearch(fullSwapSnapshot(left),fullSwapSnapshot(right)));
            });
        }
        one("recorded_dcc738_nodes_stop_first_worker_and_request_one_fresh_pair",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();
            try(Fixture f=s.new Fixture()){
                long started=SystemClock.now;
                f.graphHook=()->{
                    // The recorded first content event was already attributed to an owned
                    // window. Establish that state through earlier real reader calls.
                    if(f.graphReads==3||f.graphReads==4){
                        String key=f.graphReads==3?"first":"second";
                        JSONArray times=source.getJSONObject("times_from_request_start_ms").getJSONArray(key);
                        SystemClock.now=started+times.getLong(0);
                        // The existing framework timing port advances in three integer stages.
                        f.graphDuration=times.getInt(1)-times.getInt(0);
                        JSONArray content=source.getJSONObject("content_watermarks").getJSONArray(key);
                        int previous=f.graphReads==3?0:source.getJSONObject("content_watermarks").getJSONArray("first").getInt(1);
                        for(int e=previous;e<content.getInt(1);e++)s.noteNativeSearchEvent(7,96,NativeAppGoal.XIAOMI_PACKAGE,true,true);
                    }else f.graphDuration=15;
                    recordedHomeSample(f,f.graphReads<=3?a:b);
                };
                NativeSearchRequest first=f.startPlanning();observationIo.one();s.main.one();
                check(first.workerDrained&&f.graphReads==4&&f.planning==null&&f.retryProof==null,"fresh typed failure waits for worker drain; reads="+f.graphReads+" drained="+first.workerDrained+" old="+first.lastSampleRejection+" error="+f.error);
                observationIo.one();s.main.one();
                check(f.retryProof!=null&&first.samplingExhaustion==null&&f.effects==0&&f.planning==null,"only the typed loading successor exists");
                JSONObject original=f.diagnostic();
                check(original.getBoolean("complete_pair_available")&&!original.getBoolean("action_permission"),"historical complete failed pair preserved");
                check(SystemClock.now-started>=9017&&SystemClock.now-started<10000,"typed transition fits the recorded warm request budget");
                NativeSearchRequest fresh=f.startPlanning(f.retryProof);
                observationIo.one();s.main.one();
                check(f.planning!=null&&f.graphReads==6&&fresh!=first&&f.effects==0,"two independent synthetic future reads after the genuine historical A/B; no input");

            }
        });
    }
