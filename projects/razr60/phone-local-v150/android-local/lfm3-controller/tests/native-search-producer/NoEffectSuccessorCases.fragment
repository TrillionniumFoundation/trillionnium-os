        one("post_refresh_actual_LTC_new_model_and_new_intent_only_once",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();NativeSearchNoEffectControllerHost controller=new NativeSearchNoEffectControllerHost(s);
            try(Fixture f=s.new Fixture(controller)){
                controller.bind(f);controller.beforeModel=n->{if(n==1)armTargetRefreshEvent(s,f,3,null);};Throwable failure=pumpController(controller,f);
                if(failure!=null)throw new AssertionError("actual second-fence Controller successor failed",failure);
                check(controller.modelCalls==2&&controller.completedSteps==2&&controller.oldAxCalls==1&&f.effects==1,"actual unchanged LTC branch makes a new model call and one new intent");
                check(new HashSet<String>(controller.modelRuns).size()==2&&new HashSet<String>(controller.modelObservations).size()==2,"original model output/observation not reused");
                JSONObject first=new JSONObject(new String(Files.readAllBytes(new File(f.directory,"step-01-action.json").toPath()),StandardCharsets.UTF_8));
                JSONObject second=new JSONObject(new String(Files.readAllBytes(new File(f.directory,"step-02-action.json").toPath()),StandardCharsets.UTF_8));
                check(!first.getBoolean("accepted")&&!first.getBoolean("dispatched")&&second.getBoolean("accepted")&&second.getBoolean("dispatched"),"old actual failed receipt remains distinct from later navigation acceptance");
                check(f.base.journalNames.contains("native-search-no-effect-retirement-01.json")&&f.base.journalNames.contains("native-search-navigation-attempt-02.json"),"same actual Session ledger preserves durable retirement and unique next intent");
            }
        });
        one("post_refresh_actual_LTC_second_rejection_has_no_third_attempt",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();NativeSearchNoEffectControllerHost controller=new NativeSearchNoEffectControllerHost(s);
            try(Fixture f=s.new Fixture(controller)){
                controller.bind(f);controller.beforeModel=n->armTargetRefreshEvent(s,f,3,null);Throwable failure=pumpController(controller,f);
                check(failure!=null&&controller.modelCalls==2&&f.effects==0&&s.taskObservationAdmissions==2,"same existing one-successor cap stops repeated second-fence rejection");
                check(new File(f.directory,"step-01-action.json").isFile()&&new File(f.directory,"step-02-action.json").isFile(),"both actual failed outcomes retained");
            }
        });
