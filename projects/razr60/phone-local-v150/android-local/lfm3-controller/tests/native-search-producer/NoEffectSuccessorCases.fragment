                    check("Stopped".equals(stopped.getClass().getSimpleName()),"known late rejected callback only terminates: "+stopped);
                    JSONObject terminal=new JSONObject(new String(Files.readAllBytes(record.toPath()),StandardCharsets.UTF_8));
                    JSONObject evidence=terminal.getJSONObject("execution");
                    check(evidence.getBoolean("retired")&&evidence.getBoolean("worker_drained")&&evidence.getBoolean("callback_published")
                            &&!evidence.getBoolean("callback_authority_current")&&!terminal.getBoolean("navigation_verified")
                            &&!terminal.getBoolean("automatic_redispatch"),"actual service publishes only retired evidence");
                }else{
                    check("CleanupUnknown".equals(stopped.getClass().getSimpleName()),"missing accepted return or write failure remains blocked: "+stopped);
                    if(scenario==1)check(!record.exists(),"no qualified drain for unaccepted platform call");
                    else check(Arrays.equals(Files.readAllBytes(record.toPath()),new byte[]{4,9}),"old record never replaced");
                }
                check(!actionSlot.pending()&&!new File(f.directory,"step-01-action.json").exists(),"physical slot drained and no timely action receipt");
            }
        });}
