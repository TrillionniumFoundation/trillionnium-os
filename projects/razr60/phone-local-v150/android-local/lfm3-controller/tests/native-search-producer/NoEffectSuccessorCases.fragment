            }
        });
        for(int event=0;event<3;event++){final int kind=event;one("post_refresh_bad_event_"+kind+"_never_mints_proof",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NoEffectRun r=beginTargetRefreshRejection(s,f,f.intent(),kind,null);
                check(r.work.afterTargetRefreshRejectedWatermark!=null&&!r.work.typedAfterTargetRefreshPostDEventRejected,"actual unknown/boundary/untyped watermark retained without eligible cause");
                check(!actionIo.hasJobs(),"ineligible second fence does not claim a serial proof marker");s.main.one();
                check(r.proof==null&&r.outcome!=null&&!r.outcome.accepted&&!r.outcome.dispatched&&r.outcome.stale,"bad event remains a failed no-effect outcome");
                check(!Boolean.TRUE.equals(r.attempt.evidence().get("claimed"))&&s.taskObservationAdmissions==1,"no claimed old intent or successor read");
            }
        });}
        one("post_refresh_actual_root_metadata_change_still_refused",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NoEffectRun r=beginTargetRefreshRejection(s,f,f.intent(),3,()->f.windowTitle="changed actual fixture window title");
                check(r.work.afterTargetRefreshEventsElapsed<0&&!r.work.hasNoEffectReplanFence(),"actual changed root/window metadata rejects before the dedicated event fence");
                s.main.one();check(r.proof==null&&r.outcome!=null&&r.outcome.detail.contains("root/window metadata changed"),"window failure cannot be classified from a later content event or error string");
            }
        });
        for(int entered=0;entered<2;entered++){final boolean effect=entered==1;one("post_refresh_later_"+(effect?"effect_entered":"claimed")+"_generic_fence_never_replans",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt a=f.intent();NoEffectRun r=submitCapturedSearch(s,f,a);final boolean[] injected={false};
                SystemClock.beforeRead=()->{
                    SearchActionWork work=s.activeSearchAction;
                    if(work!=null&&successorStack("org.trillionnium.hepta.local.HeptaAccessibilityService$SearchActionWork","requireFinalEvents")
                            &&Boolean.TRUE.equals(work.attempt.evidence().get("claimed"))&&work.state.effectEntered()==effect){
                        SystemClock.beforeRead=null;injected[0]=true;successorEvent(s,3);
                    }
                };
                actionIo.one();s.main.one();
                check(injected[0]&&Boolean.TRUE.equals(a.evidence().get("claimed"))&&r.work.state.effectEntered()==effect,"real original claim/effect entry preceded the unchanged generic fence");
                check(r.work.afterTargetRefreshEventsElapsed>=0&&!r.work.hasNoEffectReplanFence()&&r.work.afterTargetRefreshRejectedWatermark==null,"passed second fence does not authorize any later rejection");
                check(r.proof==null&&r.outcome!=null&&!r.outcome.accepted&&f.effects==0&&!r.work.platformCallInvoked,"even zero platform calls cannot infer retry after claim/effect entry");
                check(s.taskObservationAdmissions==1,"no new planning admitted after claim/effect");
            }
        });}
        one("post_refresh_original_deadline_before_read_replacement_no_proof",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt a=f.intent();armTargetRefreshEvent(s,f,3,null);
                SystemClock.beforeRead=()->{if(inMethod("org.trillionnium.hepta.local.HeptaAccessibilityService$SearchActionWork","discardFinalCensusForResample")){
                    SystemClock.beforeRead=null;SystemClock.now=a.deadlineElapsed;
                }};
                NoEffectRun r=submitCapturedSearch(s,f,a);actionIo.one();s.main.one();
                check(r.work.afterTargetCensusRepairSelected&&r.work.typedAfterTargetRefreshPostDEventRejected,"live typed second fence preceded the original deadline");
                check(r.proof==null&&r.outcome!=null&&!r.outcome.accepted&&f.effects==0&&f.graphReads==4,"original expiry prevents replacement without a new model or clock");
            }
        });
        one("post_refresh_deadline_during_actual_ancestor_refresh_no_proof",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt a=f.intent();NoEffectRun r=beginTargetRefreshRejection(s,f,a,3,()->SystemClock.now=a.deadlineElapsed);
                check(!r.work.hasNoEffectReplanFence(),"expired real refresh cannot establish a typed preclaim cause");
                s.main.one();check(r.proof==null&&r.outcome!=null&&!r.outcome.accepted&&f.effects==0,"unchanged deadline/check guard stops the old action");
            }
        });
        one("post_refresh_same_worker_read_replacement_needs_no_new_marker_submission",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt a=f.intent();armTargetRefreshEvent(s,f,3,null);NoEffectRun r=submitCapturedSearch(s,f,a);
                int queued=actionIo.submissions;actionIo.reject=true;actionIo.one();actionIo.reject=false;s.main.one();
                check(r.outcome.accepted&&r.outcome.dispatched&&f.effects==1&&f.graphReads==6,"one original worker completes the replacement and original input");
                check(r.proof==null&&actionIo.submissions==queued&&!r.work.replanDrainMarkerCompleted,"no serial successor marker or additional worker submission exists on this path");
            }
        });
        one("post_refresh_cancel_before_read_replacement_no_proof",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();try(Fixture f=s.new Fixture()){
                NativeSearchSession.Attempt a=f.intent();armTargetRefreshEvent(s,f,3,null);
                SystemClock.beforeRead=()->{if(inMethod("org.trillionnium.hepta.local.HeptaAccessibilityService$SearchActionWork","discardFinalCensusForResample")){
                    SystemClock.beforeRead=null;f.cancelled=true;
                }};
                NoEffectRun r=submitCapturedSearch(s,f,a);actionIo.one();s.main.one();
                check(r.work.afterTargetCensusRepairSelected&&r.proof==null&&r.outcome!=null&&!r.outcome.accepted&&f.effects==0&&f.graphReads==4,"cancelled original worker cannot reacquire or mint successor authority");
            }
        });
        one("post_refresh_actual_LTC_one_model_same_intent_read_replacement",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();NativeSearchNoEffectControllerHost controller=new NativeSearchNoEffectControllerHost(s);
            try(Fixture f=s.new Fixture(controller)){
                controller.bind(f);controller.beforeModel=n->{if(n==1)armTargetRefreshEvent(s,f,3,null);};Throwable failure=pumpController(controller,f);
                if(failure!=null)throw new AssertionError("actual same-intent read replacement failed",failure);
                check(controller.modelCalls==1&&controller.completedSteps==1&&controller.oldAxCalls==1&&f.effects==1,"unchanged LTC receives the one original intent after fresh full C/D");
                check(new HashSet<String>(controller.modelRuns).size()==1&&new HashSet<String>(controller.modelObservations).size()==1,"no second model answer or observation is requested");
                JSONObject first=new JSONObject(new String(Files.readAllBytes(new File(f.directory,"step-01-action.json").toPath()),StandardCharsets.UTF_8));
                check(first.getBoolean("accepted")&&first.getBoolean("dispatched")&&!new File(f.directory,"step-02-action.json").exists(),"one accepted original receipt, no invented failed step or replay");
                check(!f.base.journalNames.contains("native-search-no-effect-retirement-01.json")&&!f.base.journalNames.contains("native-search-navigation-attempt-02.json"),"unchanged Session does not manufacture a successor");
            }
        });
        one("post_refresh_actual_LTC_replacement_unstable_has_no_second_attempt",()->{
            HeptaAccessibilityService s=new HeptaAccessibilityService();NativeSearchNoEffectControllerHost controller=new NativeSearchNoEffectControllerHost(s);
            try(Fixture f=s.new Fixture(controller)){
                controller.bind(f);controller.beforeModel=n->{if(n==1)armTargetRefreshEvent(s,f,3,null);};
                // The first normal refresh remains the original SDK refresh hook above.
                // Replacement instability is a new event after the replacement D census.
                final boolean[] replacementPostDInjected={false};
                SystemClock.beforeRead=()->{SearchActionWork w=s.activeSearchAction;
                    if(w!=null&&w.finalCensusResamples==1&&w.latestSnapshot!=null
                            &&w.firstFinalEventsElapsed>=0
                            &&inMethod("org.trillionnium.hepta.local.HeptaAccessibilityService$SearchActionWork","requireAfterTargetRefreshEvents")){
                        SystemClock.beforeRead=null;replacementPostDInjected[0]=true;successorEvent(s,3);
                    }};
                Throwable failure=pumpController(controller,f);
                check(replacementPostDInjected[0]&&f.graphReads==6,"the second instability is injected at the actual replacement post-D event fence");
                check(failure!=null&&controller.modelCalls==1&&f.effects==0&&s.taskObservationAdmissions==1,"a second late event in the one replacement stops the same attempt");
                check(new File(f.directory,"step-01-action.json").isFile()&&!new File(f.directory,"step-02-action.json").exists(),"only the genuine failed original outcome is retained");
                check(!f.base.journalNames.contains("native-search-no-effect-retirement-01.json"),"selected repair cannot escape into the unchanged successor branch");
            }
        });
    }
