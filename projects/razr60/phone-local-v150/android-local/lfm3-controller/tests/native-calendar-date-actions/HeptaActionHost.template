    static final class HostQueue {
        final ArrayDeque<Runnable> queue=new ArrayDeque<Runnable>();boolean reject;
        synchronized void execute(Runnable r){if(reject)throw new RejectedExecutionException("explicit host queue rejection");queue.add(r);notifyAll();}
        synchronized Runnable take()throws Exception{long end=System.nanoTime()+TimeUnit.SECONDS.toNanos(5);
            while(queue.isEmpty()&&System.nanoTime()<end)wait(10);
            if(queue.isEmpty())throw new AssertionError("expected actual queued work");return queue.remove();}
        synchronized int size(){return queue.size();}
    }
    final class HostMain {
        final HostQueue queue=new HostQueue();
        boolean post(Runnable r){
            if(workerRunnableExecuting&&inlinePublication){
                if(beforePublishHook!=null)beforePublishHook.run();
                callbackInsideWorker=true;r.run();if(afterCallbackHook!=null)afterCallbackHook.run();return true;
            }
            queue.execute(r);return true;
        }
        boolean postDelayed(Runnable r,long delay){throw new AssertionError("host watchdog scheduling is an explicit omitted timer port");}
    }
