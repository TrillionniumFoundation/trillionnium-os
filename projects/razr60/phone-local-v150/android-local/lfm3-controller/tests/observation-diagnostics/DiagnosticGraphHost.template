                change(a,i,"view_id",DiagnosticChecks.repeat('v',256));change(b,i,"view_id",DiagnosticChecks.repeat('w',256));
                change(a,i,"class",DiagnosticChecks.repeat('c',128));change(b,i,"class",DiagnosticChecks.repeat('d',128));}
