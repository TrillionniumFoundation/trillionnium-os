                Map<String,Object> fields=profile(mode==0?402:401,mode==1?"99999999-2222-3333-4444-555555555555":"11111111-2222-3333-4444-555555555555");
                if(mode==2)fields.put("profile_full_uid",1010486);if(mode!=3)b.profileWindow=new ProfileIdentity(fields);
                ObservationDiagnostics d=tracker();d.fullGraphChange("saved_graph",fullStamp(a),fullStamp(b),1200);
                DiagnosticChecks.check(delta(d).getString("status").equals("identity_mismatch")&&!delta(d).getBoolean("full_census_compared"),"profile diagnostic identity "+mode);
