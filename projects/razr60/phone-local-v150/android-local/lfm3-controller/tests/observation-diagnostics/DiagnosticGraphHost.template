            Graph g=fullGraph(20);ObservationDiagnostics.CensusStamp stamp=fullStamp(g);
            DiagnosticChecks.check(stamp!=null&&stamp.nodes.size()==20&&g.rows.size()==1,"complete copied BFS, not retained subset");
            DiagnosticChecks.check(stamp.identity.get("task_id").equals(DiagnosticChecks.TASK)&&stamp.nodes.get("0/18").equals(g.nativeActionNodes.get(19).v),"actual graph identities and immutable node values");
            g.nativeActionNodes.clear();DiagnosticChecks.check(stamp.nodes.size()==20,"already copied diagnostic independent of graph list");
        });
        DiagnosticChecks.run("full_census_adapter_never_upgrades_partial_unknown_or_missing_evidence",()->{
            for(int variant=0;variant<16;variant++){Graph g=fullGraph(3);
                switch(variant){case 0:g.nativeObservationComplete=false;break;case 1:g.truncated=true;break;case 2:g.collectionStats=null;break;
                    case 3:g.collectionStats.incomplete=true;break;case 4:g.collectionStats.visited++;break;case 5:g.collectionStats.pending=1;break;
                    case 6:g.collectionStats.nodeBudgetOmissions=1;break;case 7:g.collectionStats.textBudgetOmissions=1;break;case 8:g.collectionStats.childSlotsOmitted=1;break;
                    case 9:g.nativeActionWindows=null;break;case 10:g.state.imeVisibility=ImeVisibility.UNKNOWN;break;case 11:g.nativeActionNodes=null;break;
                    case 12:g.nativeActionWidth=0;break;case 13:g.nativeActionText=32769;break;case 14:g.nativeActionBytes=1048577;break;default:g.nativeActionTaskId=null;}
                DiagnosticChecks.check(fullStamp(g)==null,"unavailable variant "+variant);
            }
            DiagnosticChecks.check(fullStamp(null)==null,"absent graph");
        });
        DiagnosticChecks.run("full_census_adapter_enforces_complete_paths_and_existing_limits",()->{
            Graph g=fullGraph(3);g.nativeActionNodes.remove(2);g.collectionStats.visited=2;DiagnosticChecks.check(fullStamp(g)==null,"missing child cannot be full");
            g=fullGraph(3);g.nativeActionNodes.set(2,g.nativeActionNodes.get(1));DiagnosticChecks.check(fullStamp(g)==null,"duplicate path");
            g=fullGraph(3);change(g,2,"parent_class","foreign.Parent");DiagnosticChecks.check(fullStamp(g)==null,"actual parent relationship");
            g=fullGraph(3);change(g,1,"package","foreign.app");DiagnosticChecks.check(fullStamp(g)==null,"foreign node");
            DiagnosticChecks.check(fullStamp(fullGraph(1536))!=null&&fullStamp(fullGraph(1537))==null,"existing full node cap unchanged");
        });
        DiagnosticChecks.run("full_census_difference_keeps_structure_fields_and_redacts_all_content",()->{
            Graph a=fullGraph(3),b=fullGraph(3);change(b,1,"text","SECOND_PRIVATE_BODY");change(b,1,"description","SECOND_PRIVATE_DESCRIPTION");
            change(b,1,"label","SECOND_PRIVATE_LABEL");change(b,1,"bounds",Arrays.asList(1,2,1000,2390));change(b,1,"focused",true);
            change(b,1,"view_id",DiagnosticChecks.APP+":id/changed");ObservationDiagnostics d=tracker();d.fullGraphChange("screenshot_graph",fullStamp(a),fullStamp(b),1200);
            JSONObject j=delta(d),row=j.getJSONArray("node_differences").getJSONObject(0),before=row.getJSONObject("before"),after=row.getJSONObject("after");
            DiagnosticChecks.check(j.getBoolean("full_census_compared")&&j.getInt("changed_path_count")==1&&row.getString("native_path").equals("0/0")&&row.getString("parent_path").equals("0"),"actual changed path");
            DiagnosticChecks.check(after.getString("view_id").endsWith(":id/changed")&&after.getString("class").equals("android.widget.TextView")
                    &&after.getString("parent_class").equals("android.widget.FrameLayout")&&after.getJSONObject("flags").getBoolean("focused")&&after.getJSONArray("bounds").getInt(0)==1,"interpretable original structure");
            DiagnosticChecks.check(row.getJSONArray("changed_fields").toString().contains("description")&&row.getJSONArray("changed_fields").toString().contains("view_id"),"named field differences");
            DiagnosticChecks.check(before.getJSONObject("text").getInt("utf16_length")=="PRIVATE_BODY_NOT_FOR_DIAGNOSTIC".length()
