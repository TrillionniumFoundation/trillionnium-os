                if(key.equals("target"))b.nativeActionTargetSha=DiagnosticChecks.repeat('b',64);if(key.equals("goal"))b.nativeActionGoalSha=DiagnosticChecks.repeat('b',64);
                d=tracker();d.fullGraphChange("saved_graph",fullStamp(a),fullStamp(b),1200);JSONObject j=delta(d);
