    static Graph graph(int count){Graph g=new Graph();for(int i=0;i<count;i++)g.rows.add(new PhoneObservation.Node("n"+i,"0/"+i));return g;}
    static Map<String,Object> node(String path,int children){
        Map<String,Object> n=new LinkedHashMap<String,Object>();n.put("path",path);n.put("parent_class","0".equals(path)?"":"android.widget.FrameLayout");
        n.put("package",DiagnosticChecks.APP);n.put("window_id",71);n.put("class","0".equals(path)?"android.widget.FrameLayout":"android.widget.TextView");
        n.put("view_id",DiagnosticChecks.APP+":id/node"+path.replace('/','_'));n.put("text","PRIVATE_BODY_NOT_FOR_DIAGNOSTIC");
        n.put("description","PRIVATE_DESCRIPTION_NOT_FOR_DIAGNOSTIC");n.put("label","PRIVATE_LABEL_NOT_FOR_DIAGNOSTIC");
        n.put("ref_signature_sha256",DiagnosticChecks.OWNER);n.put("input_sha256",null);n.put("bounds",Arrays.asList(0,0,1080,2400));
        for(String flag:Arrays.asList("visible","enabled","clickable","editable","scrollable","focused","password","selected","checkable","checked","action_click"))
            n.put(flag,Boolean.valueOf("visible".equals(flag)||"enabled".equals(flag)));
        n.put("children",children);n.put("scroll_actions","observed_none");n.put("ime_enter","observed_absent");return n;
    }
    static Graph fullGraph(int count){
        Graph g=graph(1);g.nativeObservationComplete=true;g.collectionStats=new PhoneObservation.CollectionStats();g.collectionStats.visited=count;
        g.nativeActionWindows=Collections.<String,Object>singletonMap("already_captured",true);g.nativeActionNodes=new ArrayList<NativeActionSnapshotCheck.Node>();
        for(int i=0;i<count;i++){
            Map<String,Object> n=node(i==0?"0":"0/"+(i-1),i==0?count-1:0);
            // Keep the full 1,536-node boundary within the original content cap.
            if(count>100){n.put("text","");n.put("description","");n.put("label",null);}
            g.nativeActionNodes.add(new NativeActionSnapshotCheck.Node(n));
        }
        return g;
    }
    static void change(Graph g,int index,String key,Object value){
        Map<String,Object> n=new LinkedHashMap<String,Object>(g.nativeActionNodes.get(index).v);n.put(key,value);
        g.nativeActionNodes.set(index,new NativeActionSnapshotCheck.Node(n));
    }
    static ObservationDiagnostics.CensusStamp fullStamp(Graph g){return nativeDiagnosticCensus(g);}
    static ObservationDiagnostics tracker(){return new ObservationDiagnostics(DiagnosticChecks.TASK,DiagnosticChecks.REQUEST,DiagnosticChecks.OWNER,
            DiagnosticChecks.APP,DiagnosticChecks.GENERATION,9,1,1000,13000);}
