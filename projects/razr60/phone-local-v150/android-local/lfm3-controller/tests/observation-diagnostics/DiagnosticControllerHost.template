    static DiagnosticControllerHost fresh(){SystemClock.now=1000;ObserverPipelineHost.SystemClock.now=1000;return new DiagnosticControllerHost();}
    PhoneObservation call()throws Exception{return call(21000);}
    PhoneObservation call(long taskDeadline)throws Exception{return awaitObservationRaw(DiagnosticChecks.TASK,new File("host-diagnostic-no-actual-write"),new TaskAuthorization.Gate(),taskDeadline);}
    int diagnostics(){return pendingObservationDiagnostics.size();}
    static DiagnosticControllerHost failedPrivate(boolean terminal)throws Exception{
        DiagnosticControllerHost f=fresh();f.service.originalError="original immutable failure";f.service.privatePair=true;
        if(terminal)f.service.privateTerminal="failed";
        try{f.call();throw new AssertionError("failure lost");}catch(IllegalStateException expected){
            DiagnosticChecks.check(expected.getMessage().equals(f.service.originalError),"diagnostic changed original error");
        }
        return f;
    }
    static JSONObject persist(DiagnosticControllerHost f){return f.persistFailedCensusDiagnostic(DiagnosticChecks.TASK,"failed",false,new File("host-private-no-actual-write"));}
    static void runTests()throws Exception{
        DiagnosticChecks.run("actual_controller_consumes_static_Service_snapshot_and_original_result",()->{
            DiagnosticControllerHost f=fresh();PhoneObservation o=f.call();DiagnosticChecks.check(o==f.service.value&&f.service.observeCalls==1&&f.service.remoteChecks==1&&f.service.authorityChecks==4,"original success path");
            DiagnosticChecks.check(f.diagnostics()==1&&f.service.snapshotCalls==1&&f.service.cancellation.isCancelled(),"finally snapshot once after abandonment");
            JSONObject d=new JSONObject(f.pendingObservationDiagnostics.get(0));DiagnosticChecks.check(d.getLong("deadline_elapsed_ms")==13000,"same fixed total observation deadline");
        });
        DiagnosticChecks.run("actual_controller_keeps_original_observation_error_and_records_diagnostic",()->{
            DiagnosticControllerHost f=fresh();f.service.originalError="original immutable observer error";
            try{f.call();throw new AssertionError("error lost");}catch(IllegalStateException e){DiagnosticChecks.check(e.getMessage().equals(f.service.originalError),"original exception wins");}
            DiagnosticChecks.check(f.diagnostics()==1&&f.service.observeCalls==1&&f.service.authorityChecks==0,"no retry or authority");
        });
        DiagnosticChecks.run("actual_controller_timeout_uses_original_deadline_and_one_final_snapshot",()->{
            DiagnosticControllerHost f=fresh();f.service.timeout=true;try{f.call();throw new AssertionError("timeout lost");}catch(IllegalStateException e){DiagnosticChecks.check(e.getMessage().equals("original observation timeout"),"original timeout wins");}
            DiagnosticChecks.check(f.diagnostics()==1&&f.service.observeCalls==1&&SystemClock.now==13000,"no deadline renewal or retry");
        });
        DiagnosticChecks.run("actual_controller_accepts_before_total_deadline_and_ignores_duplicate_callback",()->{
            DiagnosticControllerHost f=fresh();f.service.callbackAt=12999;f.service.duplicateCallback=true;
            DiagnosticChecks.check(f.call()==f.service.value&&f.service.observedDeadline==13000,"fixed total deadline before callback");
            f.service.callback.onObservation(new PhoneObservation());f.service.callback.onError("after abandonment");
            DiagnosticChecks.check(f.service.authorityChecks==4&&f.written.size()==1&&f.diagnostics()==1&&f.service.cancellation.isCancelled(),"duplicate callback changed accepted result");
        });
        DiagnosticChecks.run("actual_controller_rejects_success_callback_at_exact_total_deadline",()->{
            DiagnosticControllerHost f=fresh();f.service.callbackAt=13000;
            try{f.call();throw new AssertionError("late success accepted");}catch(IllegalStateException e){DiagnosticChecks.check(e.getMessage().equals("original observation timeout"),"deadline error changed");}
            DiagnosticChecks.check(f.service.observeCalls==1&&f.service.authorityChecks==0&&f.written.isEmpty()&&f.diagnostics()==1,"late callback gained observation authority");
        });
        DiagnosticChecks.run("actual_controller_short_task_clips_total_observation_deadline",()->{
            DiagnosticControllerHost f=fresh();DiagnosticChecks.check(f.call(5000)==f.service.value,"short task success");
            DiagnosticChecks.check(f.service.observedDeadline==5000&&new JSONObject(f.pendingObservationDiagnostics.get(0)).getLong("deadline_elapsed_ms")==5000,"task clip lost");
        });
        DiagnosticChecks.run("actual_controller_task_cutoff_wins_over_queued_success",()->{
            DiagnosticControllerHost f=fresh();f.service.callbackAt=5000;
            try{f.call(5000);throw new AssertionError("task-expired success accepted");}catch(IllegalStateException e){DiagnosticChecks.check(e.getMessage().equals("original task stopped"),"task cutoff priority changed");}
            DiagnosticChecks.check(f.service.observeCalls==1&&f.service.authorityChecks==0&&f.written.isEmpty()&&f.diagnostics()==1,"expired task gained observation authority");
        });
        DiagnosticChecks.run("actual_controller_default_missing_diagnostic_is_compatible",()->{
            DiagnosticControllerHost f=fresh();f.service.omitDiagnostic=true;DiagnosticChecks.check(f.call()==f.service.value&&f.diagnostics()==0&&f.service.snapshotCalls==0,"default callback compatibility");
        });
        for(final String field:new String[]{"task_id","request_id","schema","background_generation","owner_sha256","package","deadline","sequence","oversize"})
            DiagnosticChecks.run("actual_controller_rejects_diagnostic_"+field+"_without_replacing_result",()->{
                DiagnosticControllerHost f=fresh();f.service.mutation=field;DiagnosticChecks.check(f.call()==f.service.value&&f.diagnostics()==0&&f.service.observeCalls==1,"bad diagnostic altered success");
            });
        DiagnosticChecks.run("actual_controller_snapshot_exception_cannot_replace_original_failure",()->{
            DiagnosticControllerHost f=fresh();f.service.originalError="original failure before snapshot";f.service.throwDiagnostic=true;
            try{f.call();throw new AssertionError("error lost");}catch(IllegalStateException e){DiagnosticChecks.check(e.getMessage().equals(f.service.originalError),"snapshot failure replaced error");}
            DiagnosticChecks.check(f.diagnostics()==0&&f.service.snapshotCalls==1&&f.observationDiagnosticErrors==1,"bounded error without IO");
        });
        DiagnosticChecks.run("actual_controller_finally_adds_no_IO_and_terminal_uses_existing_result",()->{
            DiagnosticControllerHost f=fresh();f.call();DiagnosticChecks.check(f.written.size()==1&&f.diagnostics()==1,"only original scope record before cleanup");
            JSONObject collected=f.takeObservationDiagnostics(DiagnosticChecks.TASK);
            f.record(new File("fixture-terminal"),"result.json",new JSONObject().put("observation_diagnostics",collected));
            DiagnosticChecks.check(f.written.size()==2&&collected.getInt("additional_file_writes")==0&&collected.getJSONArray("records").length()==1,"existing result only");
            DiagnosticChecks.check(f.diagnostics()==0&&f.observationDiagnosticErrors==0&&f.takeObservationDiagnostics(DiagnosticChecks.TASK)==null,"take clears once");
        });
        DiagnosticChecks.run("private_actual_controller_defers_source_and_one_write_until_terminal",()->{
            DiagnosticControllerHost f=failedPrivate(true);
            DiagnosticChecks.check(f.service.privateSnapshotCalls==0&&f.written.isEmpty()&&f.pendingFailedCensusDiagnostic!=null,"no private snapshot or IO before cleanup");
            JSONObject receipt=persist(f),raw=f.written.get("failed-native-census.json");
            DiagnosticChecks.check(receipt.getBoolean("artifact_written")&&receipt.getBoolean("complete_pair_recorded")&&f.service.privateSnapshotCalls==1&&f.written.size()==1,"one terminal source and private file");
            DiagnosticChecks.check(raw.toString().contains("RAW_PRIVATE_CENSUS_ONLY")&&!receipt.toString().contains("RAW_PRIVATE_CENSUS_ONLY"),"raw confined to private artifact");
            byte[] bytes=raw.toString(2).getBytes(StandardCharsets.UTF_8);
            DiagnosticChecks.check(bytes.length==receipt.getInt("bytes")&&HeptaAccessibilityService.sha(bytes).equals(receipt.getString("sha256")),"receipt pins exact pretty bytes");
            DiagnosticChecks.check(persist(f)==null&&f.written.size()==1&&f.service.privateSnapshotCalls==1,"no replay or duplicate private write");
        });
        DiagnosticChecks.run("private_actual_controller_success_drops_pending_without_source_or_IO",()->{
            DiagnosticControllerHost f=failedPrivate(true);
            DiagnosticChecks.check(f.persistFailedCensusDiagnostic(DiagnosticChecks.TASK,"model_reported_done",true,new File("unused"))==null,"successful task has no raw artifact");
            DiagnosticChecks.check(f.pendingFailedCensusDiagnostic==null&&f.service.privateSnapshotCalls==0&&f.written.isEmpty(),"success clears source without invoking it");
        });
        DiagnosticChecks.run("private_actual_controller_unfinished_worker_records_metadata_only",()->{
            DiagnosticControllerHost f=failedPrivate(false);JSONObject receipt=persist(f),raw=f.written.get("failed-native-census.json");
            DiagnosticChecks.check(receipt.getBoolean("artifact_written")&&!receipt.getBoolean("complete_pair_recorded")&&!raw.getBoolean("request_terminal_observed"),"unfinished trace is not completed evidence");
            DiagnosticChecks.check(!raw.has("before")&&!raw.has("after")&&raw.getInt("raw_pair_count")==0&&raw.getString("status").equals("request_not_terminal"),"late worker values withheld");
            DiagnosticChecks.check(!receipt.getBoolean("request_terminal_observed")&&!receipt.toString().contains("RAW_PRIVATE"),"metadata only receipt");
        });
        DiagnosticChecks.run("private_actual_controller_late_callback_cannot_replace_source",()->{
            DiagnosticControllerHost f=failedPrivate(true);AtomicInteger late=new AtomicInteger();
            f.service.callback.onPrivateCensusDiagnostic(()->{late.incrementAndGet();throw new IOException("late");});
            DiagnosticChecks.check(persist(f).getBoolean("complete_pair_recorded")&&late.get()==0&&f.service.privateSnapshotCalls==1,"abandoned callback cannot replace bound source");
        });
        for(final String mutation:new String[]{"task_id","request_id","owner_sha256","package","background_generation","oversize","throw","unfinished_raw"})
            DiagnosticChecks.run("private_actual_controller_rejects_"+mutation+"_without_write_or_failure_change",()->{
                DiagnosticControllerHost f=failedPrivate(true);f.service.privateMutation=mutation;JSONObject receipt=persist(f);
                DiagnosticChecks.check(!receipt.getBoolean("artifact_written")&&f.written.isEmpty()&&f.pendingFailedCensusDiagnostic==null,"invalid private source rejected once");
                DiagnosticChecks.check(receipt.getString("status").equals("private_census_unavailable")&&!receipt.toString().contains("raw secret"),"stable status with no raw error text");
            });
        DiagnosticChecks.run("private_actual_controller_write_failure_is_optional_and_not_retried",()->{
            DiagnosticControllerHost f=failedPrivate(true);f.failPrivateWrite=true;JSONObject receipt=persist(f);
            DiagnosticChecks.check(!receipt.getBoolean("artifact_written")&&f.written.isEmpty()&&persist(f)==null,"private file failure cannot replace or retry original task failure");
        });
        DiagnosticChecks.run("private_actual_controller_foreign_task_receives_no_old_values",()->{
            DiagnosticControllerHost f=failedPrivate(true);JSONObject receipt=f.persistFailedCensusDiagnostic("99999999999999999999999999999999","failed",false,new File("unused"));
            DiagnosticChecks.check(!receipt.getBoolean("artifact_written")&&f.service.privateSnapshotCalls==0&&f.written.isEmpty(),"foreign task refused before source call");
        });
        DiagnosticChecks.run("actual_controller_terminal_discards_foreign_and_invalid_buffer_entries",()->{
            DiagnosticControllerHost f=fresh();f.call();f.pendingObservationDiagnostics.add("not JSON");f.observationDiagnosticErrors=1;
            JSONObject collected=f.takeObservationDiagnostics("99999999999999999999999999999999");
            DiagnosticChecks.check(collected.getJSONArray("records").length()==0&&collected.getInt("discarded_records")==2&&collected.getInt("snapshot_errors")==1,"same-task-only terminal");
            DiagnosticChecks.check(f.diagnostics()==0&&f.observationDiagnosticErrors==0,"no cross-task values");
        });
    }
