        void observe(String id,File dir,Cancellation cancel,long deadline,ObservationCallback cb){
            observeCalls++;callback=cb;cancellation=cancel;observedDeadline=deadline;
            ObservationDiagnostics values=new ObservationDiagnostics(id,DiagnosticChecks.REQUEST,DiagnosticChecks.OWNER,DiagnosticChecks.APP,DiagnosticChecks.GENERATION,9,1,1000,deadline);
            diagnosticValues=values;
            if(privatePair){
                DiagnosticGraphHost.Graph a=DiagnosticGraphHost.fullGraph(12),b=DiagnosticGraphHost.fullGraph(12);
                DiagnosticGraphHost.change(b,11,"text","RAW_PRIVATE_CENSUS_ONLY");
                values.fullGraphChange("saved_graph",DiagnosticGraphHost.fullStamp(a),DiagnosticGraphHost.fullStamp(b),1200);
            }
            if(privateTerminal!=null)values.finish(privateTerminal,1300);
            Callable<String> production=ObserverPipelineHost.actualSnapshot(values);
            Callable<String> privateProduction=ObserverPipelineHost.actualPrivateSnapshot(values);
            lastPrivateSnapshot=()->{
                privateSnapshotCalls++;JSONObject raw=new JSONObject(privateProduction.call());
                if(privateMutation!=null){
                    if("oversize".equals(privateMutation))return DiagnosticChecks.repeat('x',2097153);
                    if("throw".equals(privateMutation))throw new IOException("raw secret must not be exposed");
                    if("unfinished_raw".equals(privateMutation))raw.put("request_terminal_observed",false);
                    else raw.put(privateMutation,"foreign");
                }
                return raw.toString();
            };
            cb.onPrivateCensusDiagnostic(lastPrivateSnapshot);
            lastSnapshot=()->{snapshotCalls++;if(throwDiagnostic)throw new IllegalStateException("fixture snapshot failed");JSONObject proof=new JSONObject(production.call());
                if(mutation!=null){if(mutation.equals("oversize"))proof.put("extra",DiagnosticChecks.repeat('x',17000));
                    else if(mutation.equals("sequence"))proof.put("request_sequence",97);
                    else if(mutation.equals("deadline"))proof.put("deadline_elapsed_ms",deadline+1);
                    else proof.put(mutation,mutation.equals("request_id")?"../escape":"foreign");}
                return proof.toString();};
            if(!omitDiagnostic)cb.onDiagnostic(lastSnapshot);
            if(timeout){SystemClock.now=deadline;return;}
            if(callbackAt>=0)SystemClock.now=callbackAt;
            if(originalError!=null)cb.onError(originalError);else cb.onObservation(value);
            if(duplicateCallback)cb.onError("late duplicate error");
        }
        String observationTimeoutMessage(String id){return "original observation timeout";}
