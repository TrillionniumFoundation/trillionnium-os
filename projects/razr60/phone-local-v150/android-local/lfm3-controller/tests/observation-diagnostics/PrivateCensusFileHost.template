                static void reset(boolean refused){calls=0;fail=refused;lengthAtChmod=-1;}
                static void chmod(String name,int mode)throws IOException{
                    calls++;Path path=Paths.get(name);lengthAtChmod=Files.size(path);
                    if(mode!=0600)throw new IOException("unexpected private mode");
