    // Caller control only: real Csair parsing has separate unchanged fixture gates.
    private static final class CsairCalendar {
        static boolean syntheticHeaderOnly;boolean headerOnly;
        static CsairCalendar read(JSONObject dom)throws Exception{
            if(syntheticHeaderOnly){CsairCalendar x=new CsairCalendar();x.headerOnly=true;return x;}
            org.trillionnium.hepta.local.CsairCalendar real=org.trillionnium.hepta.local.CsairCalendar.read(dom);
            if(real==null)return null;CsairCalendar x=new CsairCalendar();x.headerOnly=real.headerOnly;return x;
        }
    }
    private static final class WebFlightDomain {static boolean bookingBodyPending(JSONObject dom)throws Exception{return org.trillionnium.hepta.local.WebFlightDomain.bookingBodyPending(dom);}}

    /* EXACT_PRODUCTION_METHODS */

    static int cases,assertions;static final JSONArray names=new JSONArray();
    interface Work{void run()throws Exception;}
    static void check(boolean condition,String why){assertions++;if(!condition)throw new AssertionError(why);}
    static void test(String name,Work work)throws Exception{SystemClock.now=1000;SystemClock.onSleep=null;WebShoppingObservationStability.supported=false;CsairCalendar.syntheticHeaderOnly=false;work.run();cases++;names.put(name);}
    static void denied(Work work)throws Exception{
        boolean refused=false;try{work.run();}catch(IllegalArgumentException|IllegalStateException|JSONException|java.io.IOException expected){refused=true;}
        check(refused,"invalid or incomplete observation cannot publish");
    }
    static WebBookingBudgetHost fixture(JSONObject[] captures,PhoneObservation before,PhoneObservation...after)throws Exception{
        WebBookingBudgetHost value=new WebBookingBudgetHost();value.client=new Client(captures);
        value.immutableBinding=captures[0].getJSONObject("binding");value.journal.bindingSha=value.client.values[0].bindingSha;
        value.before=before;value.observations=after;return value;
    }
    PhoneObservation run(long deadline)throws Exception{
        return observe(before,()->{if(observed>=observations.length)throw new AssertionError("unbounded AX observations");SystemClock.now+=observationCosts==null?observationCost:observationCosts[observed];return observations[observed++];},deadline);
    }
    static JSONObject read(Path p)throws Exception{return new JSONObject(new String(Files.readAllBytes(p),StandardCharsets.UTF_8));}
    static JSONObject changed(JSONObject original,String key){
        JSONObject copy=new JSONObject(original.toString());
        if("binding".equals(key))copy.getJSONObject("binding").put("task_id","ffffffffffffffffffffffffffffffff");
        else {Object value=copy.get(key);copy.put(key,value instanceof Number?((Number)value).longValue()+1:"changed:"+value);}
        return copy;
    }
    static void noPublish(WebBookingBudgetHost f){check(f.completion.bound==0&&f.current==null&&f.currentCapture==null,"failed wait must not publish a domain");}
    static JSONObject pending(JSONObject source){return new JSONObject(source.toString()).put("_host_status","unavailable").put("_host_reason","no_main_frame_commit");}
    static long count(WebBookingBudgetHost f,String schema){long n=0;for(JSONObject r:f.records)if(schema.equals(r.optString("schema")))n++;return n;}
    static PhoneObservation[] repeated(PhoneObservation f,int n){PhoneObservation[] rows=new PhoneObservation[n];java.util.Arrays.fill(rows,f);return rows;}
    /** Explicit host metadata; never a retained native authority token. */
    static PhoneObservation frame(JSONObject capture){
        JSONObject view=new JSONObject().put("observation_id","11111111111111111111111111111111")
                .put("package","org.trillionnium.hepta.webhelper")
                .put("observation_state_sha256","aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
                .put("app_tree_sha256","bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
                .put("window_id",capture.getInt("actual_window_id")).put("rotation",0)
                .put("window",new JSONObject().put("display_id",capture.getInt("display_id")))
                .put("background_session",new JSONObject().put("generation","host-owned-generation"));
        return new PhoneObservation(new JSONObject().put("observation",view));
    }
    static WebBookingBudgetHost booking(JSONObject pending,JSONObject ready,PhoneObservation frame)throws Exception{
        WebBookingBudgetHost f=fixture(new JSONObject[]{pending,ready,ready,ready},frame,frame,frame,frame);
        f.goal=new Object();f.purpose.shopping=null;f.domain=new WebTaskDomain();
        // Actual interval 7525 request->capture ACK: 2680 ms.
        // Phase start->first retry request: 1070 ms = 200 sleep + 870 other observation cost.
        // First ACK->second capture request: 882 ms. Repeating the capture cost is simulated.
        f.client.captureCosts=new long[]{0,0,2680,2680};
        f.observationCosts=new long[]{0,870,882};
        return f;
    }
    static void failWithoutNewFrame(WebBookingBudgetHost f){
        check(f.completion.bound==0&&f.current==null&&f.currentCapture==null,"rejected read cannot publish a new frame");
    }
    static boolean retry(WebBookingBudgetHost f,JSONObject first,JSONObject last,PhoneObservation frame,long deadline)throws Exception{
        return f.retryLoadingDocument(new WebEvidenceReceipt(first),new WebEvidenceReceipt(last),frame,false,null,f.cityObservationRetry,deadline);
    }
    public static void main(String[] args)throws Exception{
        final JSONObject pending=read(Paths.get(args[0])).getJSONObject("capture");
        final JSONObject ready=read(Paths.get(args[1])).getJSONObject("capture");
        final PhoneObservation observed=frame(ready);
        final String mode=args[3];final long bookingBudget=Long.parseLong(args[4]);
        check(bookingBudget==6000||bookingBudget==16000,"known baseline/candidate budget argument");
        test("actual_retained_booking_stage_detection_and_complete_dom",()->{
            WebEvidenceReceipt a=new WebEvidenceReceipt(pending),b=new WebEvidenceReceipt(ready);
            check(WebFlightDomain.bookingBodyPending(a.dom())&&!WebFlightDomain.bookingBodyPending(b.dom()),"real booking detector must distinguish empty shell and full form");
            check(a.dom().getJSONArray("nodes").length()==52&&b.dom().getJSONArray("nodes").length()==795,"actual retained DOM counts differ");
            check(a.bindingSha.equals(b.bindingSha)&&a.instance.equals(b.instance)&&a.epoch==b.epoch
                    &&a.url.equals(b.url)&&a.displayId==b.displayId&&a.windowId==b.windowId,"actual retained capture identity must align");
            check(a.stability().rawEqual&&b.stability().rawEqual,"each actual capture must replay its full raw equality proof");
        });
        if(!"boundaries".equals(mode))test("observed_cost_profile_can_finish_one_fresh_pair",()->{
            WebBookingBudgetHost f=booking(pending,ready,observed);
            try{
                check(f.run(60000)==observed,"fresh sequence must publish its synthetic host observation");
            }catch(Exception failure){
                System.err.println("MEASURED_COST_REJECTION phase_deadline="+f.loadingDocumentDeadline+" now="+SystemClock.now
                        +" capture_attempts="+f.client.attempts+" capture_completions="+f.client.calls+" observed="+f.observed);
                throw failure;
            }
            check(f.loadingDocumentDeadline==1000+bookingBudget&&SystemClock.now==8312,"one fixed phase and the stated simulated 7312ms sequence");
            check(f.loadingDocumentReadRetries==1&&f.client.calls==4&&f.client.attempts==4&&f.observed==3,"one fresh pair, no action replay");
            check(f.completion.bound==1&&count(f,"hepta.web-read-only-content-wait.v1")==1,"only a complete synthetic observation may publish");
            check(f.client.deadlines.equals(java.util.Arrays.asList(60000L,60000L,1000+bookingBudget,1000+bookingBudget)),"both retry captures retain the same phase deadline");
            check(f.service.nativeProofCalls==0,"host timing fixture must not claim private native authority");
        });
        if(!"counterfactual".equals(mode)){
            test("short_original_task_deadline_still_rejects_cost_profile",()->{
                WebBookingBudgetHost f=booking(pending,ready,observed);
                denied(()->f.run(6000));failWithoutNewFrame(f);
                check(f.loadingDocumentDeadline==6000&&f.client.attempts==4&&f.client.calls==3,"task budget cannot become a 16-second grant");
                check(f.client.deadlines.get(2)==6000L&&f.client.deadlines.get(3)==6000L,"both calls keep the shorter task deadline");
            });
            test("same_key_never_refreshes_deadline_or_exceeds_two_reads",()->{
                WebBookingBudgetHost f=booking(pending,ready,observed);
                check(retry(f,pending,ready,observed,5500),"first bounded retry");
                String key=f.loadingDocumentKey;long started=f.loadingDocumentStarted;
                SystemClock.now+=1000;
                check(retry(f,pending,ready,observed,90000),"second bounded retry while original deadline remains");
                long end=SystemClock.now;check(!retry(f,pending,ready,observed,90000),"third retry must be refused");
                check(f.loadingDocumentDeadline==5500&&f.loadingDocumentStarted==started&&key.equals(f.loadingDocumentKey)
                        &&f.loadingDocumentReadRetries==2&&SystemClock.now==end,"same-key authority and clock budget stay fixed");
                for(JSONObject row:f.records)if("hepta.web-read-only-content-wait.v1".equals(row.optString("schema")))
                    check(row.getLong("deadline_elapsed_ms")==5500&&!row.getBoolean("action_replayed")
                            &&!row.getBoolean("model_action_dispatched"),"no extended deadline or action during waits");
            });
            test("cancellation_during_wait_stops_before_new_capture",()->{
                WebBookingBudgetHost f=booking(pending,ready,observed);
                SystemClock.onSleep=()->f.cancellation.cancelled=true;
                denied(()->f.run(60000));failWithoutNewFrame(f);
                check(f.client.calls==2&&f.client.attempts==2&&f.observed==1,"cancelled wait cannot start a new capture or AX read");
            });
            test("owner_authority_retirement_stops_before_sleep",()->{
                WebBookingBudgetHost f=booking(pending,ready,observed);f.service.authFailAt=1;
                denied(()->f.run(60000));failWithoutNewFrame(f);
                check(f.client.calls==2&&f.observed==1&&SystemClock.now==1000
                        &&count(f,"hepta.web-read-only-content-wait.v1")==0,"owner failure retains original refusal");
            });
            test("lease_retirement_stops_before_sleep",()->{
                WebBookingBudgetHost f=booking(pending,ready,observed);f.background.failAt=1;
                denied(()->f.run(60000));failWithoutNewFrame(f);
                check(f.client.calls==2&&f.observed==1&&SystemClock.now==1000
                        &&count(f,"hepta.web-read-only-content-wait.v1")==0,"lease failure retains original refusal");
            });
            test("changed_window_cannot_enter_booking_wait",()->{
                JSONObject wrong=changed(ready,"actual_window_id");
                WebBookingBudgetHost f=booking(pending,ready,observed);
                denied(()->retry(f,pending,wrong,observed,60000));failWithoutNewFrame(f);
                check(f.loadingDocumentReadRetries==0&&f.loadingDocumentKey==null&&f.records.isEmpty()&&SystemClock.now==1000,"identity change cannot receive a phase grant");
            });
            test("neighbor_stage_budgets_and_unknown_goal_unchanged",()->{
                String[] modes={"initial_with_booking","shopping","city","calendar","query","unknown"};
                long[] budgets={32000,32000,16000,6000,6000,0};
                for(int i=0;i<modes.length;i++){
                    String stage=modes[i];CsairCalendar.syntheticHeaderOnly=false;
                    WebBookingBudgetHost f=booking(pending,ready,observed);
                    JSONObject first=ready;long now=SystemClock.now;
                    if("initial_with_booking".equals(stage)){f.domain=null;first=pending;}
                    if("shopping".equals(stage)){f.goal=null;f.purpose.shopping=new Object();}
                    if("city".equals(stage)){f.cityObservationRetry=new CityObservationRetry();f.cityObservationRetry.enabled=true;}
                    if("calendar".equals(stage))CsairCalendar.syntheticHeaderOnly=true;
                    if("query".equals(stage)){f.flightProgress=new FlightProgress();f.flightProgress.dispatched=true;}
                    if("unknown".equals(stage)){f.goal=null;f.purpose.shopping=null;}
                    boolean retried=retry(f,first,ready,observed,90000);
                    check(retried==(budgets[i]>0),"unchanged stage eligibility "+stage);
                    if(retried)check(f.loadingDocumentDeadline==now+budgets[i]&&f.loadingDocumentReadRetries==1,"unchanged stage budget "+stage);
                    else check(f.loadingDocumentKey==null&&f.loadingDocumentReadRetries==0&&f.records.isEmpty(),"unknown goal gains no retry");
                }
            });
        }
        JSONObject out=new JSONObject().put("all_pass",true).put("cases",cases).put("assertions",assertions).put("names",names)
                .put("mode",mode).put("expected_booking_budget_ms",bookingBudget)
                .put("actual_pending_dom_nodes",52).put("actual_ready_dom_nodes",795)
                .put("simulated_fresh_pair_phase_cost_ms",7312).put("measured_one_capture_and_ack_ms",2680)
                .put("phone_actions",0).put("model_calls",0).put("private_native_authority_proven",false)
                .put("clock_ipc_ack_and_native_observations_mocked",true)
                .put("repeated_future_read_sequence_synthetic",true)
                .put("actual_booking_pending_detector_used",true)
                .put("synthetic_neighbor_calendar_header_and_city_credential",true)
                .put("business_verified",false);
        Files.write(Paths.get(args[2]),(out.toString(2)+"\n").getBytes(StandardCharsets.UTF_8));
        System.out.println(out.toString());
    }
