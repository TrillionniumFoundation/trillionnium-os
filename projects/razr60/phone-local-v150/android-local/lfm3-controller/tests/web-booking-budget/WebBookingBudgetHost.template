    private static final class WebEvidenceReceipt {
        final JSONObject original;final String status,bindingSha,instance,url,domSha;
        final long epoch;final int displayId,windowId;
        WebEvidenceReceipt(JSONObject capture)throws Exception{
            original=new JSONObject(capture.toString());status=original.optString("_host_status","captured");bindingSha=WebDomCanonical.sha256(original.getJSONObject("binding"));
            instance=original.getString("webview_instance");epoch="unavailable".equals(status)?0:original.getLong("navigation_epoch");
            url="unavailable".equals(status)?null:original.getString("current_native_url");displayId=original.getInt("display_id");windowId=original.getInt("actual_window_id");
            domSha=original.getString("dom_sha256");
        }
        String domRaw(){return original.getString("dom_raw_utf8");}
        String beforeDomRaw(){return original.getString("before_dom_raw_utf8");}
        JSONObject dom()throws Exception{return WebEvidenceJson.parseDom(domRaw());}
        JSONObject capture(){return new JSONObject(original.toString());}
        JSONObject callback(){return new JSONObject().put("request_nonce",original.getString("challenge")).put("reason",original.optString("_host_reason",""));}
        WebDomStability.Result stability()throws Exception{
            return WebDomStability.verify(beforeDomRaw(),domRaw(),"csair_public_flight_v1",original.getJSONObject("dom_stability"));
        }
    }
    private static final class Client {
        final WebEvidenceReceipt[] values;int calls,attempts;long captureCost;long[] captureCosts;boolean enforceDeadline=true;final List<Long> deadlines=new ArrayList<Long>();
        Client(JSONObject...captures)throws Exception{values=new WebEvidenceReceipt[captures.length];for(int i=0;i<captures.length;i++)values[i]=new WebEvidenceReceipt(captures[i]);}
        WebEvidenceReceipt capture(long deadline){
            attempts++;deadlines.add(deadline);
            if(calls>=values.length)throw new AssertionError("capture sequence exhausted or unbounded retry");
            SystemClock.now+=captureCosts==null?captureCost:captureCosts[attempts-1];if(enforceDeadline&&SystemClock.now>=deadline)throw new IllegalStateException("instrumented capture deadline; now="+SystemClock.now+" deadline="+deadline);
            return values[calls++];
        }
    }
