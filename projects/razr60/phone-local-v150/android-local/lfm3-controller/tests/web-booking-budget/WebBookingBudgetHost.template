    private static final class HeptaAccessibilityService {
        int authChecks,authFailAt,nativeProofCalls,typedChanges;boolean provideNative,integrityFailure;final List<Long> retainDeadlines=new ArrayList<Long>();
        static final class FlightObservationSnapshot {void close(){}}
        void requireBackgroundObservation(String task,PhoneObservation frame){if(frame==null)throw new IllegalStateException("missing observation");}
        void requireTaskAuthorization(String task,Object authorization){
            if(++authChecks==authFailAt)throw new IllegalStateException("instrumented authorization retirement");
        }
        FlightObservationSnapshot retainFlightObservation(WebBookingBudgetHost web,PhoneObservation frame,Cancellation cancel,long deadline){
            // The shared retain endpoint is now used for shopping read-only proof as well.
            // This legacy budget harness supplies no private native token, never a fake proof.
            retainDeadlines.add(deadline);return provideNative?new FlightObservationSnapshot():null;
        }
        JSONObject verifyFlightObservationBracket(WebBookingBudgetHost web,FlightObservationSnapshot source,
                PhoneObservation frame,WebEvidenceReceipt first,WebEvidenceReceipt last,Cancellation cancel,long deadline){
            nativeProofCalls++;
            if(integrityFailure)throw new IllegalStateException("instrumented identity mismatch");
            if(typedChanges-->0)throw new WebNativeObservationChanged("native target, ancestor or outside recommendation node changed: ","0/1");
            return new JSONObject();
        }
    }
    private PhoneObservation publishWaiting(PhoneObservation frame,WebEvidenceReceipt receipt,String reason){throw new AssertionError("unexercised IPC waiting status");}
    private WebTaskDomain applyNavigation(WebTaskDomain value){return value;}
    private void record(String name,JSONObject value)throws Exception{
        if(name.startsWith("web-observation-timing-"))return; // Separate diagnostic artifact; does not replace frame/wait evidence.
        if(failRecord)throw new java.io.IOException("instrumented persistence failure");
        records.add(new JSONObject(value.toString()));SystemClock.now+=recordDelay;
    }
    private static void need(boolean condition,String reason){WebEvidenceJson.need(condition,reason);}

