
    /** Synthetic collected values only; observer and frozen-window factory execute verbatim. */
    interface SeedFrozenRead {FrozenObservationWindow read(ObservationRequest request,CaptureIdentity identity);}
    SeedFrozenRead seedFrozenRead;
    static ObserverPipelineHost seedFixture(Change change)throws Exception{return seedFixture(change,true);}
    static ObserverPipelineHost seedFixture(final Change change,final boolean pairEvents)throws Exception{
        ObserverPipelineHost f=nativeFixture(null);f.taskAuthorization=new Object();f.autoScreenshot=false;
        f.readHook=(g,n)->{
            nativeGraph(g);g.digest=n<4?"capture-before":"saved-after";
            g.nativeActionNodes=Collections.<Object>singletonList("synthetic-complete-census");
            g.nativeActionWindows=Collections.<String,Object>singletonMap("selected_display",Integer.valueOf(9));
            g.nativeActionWidth=1080;g.nativeActionHeight=2400;
            if(n==4)SystemClock.now+=500; // Synthetic PNG/read cost, separate from stability gap.
            if(pairEvents&&(n==3||n==6))f.noteObservationEvent(9);
            if(change!=null)change.apply(f,g,n);sealGraph(g);
        };return f;
    }
    static ObservationRequest seedQueued(ObserverPipelineHost f,long taskDeadline)throws Exception{
        budgetBegin(f,taskDeadline);ObservationRequest r=f.activeObservation;f.awaitSample();
        SystemClock.now+=200;f.main.drainUntil(()->f.pendingScreenshot!=null);
        await(()->f.pendingScreenshot!=null||(f.reads.get()>=2&&!observationIoBusy.get()&&observationIo.active.get()==0),"seed second real sample");
        f.main.drainUntil(()->f.pendingScreenshot!=null);check(f.pendingScreenshot!=null,"first capture must be admitted normally");
        f.deliverScreenshot();await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"failed capture queued");
        return r;
    }
    static ObservationRequest seedAdmitted(ObserverPipelineHost f)throws Exception{
        ObservationRequest r=seedQueued(f,30000);f.main.drain();
        check(r.resampleSeed!=null&&r.nativeSample,"saved graph not retained as first WAIT");
        check(f.delivered.isEmpty()&&r.captured==null&&f.directory.list().length==0,"seed retained old image/Graph or published");
        check((r.trace==null||count(r,"SAMPLE_READY")==1)&&f.shots.size()==1,"seed created READY or screenshot");
        return r;
    }
    static void seedNextRead(ObserverPipelineHost f)throws Exception{
        SystemClock.now+=200;f.main.drain();f.awaitSample();
    }
    static void seedNewCapture(ObserverPipelineHost f,ObservationRequest r)throws Exception{
        TakeScreenshotCallback previous=f.pendingScreenshot;seedNextRead(f);
        check(f.pendingScreenshot!=previous&&r.resampleSeed==null,"new real read did not create a new capture");
        f.deliverScreenshot();f.finish();
        check(f.delivered.size()==1&&f.errors.isEmpty()&&f.reads.get()==7,"new capture and both graph rechecks required");
        check(f.shots.size()==2&&r.deadline==r.started+12000,"capture/deadline contract changed");
    }
    static long seedAdmissions(ObservationRequest r)throws Exception{return report(r).optLong("native_seed_admission_count",0);}
    static void seedNotAdmitted(ObserverPipelineHost f,ObservationRequest r,String why)throws Exception{
        check(r.resampleSeed==null&&seedAdmissions(r)==0,why+": seed admitted");
        check(f.delivered.isEmpty()&&f.directory.list().length==0&&r.captured==null,why+": old capture retained");
    }

    /** Android values are synthetic; seal, publication refusal, expiry, drain and proof are production code. */
    static final class SealedReadResult implements ObservationCallback {
        final List<NativeObservationRetryProof> proofs=new ArrayList<NativeObservationRetryProof>();
        final List<PhoneObservation> observations=new ArrayList<PhoneObservation>();
        final List<String> failures=new ArrayList<String>();
        public void onObservation(PhoneObservation value){check(isMain(),"fresh observation on main");observations.add(value);}
        public void onError(String error){check(isMain(),"failure on main");failures.add(error);}
        public void onReadRetryAvailable(String error,NativeObservationRetryProof proof){
            check(isMain()&&proof!=null,"actual private failure proof on main");failures.add(error);proofs.add(proof);
        }
    }
    static void sealedReadGraph(Graph g,String digest){
        nativeGraph(g);g.digest=digest;
        g.nativeActionNodes=Collections.<Object>singletonList("synthetic-complete-census");
        g.nativeActionWindows=Collections.<String,Object>singletonMap("selected_display",Integer.valueOf(9));
        g.nativeActionWidth=1080;g.nativeActionHeight=2400;
    }
    static final class SealedReadScenario {
        final ObserverPipelineHost f;final SealedReadResult out=new SealedReadResult();
        final PhoneObservation prior;final int first;final long taskDeadline;
        ObservationRequest request;File discarded;String fault;boolean terminalGraph,contentChanges=true;
        SealedReadScenario()throws Exception{
            f=seedFixture(null,false);f.autoScreenshot=true;
            f.readHook=(g,n)->{sealedReadGraph(g,"prior-public-frame");sealGraph(g);};
            f.seedFrozenRead=(r,i)->i.frozenWindow;twoSamples(f);
            prior=f.current;first=f.reads.get();taskDeadline=SystemClock.now+30000;
            check(prior!=null&&f.delivered.size()==1&&first==3,"real initial sealed frame required");
            check("pre_encoding_paired_history".equals(prior.captureEvidence.get("mode")),"initial real seal path");
            f.autoScreenshot=false;f.pendingScreenshot=null;
            f.readHook=(g,n)->{
                sealedReadGraph(g,terminalGraph&&contentChanges?"after-target-event":"before-target-event");
                if(n==first+3&&"unsealed".equals(fault))f.noteObservationEvent(9);
                if(n==first+3&&"incomplete".equals(fault))g.nativeActionNodes=null;
                if(terminalGraph&&"foreign_window".equals(fault))g.windowId++;
                sealGraph(g);
            };
            f.seedFrozenRead=(r,i)->{
                if("producer_retry".equals(fault))throw new StaleObservation();
                if("during_window".equals(fault))f.noteObservationEvent(9);
                if("foreign_window".equals(fault))return new FrozenObservationWindow(i.frozenWindow.packageName,i.frozenWindow.windowId+1,
                        i.frozenWindow.displayId,i.frozenWindow.rotation,i.frozenWindow.left,i.frozenWindow.top,
                        i.frozenWindow.right,i.frozenWindow.bottom,i.frozenWindow.width,i.frozenWindow.height,
                        i.frozenWindow.metadata,i.frozenWindow.windows,i.frozenWindow.profileWindow);
                return i.frozenWindow;
            };
        }
        void queued()throws Exception{
            f.observe(f.lease,f.directory,()->f.cancelled.get(),ObservationStabilityGate.requestDeadline(SystemClock.now,taskDeadline),out);
            f.main.drain();request=f.activeObservation;check(request!=null,"ordinary fresh read admitted");f.awaitSample();
            SystemClock.now+=400;f.main.drainUntil(()->f.pendingScreenshot!=null);
            await(()->f.pendingScreenshot!=null||(!observationIoBusy.get()&&observationIo.active.get()==0),"second complete sample");
            f.main.drainUntil(()->f.pendingScreenshot!=null);check(f.pendingScreenshot!=null,"new screenshot callback required");
            f.deliverScreenshot();await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"actual screenshot producer finished");
            for(File path:f.directory.listFiles())if(!path.equals(prior.path))discarded=path;
        }
        void rejectCapture()throws Exception{
            queued();
            if("unknown".equals(fault))f.noteObservationEvent(-1);
            else if(!"during_window".equals(fault))f.noteObservationEvent(9);
            if("authorization".equals(fault))f.taskAuthorization=new Object();
            if("scope".equals(fault))f.taskBackground=new BackgroundSession(9);
            f.main.drain();
            check(out.observations.isEmpty()&&f.current==prior,"unpublished capture never replaces prior frame");
            check(discarded==null||!discarded.exists(),"unpublished PNG discarded before any proof");
            check(request.captured==null&&request.deadline==request.started+12000,"capture released without renewing deadline");
        }
        void expire()throws Exception{
            if(request.finished)return;terminalGraph=true;SystemClock.now=request.started+10278;
            f.main.drain();f.finish();f.finish();
        }
        void released(){
            check(request.finished&&request.captured==null&&!request.shotPending&&f.activeObservation==null,"failed request fully retired");
            for(Graph g:f.graphs)if(g!=f.currentGraph)check(g.closed,"old graph not retained by read proof");
            for(Bitmap b:Bitmap.made)if(b!=f.currentBitmap)check(b.recycled,"old bitmap not retained by read proof");
        }
        NativeObservationRetryProof proof()throws Exception{
            rejectCapture();check(request.readCaptureFailures==0&&request.readSealedEventFailures==1,"only typed sealed-event classification");
            check(discarded!=null&&count(request,"CAPTURE_EVENT_RESET")==1,"real completed PNG rejected by unchanged fence");
            expire();released();check(out.proofs.size()==1&&out.failures.size()==1&&out.observations.isEmpty(),"one failed read, never old observation");
            Map<String,Object> e=out.proofs.get(0).evidence();
            check(((Number)e.get("capture_failures")).intValue()==0&&((Number)e.get("sealed_capture_target_event_failures")).intValue()==1,"new cause distinct in immutable proof");
            check(request.readGraphChanges>0&&Boolean.TRUE.equals(e.get("read_worker_drained"))&&Boolean.TRUE.equals(e.get("failed_request_resources_released")),"original graph-change and actual drain gates");
            return out.proofs.get(0);
        }
        void dispose()throws Exception{f.main.afterWorkerPost=null;f.dispose();}
    }
    static void sealedEventReadCases()throws Exception{
        for(final String timing:new String[]{"after_window","during_window"})eventCase("sealed_event_read_"+timing+"_requires_fresh_frame",()->{
            SealedReadScenario s=new SealedReadScenario();s.fault=timing;NativeObservationRetryProof proof=s.proof();
            long oldDeadline=s.request.deadline;int before=s.f.reads.get();SealedReadResult next=new SealedReadResult();
            s.f.readHook=(g,n)->{sealedReadGraph(g,"new-stable-frame");sealGraph(g);};s.f.seedFrozenRead=(r,i)->i.frozenWindow;s.f.autoScreenshot=true;
            s.f.observeAfterTransientFailure(s.f.lease,s.f.directory,()->false,ObservationStabilityGate.requestDeadline(SystemClock.now,s.taskDeadline),next,proof);
            s.f.main.drain();ObservationRequest replacement=s.f.activeObservation;s.f.awaitSample();SystemClock.now+=400;s.f.main.drain();s.f.awaitSample();s.f.finish();
            check(next.observations.size()==1&&next.failures.isEmpty()&&s.f.current!=s.prior&&!s.f.current.id.equals(s.prior.id),"real new observation and pixels required");
            check(s.f.reads.get()==before+3&&"pre_encoding_paired_history".equals(s.f.current.captureEvidence.get("mode")),"two fresh samples, full pair and actual window recheck");
            check(s.request.deadline==oldDeadline&&replacement.deadline<=s.taskDeadline&&replacement.deadline==replacement.started+12000,"old request unchanged and original task cap retained");
            int reads=s.f.reads.get();SealedReadResult reused=new SealedReadResult();
            s.f.observeAfterTransientFailure(s.f.lease,s.f.directory,()->false,ObservationStabilityGate.requestDeadline(SystemClock.now,s.taskDeadline),reused,proof);s.f.main.drain();
            check(reused.failures.size()==1&&s.f.reads.get()==reads,"private proof cannot be consumed twice");s.dispose();
        });
        for(final String reason:new String[]{"unknown","foreign_window","authorization","scope","unsealed","incomplete","producer_retry"})
            eventCase("sealed_event_read_rejects_"+reason,()->{
                SealedReadScenario s=new SealedReadScenario();s.fault=reason;s.rejectCapture();
                check(s.request.readSealedEventFailures==0,"generic reset cannot supply sealed-event classification");s.expire();
                if(!"producer_retry".equals(reason))check(s.out.proofs.isEmpty(),"changed or incomplete authority cannot issue new proof");
                else for(NativeObservationRetryProof proof:s.out.proofs)check(((Number)proof.evidence().get("sealed_capture_target_event_failures")).intValue()==0,"original graph-failure route stays distinct");
                check(s.out.observations.isEmpty(),"negative capture cannot publish");s.dispose();
            });
        for(final int display:new int[]{0,1})eventCase("sealed_event_read_ignores_other_display_"+display,()->{
            SealedReadScenario s=new SealedReadScenario();s.queued();s.f.noteObservationEvent(display);s.f.main.drain();
            check(s.out.observations.size()==1&&s.out.proofs.isEmpty()&&s.request.readSealedEventFailures==0,"other display does not spoil owned publication");
            check(count(s.request,"CAPTURE_EVENT_RESET")==0,"no global event reset");s.dispose();
        });
        eventCase("sealed_event_read_still_requires_graph_change",()->{
            SealedReadScenario s=new SealedReadScenario();s.contentChanges=false;s.rejectCapture();s.expire();
            check(s.request.readSealedEventFailures==1&&s.request.readGraphChanges==0&&s.out.proofs.isEmpty(),"new reason does not bypass original graph-change predicate");s.dispose();
        });
        eventCase("sealed_event_read_waits_for_actual_worker_return",()->{
            SealedReadScenario s=new SealedReadScenario();s.rejectCapture();Block hold=new Block();s.f.main.afterWorkerPost=hold;
            s.terminalGraph=true;SystemClock.now=s.request.started+10278;s.f.main.drain();hold.entered();s.f.main.drain();
            check(s.out.proofs.isEmpty()&&s.out.failures.isEmpty()&&observationIo.active.get()>=2,"busy=false and queued callback are not drain proof");s.released();
            s.f.main.afterWorkerPost=null;hold.open();s.f.finish();check(s.out.proofs.size()==1,"only actual serial worker return grants read proof");s.dispose();
        });
        eventCase("sealed_event_read_request_deadline_stays_hard",()->{
            SealedReadScenario s=new SealedReadScenario();s.queued();s.f.noteObservationEvent(9);SystemClock.now=s.request.deadline;s.f.main.drain();s.f.finish();
            check(s.request.finished&&s.out.failures.size()==1&&s.out.proofs.isEmpty()&&s.out.observations.isEmpty(),"expired product cannot classify or publish");
            check(s.request.readSealedEventFailures==0&&s.discarded!=null&&!s.discarded.exists(),"deadline rejection still discards actual PNG");s.dispose();
        });
    }

    static void savedGraphSeedCases()throws Exception{
        eventCase("saved_seed_new_real_read_and_new_pixels_keep_all_checks",()->{
            ObserverPipelineHost f=seedFixture(null);ObservationRequest r=seedQueued(f,30000);
            check(f.directory.list().length==1,"failed PNG must exist before callback");
            File old=f.directory.listFiles()[0];List<Bitmap> prior=new ArrayList<Bitmap>(Bitmap.made);
            f.main.drain();check(!old.exists()&&r.resampleSeed!=null,"old PNG not closed before admission");
            for(Bitmap bitmap:prior)check(bitmap.recycled,"old pixel object survived seed");
            check(seedAdmissions(r)==1&&count(r,"SAMPLE_READY")==1,"seed must be first WAIT");
            seedNewCapture(f,r);check(!old.equals(f.current.path),"old PNG reused");
            check(Boolean.TRUE.equals(f.current.captureEvidence.get("post_encoding_whole_graph_rechecked")),"new final graph check absent");f.dispose();
        });
        eventCase("saved_seed_8778_9402_shape_keeps_original_budget",()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{
                long start=x.activeObservation.started;
                if(n==1)SystemClock.now=start+5900;else if(n==2)SystemClock.now=start+6594;
                else if(n==3)SystemClock.now=start+7449;else if(n==4)SystemClock.now=start+8777;
                else if(n==5)SystemClock.now=start+9402;else if(n==6)SystemClock.now=start+10230;
                else if(n==7)SystemClock.now=start+11585;
            });
            AtomicInteger encoded=new AtomicInteger();Bitmap.encodeHook=()->SystemClock.now=f.activeObservation.started+(encoded.incrementAndGet()==1?8298:11105);
            ObservationRequest r=seedQueued(f,30000);SystemClock.now=r.started+8778;f.main.drain();
            check(r.resampleSeed!=null&&r.nativeSample,"late seed not admitted");
            TakeScreenshotCallback previous=f.pendingScreenshot;SystemClock.now=r.started+8978;f.main.drain();f.awaitSample();
            check(SystemClock.now==r.started+9402&&f.pendingScreenshot!=previous&&r.resampleSeed==null,"new graph not READY9402");
            f.deliverScreenshot();f.finish();
            check(f.delivered.size()==1&&SystemClock.now==r.started+11585&&r.deadline==r.started+12000,"original capture budget not honored");
            check(count(r,"SAMPLE_EXPIRED")==0&&seedAdmissions(r)==1,"unexpected renewed/expired request");f.dispose();
        });
        eventCase("saved_seed_ineligible_timing_still_expires",()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{
                long start=x.activeObservation.started;g.nativeActionNodes=null;
                if(n==1)SystemClock.now=start+5900;else if(n==2)SystemClock.now=start+6594;
                else if(n==3)SystemClock.now=start+7449;else if(n==4)SystemClock.now=start+8777;
                else if(n==5)SystemClock.now=start+9402;else if(n==6)SystemClock.now=start+10243;
            });
            ObservationRequest r=seedQueued(f,30000);SystemClock.now=r.started+8778;f.main.drain();seedNotAdmitted(f,r,"no census");
            SystemClock.now=r.started+8978;f.main.drain();f.awaitSample();
            check(count(r,"SAMPLE_READY")==1&&f.delivered.isEmpty(),"9402 must be first ordinary sample");
            SystemClock.now=r.started+9602;f.main.drain();f.awaitSample();f.finish();
            check(r.finished&&count(r,"SAMPLE_EXPIRED")==1&&f.errors.size()==1&&r.deadline==r.started+12000,"settle expiry changed");f.dispose();
        });

        for(final String reason:new String[]{"unknown_during_saved","unknown_before_main","target_before_main"})eventCase("saved_seed_completion_watermark_"+reason,()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{if(n==4&&"unknown_during_saved".equals(reason))x.noteObservationEvent(-1);});
            ObservationRequest r=seedQueued(f,30000);
            if("unknown_before_main".equals(reason))f.noteObservationEvent(-1);
            if("target_before_main".equals(reason))f.noteObservationEvent(9);
            f.main.drain();seedNotAdmitted(f,r,reason);check(count(r,"SAMPLE_READY")==1,"watermark admitted capture");f.dispose();
        });
        for(final String reason:new String[]{"unknown_in_gap","unknown_during_read","unknown_before_accept"})eventCase("saved_seed_unknown_cross_sample_"+reason,()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{if(n==5&&"unknown_during_read".equals(reason))x.noteObservationEvent(-1);});
            ObservationRequest r=seedAdmitted(f);
            if("unknown_in_gap".equals(reason))f.noteObservationEvent(-1);
            SystemClock.now+=200;f.main.drain();await(()->!observationIoBusy.get()&&observationIo.active.get()==0,"next seed read");
            if("unknown_before_accept".equals(reason))f.noteObservationEvent(-1);
            f.main.drain();check(r.resampleSeed==null&&count(r,"SAMPLE_READY")==1&&f.shots.size()==1,"unknown borrowed seed");
            check(f.delivered.isEmpty()&&f.directory.list().length==0,"unknown published");f.dispose();
        });
        for(final String reason:new String[]{"truncated","stats","census_nodes","census_windows","census_width","visible_ime","unknown_ime","window","rotation","bounds","generation","owner","display"})eventCase("saved_seed_complete_window_"+reason,()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{
                if(n!=4)return;
                if("truncated".equals(reason))g.truncated=true;else if("stats".equals(reason))g.collectionStats=null;
                else if("census_nodes".equals(reason))g.nativeActionNodes=null;
                else if("census_windows".equals(reason))g.nativeActionWindows=null;
                else if("census_width".equals(reason))g.nativeActionWidth=0;
                else if("visible_ime".equals(reason))g.state=new ObservationState(EventChecks.OWNER,ImeVisibility.VISIBLE);
                else if("unknown_ime".equals(reason))g.state=new ObservationState(EventChecks.OWNER,ImeVisibility.UNKNOWN);
                else changeIdentity(g,reason);
            });ObservationRequest r=seedQueued(f,30000);f.main.drain();seedNotAdmitted(f,r,reason);f.dispose();
        });
        for(final String reason:new String[]{"goal","web","generic_visual"})eventCase("saved_seed_non_native_scope_"+reason,()->{
            ObserverPipelineHost f=seedFixture(null);
            if("web".equals(reason))f.taskWeb=new WebFlightSession();else f.taskBackground.selection.taskTarget.nativeGoal=null;
            ObservationRequest r=seedQueued(f,30000);f.main.drain();
            check(r.resampleSeed==null&&f.delivered.isEmpty()&&f.directory.list().length==0,"nonnative seeded");f.dispose();
        });
        for(final String reason:new String[]{"missing","stale","incomplete","window","rotation","bounds","digest"})eventCase("saved_seed_next_real_graph_"+reason,()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{
                if(n!=5)return;
                if("missing".equals(reason))throw new NoActiveWindow();
                if("stale".equals(reason))throw new StaleObservation();
                if("incomplete".equals(reason))g.collectionStats=null;else changeIdentity(g,reason);
            });ObservationRequest r=seedAdmitted(f);seedNextRead(f);
            check(r.resampleSeed==null&&count(r,"SAMPLE_READY")==1&&f.shots.size()==1,"changed next graph borrowed seed");
            check(f.delivered.isEmpty(),"changed next graph published");f.dispose();
        });

        for(final String reason:new String[]{"cancel_before_admission","cancel_after_seed","lease","authorization","clock_back","settle_exact","request_exact"})eventCase("saved_seed_authority_clock_"+reason,()->{
            ObserverPipelineHost f=seedFixture(null);ObservationRequest r=seedQueued(f,30000);
            if("cancel_after_seed".equals(reason)){f.main.drain();check(r.resampleSeed!=null,"setup");f.cancelled.set(true);SystemClock.now+=200;}
            else if("cancel_before_admission".equals(reason))f.cancelled.set(true);
            else if("lease".equals(reason))f.taskBackground=new BackgroundSession(9);
            else if("authorization".equals(reason))f.taskAuthorization=new Object();
            else if("clock_back".equals(reason)){
                // Fake Handler would not dequeue at a rewound clock. Test the real admission method directly.
                f.main.drain();NativeResampleSeed seed=r.resampleSeed;check(seed!=null,"clock setup");
                SystemClock.now=r.started-1;f.retryObservation(r,200,seed);
            }
            else if("settle_exact".equals(reason))SystemClock.now=r.started+10000;
            else if("request_exact".equals(reason))SystemClock.now=r.deadline;
            f.main.drain();f.finish();
            check(r.resampleSeed==null&&f.delivered.isEmpty()&&f.directory.list().length==0,"retired authority/time seeded");
            check(r.deadline==r.started+12000,"renewed request");
            if("settle_exact".equals(reason))check(count(r,"SAMPLE_EXPIRED")==1,"settle became margin");f.dispose();
        });
        eventCase("saved_seed_second_capture_change_not_published",()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{if(n==7)g.digest="changes-again";});
            ObservationRequest r=seedAdmitted(f);TakeScreenshotCallback previous=f.pendingScreenshot;seedNextRead(f);
            check(previous!=f.pendingScreenshot,"fresh capture absent");f.deliverScreenshot();f.finish();
            check(f.delivered.isEmpty()&&f.directory.list().length==0&&count(r,"SAVED_GRAPH_CHANGED")==2,"new full check skipped");
            check(r.deadline==r.started+12000,"second mismatch renewed budget");f.dispose();
        });
        eventCase("saved_seed_optional_diagnostic_not_authority",()->{
            ObserverPipelineHost f=seedFixture(null);f.diagnosticTask=f.lease;f.diagnosticRequests=96;
            ObservationRequest r=seedAdmitted(f);check(r.trace==null,"trace intentionally absent");seedNewCapture(f,r);f.dispose();
        });
        eventCase("saved_seed_identity_only_failure_cannot_supply_full_graph",()->{
            ObserverPipelineHost f=seedFixture(null,false);
            f.seedFrozenRead=(r,i)->new FrozenObservationWindow(i.frozenWindow.packageName,i.frozenWindow.windowId+1,
                    i.frozenWindow.displayId,i.frozenWindow.rotation,i.frozenWindow.left,i.frozenWindow.top,
                    i.frozenWindow.right,i.frozenWindow.bottom,i.frozenWindow.width,i.frozenWindow.height,
                    i.frozenWindow.metadata,i.frozenWindow.windows,i.frozenWindow.profileWindow);
            ObservationRequest r=seedQueued(f,30000);f.main.drain();seedNotAdmitted(f,r,"identity-only");
            check(f.reads.get()==3&&count(r,"SAVED_GRAPH_CHANGED")==1,"identity-only branch not exercised");f.dispose();
        });
    }

    static void savedGraphSeedAdditionalCases()throws Exception{
        sealedEventReadCases();
        eventCase("saved_seed_ready_preserves_screenshot_interval_wait",()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{
                if(n==4)SystemClock.now=x.activeObservation.started+200;
                if(n==7)x.noteObservationEvent(9);
            });
            ObservationRequest r=seedAdmitted(f);TakeScreenshotCallback first=f.pendingScreenshot;seedNextRead(f);
            check(r.resampleSeed==null&&f.pendingScreenshot==first&&count(r,"SCREENSHOT_INTERVAL_WAIT")==1,"READY bypassed interval or retained seed");
            check(f.reads.get()==5&&count(r,"SAMPLE_READY")==2,"real next read must READY without capture");
            seedNextRead(f);check(f.pendingScreenshot!=first&&f.reads.get()==6,"interval must retain fresh-read schedule");
            f.deliverScreenshot();f.finish();
            check(f.delivered.size()==1&&f.reads.get()==8&&r.deadline==r.started+12000,"interval skipped capture checks");f.dispose();
        });
        eventCase("saved_seed_changed_key_requires_new_two_hundred_ms_pair",()->{
            ObserverPipelineHost f=seedFixture((x,g,n)->{if(n>=5)g.digest="third-complete-frame";});
            ObservationRequest r=seedAdmitted(f);seedNextRead(f);
            check(r.resampleSeed==null&&count(r,"SAMPLE_READY")==1,"new key borrowed seed");
            SystemClock.now+=199;f.sampleObservation(r);f.awaitSample();
            check(count(r,"SAMPLE_READY")==1&&f.shots.size()==1&&f.delivered.isEmpty(),"new key skipped200ms");f.dispose();
        });
        eventCase("saved_seed_diagnostic_maximum_preserves_original_record",()->{
            ObservationDiagnostics trace=new ObservationDiagnostics(EventChecks.TASK,EventChecks.repeat('1',32),
                    EventChecks.OWNER,EventChecks.repeat('p',128),EventChecks.GENERATION,9,96,1,Long.MAX_VALUE);
            String[] phases={"queued","sample_graph","sample_gap","screenshot_callback","screenshot_copy","screenshot_graph",
                    "png_encode","png_fsync","png_hash","saved_graph","publish","retry_gap"};
            for(int i=0;i<96;i++){trace.phase(phases[i%phases.length],1000000000000L+i);for(ObservationDiagnostics.Event e:ObservationDiagnostics.Event.values())trace.note(e);}
            for(int i=0;i<12;i++)trace.graph("sample_graph",EventChecks.OWNER,EventChecks.OWNER,EventChecks.OWNER,EventChecks.OWNER,false,1000000000200L+i);
            Map<String,Object> original=trace.snapshot(1000000000300L);
            List<ObservationDiagnostics.NodeStamp> a=new ArrayList<ObservationDiagnostics.NodeStamp>(),b=new ArrayList<ObservationDiagnostics.NodeStamp>();
            for(int i=0;i<512;i++){
                StringBuilder path=new StringBuilder("0");for(int depth=0;depth<116;depth++)path.append("/1");path.append("/").append(i);
                a.add(new ObservationDiagnostics.NodeStamp("n"+i,path.toString(),EventChecks.OWNER,EventChecks.OWNER,0,0,1080,2400));
                b.add(new ObservationDiagnostics.NodeStamp("n"+i,path.toString(),EventChecks.repeat('b',64),EventChecks.repeat('c',64),1,1,1079,2399));
            }
            ObservationDiagnostics.GraphStamp before=new ObservationDiagnostics.GraphStamp(trace.packageName,trace.generation,trace.ownerSha,9,7,
                    EventChecks.OWNER,EventChecks.OWNER,EventChecks.OWNER,false,a);
            ObservationDiagnostics.GraphStamp after=new ObservationDiagnostics.GraphStamp(trace.packageName,trace.generation,trace.ownerSha,9,7,
                    EventChecks.repeat('b',64),EventChecks.repeat('c',64),EventChecks.OWNER,false,b);
            trace.savedGraphChange(before,after,true,true,true,1000000000400L);trace.seedDecision("admitted",1000000000401L);
            Map<String,Object> full=trace.snapshot(1000000000402L);
            int fullPretty=new org.json.JSONObject(full).toString(2).getBytes(StandardCharsets.UTF_8).length;
            SystemClock.now=1000000000402L;
            String raw=new DiagnosticSnapshot(trace).call();org.json.JSONObject actual=new org.json.JSONObject(raw);
            check(raw.getBytes(StandardCharsets.UTF_8).length<=16384&&actual.toString(2).getBytes(StandardCharsets.UTF_8).length<=16384,"diagnostic budget");
            for(String key:new String[]{"events","last_graphs","last_transitions"})check(new org.json.JSONObject(original).get(key).toString().equals(actual.get(key).toString()),"old diagnostic lost "+key);
            check(actual.getLong("graph_record_count")==12&&actual.getLong("transition_count")==96,"old counts changed");
            if(fullPretty>16384)check(!actual.has("last_native_saved_graph_change")&&actual.getBoolean("native_saved_graph_detail_omitted_for_budget"),"optional detail not stripped");
            else check(actual.getJSONObject("last_native_saved_graph_change").getJSONArray("node_differences").length()==8,"bounded8 differences missing");
            check(actual.getLong("native_seed_admission_count")==1,"seed decision missing");
        });
    }

    static void savedGraphSeedProfileCases()throws Exception{
        for(final String field:new String[]{"target","generation","display","task","parent","token","user","serial","uid"})
            for(final String competing:new String[]{"none","unknown","incomplete"})eventCase("saved_seed_foreign_profile_"+field+"_"+competing,()->{
                ObserverPipelineHost f=seedFixture((x,g,n)->{
                    g.profileWindow=new WindowOwnership(n==5?field:"same");
                    if(n==5&&"unknown".equals(competing))x.noteObservationEvent(-1);
                    if(n==5&&"incomplete".equals(competing))g.collectionStats=null;
                });f.taskBackground.profile=new ProfileTarget();
                ObservationRequest r=seedAdmitted(f);seedNextRead(f);
                check(r.finished&&r.resampleSeed==null&&f.errors.size()==1&&f.delivered.isEmpty(),"foreign profile downgraded to resampling");
                check(f.shots.size()==1&&f.directory.list().length==0,"foreign profile produced pixels");f.dispose();
            });
        for(final String field:new String[]{"authorization","lease"})eventCase("saved_seed_authority_after_admission_"+field,()->{
            ObserverPipelineHost f=seedFixture(null);ObservationRequest r=seedAdmitted(f);
            if("authorization".equals(field))f.taskAuthorization=new Object();else f.taskBackground=new BackgroundSession(9);
            seedNextRead(f);check(r.finished&&r.resampleSeed==null&&f.errors.size()==1&&f.delivered.isEmpty(),"replaced authority survived seed");
            check(f.shots.size()==1,"replaced authority captured");f.dispose();
        });
        eventCase("saved_seed_does_not_infer_worker_return_from_busy_flag",()->{
            ObserverPipelineHost f=seedFixture(null);
            budgetBegin(f,30000);ObservationRequest r=f.activeObservation;f.awaitSample();SystemClock.now+=200;
            f.main.drainUntil(()->f.pendingScreenshot!=null);
            await(()->f.pendingScreenshot!=null||(f.reads.get()>=2&&!observationIoBusy.get()&&observationIo.active.get()==0),"second seed sample");
            f.main.drainUntil(()->f.pendingScreenshot!=null);check(f.pendingScreenshot!=null,"first screenshot");
            Block post=new Block();f.main.afterWorkerPost=post;f.deliverScreenshot();post.entered();
            check(!observationIoBusy.get()&&observationIo.active.get()==1&&f.reads.get()==4,"worker not held after post");
            f.main.drain();check(r.resampleSeed!=null&&f.delivered.isEmpty(),"seed not first WAIT");
            SystemClock.now+=200;f.main.drain();check(f.reads.get()==4&&observationIo.active.get()==2,"read ran around blocked worker");
            check(!report(r).getBoolean("worker_drained_proved_by_this_record"),"seed claimed drain");
            f.main.afterWorkerPost=null;post.open();f.awaitSample();f.deliverScreenshot();f.finish();
            check(f.delivered.size()==1&&f.reads.get()==7&&f.errors.isEmpty(),"serial read did not finish");
            check(r.deadline==r.started+12000,"serial handoff renewed budget");f.dispose();
        });
    }
