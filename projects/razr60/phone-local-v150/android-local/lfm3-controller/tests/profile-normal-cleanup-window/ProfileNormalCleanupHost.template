        test("first_claim_cookie_required_and_retained_cookie_loss_keeps_exact_identity",()->{
            Map<String,Object> both=new LinkedHashMap<String,Object>();evidence.put("cookie_lifecycle",both);
            ProfileNormalCleanupHostTest first=new ProfileNormalCleanupHostTest(true,false);
            first.profileOwnedTask=new ProfileOwnedTask(first.platform,first.config.profileTarget,ProfileBrokerHostTest.GEN,
                ProfileBrokerHostTest.REQUEST,first.displayId,first.publicProfileHistory);
            first.profileOwnedTask.prepare();first.profileOwnedTask.beforeDispatch();first.io.f.launch();first.profileOwnedTask.accepted(0);
            // No observe(): this is a real first-claim cleanup attempt, without a retained leaf.
            first.io.f.wrongCookie=true;first.runCleanup();
            Map<String,Object> firstRow=new LinkedHashMap<String,Object>();
            firstRow.put("state",first.state);firstRow.put("custody_known",first.profileCustody.known());
            firstRow.put("effect_counts",Arrays.asList(first.io.removeCalls,first.io.deleteCalls,first.io.releaseCalls));
            firstRow.put("validator",first.profileOwnedTask.lastLeafValidation());both.put("unclaimed",firstRow);
            first.unknown(0,0,0);
            Map<String,Object> firstDetail=first.profileOwnedTask.lastLeafValidation();
            yes("first_claim".equals(firstDetail.get("phase"))&&Boolean.FALSE.equals(firstDetail.get("launch_cookie_present"))
                &&Boolean.FALSE.equals(((Map<?,?>)firstDetail.get("checks")).get("first_claim_launch_cookie"))
                &&"PROFILE_NEW_LEAF_NOT_PROVEN".equals(firstDetail.get("refusal_code")),"missing-cookie first claim did not reach original predicate");
            yes(first.profileOwnedTask.evidence().get("leaf_task_id")==null,"refused first claim retained a leaf");

            ProfileNormalCleanupHostTest retained=new ProfileNormalCleanupHostTest(true,true);
            String token=(String)retained.profileOwnedTask.evidence().get("leaf_token_id");
            retained.io.f.wrongCookie=true;retained.runCleanup();
            Map<String,Object> retainedRow=new LinkedHashMap<String,Object>();
            retainedRow.put("state",retained.state);retainedRow.put("custody_known",retained.profileCustody.known());
            retainedRow.put("effect_counts",Arrays.asList(retained.io.removeCalls,retained.io.deleteCalls,retained.io.releaseCalls));
            retainedRow.put("validator",retained.profileOwnedTask.lastLeafValidation());both.put("retained",retainedRow);
            retained.released();
            Map<String,Object> detail=retained.profileOwnedTask.lastLeafValidation();
            yes("retained_leaf".equals(detail.get("phase"))&&Boolean.TRUE.equals(detail.get("valid"))
                &&Boolean.FALSE.equals(detail.get("launch_cookie_present"))
                &&Boolean.TRUE.equals(detail.get("actual_task_token_equal_to_retained"))
                &&Boolean.TRUE.equals(detail.get("retained_task_identity_matches")),"retained actual token predicate not exercised");
            yes(token.equals(retained.profileOwnedTask.evidence().get("leaf_token_id")),"cookie loss replaced task authority");
        });
