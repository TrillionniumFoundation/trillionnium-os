    /*__BROKER_MEMBERS__*/

    private static int assertions;
    private static final JSONArray results=new JSONArray();
    private static final Map<String,Object> evidence=new LinkedHashMap<String,Object>();
    private interface Work {void run()throws Exception;}
    private static void yes(boolean ok,String why){assertions++;if(!ok)throw new AssertionError(why);}
    private static String refused(Work work)throws Exception {
        try{work.run();throw new AssertionError("expected refusal");}
        catch(Exception expected){assertions++;return expected.getMessage();}
    }
    private static void test(String name,Work body)throws Exception {
        int begin=assertions;try{body.run();results.put(new JSONObject().put("name",name).put("passed",true).put("assertions",assertions-begin));}
        catch(Throwable e){results.put(new JSONObject().put("name",name).put("passed",false).put("assertions",assertions-begin).put("error",e.toString()));
            write(false);if(e instanceof Exception)throw (Exception)e;if(e instanceof Error)throw (Error)e;throw new AssertionError(e);}
    }
    private static Path output;
    private static void write(boolean passed)throws Exception {
        JSONObject value=new JSONObject().put("schema","hepta.profile-normal-cleanup-window-cases.v1").put("passed",passed)
            .put("cases",results).put("case_count",results.length()).put("assertions",assertions).put("evidence",evidence)
            .put("synthetic_framework_and_latency",true).put("phone_contacted",false)
            .put("historical_277631_success_claimed",false).put("complete_android_broker_compiled",false);
        Files.write(output,value.toString(2).getBytes(StandardCharsets.UTF_8));
        if(passed)System.out.println(value.toString());
    }
    private void runCleanup()throws Exception {
        io.cleanup=true;io.cleanupAt=io.f.now;beginCleanup("client_close");
        yes(cleanupDone.await(8,TimeUnit.SECONDS),"synthetic cleanup did not finish");
        yes(normalProfileCleanupWindow!=null,"normal public cleanup clock missing");
    }
    private void released() {
        yes("RELEASED".equals(state)&&profileCustody.known(),"not released: "+state+" / "+profileCleanupFailures.evidence());
        yes(io.removeCalls==1&&io.deleteCalls==1&&io.releaseCalls==1,"effect count differs");
        yes(profileOwnedTask.cleanupKnown(),"task proof missing");
    }
    private void unknown(int leaf,int root,int vd) {
        yes("CLEANUP_UNKNOWN".equals(state)&&!profileCustody.known(),"failure converted to release");
        yes(io.removeCalls==leaf&&io.deleteCalls==root&&io.releaseCalls==vd,"refusal effect counts: "+io.removeCalls+"/"+io.deleteCalls+"/"+io.releaseCalls);
    }
    public static void main(String[] args)throws Exception {
        NormalCleanupIO.before=new String(Files.readAllBytes(Paths.get(args[0])),StandardCharsets.UTF_8);
        output=Paths.get(args[1]);
        test("owned_leaf_1408ms_after_start_full_fresh_pairs_then_single_root_and_vd",()->{
            ProfileNormalCleanupHostTest b=new ProfileNormalCleanupHostTest(true,true);b.io.leafDelay=1408;
            b.runCleanup();b.released();
            yes(b.io.deletedAt-b.cleanupAt>=1408&&b.io.f.now<b.normalProfileCleanupWindow.workDeadline,"late leaf or total window not exercised");
            yes(b.io.readDeadlines.size()>8,"complete reads were not repeated");
            for(Long deadline:b.io.readDeadlines)yes(deadline<=b.normalProfileCleanupWindow.workDeadline,"IO escaped total work deadline");
            Map<String,Object> row=new LinkedHashMap<String,Object>();row.put("leaf_disappearance_scripted_at_ms",1408);
            row.put("root_effect_ms",b.io.deletedAt-b.cleanupAt);row.put("vd_effect_ms",b.io.releasedAt-b.cleanupAt);
            row.put("completed_ms",b.io.f.now-b.cleanupAt);row.put("read_deadlines",b.io.readDeadlines);row.put("read_order",b.io.reads);
            row.put("effect_counts",Arrays.asList(b.io.removeCalls,b.io.deleteCalls,b.io.releaseCalls));evidence.put("late_leaf",row);
        });
        test("same_delayed_leaf_refuses_original_1400ms_window",()->{
            ProfileNormalCleanupHostTest b=new ProfileNormalCleanupHostTest(true,true);b.io.leafDelay=1408;
            b.io.cleanup=true;b.io.cleanupAt=b.io.f.now;b.cleanupAt=b.io.f.now;b.cleanupStarted.set(true);long end=b.io.f.now+1400;
            String reason=refused(()->b.profileOwnedTask.retire(end));
            yes(!b.profileOwnedTask.cleanupKnown()&&b.io.removeCalls==1&&b.io.deleteCalls==0&&b.io.releaseCalls==0,"old budget silently passed");
            evidence.put("old_1400ms_control",reason);
        });
