    private static final class WebEvidenceReceipt {
        final JSONObject original,callbackOnly;final String status,bindingSha,instance,url,domSha;
        final long epoch;final int displayId,windowId;
        WebEvidenceReceipt(JSONObject input)throws Exception {
            JSONObject cb=input.optJSONObject("_host_callback");
            if(cb!=null){
                original=null;callbackOnly=new JSONObject(cb.toString());status=cb.getString("status");
                bindingSha=cb.getString("binding_sha256");instance=cb.getString("webview_instance");epoch=cb.getLong("navigation_epoch");
                displayId=cb.getInt("actual_display_id");windowId=cb.getInt("actual_window_id");url=null;domSha=null;
            }else{
                original=new JSONObject(input.toString());callbackOnly=null;status="captured";
                bindingSha=WebDomCanonical.sha256(original.getJSONObject("binding"));
                instance=original.getString("webview_instance");epoch=original.getLong("navigation_epoch");
                url=original.getString("current_native_url");displayId=original.getInt("display_id");windowId=original.getInt("actual_window_id");
                domSha=original.getString("dom_sha256");
            }
        }
        String domRaw(){if(original==null)throw new AssertionError("unavailable has no DOM");return original.getString("dom_raw_utf8");}
        String beforeDomRaw(){if(original==null)throw new AssertionError("unavailable has no before DOM");return original.getString("before_dom_raw_utf8");}
        JSONObject dom()throws Exception{return WebEvidenceJson.parseDom(domRaw());}
        JSONObject capture(){if(original==null)throw new AssertionError("unavailable has no capture");return new JSONObject(original.toString());}
        JSONObject callback(){return callbackOnly==null?new JSONObject().put("request_nonce",original.getString("challenge")).put("reason",JSONObject.NULL):new JSONObject(callbackOnly.toString());}
        WebDomStability.Result stability()throws Exception{
            return WebDomStability.verify(beforeDomRaw(),domRaw(),original.getJSONObject("binding").getString("site_policy_id"),original.getJSONObject("dom_stability"));
        }
    }
    private static final class Client {
        final WebEvidenceReceipt[] values;int calls,attempts;Runnable afterFourth;long captureCost;boolean enforceDeadline=true;final List<Long> deadlines=new ArrayList<Long>();
        Client(JSONObject...captures)throws Exception{values=new WebEvidenceReceipt[captures.length];for(int i=0;i<captures.length;i++)values[i]=new WebEvidenceReceipt(captures[i]);}
        WebEvidenceReceipt capture(long deadline){
            attempts++;deadlines.add(deadline);
            if(calls>=values.length)throw new AssertionError("capture sequence exhausted or unbounded retry");
            SystemClock.now+=captureCost;if(enforceDeadline&&SystemClock.now>=deadline)throw new IllegalStateException("instrumented capture deadline");
            WebEvidenceReceipt reply=values[calls++];if(calls==4&&afterFourth!=null)afterFourth.run();return reply;
        }
    }
    /** This host-only harness instruments native tokens and IPC. Original DOM
     * stability/geometry checks execute; Android native snapshots and future timing are mocked. */
