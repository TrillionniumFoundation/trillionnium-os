    static int cases,assertions;static final JSONArray names=new JSONArray();
    interface Work{void run()throws Exception;}
    static void check(boolean condition,String why){assertions++;if(!condition)throw new AssertionError(why);}
    static void test(String name,Work work)throws Exception{SystemClock.now=1000;SystemClock.onSleep=null;WebShoppingObservationStability.supported=false;work.run();cases++;names.put(name);}
    static void denied(Work work)throws Exception{
        boolean refused=false;try{work.run();}catch(IllegalArgumentException|IllegalStateException|JSONException|java.io.IOException expected){refused=true;}
        check(refused,"invalid or incomplete observation cannot publish");
    }
    static WebInitialUnavailableHost fixture(JSONObject[] captures,PhoneObservation before,PhoneObservation...after)throws Exception{
        WebInitialUnavailableHost value=new WebInitialUnavailableHost();value.client=new Client(captures);
        value.immutableBinding=captures[0].getJSONObject("binding");value.journal.bindingSha=value.client.values[0].bindingSha;
        value.before=before;value.observations=after;return value;
    }
    PhoneObservation run(long deadline)throws Exception{
        return observe(before,()->{if(observed>=observations.length)throw new AssertionError("unbounded AX observations");SystemClock.now+=observationCost;return observations[observed++];},deadline);
    }
    static JSONObject read(Path p)throws Exception{return new JSONObject(new String(Files.readAllBytes(p),StandardCharsets.UTF_8));}
    static JSONObject changed(JSONObject original,String key){
        JSONObject copy=new JSONObject(original.toString());
        if("binding".equals(key))copy.getJSONObject("binding").put("task_id","ffffffffffffffffffffffffffffffff");
        else {Object value=copy.get(key);copy.put(key,value instanceof Number?((Number)value).longValue()+1:"changed:"+value);}
        return copy;
    }
    static void noPublish(WebInitialUnavailableHost f){check(f.completion.bound==0&&f.current==null&&f.currentCapture==null,"failed wait must not publish a domain");}
    static JSONObject pending(JSONObject source){return new JSONObject(source.toString()).put("_host_status","unavailable").put("_host_reason","no_main_frame_commit");}
    static long count(WebInitialUnavailableHost f,String schema){long n=0;for(JSONObject r:f.records)if(schema.equals(r.optString("schema")))n++;return n;}
    static PhoneObservation[] repeated(PhoneObservation f,int n){PhoneObservation[] rows=new PhoneObservation[n];java.util.Arrays.fill(rows,f);return rows;}

