    private static JSONObject copied(JSONObject o){return new JSONObject(o.toString());}
    private static JSONObject unavailable(String reason,String status){
        return new JSONObject().put("_host_callback",copied(actualCallback).put("reason",reason).put("status",status));
    }
    private static PhoneObservation frame(){return new PhoneObservation(new JSONObject().put("observation",copied(actualBefore)));}
    private static WebInitialUnavailableHost phase(JSONObject failed)throws Exception{
        JSONObject a=copied(actualCaptures[3]).put("challenge",String.join("",java.util.Collections.nCopies(64,"a")));
        JSONObject b=copied(actualCaptures[3]).put("challenge",String.join("",java.util.Collections.nCopies(64,"b")));
        WebInitialUnavailableHost v=new WebInitialUnavailableHost();
        v.taskId=actualTask;v.goal=new Object();v.purpose.shopping=null;v.purpose.sitePolicyId=actualPolicy;
        v.purpose.ownerSha256=actualOwner;v.background.generation=actualGeneration;
        v.client=new Client(actualCaptures[0],actualCaptures[1],actualCaptures[2],failed,a,b);
        v.client.captureCost=100;v.observationCost=10;
        v.immutableBinding=actualCaptures[0].getJSONObject("binding");v.journal.bindingSha=v.client.values[0].bindingSha;
        v.before=frame();v.observations=new PhoneObservation[]{frame(),frame(),frame(),frame(),frame()};
        v.service.provideNative=true;return v;
    }
    private PhoneObservation exactRun(long deadline)throws Exception{
        return observe(before,()->{
            if(observed>=observations.length)throw new AssertionError("unbounded AX observations");
            if(client.calls==4)for(HeptaAccessibilityService.FlightObservationSnapshot s:service.snapshots)
                if(!s.closed)throw new AssertionError("old native snapshot retained into fresh AX");
            SystemClock.now+=observationCost;return observations[observed++];
        },deadline);
    }
    private static int records(WebInitialUnavailableHost v,String schema){
        int count=0;for(JSONObject r:v.records)if(schema.equals(r.optString("schema")))count++;return count;
    }
    private static void positive()throws Exception{
        WebInitialUnavailableHost v=phase(unavailable("DOM changed across visual callback","unavailable"));
        PhoneObservation done=v.exactRun(100000);
        check(v.client.calls==6,"did not replace unavailable pair with a complete fresh pair");
        check(v.observed==5&&v.current==done&&v.currentCapture==v.client.values[5],"only the new complete pair is published");
        check(v.loadingDocumentReadRetries==2&&records(v,"hepta.web-initial-capture-retry.v1")==1,"one existing remaining retry consumed");
        check(v.loadingDocumentDeadline==v.loadingDocumentStarted+32000,"original phase is not extended");
        check(v.service.snapshots.size()==3,"three independent retained native snapshots");
        for(HeptaAccessibilityService.FlightObservationSnapshot s:v.service.snapshots)check(s.closed,"all snapshots released");
        JSONObject last=v.records.get(v.records.size()-1);
        check(last.getString("first_capture_request_nonce").equals(v.client.values[4].callback().getString("request_nonce"))
            &&last.getString("last_capture_request_nonce").equals(v.client.values[5].callback().getString("request_nonce")),
            "final proof uses both new captures");
        check(v.client.deadlines.get(4)==v.loadingDocumentDeadline&&v.client.deadlines.get(5)==v.loadingDocumentDeadline,
            "both new reads retain the original phase deadline");
    }
    private static void noExtra(WebInitialUnavailableHost v)throws Exception{
        v.run(100000);check(v.client.calls==4&&v.currentCapture==null,"ineligible unavailable must not create a fresh pair");
        check(records(v,"hepta.web-initial-capture-retry.v1")==0,"ineligible case consumed no new retry");
    }
    private static String pinned(Path p,String hash)throws Exception{
        byte[] b=Files.readAllBytes(p);check(WebEvidenceJson.sha(b).equals(hash),"actual input hash differs: "+p.getFileName());
        return new String(b,StandardCharsets.UTF_8);
    }

