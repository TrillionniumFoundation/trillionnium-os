    private static final class HeptaAccessibilityService {
        int authChecks,authFailAt,nativeProofCalls,typedChanges;boolean provideNative,integrityFailure;final List<Long> retainDeadlines=new ArrayList<Long>();
        final List<FlightObservationSnapshot> snapshots=new ArrayList<FlightObservationSnapshot>();
        static final class FlightObservationSnapshot {boolean closed;void close(){if(closed)throw new AssertionError("snapshot double close");closed=true;}}
        void requireBackgroundObservation(String task,PhoneObservation frame){if(frame==null)throw new IllegalStateException("missing observation");}
        void requireTaskAuthorization(String task,Object authorization){
            if(++authChecks==authFailAt)throw new IllegalStateException("instrumented authorization retirement");
        }
        FlightObservationSnapshot retainFlightObservation(WebInitialUnavailableHost web,PhoneObservation frame,Cancellation cancel,long deadline){
            // The shared retain endpoint is now used for shopping read-only proof as well.
            // Tokens below instrument ownership only; they are not Android native proof.
            retainDeadlines.add(deadline);if(!provideNative)return null;FlightObservationSnapshot token=new FlightObservationSnapshot();snapshots.add(token);return token;
        }
        JSONObject verifyFlightObservationBracket(WebInitialUnavailableHost web,FlightObservationSnapshot source,
                PhoneObservation frame,WebEvidenceReceipt first,WebEvidenceReceipt last,Cancellation cancel,long deadline){
            nativeProofCalls++;
            if(integrityFailure)throw new IllegalStateException("instrumented identity mismatch");
            if(typedChanges-->0)throw new WebNativeObservationChanged("native target, ancestor or outside recommendation node changed: ","0/1");
            return new JSONObject();
        }
    }
