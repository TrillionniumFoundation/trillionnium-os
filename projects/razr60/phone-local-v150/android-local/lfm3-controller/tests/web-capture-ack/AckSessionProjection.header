package org.trillionnium.hepta.webhelper;
import android.content.Context;import android.os.*;import android.os.Process;import org.json.*;import java.nio.charset.StandardCharsets;import java.util.*;import java.util.concurrent.*;import org.trillionnium.hepta.webprotocol.*;
/** Exact production method blocks appended by runner. Attach/PM/VD/WebView/retire are explicit host boundaries. */
public final class AckSessionProjection implements AutoCloseable {
 private final Context context;private final Handler ui=new Handler(Looper.getMainLooper());private final ExecutorService fileWriter=Executors.newSingleThreadExecutor();
 final EvidenceFiles files;private PageActivity page,retiringPage;private TaskBinding binding;private JSONObject previous,cleanup,displayBefore=new JSONObject();private byte[] previousRaw;
 private EvidenceFiles.Record preservedPrevious,unstartedRecord;private final ProcessIdentity processIdentity=new ProcessIdentity();private String attachRequestRaw;
 private long attachBoundElapsed;private boolean orphan,retired,firstCaptureAttempted;private String instance;private int windowId=19;private long lastEpoch=7;
 private RemoteReply pendingCapture;private volatile RemoteReply pendingCaptureAcknowledgement;
 private final LinkedHashMap<String,String> used=new LinkedHashMap<String,String>();private final LinkedHashMap<String,JSONObject> closeUsed=new LinkedHashMap<String,JSONObject>();
 private final TreeSet<String> closeHistory=new TreeSet<String>();private JSONObject lastSuccessfulCapture;
 private final Set<String> attemptedLinkTargets=new LinkedHashSet<String>(),attemptedLinkRuns=new LinkedHashSet<String>();
 public final ArrayList<Integer> methods=new ArrayList<Integer>();
 public AckSessionProjection(Context c,JSONObject b)throws Exception{context=c;files=new EvidenceFiles(c);binding=new TaskBinding(b);instance=org.trillionnium.hepta.local.HostCaptureFixture.INSTANCE;page=new PageActivity(b,instance,windowId);}
 public void dispatch(int code,String wire,IBinder callback)throws Exception{
  JSONObject r=Jsons.parse(wire,WebEvidenceProtocol.MAX_REQUEST_BYTES);RemoteReply reply=new RemoteReply(callback,r,wire,code,10481,binding.controller,binding.helper);
  try{TaskBinding.validateCommon(r,code);requireSame(reply);consume(reply);methods.add(code);
   if(code==WebEvidenceProtocol.ATTACH){attachRequestRaw=wire;attachBoundElapsed=SystemClock.elapsedRealtime();persist("active");send(reply,"attached",null,null,null);}
   else if(code==WebEvidenceProtocol.CAPTURE)capture(reply);else if(code==WebEvidenceProtocol.ACK_CAPTURE)acknowledgeCapture(reply);
   else if(code==WebEvidenceProtocol.ARM_OBSERVED_LINK)armObservedLink(reply);else throw new IllegalStateException("outside fixture scope");
  }catch(Exception e){replyFailure(reply,"rejected",message(e));}
 }
 public java.io.File root(){return files.root;}public boolean hasLastSuccessful(){return lastSuccessfulCapture!=null;}public int usedCount(){return used.size();}
 public void fixtureConsumed(int count)throws Exception{for(int i=0;i<count;i++)used.put(String.format(java.util.Locale.ROOT,"%064x",i),String.format(java.util.Locale.ROOT,"%064x",i+1));persist("active");}
 public void fixtureClickAndCommit()throws Exception{page.fixtureClickAndCommit();}
 private void retire(String why){retired=true;binding.live=false;pendingCaptureAcknowledgement=null;lastSuccessfulCapture=null;}
 public void close()throws Exception{fileWriter.shutdown();if(!fileWriter.awaitTermination(5,TimeUnit.SECONDS))throw new IllegalStateException("host file worker still active");}
