+def settings_homepage_evidence(directory, case, suite, acceptance):
+    """Classify the retained final page; never run a device command or upgrade a task.
+
+    This oracle is deliberately scoped to the observed Motorola Settings layout.
+    A collapsed visible title is not a page identity. Require a native-bound done
+    observation, the independently visible Settings activity, and matching home
+    structure in the independent XML. Missing/ambiguous evidence stays unverified.
+    The caller must still enforce all original nonce/runtime/effect/goal gates.
+    """
+    directory = Path(directory)
+    result = {"schema": "hepta.settings-homepage-evidence.v1", "passed": False,
+              "evidence_complete": False, "checks": [], "errors": [], "source_files": {},
+              "phone_contacted": False, "full_task_acceptance_claimed": False}
+
+    def need(value, message):
+        if not value:
+            raise ValueError(message)
+
+    def read(relative, limit=131072):
+        path = directory / relative
+        need(path.is_relative_to(directory), "evidence path escaped case")
+        current = path
+        while current != directory.parent:
+            need(not current.is_symlink(), "symlink in homepage evidence path")
+            current = current.parent
+        need(path.is_file() and 0 < path.stat().st_size <= limit, "missing or oversized " + relative)
+        raw = path.read_bytes()
+        need(0 < len(raw) <= limit, "evidence size changed beyond bound")
+        result["source_files"][relative] = {"bytes": len(raw), "sha256": acceptance.digest(raw)}
+        return raw
+
+    def obj(relative):
+        value = acceptance.strict_json(read(relative))
+        need(isinstance(value, dict), "evidence object required: " + relative)
+        return value
+
+    def check(kind, passed, **detail):
+        result["checks"].append({"kind": kind, "passed": bool(passed), **detail})
+
+    def bounds(value):
+        if isinstance(value, str):
+            match = re.fullmatch(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", value)
+            value = list(map(int, match.groups())) if match else None
+        return (value if isinstance(value, list) and len(value) == 4
+                and all(type(x) is int for x in value) else None)
+
+    def inside(value, outer):
+        return (value is not None and outer[0] <= value[0] < value[2] <= outer[2]
+                and outer[1] <= value[1] < value[3] <= outer[3])
+
+    def one(pattern, text, label):
+        values = re.findall(pattern, text, re.MULTILINE)
+        need(len(values) == 1, "missing or ambiguous window " + label)
+        return values[0]
+
+    try:
+        need(case.get("assertion") in HOME_KINDS and case.get("expected_package") == SETTINGS,
+             "homepage oracle requires a Settings-home case")
+        owner = obj("task/owner.json")
+        terminal = obj("task/result.json")
+        instruction = case["instruction"]
+        need(owner.get("instruction") == instruction
+             and owner.get("instruction_utf8_sha256") == acceptance.digest(instruction.encode("utf-8")),
+             "homepage evidence belongs to another owner instruction")
+        need(isinstance(owner.get("task_id"), str) and acceptance.HEX32.fullmatch(owner["task_id"])
+             and terminal.get("task_id") == owner["task_id"], "terminal task identity differs")
+        need(terminal.get("status") == "model_reported_done" and terminal.get("model_reported_success") is True
+             and terminal.get("cleanup_known") is True, "terminal task is not completed and clean")
+        step = terminal.get("steps")
+        need(type(step) is int and 1 <= step <= 99, "invalid terminal step")
+        prefix = "task/step-%02d" % step
+        before, after = obj(prefix + "-before.json"), obj(prefix + "-after.json")
+        receipt = obj(prefix + "-action.json")
+        action = receipt.get("action", {})
+        need(receipt.get("accepted") is True and receipt.get("dispatched") is False
+             and receipt.get("stale") is False and action.get("action") == "done"
+             and action.get("status") == "success" and action.get("package") == SETTINGS
+             and action.get("observation_id") == before.get("observation_id"), "terminal done action differs")
