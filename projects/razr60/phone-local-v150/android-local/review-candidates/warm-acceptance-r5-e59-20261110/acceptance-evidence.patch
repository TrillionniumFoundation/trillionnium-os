+def json_equivalent(left, right):
+    """JSON value equality without Python's boolean/number equivalence.
+
+    JSONObject may serialize 1.0 as 1; preserve that numeric equivalence.
+    Protocol integer fields still have their separate strict integer gates.
+    """
+    if type(left) is bool or type(right) is bool:
+        return type(left) is bool and type(right) is bool and left is right
+    if left is None or right is None:
+        return left is None and right is None
+    if type(left) in (int, float) and type(right) in (int, float):
+        return ((type(left) is int or math.isfinite(left))
+                and (type(right) is int or math.isfinite(right)) and left == right)
+    if type(left) is str and type(right) is str:
+        return left == right
+    if type(left) is list and type(right) is list:
+        return len(left) == len(right) and all(json_equivalent(a, b) for a, b in zip(left, right))
+    if type(left) is dict and type(right) is dict:
+        return (all(type(key) is str for key in left) and all(type(key) is str for key in right)
+                and left.keys() == right.keys()
+                and all(json_equivalent(left[key], right[key]) for key in left))
+    return False
 
 
