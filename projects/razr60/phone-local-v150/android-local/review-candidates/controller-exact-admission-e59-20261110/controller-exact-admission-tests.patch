+package org.trillionnium.hepta.local;
+
+import android.graphics.Rect;
+import java.io.File;
+import java.util.*;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Exercises extracted production prompt()/awaitModel(), not a copied policy. */
+public final class ControllerAdmissionHostTest {
+    private static int checks;
+    private static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
+    private static String repeated(char c,int count){char[] value=new char[count];Arrays.fill(value,c);return new String(value);}
+    private static final String PACKAGE="com.example.calculator";
+    private static final String OWNER="SYNTHETIC_OWNER_BOUNDARY：保持测试目标甲与测试目标乙的先后顺序，完整保留这一句。";
+
+    private static PhoneObservation observation(){
+        List<PhoneObservation.Node> nodes=new ArrayList<PhoneObservation.Node>();
+        for(int i=0;i<24;i++)nodes.add(new PhoneObservation.Node("n"+i,PACKAGE,"android.widget.Button","button_"+i,
+                "目标"+i,"",new Rect(10+i,20+i,60+i,80+i),true,false,false,true,false,false,
+                ObservedChildText.notApplicable(),ObservedScrollActions.UNKNOWN));
+        for(int i=0;i<3;i++)nodes.add(new PhoneObservation.Node("optional"+i,PACKAGE,"android.widget.TextView","label_"+i,
+                "OPTIONAL_SHOULD_DROP_"+i+repeated('x',180),"",new Rect(10,100,300,130),false,false,false,true,false,false,
+                ObservedChildText.notApplicable(),ObservedScrollActions.UNKNOWN));
+        return new PhoneObservation("11111111111111111111111111111111",PACKAGE,1,1080,2400,0,1,
+                new Rect(0,0,1080,2400),null,"screen","tree",new ObservationState("tree",ImeVisibility.HIDDEN),
+                ObservedWindowMetadata.unknown(new int[]{0,0,1080,2400},"android.widget.FrameLayout"),false,nodes);
+    }
+    private static JSONArray history()throws Exception{
+        JSONArray rows=new JSONArray();
+        for(int step=1;step<=12;step++)rows.put(new JSONObject().put("step",step).put("action","type")
+                .put("node_label","历史目标"+step).put("node_id","past"+step).put("type_text",typed(step))
+                .put("before_package",PACKAGE).put("target_package",PACKAGE).put("package_after",PACKAGE)
+                .put("model_issued",true).put("accepted",true).put("dispatched",true).put("stale",false));
+        return rows;
+    }
+    private static String typed(int step){return "KEEP_FULL_TYPED_"+step+"_"+repeated('z',160);}
+    private static AppCatalogueRanker.Page catalogue(){
+        Map<String,String> apps=new HashMap<String,String>();apps.put(PACKAGE,"计算器");apps.put("com.example.settings","设置");
+        return new AppCatalogueRanker(apps,OWNER).search("",0);
+    }
+    private static final class Capture implements LocalInference {
+        final LocalRuntimeConfig config;int calls;String prompt,system;boolean reject;
+        Capture(LocalRuntimeConfig config){this.config=config;}
+        public LocalRuntimeConfig configuration(){return config;}
+        public Handle generate(String p,String s,File image,DecisionGrammar grammar,int maximum,long timeout,Callback callback){
+            calls++;prompt=p;system=s;
+            check(image==null,"controller remains text-only");check(maximum==256,"output reserve contract unchanged");
+            if(reject)callback.onFailure("native_failed: formatted_prompt_exceeds_fixed_context",true);
+            else callback.onSuccess("HOST_CALLBACK_ONLY","22222222222222222222222222222222");
+            return new Handle(){public void cancel(){}};
+        }
+    }
+    private static void expectRejected(ControllerPromptFixture fixture,Capture capture,String text)throws Exception{
+        int before=capture.calls;boolean rejected=false;
+        try{fixture.submitText(text,null);}catch(IllegalArgumentException|IllegalStateException expected){rejected=true;}
+        check(rejected,"invalid/bounded input must be rejected");check(capture.calls==before,"rejected Java input never reaches inference callback");
+    }
+    public static void main(String[] args)throws Exception{
+        boolean patched="candidate".equals(args[0]);
+        LocalRuntimeConfig config=new LocalRuntimeConfig(ModelProfile.GEMMA4_E4B,"npu",4096,4);
+        Capture capture=new Capture(config);ControllerPromptFixture fixture=new ControllerPromptFixture(capture);
+        ControllerPromptFixture.Frame frame=null;boolean rejected=false;
+        try{frame=ControllerPromptFixture.project(OWNER,catalogue(),observation(),history(),config);}
+        catch(IllegalStateException expected){rejected=true;check(expected.getMessage().contains("完整任务事实"),"same production baseline failure");}
+        if(!patched){
+            check(rejected&&frame==null,"baseline reproduces premature heuristic rejection");
+            expectRejected(fixture,capture,repeated('a',4000));
+            System.out.println("PASS baseline production projection and awaitModel reject before native; checks="+checks);return;
+        }
+        check(!rejected&&frame!=null,"complete required prompt reaches native decision");
+        check(!frame.estimateAdmitted(),"heuristic remains honestly false");
+        check(frame.text().endsWith("\nOWNER\n"+OWNER),"OWNER unchanged");
+        check(frame.history()==12,"entire ordered history retained");
+        for(int step=1;step<=12;step++)check(frame.text().contains(typed(step)),"complete typed history step "+step);
+        check(frame.nodes()==24&&frame.required()==24,"all required targets, only optional nodes removed");
+        for(int i=0;i<24;i++)check(frame.ids().contains("n"+i),"mandatory target "+i+" retained");
+        check(frame.visible()==0&&!frame.text().contains("OPTIONAL_SHOULD_DROP_"),"original optional reductions finish first");
+        String audit=frame.budget();
+        check(audit.contains("\"admitted\":false")&&audit.contains("\"controller_submission_allowed\":true")
+                &&audit.contains("\"native_exact_admission_deferred\":true"),"estimate, submission and exact authorization remain distinct");
+        check("HOST_CALLBACK_ONLY".equals(fixture.submit(frame)),"real awaitModel delegates bounded complete prompt");
+        check(capture.calls==1&&frame.text().equals(capture.prompt),"exact assembled bytes sent once");
+        check(ControllerPromptFixture.system().equals(capture.system),"system unchanged");
+        expectRejected(fixture,capture,repeated('a',65537));
+        expectRejected(fixture,capture,"bad\u0000prompt");
+        expectRejected(fixture,capture,"bad\ud800prompt");
+        Capture legacy=new Capture(new LocalRuntimeConfig(ModelProfile.LFM3,"npu",4096,4));
+        expectRejected(new ControllerPromptFixture(legacy),legacy,repeated('a',4000));
+        capture.reject=true;boolean failed=false;
+        try{fixture.submit(frame);}catch(IllegalStateException expected){failed=expected.getMessage().contains("formatted_prompt_exceeds_fixed_context");}
+        check(failed&&capture.calls==2,"native rejection cannot return a successful model answer");
+        System.out.println("PASS candidate production projection/awaitModel; checks="+checks+", prompt_bytes="+frame.text().getBytes("UTF-8").length
+                +", required_targets="+frame.required()+", full_history="+frame.history()+"; host IO fixtures only, no phone/model");
+    }
+}
