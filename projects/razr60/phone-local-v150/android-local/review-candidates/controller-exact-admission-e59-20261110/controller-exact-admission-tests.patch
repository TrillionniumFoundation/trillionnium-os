+'''
+    wrapper = '''
+ public static final class Frame {
+  private final PromptFrame value;
+  Frame(PromptFrame value){this.value=value;}
+  public String text(){return value.text;}
+  public String budget()throws Exception{return value.budgetJson().toString();}
