+#!/usr/bin/env python3
+"""Exercise the real generated worker's admission/control flow with a fake SDK.
+
+The tokenizer is explicitly controlled, not Gemma. Production hashing, template
+byte checks, exact-count admission, input-ID binding, request loop and receipts
+run unchanged. This proves guard ordering, not model/NPU/Android behavior.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(value)
+    return value
+
+
+def replace_once(text, old, new):
+    if text.count(old) != 1:
+        raise AssertionError("fake SDK adaptation anchor changed")
+    return text.replace(old, new)
+
+
+def build(source, out):
+    native = source / "native"
+    sys.path.insert(0, str(native))
+    generator = module("exact_budget_worker_generator", native / "generate_adapter.py")
+    existing = module("existing_warm_test", native / "tests/test_warm_runtime.py")
+    generated = out / "generated"
+    generated.mkdir()
+    adapter = generator.generate(source, generated)
+    expected = "b2276da3b7066d1da2a48097c58681e6f3b37bb786660c5bb7dc680b03910d0f"
+    if adapter["adapted_sha256"] != expected:
+        raise AssertionError("generated worker differs from actual v29/e49 compiled worker")
+    code = existing.HARNESS.replace("TEST_MODEL_SHA", hashlib.sha256(existing.WEIGHT).hexdigest()).replace("TEST_MODEL_BYTES", str(len(existing.WEIGHT)))
+    # Fixed-size fake template: explicit 54-byte overhead for the two numeric size fixtures.
+    code = replace_once(code, 'int n=asprintf(&out->formatted_text,"%s\\n%s",in->messages[0].content,in->messages[1].content);',
+                        'int n=asprintf(&out->formatted_text,"%053d%s\\n%s",0,in->messages[0].content,in->messages[1].content);')
+    old = '''    assert(vocab&&add_special&&parse_special);int32_t count=len+1;if(maximum<count)return -count;
+    tokens[0]=1;for(int32_t i=0;i<len;i++)tokens[i+1]=((unsigned char)text[i])+2;return count;'''
+    new = '''    assert(vocab&&add_special&&parse_special);
+    const char *marker=strstr(text,"HEPTA_TEST_TOKENS=");
+    int32_t count=marker?(int32_t)strtol(marker+18,NULL,10):len+1;
+    assert(count>0);
+    if(maximum<count)return -count;
+    for(int32_t i=0;i<count;i++)tokens[i]=(i%510)+1;
+    if(strstr(text,"HEPTA_TEST_MISMATCH"))return count-1;
+    return count;'''
+    code = replace_once(code, old, new)
+    code = replace_once(code, '    dirty=1;calls_generate++;out->full_text=strdup("x");',
+                        '    assert(in->input_ids==hepta_input_ids&&in->input_ids_count==hepta_input_count);\n'
+                        '    for(int32_t i=0;i<in->input_ids_count;i++)assert(in->input_ids[i]==(i%510)+1);\n'
+                        '    dirty=1;calls_generate++;out->full_text=strdup("x");')
+    test = out / "fake-sdk.c"
+    test.write_text(code)
+    binary = out / "worker-guard-test"
+    command = ["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-O1",
+               "-I" + str(generated), "-I" + str(native), "-I" + str(native / "vendor"),
+               "-I" + str(native / "vendor/llama"), str(test), "-o", str(binary)]
+    compiled = subprocess.run(command, capture_output=True, timeout=40)
+    (out / "compile.stdout").write_bytes(compiled.stdout)
+    (out / "compile.stderr").write_bytes(compiled.stderr)
+    if compiled.returncode:
+        raise RuntimeError(compiled.stderr.decode())
+    return binary, existing, adapter
+
+
+def text_bytes(size, count, mismatch=False):
+    head = "HEPTA_TEST_TOKENS=" + str(count) + ";"
+    if mismatch:
+        head += "HEPTA_TEST_MISMATCH;"
+    if len(head) > size:
+        raise ValueError("fixture too short")
+    return head + "p" * (size - len(head))
+
+
+def exercise(binary, existing, directory, specs, expected_complete, expected_exit):
+    directory.mkdir(mode=0o700)
+    runs = directory / "runs"
+    runs.mkdir(mode=0o700)
+    (runs / existing.G).mkdir(mode=0o700)
+    weight = directory / "fixture.gguf"
+    weight.write_bytes(existing.WEIGHT)
+    weight.chmod(0o600)
+    ids = ["a" * 32, "b" * 32]
+    for rid, spec in zip(ids, specs):
+        existing.request_files(directory, rid, text_bytes(spec["prompt_bytes"], spec["tokens"], spec.get("mismatch", False)))
+        system = runs / rid / "system.txt"
+        system.write_bytes(b"s" * spec["system_bytes"])
+        system.chmod(0o600)
+    first = runs / ids[0]
+    argv = [str(binary), "--request-id", ids[0], "--mode", "llm", "--runtime", "llama_cpp", "--compute", "npu",
+            "--model", str(weight), "--prompt-file", str(first / "prompt.txt"), "--system-file", str(first / "system.txt"),
+            "--grammar-file", str(first / "grammar.gbnf"), "--result-file", str(first / "native-result.json"),
+            "--text-file", str(first / "raw-text.txt"), "--ctx-size", "4096", "--max-tokens", "256", "--threads", "2",
+            "--timeout-ms", "5000", "--log-level", "debug", "--warm-generation", existing.G,
+            "--warm-task-id", existing.T, "--warm-session-dir", str(runs / existing.G)]
+    process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    receipts, reply_lines, originals = [], [], {}
+    try:
+        ready = existing.line(process)
+        assert ready == f"HEPTA_WARM_READY {existing.G} {existing.T} {process.pid}"
+        reply_lines.append(ready)
+        for index, (rid, spec) in enumerate(zip(ids, specs), 1):
+            process.stdin.write(f"RUN {existing.G} {existing.T} {rid} {index} 256 5000\n".encode())
+            process.stdin.flush()
+            rc = 0 if index <= expected_complete else 70
+            reply = existing.line(process)
+            reply_lines.append(reply)
+            assert reply == f"HEPTA_WARM_DONE {existing.G} {existing.T} {rid} {index} {rc}", reply
+            raw = (runs / rid / "native-result.json").read_bytes()
+            originals[rid] = raw
+            receipt = json.loads(raw)
+            budget = receipt["prompt_budget"]
+            assert budget["checked"] is True and budget["is_exact_token_count"] is True
+            assert budget["prompt_tokens_exact"] == spec["tokens"]
+            assert budget["total_context_tokens"] == spec["tokens"] + 512
+            assert budget["reserved_tokens"] == 256 and budget["generation_tokens"] == 256 and budget["context_tokens"] == 4096
+            assert budget["formatted_utf8_bytes"] == spec["system_bytes"] + spec["prompt_bytes"] + 54
+            if rc == 0:
+                assert receipt["generation_complete"] is True and budget["admitted"] is True
+                assert budget["input_ids_passed_directly"] is True and budget["input_ids_count"] == spec["tokens"]
+                assert receipt["profile"]["prompt_tokens"] == spec["tokens"]
+            else:
+                assert receipt["generation_complete"] is False and receipt["error"] == "formatted_prompt_exceeds_fixed_context"
+                assert budget["input_ids_passed_directly"] is False
+                if not spec.get("mismatch"):
+                    assert budget["admitted"] is False
+            receipts.append({"request": index, "spec": spec, "return_code": rc,
+                             "receipt_sha256": hashlib.sha256(raw).hexdigest(), "budget": budget})
+        if expected_exit == 0:
+            process.stdin.write(f"CLOSE {existing.G} {existing.T}\n".encode())
+            process.stdin.flush()
+        process.stdin.close()
+        code = process.wait(timeout=10)
+        stderr = process.stderr.read()
+        assert code == expected_exit, stderr.decode()
+        (directory / "stderr.log").write_bytes(stderr)
+        (directory / "control.log").write_text("\n".join(reply_lines) + "\n")
+        marker = f"reset={expected_complete} generate={expected_complete} destroy=1 deinit=1"
+        assert marker in stderr.decode(), stderr.decode()
+        terminal = json.loads((runs / existing.G / "native-session-result.json").read_bytes())
+        assert terminal["requests_received"] == len(specs) and terminal["requests_completed"] == expected_complete
+        assert terminal["sdk_destroy_rc"] == terminal["sdk_deinit_rc"] == 0
+        for rid, raw in originals.items():
+            assert (runs / rid / "native-result.json").read_bytes() == raw
+        return {"name": directory.name, "passed": True, "requests": len(specs), "generate_calls": expected_complete,
+                "process_exit": code, "receipts": receipts}
+    finally:
+        if process.poll() is None:
+            process.kill()
+            process.wait(timeout=10)
+        for stream in (process.stdin, process.stdout, process.stderr):
+            stream.close()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    source, out = args.source.resolve(), args.out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    report = {"scope": "actual unchanged generated worker with explicit fake SDK/tokenizer", "phone_tested": False,
+              "model_inference": False, "all_pass": False, "cases": []}
+    try:
+        binary, existing, adapter = build(source, out)
+        report["adapted_worker_sha256"] = adapter["adapted_sha256"]
+        home = {"system_bytes": 3593, "prompt_bytes": 2523, "tokens": 1945}
+        calc = {"system_bytes": 3593, "prompt_bytes": 2499, "tokens": 2061}
+        boundary = {"system_bytes": 3593, "prompt_bytes": 4000, "tokens": 3584}
+        overflow = {"system_bytes": 3593, "prompt_bytes": 2600, "tokens": 3585}
+        mismatch = {"system_bytes": 3593, "prompt_bytes": 2600, "tokens": 2061, "mismatch": True}
+        for name, specs, completed, code in [
+                ("synthetic-sizes-two-warm-requests", [home, calc], 2, 0),
+                ("exact-context-boundary", [boundary], 1, 0),
+                ("first-request-exact-overflow", [overflow], 0, 70),
+                ("second-request-exact-overflow", [home, overflow], 1, 70),
+                ("tokenizer-second-pass-mismatch", [mismatch], 0, 70)]:
+            report["cases"].append(exercise(binary, existing, out / name, specs, completed, code))
+        existing.exercise(binary, out / "original-one-shot", "once")
+        report["cases"].append({"name": "original-one-shot", "passed": True, "generate_calls": 1})
+        report["all_pass"] = True
+    except Exception as error:
+        report["error"] = repr(error)
+        raise
+    finally:
+        (out / "RESULT.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"all_pass": report["all_pass"], "cases": len(report["cases"]), "scope": report["scope"]}))
+
+
+if __name__ == "__main__":
+    main()
