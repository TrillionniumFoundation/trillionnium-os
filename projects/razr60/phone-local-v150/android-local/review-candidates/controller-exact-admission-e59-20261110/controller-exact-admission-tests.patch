+  public int visible(){return value.visibleTextShown;}
+  public int history(){return value.historyShown;}
+  public boolean estimateAdmitted(){return value.budget.admitted;}
+  public java.util.Set<String> ids(){return value.nodeIds;}
+ }
+ public static String system(){return SYSTEM;}
+ public static Frame project(String owner,AppCatalogueRanker.Page catalogue,PhoneObservation observation,
+                             JSONArray history,LocalRuntimeConfig config)throws Exception{
+  return new Frame(prompt(owner,catalogue,observation,history,null,null,config,new RepeatActionGuard(),new SameStateNoEffectGuard()));
+ }
+ public String submit(Frame frame)throws Exception{return submitText(frame.text(),frame.value.grammar);}
+ public String submitText(String text,DecisionGrammar grammar)throws Exception{
+  return awaitModel(text,grammar,SystemClock.elapsedRealtime()+10000).text;
+ }
+}
+'''
+    generated = dict(FIXTURES)
+    generated["org/trillionnium/hepta/local/ControllerPromptFixture.java"] = (
+        prelude + parts["system"] + parts["await_model"] + parts["active_exceptions"] + parts["prompt_assembly"] + wrapper
+    )
+    generated["org/trillionnium/hepta/local/HeptaAccessibilityService.java"] = (
+        "package org.trillionnium.hepta.local;\npublic final class HeptaAccessibilityService {\n"
+        + parts["label_bound"] + "}\n"
+    )
+    paths = []
+    for relative, text in generated.items():
+        path = output / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+        paths.append(path)
+    names = ["ActionDecision", "ActionPolicy", "ObservedTargetLabels", "ObservedScrollActions",
+             "RecentActionProjection", "PersistentActionPolicy", "ImeVisibility", "ObservationState",
+             "ObservedWindowMetadata", "ObservedChildText", "RepeatActionGuard", "SameStateNoEffectGuard",
+             "DecisionGrammar", "ModelProfile", "NativeBudgetVerifier", "LocalRuntimeConfig",
+             "ConservativeTokenBudget", "AppCatalogueRanker", "ObservedTextProjection",
+             "ObservedTransitionProjection", "PromptActionDomain", "PhoneObservation", "LocalInference"]
+    if (package / "ControllerPromptAdmission.java").is_file():
+        names += ["ControllerPromptAdmission"]
+    sources = [package / (name + ".java") for name in dict.fromkeys(names)]
+    record = {"scope": "Production prompt assembly and awaitModel; host JSON/Rect/clock and inference callback adapters only",
+              "controller_sha256": hashlib.sha256(controller.encode()).hexdigest(),
+              "parts": {name: {"bytes": len(text.encode()), "sha256": hashlib.sha256(text.encode()).hexdigest()} for name, text in parts.items()},
