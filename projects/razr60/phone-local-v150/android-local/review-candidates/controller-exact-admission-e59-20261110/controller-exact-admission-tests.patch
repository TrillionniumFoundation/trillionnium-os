+"""Execute production prompt assembly / awaitModel with explicit host-only IO fixtures.
+
+The Android Rect/SystemClock and org.json containers are small test adapters;
+they are not an Android/runtime/serialization-equivalence test. All projection,
+history, target-domain, grammar and admission decisions come from production.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+
+def section(text, start, end):
+    if text.count(start) != 1 or text.count(end) != 1:
+        raise ValueError("production extraction anchors must be unique")
+    return text[text.index(start):text.index(end, text.index(start))]
+
+
+FIXTURES = {
+    "android/graphics/Rect.java": '''package android.graphics;
+public final class Rect {
+ public final int left,top,right,bottom;
+ public Rect(int l,int t,int r,int b){left=l;top=t;right=r;bottom=b;}
+ public Rect(Rect value){this(value.left,value.top,value.right,value.bottom);}
+}
+''',
+    "android/os/SystemClock.java": '''package android.os;
+public final class SystemClock {
+ private SystemClock(){}
+ public static long elapsedRealtime(){return System.nanoTime()/1000000L;}
+}
+''',
+    "org/json/JSONException.java": '''package org.json;
+public final class JSONException extends Exception {
+ private static final long serialVersionUID=1L;
+ public JSONException(String message){super(message);}
+}
+''',
+    "org/json/JSONObject.java": r'''package org.json;
+import java.util.*;
+public final class JSONObject {
+ public static final Object NULL=new Object();
+ final Map<String,Object> fields=new LinkedHashMap<String,Object>();
+ public JSONObject(){}
+ public JSONObject(Map<?,?> value){for(Map.Entry<?,?> e:value.entrySet())fields.put(String.valueOf(e.getKey()),e.getValue());}
+ public JSONObject put(String key,Object value)throws JSONException {
+  if(key==null)throw new JSONException("null key");
+  if(value==null)fields.remove(key);else fields.put(key,value);return this;
+ }
+ public Object get(String key)throws JSONException {if(!fields.containsKey(key))throw new JSONException("missing "+key);return fields.get(key);}
+ public boolean has(String key){return fields.containsKey(key);}
+ public boolean isNull(String key){return fields.get(key)==null||fields.get(key)==NULL;}
+ public Iterator<String> keys(){return fields.keySet().iterator();}
+ public int length(){return fields.size();}
+ static String render(Object value){return JsonWriter.render(value);}
+ public String toString(){return render(fields);}
+}
+final class JsonWriter {
+ private JsonWriter(){}
+ static String quote(String value){
+  StringBuilder out=new StringBuilder("\"");
+  for(int i=0;i<value.length();i++){char c=value.charAt(i);switch(c){
+   case '"':out.append("\\\"");break;case '\\':out.append("\\\\");break;
+   case '\n':out.append("\\n");break;case '\r':out.append("\\r");break;case '\t':out.append("\\t");break;
+   default:if(c<32)out.append(String.format(java.util.Locale.ROOT,"\\u%04x",(int)c));else out.append(c);
+  }}return out.append('"').toString();
+ }
+ static String render(Object value){
+  if(value==null||value==JSONObject.NULL)return "null";
+  if(value instanceof JSONObject)return render(((JSONObject)value).fields);
+  if(value instanceof JSONArray)return render(((JSONArray)value).values);
+  if(value instanceof String||value instanceof Character)return quote(value.toString());
+  if(value instanceof Boolean||value instanceof Number)return value.toString();
+  if(value instanceof Map){StringBuilder out=new StringBuilder("{");boolean comma=false;
+   for(Map.Entry<?,?> e:((Map<?,?>)value).entrySet()){if(comma)out.append(',');comma=true;out.append(quote(String.valueOf(e.getKey()))).append(':').append(render(e.getValue()));}
+   return out.append('}').toString();}
+  if(value instanceof Iterable){StringBuilder out=new StringBuilder("[");boolean comma=false;
+   for(Object e:(Iterable<?>)value){if(comma)out.append(',');comma=true;out.append(render(e));}return out.append(']').toString();}
+  if(value.getClass().isArray()){StringBuilder out=new StringBuilder("[");for(int i=0;i<java.lang.reflect.Array.getLength(value);i++){if(i>0)out.append(',');out.append(render(java.lang.reflect.Array.get(value,i)));}return out.append(']').toString();}
+  throw new IllegalArgumentException("unsupported JSON fixture value "+value.getClass());
+ }
+}
+''',
+    "org/json/JSONArray.java": '''package org.json;
+import java.util.*;
+public final class JSONArray {
+ final List<Object> values=new ArrayList<Object>();
+ public JSONArray(){}
+ public JSONArray(Collection<?> source){values.addAll(source);}
+ public JSONArray(Object source)throws JSONException {
+  if(!source.getClass().isArray())throw new JSONException("array required");
+  for(int i=0;i<java.lang.reflect.Array.getLength(source);i++)values.add(java.lang.reflect.Array.get(source,i));
+ }
+ public JSONArray put(Object value){values.add(value==null?JSONObject.NULL:value);return this;}
+ public int length(){return values.size();}
+ public JSONObject getJSONObject(int index)throws JSONException {
+  Object value=values.get(index);if(value instanceof JSONObject)return (JSONObject)value;
+  if(value instanceof Map)return new JSONObject((Map<?,?>)value);throw new JSONException("object required");
+ }
+ public String toString(){return JSONObject.render(values);}
+}
+''',
+}
+
+
+def prepare(source, output):
+    source, output = Path(source), Path(output)
+    package = source / "src/org/trillionnium/hepta/local"
+    controller = (package / "LocalTaskController.java").read_text()
+    service = (package / "HeptaAccessibilityService.java").read_text()
+    parts = {
+        "system": section(controller, "    private static final String SYSTEM=", "    public LocalTaskController("),
+        "await_model": section(controller, "    private static final class ModelAnswer", "    private PhoneObservation awaitObservation("),
+        "active_exceptions": section(controller, "    private void checkActive(", "    private static final class PromptFrame"),
+        "prompt_assembly": section(controller, "    private static final class PromptFrame", "    private static JSONObject catalogueJson("),
+        "label_bound": next(line for line in service.splitlines(True) if line.startswith("    static String limited(")),
+    }
+    prelude = '''package org.trillionnium.hepta.local;
