+        report["tests"].append({"name": name, "exit_code": process.returncode,
+                                "stdout_sha256": hashlib.sha256(process.stdout).hexdigest(),
+                                "stderr_sha256": hashlib.sha256(process.stderr).hexdigest()})
+        if process.returncode:
+            raise RuntimeError(name + " failed:\n" + process.stderr.decode()[-8000:] + process.stdout.decode()[-3000:])
+        return process
+
+    try:
