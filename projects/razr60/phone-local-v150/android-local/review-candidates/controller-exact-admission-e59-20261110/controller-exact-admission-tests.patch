+package org.trillionnium.hepta.local;
+
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.Map;
+
+public final class ControllerBudgetPolicyHostTest {
+    private static int checks;
+    private static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
+    private static String repeat(char c,int n){char[] out=new char[n];Arrays.fill(out,c);return new String(out);}
+    private static ConservativeTokenBudget estimate(int system,int prompt,ModelProfile profile){
+        return ConservativeTokenBudget.estimate(repeat('s',system),repeat('p',prompt),new LocalRuntimeConfig(profile,"npu",4096,4));
+    }
+    private static Map<String,Object> nativeReceipt(int bytes,int count){
+        Map<String,Object> b=new HashMap<String,Object>();
+        b.put("method","llama_tokenize_exact_same_input_ids");b.put("is_exact_token_count",true);
+        b.put("checked",true);b.put("admitted",true);b.put("formatted_utf8_bytes",bytes);
+        b.put("model_contract_sha256",ModelProfile.GEMMA4_E4B.sha256);b.put("tokenizer_source_commit",ModelProfile.LLAMA_COMMIT);
+        b.put("context_tokens",4096);b.put("generation_tokens",256);b.put("reserved_tokens",256);
+        b.put("add_special",true);b.put("parse_special",true);b.put("input_ids_passed_directly",true);
+        b.put("prompt_tokens_exact",count);b.put("input_ids_count",count);b.put("total_context_tokens",count+512);
+        b.put("input_ids_sha256",repeat('a',64));return b;
+    }
+    public static void main(String[] args){
+        ConservativeTokenBudget home=estimate(3593,2523,ModelProfile.GEMMA4_E4B);
+        ConservativeTokenBudget calculator=estimate(3593,2499,ModelProfile.GEMMA4_E4B);
+        check(home.totalContextUpper==4084&&calculator.totalContextUpper==4072,"numeric size fixture byte sizes/scores");
+        check(!home.provenUpperBound&&!calculator.provenUpperBound,"scores are never exact counts or proven bounds");
+        ConservativeTokenBudget next=estimate(3593,2600,ModelProfile.GEMMA4_E4B);
+        check(!next.admitted,"unchanged heuristic rejects larger next prompt");
+        check(!ControllerPromptAdmission.projectionReady(next,true),"optional content is reduced before delegation");
+        check(ControllerPromptAdmission.projectionReady(next,false)&&ControllerPromptAdmission.maySubmit(next),"bounded irreducible exact prompt may be submitted");
+        check(!next.admitted,"delegation never rewrites the heuristic result");
+        check(ControllerPromptAdmission.maySubmit(estimate(65536,65536,ModelProfile.GEMMA4_E4B)),"unchanged 65536 byte boundary permits native decision only");
+        check(!ControllerPromptAdmission.maySubmit(estimate(65537,10,ModelProfile.GEMMA4_E4B)),"system byte bound");
+        check(!ControllerPromptAdmission.maySubmit(estimate(10,65537,ModelProfile.GEMMA4_E4B)),"prompt byte bound");
+        check(!ControllerPromptAdmission.maySubmit(estimate(10,0,ModelProfile.GEMMA4_E4B)),"empty prompt rejected");
+        check(!ControllerPromptAdmission.maySubmit(null),"missing budget rejected");
+        check(!ControllerPromptAdmission.maySubmit(estimate(3593,2600,ModelProfile.LFM3)),"original byte-proven tokenizer still refuses");
+        for(String bad:new String[]{"x\u0000y","\ud800","\udc00","\ud800x"}){
+            boolean rejected=false;try{ConservativeTokenBudget.estimate("s",bad,new LocalRuntimeConfig(ModelProfile.GEMMA4_E4B,"npu",4096,4));}
+            catch(IllegalArgumentException expected){rejected=true;}check(rejected,"Unicode/NUL protection remains");
+        }
+        LocalRuntimeConfig cfg=new LocalRuntimeConfig(ModelProfile.GEMMA4_E4B,"npu",4096,4);
+        check(NativeBudgetVerifier.valid(nativeReceipt(6170,1945),cfg,256,1945),"size-a exact prompt1945 plus512 totals2457");
+        check(NativeBudgetVerifier.valid(nativeReceipt(6146,2061),cfg,256,2061),"size-b exact prompt2061 plus512 totals2573");
+        check(NativeBudgetVerifier.valid(nativeReceipt(10000,3584),cfg,256,3584),"exact total4096 boundary");
+        check(!NativeBudgetVerifier.valid(nativeReceipt(100,3585),cfg,256,3585),"small bytes cannot override actual token overflow");
+        Map<String,Object> b=nativeReceipt(6170,1945);b.put("admitted",false);
+        check(!NativeBudgetVerifier.valid(b,cfg,256,1945),"native refusal remains refusal");
+        b=nativeReceipt(6170,1945);b.put("input_ids_passed_directly",false);
+        check(!NativeBudgetVerifier.valid(b,cfg,256,1945),"no same-ID proof cannot authorize");
+        b=nativeReceipt(6170,1945);b.put("reserved_tokens",0);
+        check(!NativeBudgetVerifier.valid(b,cfg,256,1945),"reserve cannot be relaxed");
+        check(!NativeBudgetVerifier.valid(nativeReceipt(6170,1945),cfg,256,1946),"SDK count mismatch cannot authorize");
+        System.out.println("PASS "+checks+" policy/receipt boundary assertions; synthetic sizes only, no tokenizer/model inference");
+    }
+}
