+                  (candidate / source_dir / "LocalTaskController.java", "c4e3aeaadb315d500b653108d679040a5687b60ddb7a3ff78473e4b7eacdbe25"),
+                  (candidate / source_dir / "ControllerPromptAdmission.java", "51df6e87f8d8dbb8a4791939a4d9cab270185574042c29d96eb1e3aa7a047be3")]
