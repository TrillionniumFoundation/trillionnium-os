+            run(variant + "-compile", compiler + language + ["-encoding", "UTF-8", "-Werror", "-d", classes] + sources + test_sources)
+            run(variant + "-production-controller", [java, "-cp", classes, "org.trillionnium.hepta.local.ControllerAdmissionHostTest", variant])
+            run(variant + "-original-lfm3-budget", [java, "-cp", classes, "BudgetHostTest"])
+            if variant == "candidate":
+                run("candidate-policy-receipt", [java, "-cp", classes, "org.trillionnium.hepta.local.ControllerBudgetPolicyHostTest"])
