+++ b/src/org/trillionnium/hepta/local/ControllerPromptAdmission.java
@@ -0,0 +1,27 @@
+package org.trillionnium.hepta.local;
+
+/** Submission policy for the text-only, task-owned controller worker.
+ * The sizing estimate may reduce optional observations. It never replaces the
+ * worker's exact rendered-token check or authorizes a generated action.
+ * One-shot and image engines do not use this policy.
+ */
+public final class ControllerPromptAdmission {
+    public static final int TEXT_UTF8_LIMIT = 65536;
+    private ControllerPromptAdmission(){}
+
+    public static boolean withinTextLimit(ConservativeTokenBudget budget){
+        return budget!=null && budget.systemBytesUpper>=0 && budget.systemBytesUpper<=TEXT_UTF8_LIMIT
+                && budget.promptBytesUpper>0 && budget.promptBytesUpper<=TEXT_UTF8_LIMIT;
+    }
+
+    /** Native still has to admit the exact same rendered input IDs before generation. */
+    public static boolean maySubmit(ConservativeTokenBudget budget){
+        return withinTextLimit(budget) && (budget.admitted || budget.profile.exactTokenizationRequired);
+    }
+
+    /** Exhaust the existing optional reductions before delegating a failed estimate. */
+    public static boolean projectionReady(ConservativeTokenBudget budget,boolean optionalContextRemaining){
+        return withinTextLimit(budget) && (budget.admitted
+                || (!optionalContextRemaining && budget.profile.exactTokenizationRequired));
+    }
+}
