       need(re.fullmatch(r'\"'\"'[0-9]{8}-[0-9]{6}-[0-9a-f]{32}'\"'\"',name),'\"'\"'unrecognized provider evidence member'\"'\"')\n            run=root/name;directory(run);runs+=1;need(runs<=512,'\"'\"'combined provider run bound'\"'\"')\n            path=run/'\"'\"'provider-in.jsonl'\"'\"'\n            try:raw=read(path)\n            except FileNotFoundError:\n                absent(path);missing.append(str(path));continue\n            need(not raw or raw.endswith(b'\"'\"'\\n'\"'\"'),'\"'\"'partial provider input tail is not a complete absence proof'\"'\"')\n            local=0\n            for line in raw.splitlines(keepends=True):\n                check();need(line.endswith(b'\"'\"'\\n'\"'\"') and len(line)<=4*1024*1024,'\"'\"'bounded complete provider line required'\"'\"')\n                frame=strict(line);need(type(frame) is dict,'\"'\"'provider frame object required'\"'\"');lines+=1\n                need(lines<=65536,'\"'\"'provider frame count exceeded'\"'\"')\n                if frame.get('\"'\"'kind'\"'\"')!='\"'\"'turn.start'\"'\"':continue\n                turn=frame.get('\"'\"'turn'\"'\"');need(type(turn) is dict and type(turn.get('\"'\"'user_input'\"'\"')) is str,'\"'\"'turn.start user input required'\"'\"')\n                local+=1;owner=sha(turn['\"'\"'user_input'\"'\"'].encode())\n                if owner in wanted:matches.append({'\"'\"'path'\"'\"':str(path),'\"'\"'owner_request_sha256'\"'\"':owner,'\"'\"'line_sha256'\"'\"':sha(line)})\n            scanned.append({'\"'\"'mode'\"'\"':mode,'\"'\"'path'\"'\"':str(path),'\"'\"'bytes'\"'\"':len(raw),'\"'\"'sha256'\"'\"':sha(raw),'\"'\"'turn_start_count'\"'\"':local})\n    need(not matches,'\"'\"'a failed owner hash has a published provider turn.start'\"'\"')\n    return {'\"'\"'scope'\"'\"':'\"'\"'all complete provider-in.jsonl files in the two fixed evidence roots'\"'\"',\n        '\"'\"'provider_match_count'\"'\"':0,'\"'\"'matches'\"'\"':[],'\"'\"'run_count'\"'\"':runs,'\"'\"'frame_count'\"'\"':line