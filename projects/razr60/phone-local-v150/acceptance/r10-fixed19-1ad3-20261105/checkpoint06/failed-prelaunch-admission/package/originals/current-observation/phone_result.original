adc10'\"'\"'}\nMETA=('\"'\"'st_dev'\"'\"','\"'\"'st_ino'\"'\"','\"'\"'st_mode'\"'\"','\"'\"'st_uid'\"'\"','\"'\"'st_gid'\"'\"','\"'\"'st_nlink'\"'\"','\"'\"'st_size'\"'\"','\"'\"'st_mtime_ns'\"'\"','\"'\"'st_ctime_ns'\"'\"')\nMAX_FILE=16*1024*1024\nMAX_READ=64*1024*1024\nMAX_OUTPUT=1024*1024\nSTART=None\nREAD_TOTAL=0\nFILES={}\nDIRECTORIES={}\nABSENT={}\nUSER_ZERO=None\nUSER_ZERO_VIEW=None\n\ndef need(ok,why):\n    if not ok:raise ValueError(why)\n\ndef check():need(time.monotonic()-START<30,'\"'\"'fixed scoped read exceeds 30-second cooperative budget'\"'\"')\n\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\n\ndef meta(s):return [getattr(s,key) for key in META]\n\ndef strict(raw):\n    def pairs(rows):\n        value={}\n        for key,item in rows:\n            need(key not in value,'\"'\"'duplicate JSON key'\"'\"');value[key]=item\n        return value\n    return json.loads(raw,object_pairs_hook=pairs,\n        parse_constant=lambda _:(_ for _ in ()).throw(ValueError('\"'\"'nonfinite JSON'\"'\"')))\n\ndef parent_fd(path):\n    path=Path(path)\n    need(path.is_absolute() and '\"'\"'..'\"'\"' not in path.parts and 2<=len(path.parts)<=64,'\"'\"'bounded absolute path'\"'\"')\n    if path.parts[:4]==('\"'\"'/'\"'\"','\"'\"'proc'\"'\"','\"'\"'1'\"'\"','\"'\"'root'\"'\"'):\n        fd=os.open(ANDROID,os.O_RDONLY|os.O_DIRECTORY|os.O_CLOEXEC);parts=path.parts[4:]\n    else:\n        fd=os.open('\"'\"'/'\"'\"',os.O_RDONLY|os.O_DIRECTORY|os.O_CLOEXEC);parts=path.parts[1:]\n    need(parts,'\"'\"'original leaf required'\"'\"')\n    try:\n        for name in parts[:-1]:\n            child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=fd)\n            os.close(fd);fd=child\n        return fd,parts[-1]\n    except BaseException:\n        os.close(fd);raise\n\ndef directory(path):\n    check();path=Path(path);parent,leaf=parent_fd(path)\n    try:\n        fd=os.open(leaf,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=parent)\n        try:\n            before=os.fstat(fd);names=sorted(os.listdir(fd))\n            need(stat.S_ISDIR(before.st_mode) and before.st_uid==before.st_gid==0\n                 and stat.S_IMODE(before.st_mode)==0o700 and len(names)<=1024,'\"'\"'private scoped directory shape'\"'\"')\n            need(meta(before)==meta(os.fstat(fd))==meta(os.stat(leaf,dir_fd=parent,follow_symlinks=False)),\n                 '\"'\"'directory full9 changed while read'\"'\"')\n        finally:os.close(fd)\n    finally:os.close(parent)\n    row={'\"'\"'metadata'\"'\"':meta(before),'\"'\"'names'\"'\"':names}\n    if str(path) in DIRECTORIES:need(DIRECTORIES[str(path)]==row,'\"'\"'scoped directory changed across read'\"'\"')\n    else:DIRECTORIES[str(path)]=row\n    return row\n\ndef read(path,maximum=MAX_FILE,root_owned=True):\n    global READ_TOTAL\n    check();path=Path(path);parent,leaf=parent_fd(path)\n    try:\n        fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=parent)\n        try:\n            before=os.fstat(fd)\n            need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and stat.S_IMODE(before.st_mode)==0o600\n                 and 0<=before.st_size<=maximum,'\"'\"'bounded private regular original required'\"'\"')\n            if root_owned:need(before.st_uid==before.st_gid==0,'\"'\"'root-owned scoped original required'\"'\"')\n            with os.fdopen(fd,'\"'\"'rb'\"'\"',closefd=False) as stream:raw=stream.read(before.st_size+1)\n            need(len(raw)==before.st_size and meta(before)==meta(os.fstat(fd))\n                 ==meta(os.stat(leaf,dir_fd=parent,follow_symlinks=False)),'\"'\"'original full9 changed while read'\"'\"')\n        finally:os.close(fd)\n    finally:os.close(parent)\n    READ_TOTAL+=len(raw);need(READ_TOTAL<=MAX_READ,'\"'\"'scoped original read bytes exceeded'\"'\"')\n    row={'\"'\"'bytes'\"'\"':len(raw),'\"'\"'sha256'\"'\"':sha(raw),'\"'\"'metadata'\"'\"':meta(before),'\"'\"'root_owned'\"'\"':root_owned}\n    if str(path) in FI