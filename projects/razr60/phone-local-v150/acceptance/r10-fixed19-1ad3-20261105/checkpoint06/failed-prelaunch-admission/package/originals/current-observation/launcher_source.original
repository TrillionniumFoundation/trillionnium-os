-client-session-v1.pending\'\n    absent(pending);raw=read(parent/\'owner-client-session-v1.bin\',65536,root_owned=False);absent(pending)\n    need((len(raw),sha(raw))==SELECTED_PIN,\'current selected task bytes differ from final actor CAS readback\')\n    return {\'bytes\':len(raw),\'sha256\':sha(raw),\'file\':str(parent/\'owner-client-session-v1.bin\'),\n            \'pending_absent\':True,\'matches_original_actor_final_readback\':True}\n\ndef provider_starts():\n    wanted={row[\'owner_request_sha256\'] for row in ATTEMPTS};scanned=[];matches=[];missing=[];runs=0;lines=0\n    for mode,root in [(\'production\',BASE/\'provider-state/evidence\'),(\'component\',BASE/\'component-probe-r6/evidence\')]:\n        names=directory(root)[\'names\'];need(len(names)<=512,\'provider root count exceeds existing observer limit\')\n        for name in names:\n            if mode==\'production\' and name in (\'action-ledger\',\'claims\'):\n                directory(root/name);continue\n            need(re.fullmatch(r\'[0-9]{8}-[0-9]{6}-[0-9a-f]{32}\',name),\'unrecognized provider evidence member\')\n            run=root/name;directory(run);runs+=1;need(runs<=512,\'combined provider run bound\')\n            path=run/\'provider-in.jsonl\'\n            try:raw=read(path)\n            except FileNotFoundError:\n                absent(path);missing.append(str(path));continue\n            need(not raw or raw.endswith(b\'\\n\'),\'partial provider input tail is not a complete absence proof\')\n            local=0\n            for line in raw.splitlines(keepends=True):\n                check();need(line.endswith(b\'\\n\') and len(line)<=4*1024*1024,\'bounded complete provider line required\')\n                frame=strict(line);need(type(frame) is dict,\'provider frame object required\');lines+=1\n                need(lines<=65536,\'provider frame count exceeded\')\n                if frame.get(\'kind\')!=\'turn.start\':continue\n                turn=frame.get(\'turn\');need(type(turn) is dict and type(turn.get(\'user_input\')) is str,\'turn.start user input required\')\n                local+=1;owner=sha(turn[\'user_input\'].encode())\n                if owner in wanted:matches.append({\'path\':str(path),\'owner_request_sha256\':owner,\'line_sha256\':sha(line)})\n            scanned.append({\'mode\':mode,\'path\':str(path),\'bytes\':len(raw),\'sha256\':sha(raw),\'turn_start_count\':local})\n    need(not matches,\'a failed owner hash has a published provider turn.start\')\n    return {\'scope\':\'all complete provider-in.jsonl files in the two fixed evidence roots\',\n        \'provider_match_count\':0,\'matches\':[],\'run_count\':runs,\'frame_count\':lines,\n        \'files\':scanned,\'missing_original_provider_input_paths\':missing,\n        \'native_journal_hash_chain_claimed\':False,\'unrelated_file_contents_scanned\':False}\n\ndef main():\n    global START\n    START=time.monotonic();error=None;result=None\n    try:\n        need(len(sys.argv)==1,\'fixed two-attempt observer takes no arguments\')\n        need(os.getuid()==os.geteuid()==os.getgid()==os.getegid()==0,\'actual Root credentials required\')\n        boot=Path(\'/proc/sys/kernel/random/boot_id\').read_text().strip();need(boot==BOOT,\'actual boot changed\')\n        now=time.time_ns()//1000000;need(all(now>=x[\'lease_expires_unix_ms\'] for x in ATTEMPTS),\'both original leases must remain expired\')\n        root=BASE/\'native-guard-boundaries-r10-r1\';directory(root)\n        head=read(ACTUAL08[\'path\'],16384)\n        need((len(head),sha(head))==(ACTUAL08[\'bytes\'],ACTUAL08[\'sha256\'])\n             and FILES[ACTUAL08[\'path\']][\'metadata\']==ACTUAL08[\'metadata\'],\'last actual native boundary original changed\')\n        for item in ATTEMPTS:\n            absent(root/(item[\'nonce\']+\'.json\'));absent(root/item[\'nonce\'])\n        selected=selected_state();provider=provider_starts()\n        for path,row in list(FILES.items()):read(path,max(1,row[\'bytes\']),root_owned=row[\'root_owned\'])\n        for path in list(DIRECTORIES):directory(path)\n        for path in list(ABSENT):absent(path)\n        need(selected_state()==selected,\'current selected state changed across scoped observation\')\n        need(Path(\'/proc/sys/kernel/random/boot_id\').read_text().strip()==BOOT,\'boot changed across scoped observation\');check()\n        result={\'schema\':\'hepta.native-guard.failed-prelaunch-current-observation.v1\',\n            \'state\':\'TWO_FAILED_NONCES_UNPUBLISHED_SELECTED_ORIGINAL_UNCHANGED\',\n            \'boot_id\':BOOT,\'attempts\':list(ATTEMPTS),\'last_real_native_boundary\':ACTUAL08,\n            \'observed_unix_ms\':now,\'completed_unix_ms\':time.time_ns()//1000000,\n            \'selected\':selected,\'android_user_zero_anchor\':USER_ZERO_VIEW,\'provider\':provider,\n            \'files\':FILES,\'directories\':DIRECTORIES,\'explicit_absence\':ABSENT,\n            \'full9_readset_canonical_recheck_complete\':True,\n            \'read_total_bytes\':READ_TOTAL,\'elapsed_seconds\':time.monotonic()-START,\n            \'phone_writes\':0,\'process_starts\':0,\'signals_sent\':0,\'socket_connections\':0,\'model_requests\':0,\n            \'native_boundary_created\':False,\'failed_prelaunch_closed_here\':False,\n            \'component_qualified\':False,\'business_qualified\':False,\'automatic_retry\':False}\n        raw=(json.dumps(result,sort_keys=True,ensure_ascii=False,separators=(\',\',\':\'),allow_nan=False)+\'\\n\').encode()\n        need(len(raw)<=MAX_OUTPUT,\'complete scoped observation exceeds one MiB\')\n    except BaseException as exc:\n        error={\'type\':type(exc).__name__,\'detail\':str(exc)[:1024]}\n        raw=(json.dumps({\'schema\':\'hepta.native-guard.failed-prelaunch-current-observation.v1\',\n            \'state\':\'CURRENT_OBSERVATION_FAILED_OR_PARTIAL_RETAIN_ORIGINALS\',\'boot_id\':BOOT,\'attempts\':list(ATTEMPTS),\n            \'error\':error,\'read_total_bytes\':READ_TOTAL,\'elapsed_seconds\':time.monotonic()-START,\n            \'phone_writes\':0,\'process_starts\':0,\'signals_sent\':0,\'failed_prelaunch_closed_here\':False,\n            \'component_qualified\':False,\'automatic_retry\':False},sort_keys=True,separators=(\',\',\':\'))+\'\\n\').encode()\n    sys.stdout.write(raw.decode());return 1 if error else 0\n\nif __name__==\'__main__\':raise SystemExit(main())\n\nFIXED_TWO_FAILED_PUBLICATION_1956'}
LABEL='ng-7c74b84aefb177d15f746fa7eae29d54-publication-read01'
assert len(PROBE)==13192 and hashlib.sha256(PROBE).hexdigest()=='1956c026152ff82a9c3065388139c8782c55c5788afa9cfeacfef054651f18ed'
actor=BASE/'ops/phone_once.py';assert hashlib.sha256(actor.read_bytes()).hexdigest()=='179a3a57ad8859a256f7e244e34171e9dd90544012928d65405efd22c8a74b22'
out=BASE/'fixed19-root-1ad3-failed-prelaunch-current-read01'
assert out.parent.resolve(strict=True)==out.parent;os.mkdir(out,0o700)
def put(p,b):
 fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 with os.fdopen(fd,'wb') as f:f.write(b);f.flush();os.fsync(f.fileno())
 d=os.open(p.parent,os.O_RDONLY|os.O_DIRECTORY);os.fsync(d);os.close(d)
def enc(v):return (json.dumps(v,sort_keys=True,ensure_ascii=False,indent=2)+'\n').encode()
put(out/'PROBE-SOURCE.original.py',PROBE)
request=BASE/'requests'/(LABEL+'.json');request_raw=enc(REQ);put(request,request_raw);put(out/'REQUEST.original.json',request_raw)
argv=['/usr/bin/python3','-I','-B',str(actor),LABEL,str(request)]
put(out/'INTENT.json',enc({'argv':argv,'phone_calls_max':1,'probe_source_sha256':hashlib.sha256(PROBE).hexdigest(),'request_sha256':hashlib.sha256(request_raw).hexdigest(),'phone_source_or_case_writes':0,'signals_sent':0,'automatic_retry':False,'case_pass':False}))
so=open(out/'actor.stdout.original','xb');se=open(out/'actor.stderr.original','xb')
p=subprocess.Popen(argv,stdin=subprocess.DEVNULL,stdout=so,stderr=se,start_new_session=True)
put(out/'CHILD.json',enc({'pid':p.pid,'maximum_starts':1,'automatic_retry':False}))
try:
 rc=p.wait(timeout=90)
except subprocess.TimeoutExpired:
 put(out/'UNKNOWN.json',enc({'pid':p.pid,'wait_returned':False,'signals_sent':0,'automatic_retry':False}));raise
finally:
 so.flush();os.fsync(so.fileno());so.close();se.flush();os.fsync(se.fileno());se.close()
put(out/'JOINED.json',enc({'pid':p.pid,'returncode':rc,'wait_returned':True,'signals_sent':0}))
rows={}
for name in ('intent.json','baseline.json','result.json'):
 f=BASE/'operations'/LABEL/name;fd=os.open(f,os.O_RDONLY|os.O_NOFOLLOW)
 with os.fdopen(fd,'rb') as stream:
  a=os.fstat(stream.fileno());assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size<=8*1024*1024
  raw=stream.read(8*1024*1024+1);b=os.fstat(stream.fileno())
 assert (a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_ctime_ns)==(b.st_dev,b.st_ino,b.st_size,b.st_mtime_ns,b.st_ctime_ns)
 put(out/('phone-'+name+'.original'),raw);rows[name]={'path':str(f),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}
 if name=='result.json':operation=json.loads(raw)
phone=operation.get('phone',{});phone_stdout=phone.get('stdout','').encode();put(out/'PHONE-STDOUT.original',phone_stdout)
result={'state':'READ_ONLY_FAILED_PRELAUNCH_CURRENT_COMPLETED' if rc==0 and phone.get('rc')==0 else 'READ_ONLY_FAILED_PRELAUNCH_CURRENT_FAILED_OR_UNKNOWN','actor_returncode':rc,'phone_returncode':phone.get('rc'),'phone_status':operation.get('status'),'phone_stdout':{'path':str(out/'PHONE-STDOUT.original'),'bytes':len(phone_stdout),'sha256':hashlib.sha256(phone_stdout).hexdigest()},'phone_originals':rows,'source_sha256':hashlib.sha256(PROBE).hexdigest(),'case_pass':False,'native_boundary_created':False,'signals_sent':0,'automatic_retry':False}
raw=enc(result);put(out/'RESULT.json',raw)
print(json.dumps({'result':{'path':str(out/'RESULT.json'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()},'state':result['state'],'actor_returncode':rc,'phone_returncode':phone.get('rc'),'case_pass':False},sort_keys=True))

import tarfile,io,lzma
originals={q.name:q.read_bytes() for q in out.iterdir() if q.is_file()}
assert len(originals)==12 and sum(len(x) for x in originals.values())<=16*1024*1024
buf=io.BytesIO()
with tarfile.open(fileobj=buf,mode='w',format=tarfile.USTAR_FORMAT) as archive:
 for name,body in sorted(originals.items()):
  info=tarfile.TarInfo(name);info.size=len(body);info.mode=0o600;info.mtime=0;archive.addfile(info,io.BytesIO(body))
plain=buf.getvalue();compressed=lzma.compress(plain,preset=6);assert lzma.decompress(compressed)==plain
put(out/'FULL-ORIGINALS.tar.xz',compressed)
manifest={'schema':'hepta.fixed19.readonly-diagnostic-originals.v1','source_sha256':hashlib.sha256(PROBE).hexdigest(),'archive':{'path':str(out/'FULL-ORIGINALS.tar.xz'),'bytes':len(compressed),'sha256':hashlib.sha256(compressed).hexdigest()},'tar':{'bytes':len(plain),'sha256':hashlib.sha256(plain).hexdigest()},'files':[{'path':name,'bytes':len(body),'sha256':hashlib.sha256(body).hexdigest()} for name,body in sorted(originals.items())],'originals_changed':False,'case_pass':False}
raw=enc(manifest);put(out/'ARCHIVE-MANIFEST.json',raw)
print(json.dumps({'archive_manifest':{'path':str(out/'ARCHIVE-MANIFEST.json'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()},'archive':manifest['archive'],'case_pass':False},sort_keys=True))
