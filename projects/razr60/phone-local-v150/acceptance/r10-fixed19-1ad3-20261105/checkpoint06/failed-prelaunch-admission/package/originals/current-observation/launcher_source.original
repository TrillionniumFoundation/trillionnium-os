while read\')\n        finally:os.close(fd)\n    finally:os.close(parent)\n    row={\'metadata\':meta(before),\'names\':names}\n    if str(path) in DIRECTORIES:need(DIRECTORIES[str(path)]==row,\'scoped directory changed across read\')\n    else:DIRECTORIES[str(path)]=row\n    return row\n\ndef read(path,maximum=MAX_FILE,root_owned=True):\n    global READ_TOTAL\n    check();path=Path(path);parent,leaf=parent_fd(path)\n    try:\n        fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=parent)\n        try:\n            before=os.fstat(fd)\n            need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and stat.S_IMODE(before.st_mode)==0o600\n                 and 0<=before.st_size<=maximum,\'bounded private regular original required\')\n            if root_owned:need(before.st_uid==before.st_gid==0,\'root-owned scoped original required\')\n            with os.fdopen(fd,\'rb\',closefd=False) as stream:raw=stream.read(before.st_size+1)\n            need(len(raw)==before.st_size and meta(before)==meta(os.fstat(fd))\n                 ==meta(os.stat(leaf,dir_fd=parent,follow_symlinks=False)),\'original full9 changed while read\')\n        finally:os.close(fd)\n    finally:os.close(parent)\n    READ_TOTAL+=len(raw);need(READ_TOTAL<=MAX_READ,\'scoped original read bytes exceeded\')\n    row={\'bytes\':len(raw),\'sha256\':sha(raw),\'metadata\':meta(before),\'root_owned\':root_owned}\n    if str(path) in FILES:need(FILES[str(path)]==row,\'original changed across complete readset\')\n    else:\n        need(len(FILES)<1024,\'scoped original count exceeded\');FILES[str(path)]=row\n    return raw\n\ndef absent(path):\n    check();path=Path(path);parent,leaf=parent_fd(path)\n    try:\n        before=os.fstat(parent)\n        try:os.stat(leaf,dir_fd=parent,follow_symlinks=False)\n        except OSError as exc:need(exc.errno==errno.ENOENT,\'absence is unknown\')\n        else:raise ValueError(\'forbidden pending or failed-nonce publication is present\')\n        ne