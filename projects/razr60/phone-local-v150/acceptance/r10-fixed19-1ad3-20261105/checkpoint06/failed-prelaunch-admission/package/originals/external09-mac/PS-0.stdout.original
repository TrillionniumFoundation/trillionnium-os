"stdout": False, "stderr": False}\012log_errors = {"stdout": None, "stderr": None}\012log_eof = {"stdout": False, "stderr": False}\012log_drain_finished = {"stdout": None, "stderr": None}\012log_bytes = {"stdout": {"seen": 0, "stored": 0}, "stderr": {"seen": 0, "stored": 0}}\012def drain(stream, sink, label):\012    stored = 0\012    try:\012        while True:\012            chunk = stream.read1(65536)\012            if not chunk:\012                log_eof[label] = True\012                break\012            log_bytes[label]["seen"] += len(chunk)\012            keep = chunk if req.get("execution_mode") == "operator" else chunk[:max(0, 16 * 1024 * 1024 - stored)]\012            if len(keep) != len(chunk):\012                log_truncated[label] = True\012            if log_errors[label] is None:\012                try:\012                    pending = memoryview(keep)\012                    while pending:\012                        written = sink.write(pending)\012                        if written is None or written <= 0 or written > len(pending):\012                            raise OSError("log write made invalid progress")\012                        stored += written\012                        log_bytes[label]["stored"] = stored\012                        pending = pending[written:]\012                except Exception as exc:\012                    # Continue draining after storage failure; never deadlock the\012                    # producer or publish silent success for lost output.\012                    log_errors[label] = "write: " + str(exc)\012    except Exception as exc:\012        log_errors[label] = "read: " + str(exc)\012    finally:\012        try:\012            stream.close()\012        except Exception as exc:\012            if log_errors[label] is None:\012                log_errors[label] = "close: " + str(exc)\012        log_drain_finished[label] = time.monotonic()\012\012readers = None\012try:\012    readers = [threading.Thread(target=drain,