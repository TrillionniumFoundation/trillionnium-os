ream:\n        before = os.fstat(stream.fileno())\n        if before.st_size > 4 * 1024 * 1024:\n            raise SystemExit(\"unsafe remote job file \" + name + \": linked or oversized inode\")\n        encoded = stream.read(4 * 1024 * 1024 + 1)\n        after = os.fstat(stream.fileno())\n        current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\n    def stamp(info):\n        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,\n                info.st_size, info.st_mtime_ns, info.st_ctime_ns)\n    if len(encoded) > 4 * 1024 * 1024 or stamp(before) != stamp(after) or stamp(after) != stamp(current):\n        raise SystemExit(\"unsafe remote job file \" + name + \": changed while reading\")\n    try:\n        value = json.loads(encoded)\n        if not isinstance(value, dict): raise ValueError(\"not an object\")\n        return value\n    except (ValueError, UnicodeError) as error:\n        raise SystemExit(\"corrupt remote job file \" + name) from error\n\n"\012exec(REMOTE_DIRECTORY_SOURCE)\012\012import io, json\012_original_query = json.load(sys.stdin)\012_bound_job = private_job_directory(_original_query["job_dir"])\012_bound_request = private_read_json("request.json")\012_digest = _original_query.get("request_digest")\012if (not isinstance(_bound_request, dict) or not isinstance(_digest, str) or len(_digest) != 64 or\012        any(c not in "0123456789abcdef" for c in _digest) or\012        _bound_request.get("job_id") != _original_query.get("job_id") or\012        _bound_request.get("job_dir") != _original_query.get("job_dir") or\012        _bound_request.get("unit") != _original_query.get("unit") or\012        _bound_request.get("request_digest", _bound_request.get("request_fingerprint")) != _digest):\012    raise SystemExit("remote job request binding missing or mismatched")\012# Metadata is validated before a status can claim success or cancellation can\012# acknowledge a terminal receipt. The status owner interprets a torn private\012# started.json as unknown, and a confirmed terminal receipt takes precedence.\012# Cancellation still validates its owner record before sending any signal.\012for _name in ("launch.json", "exit.json"):\012    private_read_json(_name)\012sys.stdin = io.StringIO(json.dumps(_original_query))\012\012\012import json, os, pathlib, stat, subprocess, sys, time\012q = json.load(sys.stdin)\012job = private_job_directory(q["job_dir"])\012\012def read_json(name):\012    return private_read_json(name)\012\012def process_identity(pid):\012    if sys.platform == "linux":\012        try:\012            ticks = int(pathlib.Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[19])\012            boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()\012            return {"kind": "proc_start_ticks", "value": boot + ":" + str(ticks)} if boot else None\012        except Exception:\012            return None\012    try:\012        value = subprocess.check_output(["ps", "-p", str(pid), "-o", "lstart="], text=True, timeout=3).strip()\012        return {"kind": "ps_lstart", "value": value} if value else None\012    except Exception:\012        return None\012\012def valid_owner(request, started, systemd=False):\012    nonce = request.get("launch_nonce")\012    identity = started.get("supervisor_identity")\012    return (isinstance(nonce, str) and len(nonce) == 32 and all(c in "0123456789abcdef" for c in nonce) and\012        started.get("job_id") == request.get("job_id") and started.get("launch_nonce") == nonce and\012        type(started.get("supervisor_uid")) is int and started["supervisor_uid"] == os.geteuid() and\012        type(started.get("supervisor_pid")) is int and 1 < started["supervisor_pid"] <= 2147483647 and\012        isinstance(identity, dict) and identity.get("kind") == ("proc_start_ticks" if sys.platform == "linux" else "ps_lstart") and\012        isinstance(identity.get("value"), str) and bool(identity["value"]) and\012        (not systemd or (isinstance(started.get("invocation_id"), str) and len(started["invocation_id"]) == 32 and\012            all(c in "0123456789abcdef" for c in started["invocation_id"]))))\012\012def process_uid(pid):\012    if sys.platform == "linux": return pathlib.Path(f"/proc/{pid}").stat().st_uid\012    return int(subprocess.check_output(["ps", "-p", str(pid), "-o", "uid="], text=True, timeout=3).strip())\012\012def publication_pending(reason):\012    return {"state": "finalizing", "outcome": "unknown", "reason": reason,\012            "terminal_publication_confirmed": False,\012            "status_authoritative": False, "automatic_retry": False}\012\012def read_terminal_file(name, limit, missing_ok=False):\012    # Relative to the already pinned job directory; never follow a receipt\012    # symlink or wait on a substituted FIFO. Hash and parse this one snapshot.\012    try:\012        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,\012                     dir_fd=_hepta_directory_pins[-1])\012    except FileNotFoundError:\012        if missing_ok:\012            return None\012        raise\012    with os.fdopen(fd, "rb") as stream:\012        before = os.fstat(stream.fileno())\012        if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.geteuid() or\012                before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600 or before.st_size > limit):\012            raise ValueError("unsafe terminal publication file")\012        encoded = stream.read(limit + 1)\012        after = os.fstat(stream.fileno())\012        current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\012    def stamp(info):\012        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,\012                info.st_size, info.st_mtime_ns, info.st_ctime_ns)\012    if (len(encoded) > limit or len(encoded) != before.st_size or\012            stamp(before) != stamp(after) or stamp(after) != stamp(current)):\012        raise ValueError("terminal publication file changed")\012    return encoded\012\012def read_owner_binding():\012    # An interrupted O_EXCL owner write is a permanent no-replay tombstone.\012    # Only malformed bytes in a verified private regular file become Unknown;\012    # unsafe paths, ownership/mode changes and read failures still propagate.\012    encoded = read_terminal_file("started.json", 16 * 1024, missing_ok=True)\012    if encoded is None:\012        return {}\012    try:\012        value = json.loads(encoded)\012    except ValueError:\012        return {}\012    return value if isinstance(value, dict) else {}\012\012def read_terminal_status(request):\012    field = "terminal_publication_protocol"\012    if field in request and (type(request[field]) is not int or request[field] != 1):\012        return publication_pending("terminal publication protocol is unsupported")\012    try:\012        encoded = read_terminal_file("exit.json", 1024 * 1024)\012    except FileNotFoundError:\012        return None\012    except (OSError, ValueError):\012        return publication_pending("terminal receipt is unavailable or unsafe")\012    try:\012        exit_data = json.loads(encoded)\012        if not isinstance(exit_data, dict):\012            raise ValueError("terminal receipt must be an object")\012        if field not in request and field not in exit_data:\012            return final_status(exit_data)\012        if type(exit_data.get(field)) is not int or exit_data[field] != 1:\012            return publication_pending("terminal publication protocol is missing or unsupported")\012        nonce = request.get("launch_nonce")\012        if (not isinstance(nonce, str) or len(nonce) != 32 or\012                not all(c in "0123456789abcdef" for c in nonce) or\012                exit_data.get("job_id") != request["job_id"] or exit_data.get("launch_nonce") != nonce):\012            return publication_pending("terminal receipt identity does not match the original request")\012        import hashlib\012        witness = json.loads(read_terminal_file("exit.witness.json", 4096))\012        if (not isinstance(witness, dict) or type(witness.get(field)) is not int or witness[field] != 1 or\012                witness.get("job_id") != request["job_id"] or witness.get("launch_nonce") != nonce or\012                witness.get("exit_sha256") != hashlib.sha256(encoded).hexdigest()):\012            return publication_pending("terminal publication witness does not match the original receipt")\012        result = final_status(exit_data)\012        result["terminal_publication_confirmed"] = True\012        result["automatic_retry"] = False\012        return result\012    except (OSError, ValueError, TypeError, KeyError):\012        return publication_pending("terminal publication witness or receipt is unavailable or invalid")\012\012def final_status(exit_data):\012    if exit_data.get("effect_outcome") == "unknown":\012        state = "effect_unknown"\012    elif exit_data.get("timed_out"):\012        state = "timed_out"\012    elif exit_data.get("cancelled"):\012        state = "cancelled"\012    elif int(exit_data.get("exit_code", -1)) == 0:\012        # Legacy receipts without these additive fields remain readable.\012        output_failed = any(name in exit_data and exit_data[name] is not True\012                            for name in ("output_complete", "output_durable"))\012        state = "failed" if output_failed else "succeeded"\012    else:\012        state = "failed"\012    return {**exit_data, "state": state}\012\012def one_status():\012    request = read_json("request.json")\012    if not request or request.get("job_id") != q["job_id"]:\012        return {"state": "unknown", "reason": "remote job metadata missing or mismatched"}\012    terminal = read_terminal_status(request)\012    if terminal is not None:\012        return terminal\012    requires_witness = "terminal_publication_protocol" in request\012    launch = read_json("launch.json") or {}\012    if launch.get("backend") == "systemd":\012        uid = os.getuid()\012        env = os.environ.copy()\012        env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")\012        env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{uid}/bus")\012        p = subprocess.run(\012            ["systemctl", "--user", "show", q["unit"], "--no-pager",\012             "--property=LoadState,ActiveState,SubState,Result,ExecMainPID,ExecMainCode,ExecMainStatus,InvocationID,Description"],\012            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)\012        props = {}\012        for line in p.stdout.splitlines():\012            if "=" in line:\012                k, v = line.split("=", 1); props[k] = v\012        # A --collect unit can disappear immediately after the runner exits.\012        # Re-read the atomic exit record after querying systemd to close that race.\012        terminal = read_terminal_status(request)\012        if terminal is not None:\012            return terminal\012        started = read_owner_binding()\012        nonce = request.get("launch_nonce")\012        invocation = started.get("invocation_id")\012        if not valid_owner(request, started, systemd=True):\012            return {"state":"owner_unknown","reason":"frozen supervisor binding unavailable",\012                    "status_authoritative":False,"automatic_retry":False}\012        if props.get("LoadState") != "not-found" and (props.get("InvocationID") != invocation or\012                props.get("Description") != f"Hepta Runtime job {q['"'"'job_id'"'"']} {nonce}"):\012            return {"state":"owner_unknown","reason":"unit incarnation differs from frozen supervisor",\012                    "status_authoritative":False,"automatic_retry":False}\012        active = props.get("ActiveState")\012        sub = props.get("SubState")\012        if active in ("active", "activating") and sub not in ("exited", "dead"):\012            try: matching = process_identity(started["supervisor_pid"]) == started["supervisor_identity"] and process_uid(started["supervisor_pid"]) == started["supervisor_uid"]\012            except (OSError, ValueError, subprocess.SubprocessError): matching = False\012            if not matching:\012                return {"state":"owner_unknown","reason":"frozen supervisor PID/start/UID unavailable or changed",\012                        "status_authoritative":False,"automatic_retry":False}\012            state = "running"\012        elif active == "failed":\012            if requires_witness:\012                return publication_pending("supervisor exited without a confirmed terminal receipt")\012            state = "failed"\012        elif active == "active" and sub == "exited":\012            if requires_witness:\012                return publication_pending("supervisor exited without a confirmed terminal receipt")\012            # RemainAfterExit can become visible a few microseconds before the\012            # supervisor'"'"'s atomic exit.json rename. systemd already has the\012            # authoritative process result, so use it rather than returning a\012            # false completed_unknown race.\012            try:\012                exit_code = int(props.get("ExecMainStatus", "-1"))\012            except ValueError:\012                exit_code = -1\012            if props.get("ExecMainCode") == "1":\012                state = "succeeded" if exit_code == 0 else "failed"\012                return {"state": state, "backend": "systemd", "exit_code": exit_code, "systemd": props}\012            state = "completed_unknown"\012        elif props.get("LoadState") == "not-found":\012            if requires_witness:\012                return publication_pending("supervisor disappeared without a confirmed terminal receipt")\012            state = "finalizing"\012        else:\012            if requires_witness:\012                return publication_pending("supervisor has no confirmed terminal receipt")\012            state = active or "unknown"\012        return {"state": state, "backend": "systemd", "systemd": props}\012    started = read_owner_binding()\012    if not valid_owner(request, started):\012        return {"state":"owner_unknown","reason":"frozen supervisor binding unavailable",\012                "status_authoritative":False,"automatic_retry":False}\012    pid = started["supervisor_pid"]\012    expected = started["supervisor_identity"]\012    actual = process_identity(pid)\012    running = bool(pid and actual is not None and (expected is not None and expected == actual))\012    if not running and requires_witness:\012        return publication_pending("supervisor disappeared without a confirmed terminal receipt")\012    return {"state": "running" if running else "lost", "backend": launch.get("backend", "detached"), "pid": pid, "identity": actual}\012\012deadline = time.monotonic() + min(float(q.get("wait_seconds", 0)), 30.0)\012while True:\012    status = one_status()\012    state = status.get("state")\012    transient = state in ("running", "activating", "finalizing", "completed_unknown")\012    now = time.monotonic()\012    if not transient or now >= deadline:\012        if (now >= deadline and state in ("finalizing", "completed_unknown") and\012                status.get("terminal_publication_confirmed") is not False):\012            status["state"] = "lost"\012            status["reason"] = "no exit record appeared before the wait deadline"\012        status["job_id"] = q["job_id"]\012        print(json.dumps(status, sort_keys=True))\012        break\012    time.sleep(0.1)\012'
