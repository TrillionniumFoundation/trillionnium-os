2    fd = private_open_job_file(name)\012    if fd is None: return None\012    with os.fdopen(fd, "rb") as stream:\012        before = os.fstat(stream.fileno())\012        if before.st_size > 4 * 1024 * 1024:\012            raise SystemExit("unsafe remote job file " + name + ": linked or oversized inode")\012        encoded = stream.read(4 * 1024 * 1024 + 1)\012        after = os.fstat(stream.fileno())\012        current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\012    def stamp(info):\012        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,\012                info.st_size, info.st_mtime_ns, info.st_ctime_ns)\012    if len(encoded) > 4 * 1024 * 1024 or stamp(before) != stamp(after) or stamp(after) != stamp(current):\012        raise SystemExit("unsafe remote job file " + name + ": changed while reading")\012    try:\012        value = json.loads(encoded)\012        if not isinstance(value, dict): raise ValueError("not an object")\012        return value\012    except (ValueError, UnicodeError) as error:\012        raise SystemExit("corrupt remote job file " + name) from error\012\012\012#!/usr/bin/env python3\012import errno, fcntl, hashlib, json, os, pathlib, select, shutil, signal, stat, subprocess, sys, threading, time\012# Only the trusted launcher chooses this argv marker, never request metadata.\012# A legacy unmarked runner retains the original detached nice adjustment.\012if len(sys.argv) not in (3, 4):\012    raise SystemExit("invalid supervisor launch backend; no workload submitted")\012launch_backend = sys.argv[3] if len(sys.argv) == 4 else "detached"\012if launch_backend not in ("systemd", "detached"):\012    raise SystemExit("invalid supervisor launch backend; no workload submitted")\012binding = json.loads(sys.argv[2])\012job = private_bound_job_directory(sys.argv[1], binding)\012req = private_read_json("request.json")\012if (req.get("job_id"), req.get("launch_nonce"), req.get("request_finger