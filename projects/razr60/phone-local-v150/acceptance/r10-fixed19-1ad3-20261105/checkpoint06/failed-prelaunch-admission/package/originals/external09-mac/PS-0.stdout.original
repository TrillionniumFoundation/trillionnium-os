86471     1 86471      0 Thu Nov  5 17:46:38 2026     /Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python -I -S -c \012import os, pathlib, stat, sys\012_hepta_directory_pins = []\012def private_job_directory(raw, create=False):\012    if not isinstance(raw, str) or not raw.startswith("/") or any(p in (".", "..") for p in raw.split("/")):\012        raise SystemExit("unsafe remote job path")\012    parts = [p for p in raw.split("/") if p]\012    if len(parts) < 3 or parts[-2] != "jobs":\012        raise SystemExit("remote job path must name a dedicated state/jobs/job directory")\012    shared_access = getattr(os, "O_PATH", os.O_RDONLY) if sys.platform == "linux" else os.O_RDONLY\012    path_only_shared = shared_access != os.O_RDONLY\012    directory_flags = os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC\012    fd = os.open("/", shared_access | directory_flags)\012    _hepta_directory_pins.append(fd)\012    for offset, part in enumerate(parts):\012        private = offset >= len(parts) - 3\012        if create and private and not path_only_shared:\012            try:\012                os.mkdir(part, mode=0o700, dir_fd=fd)\012                os.fsync(fd)\012            except FileExistsError:\012                pass\012        access = os.O_RDONLY if private else shared_access\012        try:\012            child = os.open(part, access | directory_flags, dir_fd=fd)\012        except FileNotFoundError:\012            if not (create and private and path_only_shared):\012                raise\012            # O_PATH traverses an existing searchable ancestor without reading it.\012            # A new child still needs its parent's original durability barrier:\012            # acquire a readable handle before mkdir, or refuse without creating.\012            sync_parent = os.open(".", os.O_RDONLY | directory_flags, dir_fd=fd)\012            _hepta_directory_pins.append(sync_parent)\012            pinned = os.fstat(fd)\012            readable = os.fstat(sync_parent)\012            if (pinned.st_dev, pinned.st_ino) != (readable.st_dev, readable.st_ino):\012                raise SystemExit("remote parent directory identity changed; no directory created")\012            try:\012                os.mkdir(part, mode=0o700, dir_fd=sync_parent)\012            except FileExistsError:\012                pass\012            else:\012                os.fsync(sync_parent)\012            child = os.open(part, os.O_RDONLY | directory_flags, dir_fd=sync_parent)\012        _hepta_directory_pins.append(child)\012        info = os.fstat(child)\012        if private and (info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700):\012            raise SystemExit("unsafe remote state/jobs/job directory; existing permissions are never repaired")\012        fd = child\012    os.fchdir(fd)\012    return pathlib.Path(".")\012\012def private_bound_job_directory(raw, expected):\012    job = private_job_directory(raw)\012    info = os.fstat(_hepta_directory_pins[-1])\012    if (info.st_dev, info.st_ino) != (expected["device"], expected["inode"]):\012        raise SystemExit("remote job directory identity changed; no workload submitted")\012    return job\012\012def private_open_job_file(name):\012    try:\012        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,\012                     dir_fd=_hepta_directory_pins[-1])\012    except FileNotFoundError:\012        return None\012    except OSError as error:\012        raise SystemExit("unsafe remote job file " + name) from error\012    info = os.fstat(fd)\012    if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or\012            info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o022):\012        os.close(fd)\012        raise SystemExit("unsafe remote job file " + name + ": non-regular or linked inode")\012    return fd\012\012def private_read_json(name):\012    import json\012    fd = private_open_job_file(name)\012    if fd is None: return None\012    with os.fdopen(fd, "rb") as stream:\012        before = os.fstat(stream.fileno())\012        if before.st_size > 4 * 1024 * 1024:\012            raise SystemExit("unsafe remote job file " + name + ": linked or oversized inode")\012        encoded = stream.read(4 * 1024 * 1024 + 1)\012        after = os.fstat(stream.fileno())\012        current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\012    def stamp(info):\012        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,\012                info.st_size, info.st_mtime_ns, info.st_ctime_ns)\012    if len(encoded) > 4 * 1024 * 1024 or stamp(before) != stamp(after) or stamp(after) != stamp(current):\012        raise SystemExit("unsafe remote job file " + name + ": changed while reading")\012    try:\012        value = json.loads(encoded)\012        if not isinstance(value, dict): raise ValueError("not an object")\012        return value\012    except (ValueError, UnicodeError) as error:\012        raise SystemExit("corrupt remote job file " + name) from error\012\012\012#!/usr/bin/env python3\012import errno, fcntl, hashlib, json, os, pathlib, select, shutil, signal, stat, subprocess, sys, threading, time\012# Only the trusted launcher chooses this argv marker, never request metadata.\012# A legacy unmarked runner retains the original detached nice adjustment.\012if len(sys.argv) not in (3, 4):\012    raise SystemExit("invalid supervisor launch backend; no workload submitted")\012launch_backend = sys.argv[3] if len(sys.argv) == 4 else "detached"\012if launch_backend not in ("systemd", "detached"):\012    raise SystemExit("invalid supervisor launch backend; no workload submitted")\012binding = json.loads(sys.argv[2])\012job = private_bound_job_directory(sys.argv[1], binding)\012req = private_read_json("request.json")\012if (req.get("job_id"), req.get("launch_nonce"), req.get("request_fingerprint")) != (binding["job_id"], binding["launch_nonce"], binding["request_fingerprint"]):\012    raise SystemExit("remote launch identity changed; no workload submitted")\012\012def atomic(name, value):\012    target = job / name\012    tmp = job / (name + ".tmp")\012    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\012    encoded = (json.dumps(value, sort_keys=True) + "\n").encode("utf-8")\012    with os.fdopen(fd, "wb") as stream:\012        stream.write(encoded)\012        stream.flush(); os.fsync(stream.fileno())\012    os.replace(tmp, target)\012    os.fsync(_hepta_directory_pins[-1])\012    return encoded\012\012def publish_terminal(value):\012    value = {**value, "terminal_publication_protocol": 1,\012             "job_id": req["job_id"], "launch_nonce": req["launch_nonce"]}\012    encoded = atomic("exit.json", value)\012    # A visible witness proves that the preceding exit file and directory\012    # barriers returned. Losing the witness only makes status unconfirmed;\012    # its presence does not claim its own final directory fsync survived loss.\012    atomic("exit.witness.json", {\012        "terminal_publication_protocol": 1,\012        "job_id": req["job_id"],\012        "launch_nonce": req["launch_nonce"],\012        "exit_sha256": hashlib.sha256(encoded).hexdigest(),\012    })\012\012def reap_original_child(child, timeout):\012    # Finish every original-group signal before entering this bounded wait.\012    # Popen.wait maps ECHILD to a successful-looking zero; only an actual\012    # waitpid return for this original child can prove a reap and exit code.\012    wait_deadline = time.monotonic() + timeout\012    while True:\012        waited_pid, status = os.waitpid(child.pid, os.WNOHANG)\012        if waited_pid == child.pid:\012            child.returncode = os.waitstatus_to_exitcode(status)\012            return child.returncode\012        if waited_pid != 0:\012            raise RuntimeError("wait returned an unexpected child identity")\012        remaining = wait_deadline - time.monotonic()\012        if remaining <= 0:\012            raise TimeoutError("original child wait deadline exceeded")\012        time.sleep(min(0.01, remaining))\012\012def process_identity(pid):\012    if sys.platform == "linux":\012        try:\012            ticks = int(pathlib.Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[19])\012            boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()\012            return {"kind": "proc_start_ticks", "value": boot + ":" + str(ticks)} if boot else None\012        except Exception:\012            return None\012    try:\012        value = subprocess.check_output(["ps", "-p", str(pid), "-o", "lstart="], text=True, timeout=3).strip()\012        return {"kind": "ps_lstart", "value": value} if value else None\012    except Exception:\012        return None\012\012os.umask(0o077)\012owner_fd = os.open(job / "owner.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)\012owner_stat = os.fstat(owner_fd)\012if not stat.S_ISREG(owner_stat.st_mode) or owner_stat.st_uid != os.geteuid() or owner_stat.st_nlink != 1 or owner_stat.st_mode & 0o077:\012    raise SystemExit("unsafe supervisor lifetime lock")\012fcntl.flock(owner_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\012if any(os.path.lexists(job / name) for name in ("owner-intent.json","started.json","exit.json","exit.witness.json","exit.witness.json.tmp")):\012    raise SystemExit("prior supervisor intent or binding exists; workload must not be replayed")\012if sys.platform == "linux":\012    if not hasattr(os, "waitid") or not hasattr(os, "WNOWAIT"):\012        raise SystemExit("non-reaping child identity observation unavailable; no workload submitted")\012elif not all(hasattr(select, name) for name in ("kqueue","kevent","KQ_FILTER_PROC","KQ_NOTE_EXIT")):\012    raise SystemExit("non-reaping child exit observation unavailable; no workload submitted")\012owner_identity = process_identity(os.getpid())\012if not owner_identity:\012    raise SystemExit("supervisor start identity unavailable; no workload submitted")\012owner_binding = {"at_unix_ms":int(time.time()*1000),"job_id":req["job_id"],\012    "launch_nonce":req["launch_nonce"],"supervisor_pid":os.getpid(),\012    "supervisor_uid":os.geteuid(),"supervisor_identity":owner_identity,\012    "invocation_id":os.environ.get("INVOCATION_ID")}\012def stage_owner(name):\012    fd = os.open(job / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\012    with os.fdopen(fd, "w", encoding="utf-8") as stream:\012        json.dump(owner_binding, stream, sort_keys=True); stream.flush(); os.fsync(stream.fileno())\012# Both files must be synced and closed before one barrier publishes their names.\012# Surviving partial creates remain tombstones; no workload precedes this barrier.\012stage_owner("owner-intent.json")\012stage_owner("started.json")\012os.fsync(_hepta_directory_pins[-1])\012child = None\012cancel_requested = False\012\012def stop_handler(signum, _frame):\012    global cancel_requested\012    cancel_requested = True\012\012signal.signal(signal.SIGTERM, stop_handler)\012signal.signal(signal.SIGINT, stop_handler)\012# systemd has already applied Nice=; only the detached path needs an adjustment.\012if launch_backend == "detached" and req.get("nice"):\012    try:\012        os.nice(int(req["nice"]))\012    except OSError:\012        pass\012out = open(job / "stdout.log", "ab", buffering=0)\012err = open(job / "stderr.log", "ab", buffering=0)\012stdin_handle = subprocess.DEVNULL\012if req.get("stdin_path"):\012    stdin_handle = open(job / "stdin.bin", "rb", buffering=0)\012env = os.environ.copy()\012env.update(req.get("env", {}))\012env["HEPTA_RUNTIME_JOB_ID"] = req["job_id"]\012try:\012    child = subprocess.Popen(\012        [req["executable"], *req.get("args", [])],\012        cwd=req.get("cwd") or req.get("default_cwd"),\012        env=env,\012        stdin=stdin_handle,\012        stdout=subprocess.PIPE,\012        stderr=subprocess.PIPE,\012        start_new_session=True,\012    )\012    atomic("child.json", {\012        "pid": child.pid,\012        "identity": process_identity(child.pid),\012    })\012except Exception as exc:\012    if child is not None:\012        # Popen crossed the effect boundary. Keep the original child unreaped\012        # until every group signal is sent, and never report a prelaunch error.\012        group_signal = "submitted"\012        try:\012            os.killpg(child.pid, signal.SIGKILL)\012        except ProcessLookupError:\012            group_signal = "already_absent"\012        except OSError:\012            group_signal = "failed"\012        child_reaped = False\012        try:\012            reap_original_child(child, 2)\012            child_reaped = True\012        except Exception:\012            pass\012        publish_terminal({\012            "at_unix_ms": int(time.time() * 1000),\012            "exit_code": 125,\012            "supervisor_error": "child receipt publication failed after spawn",\012            "effect_outcome": "unknown",\012            "status_authoritative": False,\012            "automatic_retry": False,\012            "child_spawned": True,\012            "child_pid": child.pid,\012            "child_group_signal": group_signal,\012            "child_reaped": child_reaped,\012            "child_exit_code": child.returncode if child_reaped else None,\012            "output_complete": False,\012            "output_durable": False,\012            "cancelled": False,\012            "timed_out": False,\012        })\012        raise SystemExit(125)\012    publish_terminal({\012        "at_unix_ms": int(time.time() * 1000),\012        "exit_code": 127,\012        "launch_error": str(exc),\012        "cancelled": False,\012        "timed_out": False,\012    })\012    print(str(exc), file=err, flush=True)\012    raise SystemExit(127)\012\012# Operator archives retain every byte; isolated compatibility remains bounded.\012# Disk failures are explicit capture errors, never silent tail eviction.\012log_truncated = {"stdout": False, "stderr": False}\012log_errors = {"stdout": None, "stderr": None}\012log_eof = {"stdout": False, "stderr": False}\012log_drain_finished = {"stdout": None, "stderr": None}\012log_bytes = {"stdout": {"seen": 0, "stored": 0}, "stderr": {"seen": 0, "stored": 0}}\012def drain(stream, sink, label):\012    stored = 0\012    try:\012        while True:\012            chunk = stream.read1(65536)\012            if not chunk:\012                log_eof[label] = True\012                break\012            log_bytes[label]["seen"] += len(chunk)\012            keep = chunk if req.get("execution_mode") == "operator" else chunk[:max(0, 16 * 1024 * 1024 - stored)]\012            if len(keep) != len(chunk):\012                log_truncated[label] = True\012            if log_errors[label] is None:\012                try:\012                    pending = memoryview(keep)\012                    while pending:\012                        written = sink.write(pending)\012                        if written is None or written <= 0 or written > len(pending):\012                            raise OSError("log write made invalid progress")\012                        stored += written\012                        log_bytes[label]["stored"] = stored\012                        pending = pending[written:]\012                except Exception as exc:\012                    # Continue draining after storage failure; never deadlock the\012                    # producer or publish silent success for lost output.\012                    log_errors[label] = "write: " + str(exc)\012    except Exception as exc:\012        log_errors[label] = "read: " + str(exc)\012    finally:\012        try:\012            stream.close()\012        except Exception as exc:\012            if log_errors[label] is None:\012                log_errors[label] = "close: " + str(exc)\012        log_drain_finished[label] = time.monotonic()\012\012readers = None\012try:\012    readers = [threading.Thread(target=drain, args=(child.stdout, out, "stdout"), daemon=True),\012               threading.Thread(target=drain, args=(child.stderr, err, "stderr"), daemon=True)]\012    for reader in readers:\012        reader.start()\012except Exception as exc:\012    # Reader startup is after Popen and the durable child receipt. Keep the\012    # original child unreaped until the last group signal, just as for a\012    # post-spawn receipt failure; this must never become a prelaunch error.\012    primary_error = type(exc).__name__ + ": " + str(exc)\012    cleanup_errors = []\012    group_signal = "submitted"\012    try:\012        os.killpg(child.pid, signal.SIGKILL)\012    except ProcessLookupError:\012        group_signal = "already_absent"\012    except Exception as cleanup:\012        group_signal = "failed"\012        cleanup_errors.append("signal: " + str(cleanup))\012    child_reaped = False\012    try:\012        reap_original_child(child, 2)\012        child_reaped = True\012    except Exception as cleanup:\012        cleanup_errors.append("wait: " + str(cleanup))\012    for index, (label, stream) in enumerate((("stdout", child.stdout), ("stderr", child.stderr))):\012        reader = readers[index] if readers is not None else None\012        # ident remains set after a thread exits. Join every reader whose\012        # startup is observable; do not join one without an observed ident.\012        try:\012            if reader is not None and reader.ident is not None:\012                reader.join(timeout=2)\012                if reader.is_alive():\012                    cleanup_errors.append(label + ": output reader did not stop")\012            else:\012                stream.close()\012        except Exception as cleanup:\012            cleanup_errors.append(label + ": " + str(cleanup))\012    try:\012        publish_terminal({\012            "at_unix_ms": int(time.time() * 1000),\012            "exit_code": 125,\012            "supervisor_error": "output reader startup failed after spawn: " + primary_error,\012            "supervisor_cleanup_errors": cleanup_errors,\012            "effect_outcome": "unknown",\012            "status_authoritative": False,\012            "automatic_retry": False,\012            "child_spawned": True,\012            "child_pid": child.pid,\012            "child_group_signal": group_signal,\012            "child_reaped": child_reaped,\012            "child_exit_code": child.returncode if child_reaped else None,\012            "output_complete": False,\012            "output_durable": False,\012            "cancelled": False,\012            "timed_out": False,\012        })\012    except Exception as publication_error:\012        # A failed error receipt must not replace the original startup error.\012        raise exc from publication_error\012    raise SystemExit(125)\012timed_out = False\012timeout = req.get("timeout_seconds")\012deadline = time.monotonic() + float(timeout) if timeout else None\012stop_deadline, kill_submitted = None, False\012# Preserve both original join budgets while the leader remains unreaped:\012# stdout gets two seconds, then stderr gets two seconds after stdout finishes.\012# The absolute four-second cap also bounds any cleanup after a failed join.\012leader_drain_until, leader_reader_deadline = None, None\012leader_reader_index, leader_reader_expired = 0, False\012leader_drain_error, leader_group_signal = None, "not_submitted"\012leader_group_signal_number = None\012leader_kill_submitted, leader_cancel_signalled = False, False\012leader_cleanup_errors = []\012exit_queue, exit_seen = None, False\012def exit_observation_failed(exc):\012    # A failed observer does not establish that the submitted child stopped.\012    # Except for ECHILD, this owner has never reaped its original child: finish\012    # every group signal before its bounded wait. ECHILD expressly removes\012    # that custody; neither a saved PID nor Popen's ECHILD compatibility result\012    # may then authorize signalling or be presented as a known child exit.\012    primary_error = type(exc).__name__ + ": " + str(exc)\012    cleanup_errors = []\012    custody_retained = not isinstance(exc, ChildProcessError) and getattr(exc, "errno", None) != errno.ECHILD\012    group_signal, group_signal_number, child_reaped = "not_submitted", None, False\012    if custody_retained:\012        group_signal, group_signal_number = "submitted", int(signal.SIGKILL)\012        try:\012            os.killpg(child.pid, signal.SIGKILL)\012        except ProcessLookupError:\012            group_signal = "already_absent"\012        except Exception as cleanup:\012            group_signal = "failed"\012            cleanup_errors.append("signal: " + str(cleanup))\012        try:\012            reap_original_child(child, 2)\012            child_reaped = True\012        except Exception as cleanup:\012            if isinstance(cleanup, ChildProcessError) or getattr(cleanup, "errno", None) == errno.ECHILD:\012                custody_retained = False\012            cleanup_errors.append("wait: " + str(cleanup))\012    else:\012        cleanup_errors.append("wait: original child custody unavailable; no signal or wait submitted")\012    # This is a separate failure cleanup budget, never a new workload timeout\012    # or a retry. One absolute join budget covers both already-started readers.\012    join_deadline = time.monotonic() + 2\012    for label, reader in zip(("stdout", "stderr"), readers):\012        try:\012            reader.join(timeout=max(0, join_deadline - time.monotonic()))\012            if reader.is_alive():\012                cleanup_errors.append(label + ": output reader did not stop")\012        except Exception as cleanup:\012            cleanup_errors.append(label + ": " + str(cleanup))\012    if exit_queue is not None:\012        try:\012            exit_queue.close()\012        except Exception as cleanup:\012            cleanup_errors.append("observer close: " + str(cleanup))\012    try:\012        publish_terminal({\012            "at_unix_ms": int(time.time() * 1000),\012            "exit_code": 125,\012            "supervisor_error": "child exit observation failed after spawn: " + primary_error,\012            "supervisor_cleanup_errors": cleanup_errors,\012            "effect_outcome": "unknown",\012            "status_authoritative": False,\012            "automatic_retry": False,\012            "child_spawned": True,\012            "child_pid": child.pid,\012            "child_custody_retained": custody_retained,\012            "child_group_signal": group_signal,\012            "child_group_signal_number": group_signal_number,\012            "child_reaped": child_reaped,\012            "child_exit_code": child.returncode if child_reaped else None,\012            "output_complete": False,\012            "output_durable": False,\012            "cancelled": bool(cancel_requested),\012            "timed_out": bool(timed_out),\012        })\012    except Exception as publication_error:\012        raise exc from publication_error\012    raise SystemExit(125)\012\012if sys.platform != "linux":\012    try:\012        exit_queue = select.kqueue()\012        try:\012            exit_queue.control([select.kevent(child.pid, filter=select.KQ_FILTER_PROC,\012                flags=select.KQ_EV_ADD | select.KQ_EV_ENABLE, fflags=select.KQ_NOTE_EXIT)], 0, 0)\012        except ProcessLookupError:\012            exit_seen = True\012    except Exception as exc:\012        exit_observation_failed(exc)\012while True:\012    # waitid(WNOWAIT) / kqueue observes exit without reaping. The original\012    # leader holds its PID/PGID until this one path completes all group signals.\012    try:\012        if sys.platform == "linux":\012            exited = os.waitid(os.P_PID, child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)\012        else:\012            exit_seen = exit_seen or bool(exit_queue.control([], 1, 0))\012            exited = True if exit_seen else None\012    except Exception as exc:\012        exit_observation_failed(exc)\012    now = time.monotonic()\012    if exited is None and deadline is not None and now >= deadline:\012        timed_out = True\012    stopping = timed_out or cancel_requested\012    if exited is not None and not stopping and leader_drain_until is None:\012        leader_reader_deadline, leader_drain_until = now + 2, now + 4\012    if leader_drain_until is not None:\012        if not leader_kill_submitted:\012            while leader_reader_index < len(readers):\012                label = ("stdout", "stderr")[leader_reader_index]\012                finished = log_drain_finished[label]\012                # Natural completion requires EOF and an ended thread: a read\012                # failure also ends drain without releasing inherited writers.\012                # A completion timestamp later than this reader's deadline\012                # cannot turn an expired join into success.\012                if (log_eof[label] and not readers[leader_reader_index].is_alive() and finished is not None\012                        and finished <= leader_reader_deadline):\012                    leader_reader_index += 1\012                    if leader_reader_index < len(readers):\012                        leader_reader_deadline = min(leader_drain_until, now + 2)\012                    continue\012                if now >= leader_reader_deadline:\012                    leader_reader_expired = True\012                break\012            if leader_reader_index == len(readers):\012                break\012        elif not any(reader.is_alive() for reader in readers):\012            break\012        # Cancellation during this existing drain window must not renew it\012        # with a fresh eight-second cancellation grace period.\012        if cancel_requested and not leader_cancel_signalled 