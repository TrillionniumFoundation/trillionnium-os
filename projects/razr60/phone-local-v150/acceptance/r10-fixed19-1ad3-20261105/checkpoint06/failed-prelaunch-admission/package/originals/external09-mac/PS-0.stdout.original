m:\n        before = os.fstat(stream.fileno())\n        if before.st_size > 4 * 1024 * 1024:\n            raise SystemExit(\"unsafe remote job file \" + name + \": linked or oversized inode\")\n        encoded = stream.read(4 * 1024 * 1024 + 1)\n        after = os.fstat(stream.fileno())\n        current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\n    def stamp(info):\n        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,\n                info.st_size, info.st_mtime_ns, info.st_ctime_ns)\n    if len(encoded) > 4 * 1024 * 1024 or stamp(before) != stamp(after) or stamp(after) != stamp(current):\n        raise SystemExit(\"unsafe remote job file \" + name + \": changed while reading\")\n    try:\n        value = json.loads(encoded)\n        if not isinstance(value, dict): raise ValueError(\"not an object\")\n        return value\n    except (ValueError, UnicodeError) as error:\n        raise SystemExit(\"corrupt remote job file \" + name) from error\n\n"\012exec(REMOTE_DIRECTORY_SOURCE)\012\012import io, json\012_original_query = json.load(sys.stdin)\012_bound_job = private_job_directory(_original_query["job_dir"])\012_bound_request = private_read_json("request.json")\012_digest = _original_query.get("request_digest")\012if (not isinstance(_bound_request, dict) or not isinstance(_digest, str) or len(_digest) != 64 or\012        any(c not in "0123456789abcdef" for c in _digest) or\012        _bound_request.get("job_id") != _original_query.get("job_id") or\012        _bound_request.get("job_dir") != _original_query.get("job_dir") or\012        _bound_request.get("unit") != _original_query.get("unit") or\012        _bound_request.get("request_digest", _bound_request.get("request_fingerprint")) != _digest):\012    raise SystemExit("remote job request binding missing or mismatched")\012# Metadata is validated before a status can claim success or cancellation can\012# acknowledge a terminal receipt. The status owner interprets a torn private\012# started.json as unknown, and a confirmed terminal receipt takes precedence.\012# Cancellation still validates its owner record before sending any signal.\012for _name in ("launch.json", "exit.json"):\012    private_read_json(_name)\012sys.stdin = io.StringIO(json.dumps(_original_query))\012\012\012import json, pathlib, sys\012q = json.load(sys.stdin)\012job = private_job_directory(q["job_dir"])\012try:\012    request = private_read_json("request.json")\012except Exception:\012    raise SystemExit("remote job metadata missing")\012if request.get("job_id") != q["job_id"]:\012    raise SystemExit("remote job metadata mismatch")\012limit = max(1, min(int(q.get("limit", 16384)), 16384))\012\012def read_part(name, offset):\012    fd = private_open_job_file(name)\012    offset = max(0, int(offset or 0))\012    data = b""\012    size = 0\012    if fd is not None:\012        with os.fdopen(fd, "rb") as stream:\012            before = os.fstat(stream.fileno())\012            size = before.st_size\012            if offset > size: raise SystemExit("cursor exceeds log length; refusing silent rewind")\012            stream.seek(offset)\012            data = stream.read(min(limit, size - offset))\012            current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\012            after = os.fstat(stream.fileno())\012            if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino) or after.st_nlink != 1 or after.st_size < size:\012                raise SystemExit("remote log identity changed while reading")\012    elif offset:\012        raise SystemExit("cursor exceeds log length; refusing silent rewind")\012    return {"offset": offset, "next_offset": offset + len(data), "size": size,\012            "eof": offset + len(data) >= size, "text": data.decode("utf-8", errors="replace"),\012            "bytes_hex": data.hex()}\012\012print(json.dumps({\012    "job_id": q["job_id"],\012    "stdout": read_part("stdout.log", q.get("stdout_offset", 0)),\012    "stderr": read_part("stderr.log", q.get("stderr_offset", 0)),\012}, sort_keys=True))\012'
