23438 64517 64517      0 Thu Nov  5 18:55:38 2026     ssh -T -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=yes -o ForwardAgent=no desktop-ts 'python3' -c 'REMOTE_DIRECTORY_SOURCE = "\nimport os, pathlib, stat, sys\n_hepta_directory_pins = []\ndef private_job_directory(raw, create=False):\n    if not isinstance(raw, str) or not raw.startswith(\"/\") or any(p in (\".\", \"..\") for p in raw.split(\"/\")):\n        raise SystemExit(\"unsafe remote job path\")\n    parts = [p for p in raw.split(\"/\") if p]\n    if len(parts) < 3 or parts[-2] != \"jobs\":\n        raise SystemExit(\"remote job path must name a dedicated state/jobs/job directory\")\n    shared_access = getattr(os, \"O_PATH\", os.O_RDONLY) if sys.platform == \"linux\" else os.O_RDONLY\n    path_only_shared = shared_access != os.O_RDONLY\n    directory_flags = os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC\n    fd = os.open(\"/\", shared_access | directory_flags)\n    _hepta_directory_pins.append(fd)\n    for offset, part in enumerate(parts):\n        private = offset >= len(parts) - 3\n        if create and private and not path_only_shared:\n            try:\n                os.mkdir(part, mode=0o700, dir_fd=fd)\n                os.fsync(fd)\n            except FileExistsError:\n                pass\n        access = os.O_RDONLY if private else shared_access\n        try:\n            child = os.open(part, access | directory_flags, dir_fd=fd)\n        except FileNotFoundError:\n            if not (create and private and path_only_shared):\n                raise\n            # O_PATH traverses an existing searchable ancestor without reading it.\n            # A new child still needs its parent'"'"'s original durability barrier:\n            # acquire a readable handle before mkdir, or refuse without creating.\n            sync_parent = os.open(\".\", os.O_RDONLY | directory_flags, dir_fd=fd)\n            _hepta_directory_pins.append(sync_parent)\n            pinned = os.fstat(fd)\n            readable = os.fstat(sync_parent)\n            if (pinned.st_dev, pinned.st_ino) != (readable.st_dev, readable.st_ino):\n                raise SystemExit(\"remote parent directory identity changed; no directory created\")\n            try:\n                os.mkdir(part, mode=0o700, dir_fd=sync_parent)\n            except FileExistsError:\n                pass\n            else:\n                os.fsync(sync_parent)\n            child = os.open(part, os.O_RDONLY | directory_flags, dir_fd=sync_parent)\n        _hepta_directory_pins.append(child)\n        info = os.fstat(child)\n        if private and (info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700):\n            raise SystemExit(\"unsafe remote state/jobs/job directory; existing permissions are never repaired\")\n        fd = child\n    os.fchdir(fd)\n    return pathlib.Path(\".\")\n\ndef private_bound_job_directory(raw, expected):\n    job = private_job_directory(raw)\n    info = os.fstat(_hepta_directory_pins[-1])\n    if (info.st_dev, info.st_ino) != (expected[\"device\"], expected[\"inode\"]):\n        raise SystemExit(\"remote job directory identity changed; no workload submitted\")\n    return job\n\ndef private_open_job_file(name):\n    try:\n        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,\n                     dir_fd=_hepta_directory_pins[-1])\n    except FileNotFoundError:\n        return None\n    except OSError as error:\n        raise SystemExit(\"unsafe remote job file \" + name) from error\n    info = os.fstat(fd)\n    if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or\n            info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o022):\n        os.close(fd)\n        raise SystemExit(\"unsafe remote job file \" + name + \": non-regular or linked inode\")\n    return fd\n\ndef private_read_json(name):\n    import json\n    fd = private_open_job_file(name)\n    if fd is None: return None\n    with os.fdopen(fd, \"rb\") as stream:\n        before = os.fstat(stream.fileno())\n        if before.st_size > 4 * 1024 * 1024:\n            raise SystemExit(\"unsafe remote job file \" + name + \": linked or oversized inode\")\n        encoded = stream.read(4 * 1024 * 1024 + 1)\n        after = os.fstat(stream.fileno())\n        current = os.stat(name, dir_fd=_hepta_directory_pins[-1], follow_symlinks=False)\n    def stamp(info):\n        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,\n                info.st_size, info.st_mtime_ns, info.st_ctime_ns)\n    if len(encoded) > 4 * 1024 * 1024 or stamp(before) != stamp(after) or stamp(after) != stamp(current):\n        raise SystemExit(\"unsafe remote job file \" + name + \": changed while reading\")\n    try:\n        value = json.loads(encoded)\n        if not isinstance(value, dict): raise ValueError(\"not an object\")\n        return value\n    except (ValueError, UnicodeError) as error:\n        raise SystemExit(\"corrupt remote job file \" + name) from error\n\n"\012exec(REMOTE_DIRECTORY_SOURCE)\012\012import fcntl, json, os, pathlib, shutil, subprocess, sys, time\012req = json.load(sys.stdin)\012req["default_cwd"] = os.getcwd()\012os.umask(0o077)\012job = private_job_directory(req["job_dir"], create=True)\012lock_fd = os.open(job / "launch.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)\012lock_info = os.fstat(lock_fd)\012if not stat.S_ISREG(lock_info.st_mode) or lock_info.st_uid != os.geteuid() or lock_info.st_nlink != 1 or stat.S_IMODE(lock_info.st_mode) != 0o600:\012    raise SystemExit("unsafe remote launch lock")\012launch_lock = os.fdopen(lock_fd, "a")\012fcntl.flock(launch_lock.fileno(), fcntl.LOCK_EX)\012\012\012def read_json(name):\012    return private_read_json(name)\012\012def atomic(name, value):\012    target = job / name\012    tmp = job / (name + ".tmp")\012    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\012    with os.fdopen(fd, "w", encoding="utf-8") as stream:\012        stream.write(json.dumps(value, sort_keys=True) + "\n")\012        stream.flush(); os.fsync(stream.fileno())\012    os.replace(tmp, target)\012    fd = os.open(job, os.O_RDONLY)\012    try: os.fsync(fd)\012    finally: os.close(fd)\012\012def stage_file(name, data, mode):\012    # A durable request/launch must never refer to an unsynchronized input or\012    # supervisor archive. Partial creates remain tombstones, never replacements.\012    fd = os.open(job / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)\012    with os.fdopen(fd, "wb") as stream:\012        stream.write(data)\012        os.fchmod(stream.fileno(), mode)\012        stream.flush()\012        os.fsync(stream.fileno())\012    os.fsync(_hepta_directory_pins[-1])\012\012stdin_text = req.pop("stdin", None)\012existing = read_json("request.json")\012if existing is not None:\012    if (existing.get("job_id") != req.get("job_id") or existing.get("request_fingerprint") != req.get("request_fingerprint") or\012            existing.get("job_dir") != req.get("job_dir") or existing.get("unit") != req.get("unit") or\012            existing.get("request_digest", existing.get("request_fingerprint")) != req.get("request_digest", req.get("request_fingerprint"))):\012        raise SystemExit("remote job directory is bound to a different request")\012    launch = read_json("launch.json")\012    exit_data = read_json("exit.json")\012    # An existing request never launches again. Owner tombstones need not be\012    # parsed here; status owns their conservative interpretation.\012    if launch and launch.get("backend") == "launch_failed":\012        raise SystemExit("prior remote launch failed; reconcile original identity without replay")\012    if launch or exit_data:\012        print(json.dumps({"ok": True, "reused_remote": True, **(launch or {"backend": "completed"})}, sort_keys=True))\012        raise SystemExit(0)\012    raise SystemExit("ambiguous prior launch: inspect th