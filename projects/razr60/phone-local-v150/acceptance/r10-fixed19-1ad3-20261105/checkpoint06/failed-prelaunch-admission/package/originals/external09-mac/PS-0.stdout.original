dentity changed; no workload submitted")\012\012def atomic(name, value):\012    target = job / name\012    tmp = job / (name + ".tmp")\012    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\012    encoded = (json.dumps(value, sort_keys=True) + "\n").encode("utf-8")\012    with os.fdopen(fd, "wb") as stream:\012        stream.write(encoded)\012        stream.flush(); os.fsync(stream.fileno())\012    os.replace(tmp, target)\012    os.fsync(_hepta_directory_pins[-1])\012    return encoded\012\012def publish_terminal(value):\012    value = {**value, "terminal_publication_protocol": 1,\012             "job_id": req["job_id"], "launch_nonce": req["launch_nonce"]}\012    encoded = atomic("exit.json", value)\012    # A visible witness proves that the preceding exit file and directory\012    # barriers returned. Losing the witness only makes status unconfirmed;\012    # its presence does not claim its own final directory fsync survived loss.\012    atomic("exit.witness.json", {\012        "terminal_publication_protocol": 1,\012        "job_id": req["job_id"],\012        "launch_nonce": req["launch_nonce"],\012        "exit_sha256": hashlib.sha256(encoded).hexdigest(),\012    })\012\012def reap_original_child(child, timeout):\012    # Finish every original-group signal before entering this bounded wait.\012    # Popen.wait maps ECHILD to a successful-looking zero; only an actual\012    # waitpid return for this original child can prove a reap and exit code.\012    wait_deadline = time.monotonic() + timeout\012    while True:\012        waited_pid, status = os.waitpid(child.pid, os.WNOHANG)\012        if waited_pid == child.pid:\012            child.returncode = os.waitstatus_to_exitcode(status)\012            return child.returncode\012        if waited_pid != 0:\012            raise RuntimeError("wait returned an unexpected child identity")\012        remaining = wait_deadline - time.monotonic()\012        if remaining <= 0:\012            raise TimeoutError("original child wait deadline exceeded")\012        time.sleep(min(0.01, remaining))\012\012def process_identity(pid):\012    if sys.platform == "linux":\012        try:\012            ticks = int(pathlib.Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[19])\012            boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()\012            return {"kind": "proc_start_ticks", "value": boot + ":" + str(ticks)} if boot else None\012        except Exception:\012            return None\012    try:\012        value = subprocess.check_output(["ps", "-p", str(pid), "-o", "lstart="], text=True, timeout=3).strip()\012        return {"kind": "ps_lstart", "value": value} if value else None\012    except Exception:\012        return None\012\012os.umask(0o077)\012owner_fd = os.open(job / "owner.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)\012owner_stat = os.fstat(owner_fd)\012if not stat.S_ISREG(owner_stat.st_mode) or owner_stat.st_uid != os.geteuid() or owner_stat.st_nlink != 1 or owner_stat.st_mode & 0o077:\012    raise SystemExit("unsafe supervisor lifetime lock")\012fcntl.flock(owner_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\012if any(os.path.lexists(job / name) for name in ("owner-intent.json","started.json","exit.json","exit.witness.json","exit.witness.json.tmp")):\012    raise SystemExit("prior supervisor intent or binding exists; workload must not be replayed")\012if sys.platform == "linux":\012    if not hasattr(os, "waitid") or not hasattr(os, "WNOWAIT"):\012        raise SystemExit("non-reaping child identity observation unavailable; no workload submitted")\012elif not all(hasattr(select, name) for name in ("kqueue","kevent","KQ_FILTER_PROC","KQ_NOTE_EXIT")):\012    raise SystemExit("non-reaping child exit observation unavailable; no workload submitted")\012owner_identity = process_identity(os.getpid())\012if not owner_identity:\012    raise SystemExit("supervisor start identity unavailable; no workload submitted")\012owner_binding = {"at_unix_ms":int(time.time()*1000),"job_id":req["job_id"],\012    "launch_nonce":req["launch_nonce"],"supervisor_pid":os.getpid(),\012    "supervisor_uid":os.geteuid(),"supervisor_identity":owner_identity,\012    "invocation_id":os.environ.get("INVOCATION_ID")}\012def stage_owner(name):\012    fd = os.open(job / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\012    with os.fdopen(fd, "w", encoding="utf-8") as stream:\012        json.dump(owner_binding, stream, sort_keys=True); stream.flush(); os.fsync(stream.fileno())\012# Both files must be synced and closed before one barrier publishes their names.\012# Surviving partial creates remain tombstones; no workload precedes this barrier.\012stage_owner("owner-intent.json")\012stage_owner("started.json")\012os.fsync(_hepta_directory_pins[-1])\012child = None\012cancel_requested = False\012\012def stop_handler(signum, _frame):\012    global cancel_requested\012    cancel_requested = True\012\012signal.signal(signal.SIGTERM, stop_handler)\012signal.signal(signal.SIGINT, stop_handler)\012# systemd has already applied Nice=; only the detached path needs an adjustment.\012if launch_backend == "detached" and req.get("nice"):\012    try:\012        os.nice(int(req["nice"]))\012    except OSError:\012        pass\012out = open(job / "stdout.log", "ab", buffering=0)\012err = open(job / "stderr.log", "ab", buffering=0)\012stdin_handle = subprocess.DEVNULL\012if req.get("stdin_path"):\012    stdin_handle = open(job / "stdin.bin", "rb", buffering=0)\012env = os.environ.copy()\012env.update(req.get("env", {}))\012env["HEPTA_RUNTIME_JOB_ID"] = req["job_id"]\012try:\012    child = subprocess.Popen(\012        [req["executable"], *req.get("args", [])],\012        cwd=req.get("cwd") or req.get("default_cwd"),\012        env=env,\012        stdin=stdin_handle,\012        stdout=subprocess.PIPE,\012        stderr=subprocess.PIPE,\012        start_new_session=True,\012    )\012    atomic("child.json"