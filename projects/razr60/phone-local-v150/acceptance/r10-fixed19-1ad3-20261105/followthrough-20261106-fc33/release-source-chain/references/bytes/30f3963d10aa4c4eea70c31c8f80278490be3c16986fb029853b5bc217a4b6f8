# R3 full IPC candidate = exact frozen r2 body plus runtime-self delta below.
# Business public-interface delta is separate and is not included.
# The r2 comments below identify the preserved predecessor input.

# R2 CANDIDATE ONLY. Magisk 31.1 parser statements, not platform TE.
# Do not apply before independent review and offline actual-parser validation.
# Only new domains/labels are introduced; no bootstrap -> magisk allow.
type trillionnium_owner_open_phone_executor domain
type trillionnium_owner_open_phone_worker domain
type trillionnium_owner_open_phone_executor_exec file_type
typeattribute trillionnium_owner_open_phone_executor_exec exec_type
type trillionnium_owner_open_phone_worker_exec file_type
typeattribute trillionnium_owner_open_phone_worker_exec exec_type
