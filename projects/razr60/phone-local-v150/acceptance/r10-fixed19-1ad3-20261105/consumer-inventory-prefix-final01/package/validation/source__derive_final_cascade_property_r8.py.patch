+        require(type(row) is dict and set(row) == {'path', 'bytes', 'sha256'}
+                and type(row['path']) is str and row['path'] not in rows
+                and type(row['bytes']) is int and 0 <= row['bytes'] <= 8 * 1024 * 1024
+                and type(row['sha256']) is str,
