<resources>
    <style name="Theme.HeptaOwnerOpen" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/hepta_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/hepta_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/hepta_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustNothing</item>
    </style>
</resources>
