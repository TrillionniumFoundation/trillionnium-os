<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.trillionnium.owneropen">
    <application
        android:allowBackup="false"
        android:debuggable="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_hepta_launcher"
        android:roundIcon="@mipmap/ic_hepta_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.HeptaOwnerOpen"
        android:resizeableActivity="true">
        <activity
            android:name=".OwnerOpenShellActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="moto_cli_fullscreen_mode" android:value="true" />
            <meta-data android:name="moto_cli_orientation" android:value="16" />
        </activity>
        <!-- Explicit OEM external-launcher route. Opening it only presents the
             existing HEPTA conversation on the caller's display. -->
        <activity android:name=".OwnerOpenCoverEntryActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.trillionnium.owneropen.OPEN_COVER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="moto_cli_fullscreen_mode" android:value="true" />
        </activity>
        <!-- Privileged read-only session snapshot export for the owner's
             pre-DSU-migration ADB backup. No cross-app write methods.
             DUMP permission is granted to the Android shell; provider also
             enforces Binder uid 2000 in openFile. -->
        <provider
            android:name=".OwnerOpenStateBackupProvider"
            android:authorities="org.trillionnium.owneropen.audit"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />
        <service
            android:name=".OwnerOpenTileService"
            android:exported="true"
            android:label="@string/systemui_entry_label"
            android:icon="@drawable/ic_owner_open_entry"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>

