<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.trillionnium.hepta.entry">
    <queries><package android:name="org.trillionnium.owneropen" /></queries>
    <application android:allowBackup="false" android:debuggable="false"
        android:label="@string/app_name" android:icon="@drawable/ic_hepta_entry"
        android:supportsRtl="true" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".EntrySetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".OpenHeptaActivity" android:exported="true"
            android:noHistory="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <meta-data android:name="moto_cli_fullscreen_mode" android:value="true" />
        </activity>
        <receiver android:name=".ShortcutPinnedReceiver" android:exported="false" />
        <receiver android:name=".HeptaEntryWidget" android:exported="false"
            android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hepta_entry_widget" />
        </receiver>
    </application>
</manifest>
