+def pinned_cli_file(path, expected_sha, label):
+    identity = file_identity(path)
+    require(stat.S_ISREG(path.stat().st_mode), f'{label} is not a regular file')
+    require(sha(path) == expected_sha, f'{label} byte pin differs; review update before restart')
+    require(file_identity(path) == identity, f'{label} changed during qualification')
+    return {'path': str(path), 'sha256': expected_sha, 'file_identity': identity}
+
+
+def qualify_cli(args):
+    # The selected, byte-pinned launcher delegates to this exact bundled program.
+    # Pin both files and launch the qualified program directly, preserving argv.
+    launcher = Path(args.codex).resolve(strict=True)
+    executable = (launcher.parent.parent/'CodexCLI.app/Contents/MacOS/codex').resolve(strict=True)
+    launcher_pin = pinned_cli_file(launcher, CLI_SHA, 'CLI launcher')
+    executable_pin = pinned_cli_file(executable, CLI_EXECUTABLE_SHA, 'CLI executable')
+    args.codex = str(launcher)
+    args.cli_stat = launcher_pin['file_identity']
+    args.cli_binary = str(executable)
+    args.cli_binary_stat = executable_pin['file_identity']
+    args.cli_binding = {'schema': 'hepta.cli-executable-binding.v1',
+                        'launcher': launcher_pin, 'executable': executable_pin}
 
 
